#!/usr/bin/env bash
# Entry point. Runs the package from the repository root so `adh` is importable
# without installation.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from adh.__main__ import main; sys.exit(main(sys.argv[2:]))' "$HERE" "$@"
