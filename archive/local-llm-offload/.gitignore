# whitelist: ignore everything, then allow source/docs
*
!.gitignore
!*/
!*.py
!*.sh
!*.md
!*.yaml
!*.jinja
!*.plist
!ollama-dispatch*
!ollama-land
!harness-lint
!graphify-all
# never
*.bak*
*.orig
*.retired*
*.severed*
*.corrupt*
*.log
*.lock
*.json
*.jsonl
*.tar.gz
__pycache__/
.ruff_cache/
.archive/
.deploy-bak/
.dispatch-auto-sync-backup-*/
*-venv/
*-logs/
*-logs-backups/
*-livelogs/
retired/
retired-launchagents/
test-fixtures*/
vault-embed-index/
llama-swap
gRPCServerCLI
*token*
*secret*
*key*
*.env
*.pem
cashback-unwrap/
