except Exception:
    pass
_in_scope_harness = [f for f in _scope
                     if (f[2:] if f.startswith("./") else f) in _HARNESS_NAMES]
if _in_scope_harness:
    fail("TASK.md's scope line lets the coding job edit harness file(s) "
