MAX_EXTRA_LITERALS = 8
if _REQUIRED and len(_mc_lits) > len(_REQUIRED) + MAX_EXTRA_LITERALS:
    fail("TASK.md `## Must contain` lists %d literal(s) but the plan pins only %d: keep the "
         "plan's literals and at most %d extra ones (the 2-3 names that most directly prove "
