CONFIG_DIR = Path(os.environ.get("OLLAMA_DISPATCH_HOME",
                                 Path.home() / ".ollama-dispatch"))
DEFAULTS_FILE = CONFIG_DIR / "defaults.json"
FALLBACK_MODEL = "qwen3.6-35b-a3b-vl-mtp-mxfp8"   # Darkbloom default (2026-10-02, the owner approved)
FALLBACK_HOST = "studio"

# num_ctx sizing (fix 2026-09-13): the old hard-coded 32768 default starved a
# large target (e.g. the 3012-line ollama-queue.py) -- the refine loop hit
# context_threshold and re-paused forever even when the model had the right fix.
# Size the base window to the TARGET file instead: ~bytes/3.5 tokens for the
# file, + generous headroom for TASK + fixture + iteration history, rounded up
# to the next power of two and clamped into [MIN_NUM_CTX, MODEL_MAX_CTX].
MODEL_MAX_CTX = 131072          # host ceiling used elsewhere in the pipeline
MIN_NUM_CTX = 32768             # the previous hard-coded default is now the floor
NUM_CTX_HEADROOM_TOKENS = 24000  # TASK + fixture + refimpl + iteration transcript
NUM_CTX_BYTES_PER_TOKEN = 3.5

# Authoring-phase num_ctx FLOOR (fix 2026-09-17): compute_num_ctx() sizes the base
# window to the TARGET file, so a SMALL target floors at MIN_NUM_CTX (32768). But the
# AUTHORING dispatch does not merely read the target -- it has the model write TASK.md +
# an adversarial test + refimpl.py and SELF-ITERATE (up to 14+ rounds), carrying the full
# authoring transcript forward each round. That transcript accumulation, not the target,
# fills the window: a TRIVIAL job (add "costco" to an ALWAYS_SITES array in a small .js,
# job 10e301cbfc24) PAUSED at iteration 9/14 with pause_meta={tokens_used:30269,
# num_ctx:32768} (92%), pause_reason=context_threshold -- it never converged despite the
# fix being one line. This is the exact analogue of ollama-queue.py's DIAGNOSIS_CTX_FLOOR
# (a repo-reading diagnosis floored at 49152, set after a diagnosis paused at 92% on 32768
# at iter 18/30). Authoring hit the wall EARLIER per-iteration (9/14 vs 18/30), i.e. it
# accumulates FASTER, so its floor is set one bucket higher: 65536 -- the top safe CTX
# bucket used across the pipeline (~59k usable tokens at the 0.90 pause), well under the
# 131072 host ceiling. A bigger target still sizes ABOVE this and clamps to the ceiling;
# an explicit --num-ctx always wins. This does NOT touch the 90% safety pause -- that pause
# is correct for a real context wall; this just gives trivial jobs the room not to hit it.
AUTHORING_CTX_FLOOR = 65536


def compute_num_ctx(target_file: Path,
                    model_max: int = MODEL_MAX_CTX,
                    floor: int = MIN_NUM_CTX) -> tuple:
    """Base num_ctx sized to the target file. Returns (num_ctx, why).

    A missing/absent target (a genuine creation task, or --new-project) sizes
    from zero bytes, i.e. the floor -- there is nothing to read in yet."""
    try:
        nbytes = Path(target_file).stat().st_size
    except Exception:
        nbytes = 0
    need = math.ceil(nbytes / NUM_CTX_BYTES_PER_TOKEN) + NUM_CTX_HEADROOM_TOKENS
    pow2 = 1 << max(0, (need - 1).bit_length())  # next power of two >= need
    chosen = max(floor, min(pow2, model_max))
    why = (f"target {nbytes}B ~= {math.ceil(nbytes / NUM_CTX_BYTES_PER_TOKEN)} tok "
           f"+ {NUM_CTX_HEADROOM_TOKENS} headroom = {need} -> 2^n {pow2}, "
           f"clamped to [{floor}, {model_max}] = {chosen}")
    return chosen, why


def _target_in_existing_repo(target: str):
    """If `target` names a file that ALREADY EXISTS inside a git repo (resolved
    relative to cwd unless absolute), return that repo's root; else None.

    Used by fix 2a to refuse a repo-EDIT that was mis-invoked as --new-project.
    Deliberately keyed on the file EXISTING so a genuine new-file creation task
    (the file is absent) is never blocked."""
    p = Path(target).expanduser()
    if not p.is_absolute():
        p = (Path.cwd() / p)
    try:
        p = p.resolve()
    except Exception:
        return None
    if not p.is_file():
        return None
    for anc in [p.parent, *p.parent.parents]:
        if (anc / ".git").exists():
            return anc
    return None

# The fixture is stamped model-drafted (same marker ollama-dispatch-draft uses)
# only at the END, once relevance passes -- so the loop can measure relevance on
# an unmarked fixture, then the marker forces the one human read before enqueue.
DRAFT_MARK = "DRAFT_UNCONFIRMED = True"
DRAFT_MARK_JS = "const DRAFT_UNCONFIRMED = true"

QUEUE_STATE = Path.home() / "bin" / "ollama-queue-state.json"


_LAST_DIE = [None]   # the last die() message: run_chain parks a failed run WITH it


def die(msg, code=2):
    _LAST_DIE[0] = str(msg)
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


# MULTI-MODULE intent for ONE --target (2026-10-04, chat-frontend f089442e2e8b): the
# --interface listed 7 package files (projects.py, sessions.py, images.py,
# messages.py, job.py, routes.py, static/chat.html) but --target was routes.py, so
# the authored TASK.md said "Only edit `dashboard_chat/routes.py`" while its intent
# required six other modules -- a self-contradictory harness. One AUTO run builds
# ONE file; a multi-module build needs a plan (one target per run).
_SRC_FILE_RE = re.compile(
    r"(?<![\w./~$-])((?:[\w-]+/)*[\w-]+\.(?:py|ts|tsx|js|jsx|mjs|cjs|swift|sh|cs|go|rs|"
    r"html|css))(?![\w/])")


_HARNESS_FILE_NAMES = frozenset({
    "refimpl.py", "verify.sh", "check_literals.py", "auto-harness-check.py",
    "test_fixture.py", "verify.test.ts", "verify_impl.mts", "verify_impl.mjs",
    "verify_impl.js", "verify_cases.sh"})


def foreign_module_files(text: str, target: str, root=None) -> list:
    """PURE (bar an is_file probe under `root`). Source files the intent/interface
    NAMES that are neither the --target nor already present under `root` (repo /
    project dir). Home/absolute paths (`~/bin/x.py`, `/usr/x.py`) are external
    references, not modules to build, and are ignored; so is any mention whose
    basename is the target's ("routes.py" for dashboard_chat/routes.py)."""
    tgt = Path(str(target or "")).as_posix().lstrip("./")
    tbase = Path(tgt).name
    base = Path(root).expanduser() if root else None
    have = None
    out = []
    for f in _SRC_FILE_RE.findall(text or ""):
        p = Path(f).as_posix()
        if p == tgt or Path(p).name == tbase or p in out:
            continue
        if re.fullmatch(r"[A-Z][a-z0-9]+\.js", p):      # Next.js / Node.js: a name
            continue
        # The dispatch's OWN harness files (2026-10-06, link-sync-feedback-v2: an
        # intent telling the author "refimpl.py must extract...", "do not edit
        # verify.sh / check_literals.py" was refused as a 3-module build). They
        # are meta-references the pipeline writes, never modules to build.
        if Path(p).name in _HARNESS_FILE_NAMES:
            continue
        # present in the tree: exact relpath, or a bare/partial name that is the
        # tail of a real file ('detection.py' -> broker_guard/detection.py)
        if base is not None:
            if (base / p).is_file() or (base / Path(tgt).parent / p).is_file():
                continue
            if have is None:
                have = _files_under(base)
            if any(h.endswith("/" + p) for h in have):
                continue
        out.append(p)
    return out


def multi_module_check(intent, interface, target, root, allow=False, lenient=False):
    """PURE-ish (reads the tree under `root`). -> (None|'warn'|'refuse', message).
    Refuse when the intent/interface names >= 2 not-yet-existing source files
    besides `target`; warn for exactly 1, or when `allow` (--allow-multi-module)
    or `lenient` (a slicer-driven per-slice run / --drafter-cmd test: never park a
    plan's slice on its prose) is set."""
    mm = foreign_module_files(f"{intent or ''}\n{interface or ''}", target, root)
    if not mm:
        return None, ""
    msg = (f"the intent/interface names {len(mm)} source file(s) other than "
           f"--target {target!r} that do not exist yet ({', '.join(mm[:8])}), but "
           f"one AUTO run builds ONE file: TASK.md would say 'Only edit {target}' "
           f"while the intent needs the others (chat-frontend f089442e2e8b). Split "
           f"it: one run per module (each its own --target, intent scoped to that "
           f"module), or a single-target plan via ollama-dispatch-plan.")
    if len(mm) >= 2 and not allow and not lenient:
        return "refuse", msg + " Pass --allow-multi-module to override."
    return "warn", msg


def _files_under(root, cap=200000):
    """Relative posix paths of the files under `root`: `git ls-files` (tracked +
    untracked-not-ignored) in a repo, else a walk skipping VCS/dependency dirs,
    capped; empty set when root is None/missing."""
    if not root:
        return set()
    base = Path(root).expanduser()
    if not base.is_dir():
        return set()
    try:
        r = subprocess.run(["git", "-C", str(base), "ls-files", "-co",
                            "--exclude-standard"], capture_output=True, text=True,
                           timeout=20)
        if r.returncode == 0:
            return set(r.stdout.splitlines())
    except Exception:
        pass
    out = set()
    skip = {".git", "node_modules", ".venv", "venv", "__pycache__", ".next", "dist",
            "build"}
    for dp, dns, fns in os.walk(base):
        dns[:] = [d for d in dns if d not in skip]
        for fn in fns:
            out.add((Path(dp) / fn).relative_to(base).as_posix())
            if len(out) >= cap:
                return out
    return out


def _under_slicer(a=None):
    """True iff this AUTO run is authoring ONE slice of a sliced chain, in which
    case it must never (re-)slice: a per-slice failure has to surface through the
    slicer's own FAILED state (see omnibus_slice's RE-ENTRANCY / RECURSION GUARD).

    BUG (2026-09-21): the guard was ONLY the OLLAMA_DISPATCH_NO_SPLIT env var,
    which omnibus_slice.handoff_to_slicer exports. But ollama-dispatch-slice
    invokes AUTO with a plain `subprocess.run([AUTO, ...])` and no env override,
    so a slicer launched DIRECTLY on a hand-authored plan (the normal path
    whenever up-front auto-slicing declined the intent) ran every per-slice AUTO
    with the recursion guard OFF. Observed live on bg-dashboard-s1-app-and-status:
    a per-slice authoring failure reached _autoslice_on_failure(), which reported
    'cannot-slice-escalate: this intent does not decompose into >= 2 independent
    properties, so slicing cannot help' -- true but irrelevant and misleading,
    since re-slicing an already-atomic slice was never a legal response. Worse,
    the same hole let a slice intent that DOES look multi-property be auto-sliced
    a second time, nested inside the slicer. AUTO already knows it is authoring a
    slice (--slice-id), so key the guard on that as well as the env var.
    """
    return bool(os.environ.get("OLLAMA_DISPATCH_NO_SPLIT")
                or (a is not None and getattr(a, "slice_id", None)))


# --- CHAIN RUN STATE for the queue's bundle-focus scheduler (the owner 2026-09-24) -------
# "Auto author should have been first slice in that bundle so bake off would continue."
# ollama-queue.py keeps ONE bundle focused start-to-finish, but it can only hold a
# bundle it knows is still being worked. A sliced plan advertises that through the
# slicer's own run-state (slice-runs/<label>.json + .advance.lock); a plain AUTO run
# had nothing, so the moment a round went terminal its chain read as complete and the
# next round (prepared here over minutes: poll -> self-check -> preflight -> enqueue)
# landed at the tail of the queue like fresh work. This file is the chain's
# equivalent of the slicer's lock: auto-runs/<key>.json, key = --bundle or --label,
# which is exactly ollama-queue.job_group_key for every round of this chain.
#   phase `advancing`  between rounds (this process is preparing the next one)
#   phase `waiting`    a round is in the queue; `job` names it
#   phase `ended`      this process is done (outcome recorded, pid cleared)
# The queue trusts it only while `pid` is alive and, for `advancing`, only for a
# bounded time -- so a crashed/killed/stuck driver never pins the lanes. Best-effort:
# a write failure is printed and ignored; it must never fail a dispatch.
AUTO_RUNS_DIR = Path(os.environ.get("OLLAMA_DISPATCH_AUTO_RUNS_DIR",
                                    CONFIG_DIR / "auto-runs"))


def chain_key(a):
    """The queue bundle key this run's rounds share: the explicit --bundle tag, else
    the --label (ollama-queue.job_group_key strips auto-author-/auto-refine-/-rN/-cN
    down to exactly that). None before the label is resolved."""
    return (getattr(a, "bundle", None) or getattr(a, "label", None)) or None


def _chain_run_rank(r, alive=None):
    """Sort key for picking the run a bundle's top-level chain summary mirrors: an
    ALIVE driver that is advancing, then an alive driver waiting on a round, then any
    other non-ended record, then ended ones -- newest first inside each tier."""
    alive = alive or _pid_alive_simple
    pid = r.get("pid")
    live = bool(pid) and r.get("phase") != "ended" and alive(pid)
    tier = (0 if live and r.get("phase") == "advancing" else
            1 if live else
            2 if r.get("phase") != "ended" else 3)
    try:
        ts = time.mktime(time.strptime(str(r.get("updated_at")), "%Y-%m-%dT%H:%M:%SZ"))
    except (ValueError, TypeError):
        ts = 0.0
    return (tier, -ts)


def _pid_alive_simple(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def _chain_locked_update(fp, mutate, alive=None):
    """LOCKED read-modify-write of auto-runs/<key>.json (2026-10-05). Several
    dispatch-auto runs can share ONE bundle key (rt-bg-commitments-fix ran the
    getcommitments AND the sync-guard driver); each used to overwrite the whole file,
    so the last writer erased the other run's record (sync-guard's `ended` wiped
    getcommitments' rounds). Now every run owns `runs[<label>]`, and the TOP-LEVEL
    fields -- the only ones ollama-queue.chain_run_progress / bundle_view read, so the
    running daemon needs no restart -- mirror the most active run (_chain_run_rank).
    `mutate(doc)` edits the doc in place. Returns the new doc. Raises on I/O error
    (callers are best-effort wrappers)."""
    import fcntl
    fp = Path(fp)
    fp.parent.mkdir(parents=True, exist_ok=True)
    with open(fp.with_name(fp.name + ".lock"), "a+") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            try:
                doc = json.loads(fp.read_text())
                if not isinstance(doc, dict):
                    doc = {}
            except (OSError, ValueError):
                doc = {}
            runs = doc.get("runs") if isinstance(doc.get("runs"), dict) else {}
            # a legacy single-run doc becomes that label's run record
            if not runs and doc.get("label") and doc.get("phase"):
                runs = {doc["label"]: {k: v for k, v in doc.items()
                                       if k not in ("runs", "parked")}}
            doc["runs"] = runs
            mutate(doc)
            runs = doc.get("runs") or {}
            if runs:
                top = sorted(runs.values(), key=lambda r: _chain_run_rank(r, alive))[0]
                for k in ("key", "label", "bundle", "pid", "started_at", "phase",
                          "phase_since", "step", "job", "rounds", "outcome", "updated_at"):
                    doc[k] = top.get(k)
            tmp = fp.with_name(fp.name + f".tmp{os.getpid()}")
            tmp.write_text(json.dumps(doc, indent=1))
            os.replace(tmp, fp)
            return doc
        finally:
            fcntl.flock(lk, fcntl.LOCK_UN)


def chain_state_write(a, phase, step=None, job=None, outcome=None, runs_dir=None, now=None,
                      alive=None):
    """Record this run's phase for ollama-queue.chain_run_progress. Returns the path
    written, or None. phase_since resets only when the PHASE changes (the queue's
    advance ceiling measures the whole between-rounds gap, not one step of it);
    started_at is kept across writes from the same pid. The record lives under
    runs[<label>] of a LOCKED shared bundle file (see _chain_locked_update), so two
    runs in one bundle never erase each other. Never raises."""
    key = chain_key(a)
    if not key:
        return None
    try:
        d = Path(runs_dir) if runs_dir else AUTO_RUNS_DIR
        fp = d / f"{key}.json"
        ts = now or time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        me = os.getpid()
        label = getattr(a, "label", None) or key

        def _mut(doc):
            prev = doc["runs"].get(label) or {}
            same_run = prev.get("pid") == me
            rec = {
                "key": key,
                "label": getattr(a, "label", None),
                "bundle": getattr(a, "bundle", None),
                "pid": None if phase == "ended" else me,
                "started_at": prev.get("started_at") if same_run else ts,
                "phase": phase,
                "phase_since": (prev.get("phase_since")
                                if same_run and prev.get("phase") == phase else ts),
                "step": step,
                "job": job if job is not None else (prev.get("job") if same_run else None),
                "rounds": list(prev.get("rounds") or []) if same_run else [],
                "outcome": outcome,
                "updated_at": ts,
                "code": CODE_STAMP,   # stale-driver detection (maybe_restart_stale)
            }
            if job and job not in rec["rounds"]:
                rec["rounds"].append(job)
            doc["runs"][label] = rec

        _chain_locked_update(fp, _mut, alive=alive)
        return fp
    except Exception as e:  # pragma: no cover - must never fail a dispatch
        print(f"    [chain-state] write failed for {key}: {e}", file=sys.stderr)
        return None


def run(cmd, **kw):
    return subprocess.run(cmd, **kw).returncode


def capture(cmd, cwd=None, timeout=None):
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                       shell=isinstance(cmd, str), timeout=timeout)
    return p.returncode, p.stdout, p.stderr


def load_defaults():
    try:
        d = json.loads(DEFAULTS_FILE.read_text())
    except (OSError, ValueError):
        d = {}
    return (d.get("model") or FALLBACK_MODEL), (d.get("host") or FALLBACK_HOST)


# --------------------------------------------------------------------------
# the author/refine self-check: the queue worker runs THIS after every edit.
# It proves the harness DISCRIMINATES (verify fails at baseline) and is
# SATISFIABLE (refimpl.py makes verify green), and it leaves the tree exactly at
# baseline -- the both-ways proof minus the slow relevance mutation, which the
# orchestrator runs itself via the real preflight. TARGET is substituted in.
# --------------------------------------------------------------------------
HARNESS_CHECK = r'''#!/usr/bin/env python3
"""Author/refine self-check (written by ollama-dispatch-auto). Proves the
harness DISCRIMINATES (verify fails at baseline) and is SATISFIABLE (refimpl.py
makes it green), leaving the tree exactly at baseline. It also FREEZES the
Must-contain literals into check_literals.py from TASK.md so the provided
verify.sh stays coherent as the model edits the spec (the same transform
ollama-dispatch-scaffold --freeze-literals does). It does NOT run the slow
relevance mutation -- the orchestrator does that via the real preflight."""
import re as _re
import shutil
import subprocess
import sys
from pathlib import Path

WT = Path(__file__).resolve().parent


import os as _os
import signal as _signal

# HARD WALL TIMEOUT per command (2026-10-06, rt-bfmr-tls-fingerprint -c2): a verify whose tests
# hang (a fake response stream that never ends, a real network call) used to freeze this check
# -- and the committed bundle's driver with it, and with it every queue lane -- for the
# driver's whole 900s. node:test's --test-timeout is PER TEST, so N hung tests cost N x 120s.
# The command now gets its own session and the WHOLE group is killed at the wall.
SELFCHECK_CMD_TIMEOUT_S = int(_os.environ.get("DISPATCH_SELFCHECK_CMD_TIMEOUT_S") or 180)
HANG_MARK = "SELFCHECK_HANG"


def _hang_msg(cmd, secs):
    return (HANG_MARK + ": self-check timed out after %ds running `%s`; likely a test blocked on "
            "network/IO/an unmocked call, or a fake stream/promise that never settles (a mocked "
            "response that never emits 'end', an un-awaited fetch, an open handle). Find the test "
            "that never completes and make it settle; do not add real network calls." % (secs, cmd))


def sh(cmd):
    p = subprocess.Popen(cmd, cwd=WT, shell=True, text=True, stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE, start_new_session=True)
    try:
        out, err = p.communicate(timeout=SELFCHECK_CMD_TIMEOUT_S)
        return subprocess.CompletedProcess(cmd, p.returncode, out, err)
    except subprocess.TimeoutExpired as te:
        try:
            _pg = _os.getpgid(p.pid)
            if _pg != _os.getpgid(0):
                _os.killpg(_pg, _signal.SIGKILL)
            else:
                p.kill()
        except (ProcessLookupError, PermissionError, OSError):
            p.kill()
        try:
            out, err = p.communicate(timeout=10)
        except Exception:
            out, err = te.stdout, te.stderr
        out = out.decode("utf-8", "replace") if isinstance(out, bytes) else (out or "")
        err = err.decode("utf-8", "replace") if isinstance(err, bytes) else (err or "")
        return subprocess.CompletedProcess(
            cmd, 124, out + "\n" + _hang_msg(cmd, SELFCHECK_CMD_TIMEOUT_S) + "\n", err)


def _hung(r):
    return r.returncode == 124 and HANG_MARK in (r.stdout or "")


GIT_UNUSABLE = "HARNESS ERROR: git is unusable in this worktree"


def git(*a):
    # FAIL CLOSED (2026-10-02, Rivian s1 054f6829bd98 / aec13ee90411). Every git
    # call here is a plain read or restore that cannot legitimately fail in a
    # healthy worktree. When git DID fail -- "not a git repository: (null)",
    # "couldn't read .git/packed-refs: Resource deadlock avoided": the Desktop
    # repo's .git metadata was iCloud-evicted (dataless) and could not be read from
    # the queue's context -- the old wrapper returned empty stdout, which read as
    # "nothing modified": the target was NOT reset to HEAD, the model's applied
    # refimpl was measured as the baseline, and the check reported "verify.sh
    # PASSES at baseline -- the fixture cannot fail" (a false, model-blaming
    # verdict that a clean re-measure then contradicted), while revert() silently
    # failed and left the solution in the tree. Retry transient failures, then
    # refuse to judge at all.
    import time as _t
    r = None
    for _i in range(4):
        r = subprocess.run(["git", "-C", str(WT), *a], capture_output=True, text=True)
        if r.returncode == 0:
            return r
        _t.sleep(2 * (_i + 1))
    print("  " + GIT_UNUSABLE + " (`git %s` rc=%s: %s) -- the self-check cannot "
          "measure the baseline or restore the tree, so it refuses to judge the "
          "harness. This is NOT a fixture problem; do not edit files to fix it."
          % (" ".join(a), r.returncode, (r.stderr or r.stdout).strip()[-200:]))
    sys.exit(3)


def fail(m):
    print("  FAIL:", m)
    sys.exit(1)


