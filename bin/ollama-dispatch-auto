def freeze_literals():
    """Rewrite check_literals.py's LITERALS from TASK.md. Mirrors the scaffold's
    freeze AND check_literals._parse_must_contain exactly, so its drift guard
    (frozen == current) holds."""
    cl = WT / "check_literals.py"
    if not cl.is_file():
        return
    m = _re.search(r"##+\s*Must contain[^\n]*\n(.*?)(?=\n##\s|\Z)",
                   task, _re.S | _re.I)
    pairs = []
    if m:
        for line in m.group(1).splitlines():
            if not _re.match(r"\s*-\s", line):
                continue  # only real `- ` list items; skip instructional prose/parentheticals
            fm = _re.search(r"(?:^|\s)in\s+([^\s:`]+)\s*:", line)
            f = fm.group(1) if fm else None
            for lm in _re.finditer(r"`([^`\n]{1,200})`", line):
                lit = lm.group(1)
                if "TODO" in lit:
                    continue
                pairs.append([f, lit])
    txt = cl.read_text()
    # Callable replacement: a STRING template re-interprets backslashes, so a
    # literal like replace(/\\D/g, '') was frozen with half its backslashes
    # and the verify then failed "literals DRIFTED" forever (Rivian s2 c2).
    _frozen = "LITERALS = " + repr(pairs)
    new = _re.sub(r"^LITERALS = \[.*?\]$", lambda _m: _frozen,
                  txt, count=1, flags=_re.M | _re.S)
    cl.write_text(new)



freeze_literals()


def _must_contain_pairs():
    m = _re.search(r"##+\s*Must contain[^\n]*\n(.*?)(?=\n##\s|\Z)", task, _re.S | _re.I)
    out = []
    for line in (m.group(1).splitlines() if m else []):
        if not _re.match(r"\s*-\s", line):
            continue
        fm = _re.search(r"(?:^|\s)in\s+([^\s:`]+)\s*:", line)
        for lm in _re.finditer(r"`([^`\n]{1,200})`", line):
            if "TODO" not in lm.group(1):
                out.append((fm.group(1) if fm else None, lm.group(1)))
    return out


def _scope_files():
    out = []
    for m in _re.finditer(r"[Oo]nly edit\b([^\n]*)", task):
        tail = _re.split(r"(?i)\bdo\s*n(?:['\u2019]t|ot)\s+edit\b", m.group(1), maxsplit=1)[0]
        for g in _re.findall(r"`([^`\n]+)`", tail):
            for tok in _re.split(r"[,\s]+(?:and\s+)?", g):
                tok = tok.strip("`,.; ")
                if tok and tok not in out:
                    out.append(tok)
    return out


# SCOPE vs PINNED FILES (2026-10-05, rt-egift-link-s1-s0-db-schema): the Must-contain
# list pinned literals to prisma/schema.prisma while the scope line said "Only edit
# `lib/egiftLink.ts`" -- the coding job that runs after the seal could never satisfy
# both. Every file a literal is pinned to must be on the scope line.
_pins = sorted({f for f, _ in _must_contain_pairs() if f})
_scope = _scope_files()

# HARNESS FILES ON THE SCOPE LINE (2026-10-06, rt-bfmr-link-sync-feedback r2): a
