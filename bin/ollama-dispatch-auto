        fail(f + " is missing -- author it")
# The fixture filename is LANGUAGE-dependent -- Python is test_fixture.py, but a
# --lang ts dispatch emits verify.test.ts / verify_impl.mts / *.test.ts and a
# swift one emits a *Tests/main.swift. Hardcoding test_fixture.py made this
# self-check unsatisfiable from iteration 0 on every non-Python dispatch (it
# burned resell-gc-ingest to its iteration cap, misread as a model failure).
# The acceptable globs are injected by write_harness_check() from a.lang.
_FIXTURE_GLOBS = __FIXTURE_GLOBS__


def _mock_module_lint():
    """node:test mock.module misuse in the JS/TS fixture(s), as hint lines (2026-10-06).
    Static text checks only; never fails the check on its own."""
    _MM_VALID = {"exports", "namedExports", "defaultExport", "cache"}
    _tgt = ""
    try:
        import json as _jj
        _tgt = (_jj.loads((WT / ".dispatch-harness.json").read_text()) or {}).get("target") or ""
    except Exception:
        _tgt = ""
    _tgt_stem = _re.sub(r"\.[cm]?[jt]sx?$", "", _tgt).lstrip("./")
    out = []
    files = []
    for g in _FIXTURE_GLOBS:
        for f in sorted(_glob.glob(str(WT / g), recursive=True)):
            if f not in files and f.endswith((".ts", ".mts", ".js", ".mjs", ".tsx")):
                files.append(f)
    for f in files[:6]:
        try:
            src = Path(f).read_text(errors="replace")
        except OSError:
            continue
        # blank out comments (keeping newlines, so line numbers hold): a comment that
        # MENTIONS mock.module / an import is not a call
        src = _re.sub(r"/\*.*?\*/|(?<![:'\"`\\])//[^\n]*",
                      lambda mc: _re.sub(r"[^\n]", " ", mc.group(0)), src, flags=_re.S)
        name = Path(f).name
        calls = []
        for m in _re.finditer(r"\bmock\.module\s*(?:<[^\n]*?>)?\s*\(\s*([`'\"])([^`'\"]+)\1\s*,?\s*", src):
            spec, i = m.group(2), m.end()
            line = src.count("\n", 0, m.start()) + 1
            keys, has_obj = set(), False
            if i < len(src) and src[i] == "{":
                has_obj, depth, j, tok = True, 0, i, ""
                while j < len(src):
                    c = src[j]
                    if c in "{[(":
                        depth += 1
                    elif c in "}])":
                        depth -= 1
                        if depth == 0:
                            break
                    j += 1
                body = src[i:j + 1]
                # top-level keys of the options object: the name right after the
                # opening `{` or a depth-1 `,`
                d, starts = 0, []
                for idx, c in enumerate(body):
                    if c in "{[(":
                        d += 1
                        if d == 1:
                            starts.append(idx + 1)
                    elif c in "}])":
                        d -= 1
                    elif c == "," and d == 1:
                        starts.append(idx + 1)
                for p in starts:
                    mk = _re.match(r"\s*(?:\.\.\.\s*)?([A-Za-z_$][\w$]*)\s*[:,}(]", body[p:])
                    if mk:
                        keys.add(mk.group(1))
            calls.append((spec, line, has_obj, keys))
            _bad = sorted(keys - _MM_VALID)
            if has_obj and _bad and (keys & _MM_VALID):
                # a valid key (often `cache`) next to an unknown one (`moduleExports`,
                # `factory`) -- the unknown one is still dropped silently
                out.append(
                    "%s:%d `mock.module('%s', { %s })` -- `%s` %s not a mock.module option; "
                    "node:test IGNORES it silently (only exports / defaultExport / cache are "
                    "read), so the mock has none of the exports you put there. Write "
                    "`{ exports: { ... } }`."
                    % (name, line, spec, ", ".join(sorted(keys)), "`, `".join(_bad),
                       "is" if len(_bad) == 1 else "are"))
            if has_obj and not (keys & _MM_VALID):
                out.append(
                    "%s:%d `mock.module('%s', { %s })` -- %s not a mock.module option, so "
                    "node:test IGNORES it and mocks '%s' with NO exports (every import from it "
                    "is undefined -> `X is not a function` / a 500). Write `{ exports: { ... } }`."
                    % (name, line, spec, ", ".join(sorted(keys)) or "",
                       ("`" + "`, `".join(sorted(keys)) + "` is") if keys else "an empty object is",
                       spec))
        if not calls:
            continue
        mocked = {c[0] for c in calls}
        for m in _re.finditer(r"^\s*import\s+(?!type\b)[^;]*?\bfrom\s+['\"]([^'\"]+)['\"]", src, _re.M):
            spec = m.group(1)
            if spec.startswith("node:"):
                continue
            stem = _re.sub(r"\.[cm]?[jt]sx?$", "", spec)
            stem = stem[2:] if stem.startswith("@/") else stem.lstrip("./")
            if (_tgt_stem and stem == _tgt_stem) or spec in mocked:
                line = src.count("\n", 0, m.start()) + 1
                out.append(
                    "%s:%d static `import ... from '%s'` -- static imports run BEFORE every "
                    "mock.module call, so %s loads with the REAL dependencies and your mocks never "
                    "apply to it. Delete the static import; load it with `await import('%s')` "
                    "inside the test, after the module-scope mocks."
                    % (name, line, spec, "the target" if stem == _tgt_stem else "'" + spec + "'", spec))
        cnt = {}
        for c in calls:
            cnt[c[0]] = cnt.get(c[0], 0) + 1
        multi = sorted(s for s, n in cnt.items() if n > 1)
        if multi:
            out.append(
                "%s mocks %s more than once (per test). The target is CACHED after its first "
                "`await import(...)`, so every later test still runs against the FIRST test's fake "
                "(and a second live mock of the same module throws `already mocked`). Mock each "
                "module ONCE at module scope with a shared mutable fake (`let impl = ...;` read by "
                "the mock) and change `impl` per test."
                % (name, ", ".join("'" + s + "'" for s in multi[:4])))
    return out[:8]


