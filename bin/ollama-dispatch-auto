#!/usr/bin/env python3
"""ollama-dispatch-auto -- one command from a one-line intent to a GATE-PASSING,
harness-authored dispatch, paused only at the human RELEVANCE review.

The rest of the pipeline (ollama-dispatch) has a HUMAN author the harness --
TASK.md, the adversarial fixture, the reference impl -- and only offloads the
FIX. For a greenfield build the reference impl basically IS the deliverable, so
that hand-authoring is most of the work. This tool pushes the whole authoring
loop onto the local model and keeps the human in the loop for exactly one thing:
judging whether the fixture tests the RIGHT property (relevance), which no gate
can decide.

    intent + --target ->
      scaffold (skeleton) ->
      local model authors TASK.md + adversarial fixture + refimpl.py (queue) ->
      preflight (both-ways + verify-relevance mutation) ->
        NO-GO?  parse the survivors / blockers, feed each back to the model
                ("add a minimal case that FAILS if THIS line is mutated"),
                or lean on the benign-mutation allowlist -> loop (bounded) ->
        GO   ->  mark the fixture UNCONFIRMED and STOP at the relevance review.

It NEVER enqueues the real job: the last step is always a human read of the
fixture for relevance, then `ollama-dispatch-draft <wt> --confirm` and the
enqueue command this tool prints. Everything UP TO that judgement is automated;
the judgement itself is not removed.

The model dispatch goes through ollama-queue.py exactly as ollama-dispatch-draft
does (default qwen3.6-35b-a3b-vl-mtp-mxfp8 on studio). `--drafter-cmd '<cmd>'` swaps the
model for any command (its run in the worktree IS the authoring step) so the
orchestration -- scaffold, the preflight loop, survivor parsing, the pause --
is testable without a live model.

USAGE
  ollama-dispatch-auto --new-project ~/scratch/usagebar \\
      --intent "a FastAPI service exposing GET /health -> {status:'ok'}" \\
      --target app/main.py --interface "use FastAPI + a TestClient fixture"

  ollama-dispatch-auto --repo ~/src/proj --intent "..." --target src/x.py
"""
from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
import re
import shlex
import signal
import subprocess
import sys

# GIT_OPTIONAL_LOCKS=0 (2026-10-02, Rivian s5 566e7cc77629 / 5059223eacc3 / 454979f2a248):
# a plain `git status` REWRITES .git/index (it takes index.lock to refresh stat
# info). Our observers (worktree snapshots, dirty checks) run it with timeouts
# against .git dirs inside the iCloud Desktop repos, where it can be slow -- and a
# held or timeout-orphaned index.lock made auto-harness-check's `git checkout`
# fail with "index.lock: File exists" -> "HARNESS ERROR: git is unusable". With
# this set, read-only commands never take the optional lock; writes still lock.
os.environ.setdefault("GIT_OPTIONAL_LOCKS", "0")

# iCloud "Optimize Storage" evicts the Desktop repos' .git metadata; without this a
# git child gets EDEADLK ("not a git repository: (null)") -- see dataless_policy.py.
try:
    import importlib.util as _dp_iu, os as _dp_os
    _dp_s = _dp_iu.spec_from_file_location("dataless_policy", _dp_os.path.join(
        _dp_os.path.dirname(_dp_os.path.realpath(__file__)), "dataless_policy.py"))
    _dp_m = _dp_iu.module_from_spec(_dp_s)
    _dp_s.loader.exec_module(_dp_m)
    _dp_m.enable()
except Exception:
    pass
import time
