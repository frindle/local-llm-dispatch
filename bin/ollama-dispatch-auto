    fail("TASK.md pins Must-contain literal(s) to " + ", ".join("`" + f + "`" for f in _unscoped)
         + " but its scope line only allows " + ", ".join("`" + f + "`" for f in _scope)
         + " -- the coding job could never satisfy both. Add each pinned file to the scope "
         "line, e.g. `Only edit " + ", ".join("`" + f + "`" for f in (_scope + _unscoped))
