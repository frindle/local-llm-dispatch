#!/usr/bin/env python3
"""ollama-dispatch-scaffold -- emit a dispatch scaffold, minus the judgment.

WHY THIS EXISTS
---------------
`ollama-dispatch-preflight` automated the GATE. The SCAFFOLD was still
hand-written every dispatch: worktree, TASK.md sections, the venv/Package
bootstrap, the counting-idiom verify, the fixture harness, the refimpl. That is
the bulk of the per-dispatch typing and none of it is judgment -- it is the same
five files with different nouns, and hand-typing them is how a required section
goes missing and the failure then reads as model incapacity.

THE ONE THING IT DELIBERATELY DOES NOT DO
-----------------------------------------
It does not author the adversarial assertions, and it does NOT emit a scaffold
that passes the gate.

That is the whole design, not a limitation. A generator that emitted a
gate-passing scaffold would let an operator skip the only step that cannot be
mechanised: deciding what makes a verify RELEVANT rather than merely
discriminating. A benign fixture (flag=True, count=99) discriminates change and
certifies broken work; picking the inputs that separate "did the job" from
"made the test go green" is the judgment this whole toolchain exists to
protect. So the emitted fixture has an EMPTY case list and the verify exits 1
with SCAFFOLD_INCOMPLETE until a human fills it in. The gate will NO-GO, loudly
and by name, and that NO-GO is the generator working correctly.

Pipeline:  scaffold  ->  you author the adversarial cases  ->  gate  ->  enqueue

  ollama-dispatch-scaffold --label fix-foo --repo ~/src/proj --lang python \\
      --target app/thing.py --entry-point app/thing.py:88 \\
      --defect "confirmed: X returns Y; observed by running Z" \\
      --property "X must return W for the boundary inputs"

  ollama-dispatch-scaffold --label usagebar --new-project ~/scratch/usagebar \\
      --lang swift --target Sources/Core/Parser.swift
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

SCAFFOLD_MARK = "SCAFFOLD_INCOMPLETE"
LANGS = ("python", "swift", "typescript", "ts", "js", "javascript",
         "bash", "sh", "shell", "go", "golang", "rust", "rs", "java", "kotlin", "kt",
         "csharp", "cs", "dotnet",
         # accepted ONLY so the refusal can say why (dispatch_langs.UNSUPPORTED),
         # instead of argparse's bare "invalid choice"
         "fsharp")
# ts/js/javascript are aliases -- one tsx-based harness serves them all (tsx
# type-strips .ts/.mts and runs .js/.mjs unchanged). sh/shell alias bash: the
# harness runs the script under `bash`, so a POSIX-sh target is tested by the
# shell that will actually run it in the verify.
LANG_ALIASES = {"ts": "typescript", "js": "typescript", "javascript": "typescript",
                "sh": "bash", "shell": "bash", "golang": "go", "rs": "rust", "kt": "kotlin",
                "cs": "csharp", "dotnet": "csharp"}

# The TS/JS sidecars live next to this script (bin/ts-mutator/). ts-parse is the
# ast.parse analogue used as a best-effort syntax floor in the TS verify (tsc
# --noEmit is the authoritative parse+type check). ts-extract is no longer used
# by the scaffold -- the fixture now imports the REAL exported symbol under tsx
# rather than re-extracting a span to run in isolation.
SCRIPT_DIR = Path(__file__).resolve().parent
TS_PARSE = SCRIPT_DIR / "ts-mutator" / "ts-parse.mjs"

# suffixes build_ts / the TS verify treat as TS/JS
TS_SUFFIXES = (".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs")

# A --target that does not yet exist in --repo mode is a CREATION task IFF it
# carries a real code extension -- then we seed a minimal language stub so the
# baseline verify FAILS (feature absent) and the model builds it, instead of
# forcing the caller through the hand-seed dance. A path WITHOUT one of these
# extensions still errors as a likely typo (the original guard). Added 2026-09-12.
CREATION_CODE_EXTS = set(TS_SUFFIXES) | {".py", ".swift", ".go", ".rs", ".java",
                                         ".kt", ".sh", ".bash", ".cs"}


def _target_in_existing_repo(target: str):
    """If `target` names a file that ALREADY EXISTS inside a git repo (resolved
    relative to cwd unless absolute), return that repo's root; else None. Used by
    fix 2a to refuse a repo-EDIT mis-invoked as --new-project. Keyed on the file
    EXISTING so a genuine new-file creation task is never blocked."""
    p = Path(target).expanduser()
    if not p.is_absolute():
        p = Path.cwd() / p
    try:
        p = p.resolve()
    except Exception:
        return None
    if not p.is_file():
        return None
    for anc in [p.parent, *p.parent.parents]:
        if (anc / ".git").exists():
            return anc
    return None


def looks_like_creation_stub(path):
    """True when an on-disk creation target is still a creation_stub() (or a
    language-adjusted one, e.g. build_go's package rewrite): small and carrying the
    stub marker. Anything else is an implementation, never a launch baseline."""
    try:
        txt = Path(path).read_text(errors="replace")
    except OSError:
        return True
    if not txt.strip():
        return True
    if len(txt) <= 600 and "implement per TASK.md" in txt:
        return True
    # A bare `export {};` / `module.exports = {};` / comment-only file (5b6b052149a7) is a
    # stub too, whoever spelled it: treating it as an IMPLEMENTATION made the seal move it
    # aside and the preflight read it as dirt.
    try:
        import importlib.util as _iu
        _sp = _iu.spec_from_file_location(
            "dispatch_harness_gates", Path(__file__).resolve().parent / "dispatch_harness_gates.py")
        _m = _iu.module_from_spec(_sp)
        _sp.loader.exec_module(_m)
        return bool(_m.is_stub_text(txt))
    except Exception:
        return False


def creation_stub(target, ext):
    """A minimal, feature-absent stub for a newly-created target. Deliberately
    near-empty so the baseline verify fails; the model fills it in."""
    ext = ext.lower()
    if ext == ".py":
        return f'"""Stub for {target} -- implement per TASK.md."""\n'
    if ext in (".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"):
        return f"// Stub for {target} -- implement per TASK.md.\nexport {{}};\n"
    if ext == ".swift":
        return f"// Stub for {target} -- implement per TASK.md.\n"
    if ext == ".java":
        # A java file must declare a class matching its name or javac refuses
        # it -- even the "feature absent" stub has to be compilable.
        return ("public class %s {\n    // Stub -- implement per TASK.md.\n}\n"
                % __import__("pathlib").Path(target).stem)
    if ext == ".kt":
        return f"// Stub for {target} -- implement per TASK.md.\n"
    if ext == ".cs":
        # An empty C# compilation unit compiles; the harness project compiles
        # this file directly, so the stub must not break the build.
        return f"// Stub for {target} -- implement per TASK.md.\n"
    if ext == ".rs":
        return f"// Stub for {target} -- implement per TASK.md.\n"
    if ext == ".go":
        # Go refuses to compile a file without a package clause, so even the
        # "feature absent" stub needs one; build_go rewrites it with the real
        # package name when it seeds the target itself.
        return f"package main\n\n// Stub for {target} -- implement per TASK.md.\n"
    if ext in (".sh", ".bash"):
        # A shell stub must still be RUNNABLE: the fixture invokes it, and a
        # stub that is a syntax error fails for a reason unrelated to the task.
        return (f"#!/usr/bin/env bash\n# Stub for {target} -- implement per "
                f"TASK.md.\nexit 1\n")
    return f"// Stub for {target} -- implement per TASK.md.\n"


def sh(cmd, cwd=None):
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    return p.returncode, p.stdout, p.stderr


def _fresh_base_ref(repo, fetch_timeout=90):
    """The ref a new dispatch worktree should start from: the repo's HEAD, UNLESS
    HEAD is strictly BEHIND origin's default branch -- then that branch.

    Live 2026-10-02 (resell-tracker): landings go out from separate clones (a
    lander agent, the BFMR replace-tracking clone), so the source repo here had not
    fetched them; a worktree cut from its HEAD started hours stale and its landing
    conflicted with what was already on main. HEAD is kept when it is AHEAD of or
    DIVERGED from origin (local work never silently dropped), and on any failure
    (no origin, offline, fetch timeout) -- i.e. never worse than before.
    Returns (ref, note)."""
    try:
        rc, _, err = (lambda p: (p.returncode, p.stdout, p.stderr))(subprocess.run(
            ["git", "-C", str(repo), "fetch", "--quiet", "origin"],
            capture_output=True, text=True, timeout=fetch_timeout))
    except (OSError, subprocess.SubprocessError) as e:
        return "HEAD", f"fetch origin failed ({type(e).__name__}) -- cutting from HEAD"
    if rc != 0:
        return "HEAD", f"fetch origin failed ({(err or '').strip()[:120]}) -- cutting from HEAD"
    rc, out, _ = sh(["git", "-C", str(repo), "symbolic-ref", "--quiet", "--short",
                     "refs/remotes/origin/HEAD"])
    cands = [out.strip()] if rc == 0 and out.strip() else []
    cands += ["origin/main", "origin/master"]
    remote = next((r for r in cands
                   if sh(["git", "-C", str(repo), "rev-parse", "--verify", "--quiet", r])[0] == 0),
                  None)
    if not remote:
        return "HEAD", "no origin default branch -- cutting from HEAD"
    head = sh(["git", "-C", str(repo), "rev-parse", "HEAD"])[1].strip()
    rsha = sh(["git", "-C", str(repo), "rev-parse", remote])[1].strip()
    if not head or head == rsha:
        return "HEAD", f"HEAD is {remote}"
    behind = sh(["git", "-C", str(repo), "merge-base", "--is-ancestor", "HEAD", remote])[0] == 0
    if behind:
        return remote, f"HEAD {head[:8]} is behind {remote} {rsha[:8]} -- cutting from {remote}"
    return "HEAD", f"HEAD {head[:8]} is ahead of/diverged from {remote} -- keeping HEAD"


# --- iCloud-evicted .git files (2026-10-02, resell-tracker) --------------------
# Repos under ~/Desktop sync to iCloud Drive with Optimize Mac Storage on; macOS
# evicts rarely-read files to 'dataless' placeholders -- including .git pack
# .rev/.idx files (1445 such files in resell-tracker's .git alone). git mmaps
# packs; mmap of a dataless file from a process that may not trigger a download
# fails with ECANCELED: "fatal: mmap failed: Operation canceled", so the worktree
# add died (scaffold rc=2) and left an empty dispatch/ branch. Fault the files in
# by READING them (a read can trigger the download where mmap does not), falling
# back to `brctl download`.
_MMAP_FAIL = "mmap failed"
_SF_DATALESS = 0x40000000


def _git_common_dir(repo):
    rc, out, _ = sh(["git", "-C", str(repo), "rev-parse", "--path-format=absolute",
                     "--git-common-dir"])
    return Path(out.strip()) if rc == 0 and out.strip() else None


def _is_dataless(p):
    try:
        return bool(os.lstat(p).st_flags & _SF_DATALESS)
    except (OSError, AttributeError):
        return False


def _dataless_files(repo):
    gd = _git_common_dir(repo)
    if gd is None:
        return []
    out = []
    for dp, dn, fn in os.walk(gd):
        dn[:] = [d for d in dn if d != "worktrees"]
        for f in fn:
            fp = os.path.join(dp, f)
            if _is_dataless(fp):
                out.append(fp)
    return out


def _ensure_git_materialized(repo, read=None, download=None):
    """Fault in every dataless file under the repo's git dir. Returns the list
    still dataless afterwards ([] = all good). Never raises."""
    read = read or (lambda fp: open(fp, "rb").read())
    download = download or (lambda fp: sh(["brctl", "download", fp]))
    try:
        files = _dataless_files(repo)
    except Exception:
        return []
    if files:
        print(f"materializing {len(files)} iCloud-evicted file(s) under "
              f"{_git_common_dir(repo)} before adding the worktree", file=sys.stderr)
    def one(fp):
        try:
            read(fp)
        except OSError:
            pass
        if _is_dataless(fp):
            try:
                download(fp)
            except Exception:
                pass
        return fp if _is_dataless(fp) else None
    # Each read is an iCloud round-trip (~150ms; 1441 files took ~4 min serially
    # on resell-tracker): fan out, they are independent and I/O-bound.
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=16) as ex:
        res = list(ex.map(one, files))
    return [fp for fp in res if fp]


def _drop_unused_branch(repo, branch):
    """Delete `branch` if a failed worktree add created it and no worktree uses it."""
    rc, out, _ = sh(["git", "-C", str(repo), "worktree", "list", "--porcelain"])
    if rc != 0 or f"branch refs/heads/{branch}" in out:
        return
    sh(["git", "-C", str(repo), "branch", "-D", branch])


def _safe_branch(label: str) -> str:
    """A git-legal branch name derived from --label. A worktree cut at a detached
    HEAD (`worktree add <dest> HEAD`) has no branch, so seal_baseline and the
    model's fix commit land on an unreachable ref that `worktree remove`/`prune`
    orphans for gc -- and the integrate tool assumes a real `dispatch/<slug>`
    branch. Sanitize to git's ref rules: no `..`, no leading/trailing `-` `.`
    `/`, no forbidden metachars."""
    s = re.sub(r"[^A-Za-z0-9._/-]", "-", label)
    s = re.sub(r"\.{2,}", ".", s)
    s = re.sub(r"/{2,}", "/", s)
    s = re.sub(r"-{2,}", "-", s)
    s = s.strip("-./")
    return "dispatch/" + (s or "scaffold")


def _worktree_scratch_default(label: str) -> Path:
    """Default worktree location. NOT $TMPDIR: on macOS that is
    /var/folders/.../T, which the OS purges after ~3 days -- a dispatch that sat
    over a long weekend would vanish mid-review. Under a stable scratch dir the
    help text already advertises ("under the scratchpad"); override with
    OLLAMA_DISPATCH_WORKTREES."""
    base = os.environ.get("OLLAMA_DISPATCH_WORKTREES")
    root = Path(base).expanduser() if base else \
        Path.home() / ".ollama-dispatch" / "worktrees"
    return root / f"wt-{label}"


def _remove_worktree(repo: Path, dest: Path, branch: str | None = None):
    """Undo a `git worktree add` so a retry is clean. `git worktree add` refuses
    an already-registered path, and the old --force never removed/pruned, so a
    failure after creation wedged every retry. Remove + prune (+ delete the
    branch we created) makes re-running idempotent."""
    sh(["git", "-C", str(repo), "worktree", "remove", "--force", str(dest)])
    sh(["git", "-C", str(repo), "worktree", "prune"])
    if branch:
        sh(["git", "-C", str(repo), "branch", "-D", branch])


def _worktree_for_branch(repo: Path, branch: str) -> str | None:
    """Path of the worktree that currently has <branch> checked out, or None.
    A branch left behind by a reaped/aborted run is 'orphaned' (it exists but no
    worktree uses it) and is safe to reclaim; one a live worktree holds is not."""
    rc, out, _ = sh(["git", "-C", str(repo), "worktree", "list", "--porcelain"])
    cur = None
    for line in out.splitlines():
        if line.startswith("worktree "):
            cur = line[len("worktree "):].strip()
        elif line.startswith("branch ") and \
                line[len("branch "):].strip() == f"refs/heads/{branch}":
            return cur
    return None


def _worktree_is_dirty(wt: str) -> bool:
    rc, out, _ = sh(["git", "-C", wt, "status", "--porcelain"])
    return bool(out.strip())


def _tsc_target_grep(target: str) -> str:
    """A shell-quoted ERE that matches a tsc error line for THIS target and not a
    sibling that shares its prefix. `grep -F 'app/foo.ts'` is a substring match,
    so a tsc error in `app/foo.tsx` false-FAILs as in-target. tsc prints
    `path(line,col):` (or `path:line:col:`), so anchor on the target followed by
    `(` or `:`, with the path metachars regex-escaped."""
    return shlex.quote(re.escape(target) + "[(:]")


# ---------------------------------------------------------------------------
# TASK.md -- every section the gate's `task-shape` check requires, with the
# judgment parts marked TODO rather than invented. A plausible-looking invented
# defect is worse than a blank one: it reads as confirmed when nobody confirmed
# it.
# ---------------------------------------------------------------------------
def task_md(a):
    defect = a.defect or (
        "TODO -- state the CONFIRMED defect: the observed symptom and how you\n"
        "verified it. Not a suspected mechanism, not a named culprit. If you\n"
        "have not actually reproduced it, stop and reproduce it first: a task\n"
        "asserting a defect that does not exist still gets you a change.")
    entry = a.entry_point or f"TODO -- {a.target}:<line>"
    prop = a.property or (
        "TODO -- state the property the change must satisfy, behaviourally.")
    # Scope line: a --ts-runner node-test fix SPANS MULTIPLE files, so the
    # single --target cannot express the editable set and `scope-respected`
    # false-fails the very mode that exists for multi-file fixes. Allow extra
    # in-scope files (--edit-file, node-test only) to be declared here.
    scope_files = [a.target] + [f for f in getattr(a, "edit_file", []) or []
                                if f != a.target]
    scope_edit = ", ".join(f"`{f}`" for f in scope_files)
    # `## Test environment` naming any import-time env vars verify.sh exports --
    # empty for non-TS or when nothing was detected. Named here so the spec-gap
    # check does not flag the vars the bootstrap sets (auto-export -> auto-name).
    env_section = _ts_test_env_section(a)
    return f"""# TASK: {a.label}

## Confirmed defect (observed, not suspected)

{defect}

## Entry point

{entry}

## Required change

{prop}

Behaviour that must NOT change:
- TODO -- list what must still hold. This is where regressions get caught: the
  verify's non-adversarial half exists to pin these, and a fix that breaks one
  should turn them red.

## Must contain

- `TODO -- a literal token the correct change necessarily introduces`

(The gate holds the reference impl against this list. If the verify goes green
while one of these is absent from the changed files, the verify does not
enforce the spec -- that is a benign verify, caught mechanically.)

(A bare bullet checks the default target. To PIN a literal to a specific file --
useful when a fix spans a helper file and the route/wiring that calls it --
prefix the bullet with `in <path>:`, e.g.
`- in app/api/x/route.ts: ` followed by a backtick-quoted token. Then that
token is required in THAT file, not the target.)

## Scope

Only edit {scope_edit}; do not edit `verify.sh`, `{a.fixture_rel}` or `TASK.md`.
{a.fixture_rel} is the test fixture -- changing it invalidates the check.

{env_section}## Keep every changed line exercised (relevance)

After the job runs, a mutation check flips/deletes each line you changed and
asks the verify to catch it. A changed line whose every mutant survives --
because no test asserts it -- FAILS the gate even when the fix is correct, and
the review never runs. So do NOT emit an isolated, untested line:
- Fold an unavoidable constant onto a line the test already exercises. Put a
  `timeout=` / a `daemon=True` flag / a small tuning number on the SAME line as
  a header dict, URL, or argument the fixture checks -- never on its own line.
- Prefer falling through to an implicit `return None` over a standalone
  `return None` in an `except:` the tests do not assert.
- If a line genuinely cannot be asserted and cannot be folded, it usually
  should not be a separate line at all -- restructure so it isn't.
This is not about adding bogus assertions for constants; it is about not
leaving a lone line that carries no tested behaviour.

## Loop instruction

Run `bash verify.sh` after every edit and keep editing until it prints
`VERIFY_OK`.
"""


def merge_task_md(a):
    """Canned TASK.md for a merge-CONFLICT resolution dispatch (--task merge).

    The baseline tree (cut via --baseline-ref) carries `<target>` with git
    conflict markers plus BOTH sides' behavioural tests, already registered in
    `scripts.test`. The model's only job is to resolve the markers in the ONE
    target file so both tests pass. Scope is strictly the single target -- the
    tests and package.json are dependencies it must NOT edit."""
    tgt = a.target
    return f"""# TASK: {a.label}

## Confirmed defect (observed, not suspected)

`{tgt}` contains an UNRESOLVED 3-way merge conflict: it carries git conflict
markers (`<<<<<<<`, `=======`, `>>>>>>>`). The file does not parse / type-check
and the test suite cannot run while the markers are present. This is a real,
materialised conflict tree, not a hypothetical.

## Entry point

{tgt} -- the conflict hunk(s) between the `<<<<<<<` and `>>>>>>>` markers.

## Required change

Resolve the conflict markers in `{tgt}` so the file is a single coherent
version that preserves BOTH sides' behaviour. Remove every conflict marker.
The correct resolution is the UNION of the two intents: both behavioural tests
already present in the tree must pass against the resolved file.

Behaviour that must NOT change:
- Both sides' behavioural tests (already registered in `scripts.test`) must
  BOTH pass. A resolution that keeps only one side (take-ours / take-theirs)
  drops the other side's behaviour and FAILS the verify by design.

## Must contain

- `TODO -- (frozen at scaffold time if needed; the verify enforces the union
  behaviourally via both tests, so a literal list is optional here)`

## Scope

Only edit `{tgt}`. Do NOT edit `verify.sh`, `TASK.md`, the test files, or
`package.json` -- those are fixed dependencies of the resolution. Editing a
test to make it pass invalidates the check.

## Loop instruction

Run `bash verify.sh` after every edit and keep editing `{tgt}` until it prints
`VERIFY_OK` (no conflict markers, types resolve, BOTH behavioural tests green).
"""


DIAGNOSIS_VERIFY = '''\
#!/usr/bin/env bash
# verify for: a DIAGNOSIS deliverable (not a code fix)
# Counting idiom, NOT `set -e` -- an aborting verify never prints why it failed.
cd "$(dirname "$0")" || exit 1

fails=0

echo "=== DIAGNOSIS.md present ==="
if [ ! -f DIAGNOSIS.md ]; then
  echo "  FAIL: DIAGNOSIS.md is missing -- the diagnosis deliverable was never written"; fails=$((fails+1))
fi
# The whole contract hangs on this file; without it nothing else can be checked.
[ -f DIAGNOSIS.md ] || { echo "--- $fails failed ---"; exit 1; }

echo "=== DIAGNOSIS.md substantive ==="
sz=$(wc -c < DIAGNOSIS.md)
if [ "$sz" -lt 500 ]; then
  echo "  FAIL: DIAGNOSIS.md is only $sz bytes (< 500) -- too thin to be a real diagnosis"; fails=$((fails+1))
fi

echo "=== required sections ==="
for sec in "Root cause" "Evidence" "Fix sketch" "Falsifiable prediction"; do
  if grep -q "$sec" DIAGNOSIS.md; then
    echo "  ok: section '$sec' present"
  else
    echo "  FAIL: section '$sec' missing from DIAGNOSIS.md"; fails=$((fails+1))
  fi
done

echo "=== file:line grounding ==="
if grep -qE "[A-Za-z0-9_./-]+\\.[A-Za-z0-9]+:[0-9]+" DIAGNOSIS.md; then
  echo "  ok: at least one file.ext:line reference cited"
else
  echo "  FAIL: no file.ext:line reference in DIAGNOSIS.md -- the diagnosis is not grounded to code"; fails=$((fails+1))
fi

echo "=== anti-fabrication grounding ==="
# At least one cited path must resolve to a real file in THIS tree.
grounded=0
while IFS= read -r ref; do
  p="${ref%%:*}"
  if [ -f "$p" ]; then grounded=1; break; fi
done < <(grep -oE "[A-Za-z0-9_./-]+\\.[A-Za-z0-9]+:[0-9]+" DIAGNOSIS.md)
if [ "$grounded" -eq 1 ]; then
  echo "  ok: a cited path resolves to a real file in the tree"
else
  echo "  FAIL: no cited path in DIAGNOSIS.md is a real file here -- possible fabrication"; fails=$((fails+1))
fi

echo "=== SCOPE OF THIS GATE (read before trusting a pass) ==="
echo "  This verify checks the diagnosis's STRUCTURE only -- sections present,"
echo "  file:line grounding, cited path real. It does NOT and cannot validate that"
echo "  the claimed mechanism is CORRECT. A green diagnosis is UNVERIFIED, not proven:"
echo "  run the 'Falsifiable prediction' against the code/data before acting on it."

echo "--- $fails failed ---"
[ "$fails" -eq 0 ] && echo VERIFY_OK || exit 1
'''


def diagnosis_task_md(a):
    """Canned TASK.md for an INVESTIGATION/DIAGNOSIS dispatch (--task diagnosis).

    A diagnosis reads a repo to explain WHERE/WHY something happens and writes its
    findings to DIAGNOSIS.md -- it does not edit source. Its failure mode is open-ended
    searching: a real one re-issued near-identical greps against the same files, burned
    context in circles, and paused at 92% without converging. The mandatory SEARCH PLAN
    section below is the fix: an ordered plan with an explicit STOP condition, a read
    budget, and a 'consult REPO_MAP.md first' step so discovery becomes lookup, not blind
    grepping (REPO_MAP.md is generated into the worktree by the scaffold; see build below).
    """
    symptom = a.defect or (
        "TODO -- state the CONFIRMED symptom to explain: what is observed, and how you\n"
        "saw it. Not a suspected mechanism, not a named culprit.")
    question = a.property or (
        "TODO -- the ONE question this diagnosis must answer, e.g. 'where is the order\n"
        "total computed, and why is it wrong?'")
    return f"""# TASK: {a.label} (diagnosis)

## Confirmed symptom (observed, not suspected)

{symptom}

## The question to answer

{question}

## SEARCH PLAN -- do these IN ORDER, and STOP as soon as you can answer the question

1. Read `REPO_MAP.md` at the repo root FIRST. It has a file->exported-symbols index
   and a "computation digest" (where quantities/counts/totals are summed or reduced).
   Use it to LOCALIZE the relevant code -- do NOT grep blind.
2. From the map, open ONLY the 1-3 files most likely to hold the answer. Read each once.
3. Grep ONLY to CONFIRM a specific location the map pointed you to (e.g. one symbol,
   one file:line) -- never to discover from scratch what the map already lists.
4. As soon as you can name the root cause with a file:line, STOP searching and write
   `DIAGNOSIS.md` immediately. Do not keep exploring "to be thorough".

STOP condition: you have a file:line + a one-paragraph mechanism for the symptom.
Read budget: at most ~8 file reads / greps total. If you approach that, WRITE your
best current finding to DIAGNOSIS.md now rather than reading more.
Do NOT re-grep or re-read a file you have already seen this run -- act on what you found.

## Required output

Write `DIAGNOSIS.md` at the repo root containing:
- Root cause: the file:line where the problem originates, and the mechanism (why).
- Evidence: the specific code/values you saw that prove it (quote them).
- Fix sketch: one paragraph on what change would resolve it (do NOT make the change).
- Falsifiable prediction: one concrete, checkable claim that MUST be true if this
  mechanism is the cause and would be FALSE if it isn't -- something a reviewer can
  confirm against the code or the live data without trusting your reasoning. State
  the exact check (e.g. "row X will have field F = null", "deleting Y drops total by
  Z", "this branch conserves the summed value, so it cannot change the total"). A
  mechanism with no falsifiable prediction is a guess; a wrong mechanism usually
  makes a prediction that the data contradicts, which is how a bad diagnosis is caught.

## Scope

This is a READ-ONLY investigation. Edit ONLY `DIAGNOSIS.md`. Do not modify any source
file, `verify.sh`, `REPO_MAP.md`, or `TASK.md`.

## Loop instruction

Run `bash verify.sh` to confirm DIAGNOSIS.md exists and is non-empty, then stop.
"""


# ---------------------------------------------------------------------------
# Python flavour
