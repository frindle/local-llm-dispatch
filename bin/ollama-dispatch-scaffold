KOTLIN_FIXTURE = '''\
// Adversarial fixture for: {label}
//
// >>> THE ONE THING THE GENERATOR CANNOT WRITE FOR YOU <<<
//
// The case list is EMPTY and this verify FAILS ({mark}) until you author >= 3
// real cases below. Deliberate: a generator can emit a verify that
// DISCRIMINATES (red at baseline, green on a fix); it cannot decide whether the
// verify is RELEVANT -- whether it tests the property the task asked for.
//
// Each case is one `chk("<description>", <got>, <want>)` call driving the REAL
// code in {target}. Author the boundary and one input on each side, the
// degenerate inputs (null, empty, 0) that must NOT throw, one input a plausible
// WRONG fix gets wrong, an OVER-TRIGGER GUARD, and the regression half.
import kotlin.system.exitProcess

// >>> Flip to true once >= 3 real cases are authored below. Until then the gate
//     NO-GOs by name, which is correct. <<<
const val CASES_AUTHORED = false

var checks = 0
var fails = 0

// chk PRINTS every case, pass or fail, so the drafter can tell "the cases ran
// and disagreed" from "the file did not compile".
fun chk(desc: String, got: Any?, want: Any?) {{
    checks++
    if (got != want) {{
        println("FAIL - $desc (got $got, want $want)")
        fails++
    }} else {{
        println("ok - $desc")
    }}
}}

fun main() {{
    // --- adversarial cases -- AUTHOR THESE ---------------------------------
    //   chk("just over the boundary clamps down", percent(101), 100)

    if (!CASES_AUTHORED) {{
        println("  {mark}: adversarial cases not yet authored in {fixture_rel}.")
        exitProcess(1)
    }}
    // Structural floor -- matches the Python/Swift/TS `>= 3` discipline:
    // flipping the guard with no cases would otherwise go green (vacuous).
    if (checks < 3) {{
        println("  {mark}: only $checks chk case(s); need >= 3.")
        exitProcess(1)
    }}
    println("--- $fails failed ---")
    exitProcess(if (fails == 0) 0 else 1)
}}
'''

KOTLIN_VERIFY = '''\
#!/usr/bin/env bash
# verify for: {label}
# DISPATCH_FIXTURE_CMD: {kotlinc} {target} VerifyImpl.kt -d out 2>/dev/null && {java} -cp "out:{kotlin_home}/lib/kotlin-stdlib.jar" VerifyImplKt
# ^ how to run the BEHAVIOURAL fixture ALONE, in this directory (read by
# ollama-dispatch-draft so the drafter compiles and runs it exactly as this
# verify does). kotlinc is SLOW (tens of seconds) -- that is the cost of the
# flavour, and it is why the verify compiles once and then runs.
# Counting idiom, NOT `set -e` -- an aborting verify never prints why it failed.
