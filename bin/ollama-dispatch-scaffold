if [ "$rc" -eq 0 ]; then
  echo "  ok: adversarial cases pass"
else
  echo "  FAIL: adversarial cases failed (exit $rc)"; fails=$((fails+1))
fi

echo "--- $fails failed ---"
[ "$fails" -eq 0 ] && echo VERIFY_OK || exit 1
'''

# ---------------------------------------------------------------------------
# C# / .NET flavour (2026-09-27) -- clamshell PeerTests' shape: a plain net8.0
# CONSOLE project (no xunit: nothing to restore from NuGet, so it builds
# offline) that compiles the target FILE directly via <Compile Include>. That is
# what lets a platform-neutral file inside a net8.0-windows project be tested on
# the Mac, and it never touches the repo's own .csproj. The harness directory
# carries empty Directory.Build.props/.targets/Directory.Packages.props so a
# repo's build customisation (TreatWarningsAsErrors, central package
# management, analyzers) cannot leak into the harness build.
# ---------------------------------------------------------------------------
CS_HARNESS_DIR = "DispatchTests"

CS_PROJECT = """\
<Project Sdk="Microsoft.NET.Sdk">
  <!-- dispatch harness (ollama-dispatch-scaffold): never integrated. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0162;CS8981;CS1998</NoWarn>
    <AssemblyName>DispatchTests</AssemblyName>
    <RootNamespace>DispatchTests</RootNamespace>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="VerifyImpl.cs" />
    <Compile Include="{target_from_harness}" />
  </ItemGroup>
</Project>
"""

CS_FIXTURE = """\
// Adversarial fixture for: {label}
//
// >>> THE ONE THING THE GENERATOR CANNOT WRITE FOR YOU <<<
//
// The case list is EMPTY and this verify FAILS ({mark}) until you author >= 3
// real cases inside Main() below. Deliberate: a generator can emit a verify that
// DISCRIMINATES (red at baseline, green on a fix); it cannot decide whether the
// verify is RELEVANT -- whether it tests the property the task asked for.
//
// Each case is ONE line `chk("<description>", <got>, <want>);` (or
// `chkThrows<SomeException>("<description>", () => ...);`) driving the REAL
// code in {target} -- this project compiles that file directly, so the model's
// edits to it are exactly what gets exercised.
//
// Author inputs that separate "did the job" from "made the test go green": the
// boundary and one input on each side, degenerate inputs (0, "", null, empty
// collections) that must NOT throw, at least one a plausible WRONG fix would get
// wrong, an OVER-TRIGGER GUARD (an input the change must not affect), and the
// regression half.
{usings}
static class VerifyImpl
{{
    static int checks, fails;

    // Prints EVERY case (not just failures) so the drafter can tell "the cases
    // ran and disagreed" from "the project did not build".
    static void chk(string desc, object got, object want)
    {{
        checks++;
        if (Equals(got, want) || string.Equals(System.Convert.ToString(got, System.Globalization.CultureInfo.InvariantCulture),
                                               System.Convert.ToString(want, System.Globalization.CultureInfo.InvariantCulture)))
            System.Console.WriteLine($"ok - {{desc}}");
        else {{ fails++; System.Console.WriteLine($"FAIL - {{desc}} (got {{got}}, want {{want}})"); }}
    }}

    static void chkThrows<T>(string desc, System.Action act) where T : System.Exception
    {{
        checks++;
        try {{ act(); fails++; System.Console.WriteLine($"FAIL - {{desc}} (no {{typeof(T).Name}} thrown)"); }}
        catch (T) {{ System.Console.WriteLine($"ok - {{desc}}"); }}
        catch (System.Exception e) {{ fails++; System.Console.WriteLine($"FAIL - {{desc}} (threw {{e.GetType().Name}})"); }}
    }}

    static int Main()
    {{
        try
        {{
            // --- adversarial cases -- AUTHOR THESE, one chk(...) per line ------
            //   chk("just over the boundary clamps down", Calc.Clamp(101, 0, 100), 100);

            // >>> Flip to true once >= 3 real cases (incl. the over-trigger guard)
            //     are authored above. Until then the gate NO-GOs by name. <<<
            bool CASES_AUTHORED = false;
            if (!CASES_AUTHORED)
            {{
                System.Console.WriteLine("  {mark}: adversarial cases not yet authored in {fixture_rel}");
                return 1;
            }}
        }}
        catch (System.Exception e)
        {{
            fails++;
            System.Console.WriteLine($"FAIL - a case threw {{e.GetType().Name}}: {{e.Message}}");
        }}
        // Structural floor -- the same `>= 3` discipline as every other flavour.
        if (checks < 3)
        {{
            System.Console.WriteLine($"  {mark}: only {{checks}} chk case(s); need >= 3");
            return 1;
        }}
        System.Console.WriteLine($"  {{checks - fails}}/{{checks}} case(s) passed");
        return fails == 0 ? 0 : 1;
    }}
}}
"""

CS_VERIFY = """\
#!/usr/bin/env bash
# verify for: {label}
# DISPATCH_FIXTURE_CMD: {env} {dotnet} run --project {hdir} -p:UseSharedCompilation=false
# ^ how to run the BEHAVIOURAL fixture ALONE, in this directory (read by
# ollama-dispatch-draft so the drafter runs it exactly as this verify does).
# Counting idiom, NOT `set -e` -- an aborting verify never prints why it failed.
cd "$(dirname "$0")" || exit 1

fails=0
# ABSOLUTE dotnet + its env: the queue daemon runs verify under launchd's bare
# PATH/env, where a user-local SDK (~/.dotnet) is invisible without DOTNET_ROOT.
DOTNET={dotnet}
export {env}

# NOTE: `if cmd | tail -20; then` tests TAIL's exit status, not cmd's -- tail
# always succeeds, so every failure reads as a pass. Capture, then test.
echo "=== build (target + fixture) ==="
out=$("$DOTNET" build {hdir} -nologo -v q -p:UseSharedCompilation=false 2>&1); rc=$?
echo "$out" | grep -E "error|warn.*{target_base}" | sort -u | tail -20
if [ "$rc" -eq 0 ]; then
  echo "  ok: dotnet build"
else
  echo "  FAIL: dotnet build (exit $rc)"; fails=$((fails+1))
