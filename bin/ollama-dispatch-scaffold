if python3 ./check_literals.py; then
  echo "  ok: every Must-contain literal present"
else
  echo "  FAIL: a Must-contain literal is missing"; fails=$((fails+1))
fi

echo "=== behavioural cases ==="
if [ "$rc" -eq 0 ]; then
  out=$("$DOTNET" run --no-build --project {hdir} 2>&1); rc=$?
  echo "$out" | tail -40
  if [ "$rc" -eq 0 ]; then
    echo "  ok: adversarial cases pass"
  else
    echo "  FAIL: adversarial cases failed (exit $rc)"; fails=$((fails+1))
  fi
else
  echo "  FAIL: not run -- the build failed"; fails=$((fails+1))
fi

echo "--- $fails failed ---"
[ "$fails" -eq 0 ] && echo VERIFY_OK || exit 1
"""

# ---------------------------------------------------------------------------
# Bash / shell flavour -- the SIMPLEST flavour there is, deliberately. No venv,
# no npm ci, no tsx, no prisma: a shell script's runtime is already installed,
# so the entire env-parity story is "bash exists". The fixture DRIVES the script
# under test as a subprocess and asserts its stdout and its EXIT CODE -- a shell
# script's exit status is behaviour, and a fixture that only reads stdout cannot
# see a script that silently exits 0 on a failure it should have reported.
# ---------------------------------------------------------------------------
BASH_FIXTURE = '''\
#!/usr/bin/env bash
# Adversarial fixture for: {label}
#
# >>> THE ONE THING THE GENERATOR CANNOT WRITE FOR YOU <<<
#
# The case list is EMPTY and this verify FAILS ({mark}) until you author >= 3
# real cases below. Deliberate: a generator can emit a verify that
# DISCRIMINATES (red at baseline, green on a fix); it cannot decide whether the
# verify is RELEVANT -- whether it tests the property the task asked for.
#
# Each case is ONE line:
#     chk "<description>" "<actual>" "<expected>"
# where <actual> drives the REAL script through run_target / run_target_rc, so
# the model's edits to {target} are exactly what gets exercised.
#
# Author inputs that separate "did the job" from "made the test go green":
#   - the boundary, and one input on each side of it;
#   - the degenerate inputs (no args, empty string, a missing file, a path with
#     spaces) that must NOT crash with an unhandled error;
#   - the EXIT CODE, not just stdout -- a script that prints the right thing and
#     exits 0 on an error is still broken;
#   - an OVER-TRIGGER GUARD: an input the change must NOT affect.
#
# BUILD ANY INPUT THE CASES NEED INSIDE THIS FILE (printf into a temp file, and
# clean it up), so the fixture is SELF-CONTAINED. A case that reads a data file
# created outside the harness breaks the moment the worktree is re-cut, and the
# harness seal does not know that file is part of the verify.
cd "$(dirname "$0")" || exit 1
TARGET="{target}"

fails=0
checks=0
chk() {{
  checks=$((checks+1))
  if [ "$2" = "$3" ]; then
    echo "ok - $1"
  else
    echo "FAIL - $1 (got '$2', want '$3')"
    fails=$((fails+1))
  fi
}}

# Drive the script under test. run_target -> its stdout; run_target_rc -> its
# exit status. Always go through these: a case that reimplements the logic
# instead of calling the script proves nothing about the script.
run_target() {{ bash "$TARGET" "$@" 2>/dev/null; }}
run_target_rc() {{ bash "$TARGET" "$@" >/dev/null 2>&1; echo $?; }}

# --- adversarial cases -- AUTHOR THESE, then set CASES_AUTHORED=1 -----------
#   chk "no args -> usage exit 2"   "$(run_target_rc)"              "2"
#   chk "sums the column"           "$(run_target fixtures/a.txt)"  "42"

# >>> Flip this to 1 once >= 3 real cases (incl. the over-trigger guard) are
#     authored above. Until then the gate NO-GOs by name, which is correct. <<<
CASES_AUTHORED=0
if [ "$CASES_AUTHORED" != "1" ]; then
  echo "  {mark}: adversarial cases not yet authored in {fixture_rel}."
  exit 1
fi

# Structural floor -- matches the Python/Swift/TS `>= 3` discipline. Flipping
# the guard with zero cases would otherwise leave fails=0 and go green.
if [ "$checks" -lt 3 ]; then
  echo "  {mark}: only $checks chk case(s); need >= 3."
  exit 1
fi
echo "--- $fails failed ---"
[ "$fails" -eq 0 ] || exit 1
'''

BASH_VERIFY = '''\
#!/usr/bin/env bash
# verify for: {label}
# DISPATCH_FIXTURE_CMD: bash ./{fixture_rel}
# ^ how to run the BEHAVIOURAL fixture ALONE, in this directory (read by
# ollama-dispatch-draft so the drafter runs it exactly as this verify does).
# Counting idiom, NOT `set -e` -- an aborting verify never prints why it failed.
cd "$(dirname "$0")" || exit 1

fails=0

# NO env bootstrap: this is the one flavour whose runtime is always present.
# `bash -n` is the shell analogue of `ast.parse` -- it parses without executing,
# so a half-written edit is caught as a syntax error rather than as a mysterious
# case failure.
echo "=== target parses ==="
if bash -n {target} 2>/tmp/_verify_parse.$$.log; then
  echo "  ok: {target} parses"
else
  echo "  FAIL: {target} does not parse"; head -5 /tmp/_verify_parse.$$.log
  fails=$((fails+1))
fi
rm -f /tmp/_verify_parse.$$.log

# shellcheck is a WARNING, never a FAIL: it is not installed everywhere (the
# queue host may not have it), and a style finding is not this task's contract.
if command -v shellcheck >/dev/null 2>&1; then
  echo "=== shellcheck (advisory) ==="
  shellcheck -S error {target} || echo "  WARN: shellcheck findings above (advisory, not a gate)"
fi

echo "=== spec literals ==="
if python3 ./check_literals.py; then
  echo "  ok: every Must-contain literal present"
else
  echo "  FAIL: a Must-contain literal is missing"; fails=$((fails+1))
fi

echo "=== behavioural cases ==="
if bash ./{fixture_rel}; then
  echo "  ok: adversarial cases pass"
else
  echo "  FAIL: adversarial cases failed"; fails=$((fails+1))
fi

echo "--- $fails failed ---"
[ "$fails" -eq 0 ] && echo VERIFY_OK || exit 1
'''


# ---------------------------------------------------------------------------
# Go flavour -- the fixture is a REAL `go test` file in the target's own
# package (so it can drive unexported functions too), not a bespoke harness.
# `go test -v` so the per-case `ok - ` / `FAIL - ` lines are always printed:
# without -v a passing run prints nothing, and the drafter's "did it actually
# run the cases?" evidence disappears.
# ---------------------------------------------------------------------------
GO_FIXTURE = '''\
// Adversarial fixture for: {label}
//
// >>> THE ONE THING THE GENERATOR CANNOT WRITE FOR YOU <<<
//
// The case list is EMPTY and this verify FAILS ({mark}) until you author >= 3
// real cases below. Deliberate: a generator can emit a verify that
// DISCRIMINATES (red at baseline, green on a fix); it cannot decide whether the
// verify is RELEVANT -- whether it tests the property the task asked for.
//
// Each case is one `chk(t, "<description>", <got>, <want>)` call driving the
// REAL function in this package, so the model's edits to {target} are exactly
// what gets exercised.
//
// Author inputs that separate "did the job" from "made the test go green":
// the boundary and one input on each side, the degenerate inputs (zero value,
// empty slice/map, nil) that must NOT panic, at least one a plausible WRONG fix
// would get wrong, an OVER-TRIGGER GUARD (an input the change must not affect),
// and the regression half.
package {pkg}

import (
	"fmt"
	"testing"
)

// >>> Flip to true once >= 3 real cases (incl. the over-trigger guard) are
//     authored below. Until then the gate NO-GOs by name, which is correct. <<<
const CASES_AUTHORED = false

var checks int

// chk reports one case. It PRINTS every case (not just failures) so the drafter
// can tell "the cases ran and disagreed" from "the package did not build".
func chk(t *testing.T, desc string, got, want interface{{}}) {{
	t.Helper()
	checks++
	if fmt.Sprint(got) != fmt.Sprint(want) {{
		fmt.Printf("FAIL - %s (got %v, want %v)\\n", desc, got, want)
		t.Fail()
	}} else {{
		fmt.Printf("ok - %s\\n", desc)
	}}
}}

func TestAdversarialCases(t *testing.T) {{
	// --- adversarial cases -- AUTHOR THESE ---------------------------------
	//   chk(t, "just over the boundary clamps down", Percent(101), 100)

	if !CASES_AUTHORED {{
		t.Fatalf("  {mark}: adversarial cases not yet authored in {fixture_rel}")
	}}
	// Structural floor -- matches the Python/Swift/TS `>= 3` discipline:
	// flipping the guard with no cases would otherwise go green (vacuous).
	if checks < 3 {{
		t.Fatalf("  {mark}: only %d chk case(s); need >= 3", checks)
	}}
}}
'''

GO_VERIFY = '''\
#!/usr/bin/env bash
# verify for: {label}
# DISPATCH_FIXTURE_CMD: {go} test -v {pkg_dir}
# ^ how to run the BEHAVIOURAL fixture ALONE, in this directory (read by
# ollama-dispatch-draft so the drafter runs it exactly as this verify does).
# Counting idiom, NOT `set -e` -- an aborting verify never prints why it failed.
cd "$(dirname "$0")" || exit 1

fails=0
GO={go}     # absolute: the queue daemon runs under launchd's PATH

echo "=== target builds ==="
out=$("$GO" build ./... 2>&1); rc=$?
echo "$out" | tail -20
if [ "$rc" -eq 0 ]; then
  echo "  ok: go build"
else
  echo "  FAIL: go build (exit $rc)"; fails=$((fails+1))
fi

# go vet is the Go analogue of a type-lint. ADVISORY: a vet finding in code this
# task never touched is not this task's contract.
out=$("$GO" vet ./... 2>&1) || echo "  WARN: go vet findings (advisory, not a gate):
$out"

echo "=== spec literals ==="
if python3 ./check_literals.py; then
  echo "  ok: every Must-contain literal present"
else
  echo "  FAIL: a Must-contain literal is missing"; fails=$((fails+1))
fi

echo "=== behavioural cases ==="
out=$("$GO" test -v {pkg_dir} 2>&1); rc=$?
echo "$out" | tail -40
if [ "$rc" -eq 0 ]; then
  echo "  ok: adversarial cases pass"
else
  echo "  FAIL: adversarial cases failed (exit $rc)"; fails=$((fails+1))
fi

echo "--- $fails failed ---"
[ "$fails" -eq 0 ] && echo VERIFY_OK || exit 1
'''


# ---------------------------------------------------------------------------
# Rust flavour -- the fixture is a real cargo INTEGRATION test (tests/*.rs), so
# it drives the crate exactly as a downstream user would: only the public API.
# `-- --nocapture` so the per-case lines are printed (cargo swallows stdout of
# passing tests otherwise, and the drafter's "did the cases actually run?"
# evidence would vanish).
# ---------------------------------------------------------------------------
RUST_FIXTURE = '''\
// Adversarial fixture for: {label}
//
// >>> THE ONE THING THE GENERATOR CANNOT WRITE FOR YOU <<<
//
// The case list is EMPTY and this verify FAILS ({mark}) until you author >= 3
// real cases below. Deliberate: a generator can emit a verify that
// DISCRIMINATES (red at baseline, green on a fix); it cannot decide whether the
// verify is RELEVANT -- whether it tests the property the task asked for.
//
// Each case is one `chk!("<description>", <got>, <want>)` driving the REAL
// public API of the crate, so the model's edits to {target} are what gets
// exercised. Author the boundary and one input on each side, the degenerate
// inputs (empty, zero, None) that must NOT panic, one input a plausible WRONG
// fix gets wrong, an OVER-TRIGGER GUARD (an input the change must not affect),
// and the regression half.
use {crate_name}::*;

// >>> Flip to true once >= 3 real cases (incl. the over-trigger guard) are
//     authored below. Until then the gate NO-GOs by name, which is correct. <<<
const CASES_AUTHORED: bool = false;

#[test]
fn adversarial_cases() {{
    // Counters are LOCALS, not `static mut`: macro_rules hygiene resolves the
    // names at the definition site, so chk! updates these without any unsafe.
    let mut checks = 0u32;
    let mut fails = 0u32;

    // chk! PRINTS every case, pass or fail, so the drafter can tell "the cases
    // ran and disagreed" from "the crate did not compile".
    macro_rules! chk {{
        ($desc:expr, $got:expr, $want:expr) => {{{{
            checks += 1;
            let got = $got;
            let want = $want;
            if got != want {{
                println!("FAIL - {{}} (got {{:?}}, want {{:?}})", $desc, got, want);
                fails += 1;
            }} else {{
                println!("ok - {{}}", $desc);
            }}
        }}}};
    }}

    // --- adversarial cases -- AUTHOR THESE ---------------------------------
    //   chk!("just over the boundary clamps down", percent(101), 100);

    if !CASES_AUTHORED {{
        panic!("  {mark}: adversarial cases not yet authored in {fixture_rel}");
    }}
    // Structural floor -- matches the Python/Swift/TS `>= 3` discipline:
    // flipping the guard with no cases would otherwise go green (vacuous).
    if checks < 3 {{
        panic!("  {mark}: only {{}} chk case(s); need >= 3", checks);
    }}
    println!("--- {{}} failed ---", fails);
    assert_eq!(fails, 0, "{{}} adversarial case(s) failed", fails);
}}
'''

RUST_CARGO_TOML = '''\
[package]
name = "{crate_name}"
version = "0.1.0"
edition = "2021"

[lib]
path = "{lib_path}"
'''

RUST_VERIFY = '''\
#!/usr/bin/env bash
# verify for: {label}
# DISPATCH_FIXTURE_CMD: {cargo} test --test verify_impl -- --nocapture
# ^ how to run the BEHAVIOURAL fixture ALONE, in this directory (read by
# ollama-dispatch-draft so the drafter runs it exactly as this verify does).
# Counting idiom, NOT `set -e` -- an aborting verify never prints why it failed.
cd "$(dirname "$0")" || exit 1

fails=0
CARGO={cargo}     # absolute: the queue daemon runs under launchd's PATH

echo "=== target builds ==="
out=$("$CARGO" build 2>&1); rc=$?
echo "$out" | tail -20
if [ "$rc" -eq 0 ]; then
  echo "  ok: cargo build"
else
  echo "  FAIL: cargo build (exit $rc)"; fails=$((fails+1))
fi

echo "=== spec literals ==="
if python3 ./check_literals.py; then
  echo "  ok: every Must-contain literal present"
else
  echo "  FAIL: a Must-contain literal is missing"; fails=$((fails+1))
fi

echo "=== behavioural cases ==="
out=$("$CARGO" test --test verify_impl -- --nocapture 2>&1); rc=$?
echo "$out" | tail -40
if [ "$rc" -eq 0 ]; then
  echo "  ok: adversarial cases pass"
else
  echo "  FAIL: adversarial cases failed (exit $rc)"; fails=$((fails+1))
fi

echo "--- $fails failed ---"
[ "$fails" -eq 0 ] && echo VERIFY_OK || exit 1
'''


# ---------------------------------------------------------------------------
# Java / Kotlin flavour -- EXIT-CODE EXEC, not JUnit. Same reasoning as the
# swift flavour (reference_clt_toolchain_no_xctest): a test FRAMEWORK is a
# dependency to resolve, a version to pin and a download on the dispatch host,
# and none of that is what the verify is proving. A `main` that prints each case
# and exits nonzero needs nothing but the compiler that is already there, and it
# is the same shape every other flavour uses.
# ---------------------------------------------------------------------------
JAVA_FIXTURE = '''\
// Adversarial fixture for: {label}
//
// >>> THE ONE THING THE GENERATOR CANNOT WRITE FOR YOU <<<
//
// The case list is EMPTY and this verify FAILS ({mark}) until you author >= 3
// real cases below. Deliberate: a generator can emit a verify that
// DISCRIMINATES (red at baseline, green on a fix); it cannot decide whether the
// verify is RELEVANT -- whether it tests the property the task asked for.
//
// Each case is one `chk("<description>", <got>, <want>)` call driving the REAL
// class in {target}. Author the boundary and one input on each side, the
// degenerate inputs (null, empty, 0) that must NOT throw, one input a plausible
// WRONG fix gets wrong, an OVER-TRIGGER GUARD (an input the change must not
// affect), and the regression half.
public class VerifyImpl {{

    // >>> Flip to true once >= 3 real cases are authored below. Until then the
    //     gate NO-GOs by name, which is correct. <<<
    static final boolean CASES_AUTHORED = false;

    static int checks = 0;
    static int fails = 0;

    // chk PRINTS every case, pass or fail, so the drafter can tell "the cases
    // ran and disagreed" from "the class did not compile".
    static void chk(String desc, Object got, Object want) {{
        checks++;
        if (got == null ? want != null : !got.equals(want)) {{
            System.out.println("FAIL - " + desc + " (got " + got + ", want " + want + ")");
            fails++;
        }} else {{
            System.out.println("ok - " + desc);
        }}
    }}

    public static void main(String[] args) {{
        // --- adversarial cases -- AUTHOR THESE -----------------------------
        //   chk("just over the boundary clamps down", Clamp.percent(101), 100);

        if (!CASES_AUTHORED) {{
            System.out.println("  {mark}: adversarial cases not yet authored in {fixture_rel}.");
            System.exit(1);
        }}
        // Structural floor -- matches the Python/Swift/TS `>= 3` discipline:
        // flipping the guard with no cases would otherwise go green (vacuous).
        if (checks < 3) {{
            System.out.println("  {mark}: only " + checks + " chk case(s); need >= 3.");
            System.exit(1);
        }}
        System.out.println("--- " + fails + " failed ---");
        System.exit(fails == 0 ? 0 : 1);
    }}
}}
'''

