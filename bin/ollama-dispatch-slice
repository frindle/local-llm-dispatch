        check("a never-dispatched PENDING slice with no job, no driver, idle past the "
              "grace window IS kicked (case 4)", (_sweep(), _fired), (["gamma"], ["gamma"]))
        check("...and the reason names the idle slice",
              "s2 is pending" in (plan_needs_kick(_idle, {}, _old, None, False, now=_T0,
                                                  idle_age=LOST_EVENT_GRACE_S + 1) or ""), True)
        _fired.clear()
        # a HUMAN cancel is terminal: the sweep never re-arms a cancelled plan
        import plan_cancel as _pcx
        _pcx.mark_cancelled("gamma", "the owner cancelled", runs_dir=STATE_ROOT)
        check("a CANCELLED plan is never kicked by the sweep, however due", _sweep(), [])
        check("...and execute() re-checks the cancel before every slice",
              "_plan_cancelled(st[\"label\"])" in inspect.getsource(execute)
              and "_canc = _plan_cancelled(st[\"label\"])" in inspect.getsource(main), True)
        _pcx.clear_cancelled("gamma", runs_dir=STATE_ROOT)
        _fired.clear()
        # same plan, LIVE driver: not ours
        Path(lock_path("gamma")).write_text(json.dumps(
            {"pid": os.getpid(), "started_at": datetime.now(timezone.utc).isoformat()}))
        check("...but NOT under a live driver", _sweep(), [])
        release_advance_lock("gamma")
        # same plan, freshly written: inside the grace window
        os.utime(_gpath, (_T0, _T0))
        check("...and NOT while the plan is fresh (inside the grace window)", _sweep(), [])
        # a recent detached advance header is life too -- the kick itself resets the
        # clock, so a no-op --execute costs one process per window, not one per pass
        os.utime(_gpath, (_stale, _stale))
        Path(_glog).write_text("\n===== advance (test) =====\n")
        check("...a fresh .advance.log header resets the idle clock (storm-proof)",
              _sweep(), [])
        os.unlink(_glog)
        check("...idle_age None (unknown) never kicks", plan_needs_kick(
            _idle, {}, _old, None, False, now=_T0, idle_age=None), None)
        check("...an ENQUEUED slice anywhere means an event is in flight: case 4 stays out",
              plan_needs_kick({"label": "g", "order": ["s1", "s2"],
                               "slices": {"s1": {"status": PENDING, "depends_on": []},
                                          "s2": {"status": ENQUEUED, "job_id": "jx"}}},
                              {"jx": "running"}, _young, None, False, now=_T0,
                              idle_age=LOST_EVENT_GRACE_S + 1), None)
        # ESCALATED head with only its DEPENDENTS behind it: nothing runnable, so
        # nothing to kick (the queue parks the bundle and alerts). 2026-09-27: a
        # slice that does NOT depend on the escalated one IS due (the owner: work the
        # bundle while anything in it can still run).
        _idle["slices"]["s2"]["status"] = ESCALATED
        _idle["order"].append("s3")
        _idle["slices"]["s3"] = {"status": PENDING, "depends_on": ["s2"], "job_id": None}
        Path(_gpath).write_text(json.dumps(_idle))
        os.utime(_gpath, (_stale, _stale))
        check("an ESCALATED head with only its dependents behind it is NOT kicked",
              (_sweep(), first_due_slice(_idle)), ([], None))
        _indep = json.loads(json.dumps(_idle))
        _indep["order"].append("s4")
        _indep["slices"]["s4"] = {"status": PENDING, "depends_on": [], "job_id": None}
        check("...but a slice INDEPENDENT of the escalated one is due (s4, not s3)",
              first_due_slice(_indep), ("s4", PENDING))
        for _park in (AWAITING_REVIEW, ENQUEUED):
            _idle["slices"]["s2"]["status"] = _park
            check(f"first_due_slice stops at {_park} (not the sweep's business)",
                  first_due_slice(_idle), None)
        _idle["slices"]["s2"]["status"] = ESCALATED
        # FAILED / BLOCKED follow execute(): retried/revived only when deps allow
        check("a FAILED slice whose deps are satisfied is due (execute auto-retries it)",
              first_due_slice({"order": ["s1"], "slices": {
                  "s1": {"status": FAILED, "depends_on": []}}}), ("s1", FAILED))
        check("a FAILED slice whose deps are NOT satisfied is stepped over, not due",
              first_due_slice({"order": ["s0", "s1"], "slices": {
                  "s0": {"status": FAILED, "depends_on": ["s1"]},
                  "s1": {"status": FAILED, "depends_on": ["s0"]}}}), None)
        check("a BLOCKED slice whose deps all recovered is due (execute revives it)",
              first_due_slice({"order": ["s1", "s2"], "slices": {
                  "s1": {"status": DONE, "depends_on": []},
                  "s2": {"status": BLOCKED, "depends_on": ["s1"]}}}), ("s2", BLOCKED))
        check("a PENDING slice behind a FAILED dep is stepped over (execute marks it BLOCKED)",
              first_due_slice({"order": ["s1", "s2"], "slices": {
                  "s1": {"status": FAILED, "depends_on": ["s9"]},
                  "s2": {"status": PENDING, "depends_on": ["s1"]}, "s9": {"status": PENDING}}}),
              None)
        check("a collided CONFIRMED slice belongs to the collision retry, not case 4",
              first_due_slice({"order": ["s1"], "slices": {
                  "s1": {"status": CONFIRMED, "last_collision": {"at": 1.0}}}}), None)
        check("a fully satisfied plan has nothing due",
              first_due_slice({"order": ["s1"], "slices": {"s1": {"status": SKIPPED}}}), None)
        # an INTENTIONALLY abandoned plan lives under slice-runs/_abandoned/: the
        # sweep lists STATE_ROOT itself (no recursion), so it is never seen
        _aband = os.path.join(STATE_ROOT, "_abandoned")
        os.makedirs(_aband, exist_ok=True)
        _zpath = os.path.join(_aband, "zeta.json")
        Path(_zpath).write_text(json.dumps({
            "label": "zeta", "plan_path": _plan_f, "order": ["s1"],
            "slices": {"s1": {"status": PENDING, "depends_on": [], "job_id": None}}}))
        os.utime(_zpath, (_stale, _stale))
        _fired.clear()
        check("a plan under _abandoned/ is never swept, however idle", _sweep(), [])
        shutil.rmtree(_aband, ignore_errors=True)
        # a due-but-unregistered plan (missing plan file) is REPORTED, not fired
        _idle["slices"]["s2"]["status"] = DONE
        _idle["plan_path"] = os.path.join(STATE_ROOT, "no-such.plan.json")
        Path(_gpath).write_text(json.dumps(_idle))
        os.utime(_gpath, (_stale, _stale))
        check("a due idle plan whose plan file is missing needs a hand --execute, not a kick",
              _sweep(), [])
        check("--sweep's help text names the idle case",
              "due work" in inspect.getsource(main), True)
        for _f in (state_path("gamma"), _plan_f):
            try:
                os.unlink(_f)
            except OSError:
                pass
        # levers report a state change so main() can re-arm the plan
        _saved_infl = globals()["slice_job_inflight"]
        globals()["slice_job_inflight"] = lambda st_, sid: None
        try:
            _lst = {"label": "delta", "order": ["s1"], "repo": "/nonexistent",
                    "target": "x.py", "chain_branch": "slice/delta",
                    "chain_worktree": "/nonexistent/wt",
                    "slices": {"s1": {"status": PENDING, "title": "t", "depends_on": []}}}
            check("--skip-slice reports the change it made",
                  skip_slice(_lst, "s1", "already true at the tip"), True)
            check("...and reports NOTHING when there was nothing to do",
                  skip_slice(_lst, "s1", "again"), None)
            _lst["slices"]["s1"]["status"] = AWAITING_REVIEW
            check("--confirm-slice reports the change it made",
                  confirm_slice(_lst, "s1"), True)
        finally:
            globals()["slice_job_inflight"] = _saved_infl
            try:
                os.unlink(state_path("delta"))
            except OSError:
                pass
        check("every state-changing lever hands its result to the re-arm",
              all(f"_rearm({fn}(" in inspect.getsource(main)
                  for fn in ("confirm_slice", "retry_slice", "skip_slice",
                             "reland_slice", "accept_slice", "complete_slice")), True)
        check("the re-arm fires the SAME detached advance the completion hook does",
              "advance_detached(st, a.plan)" in inspect.getsource(main)
              and "a.no_advance" in inspect.getsource(main), True)
        check("a killed --execute still runs its finally (SIGTERM/SIGHUP -> SystemExit)",
              "signal.SIGTERM" in inspect.getsource(main)
              and "signal.SIGHUP" in inspect.getsource(main)
              and "raise SystemExit(128 + signum)" in inspect.getsource(main), True)
        check("--sweep needs no plan argument",
              "if a.sweep:" in inspect.getsource(main)
              and "sweep_stranded_advances()" in inspect.getsource(main), True)
        check("a live owner's lock is NOT reclaimed at the old 6h age",
              lock_is_stale({"pid": 1, "started_at":
                             (datetime.now(timezone.utc)
                              .replace(microsecond=0)).isoformat()},
                            alive=lambda p: True,
                            now=datetime.now(timezone.utc).replace(microsecond=0)
                            + __import__("datetime").timedelta(hours=7)), False)

        # --- whole-chain integration (2026-09-23, Fable pass 2) -------------------
        _D, _S, _P = {"status": DONE}, {"status": SKIPPED}, {"status": PENDING}
        check("a plan is converged when every slice is done/skipped and one is done",
              plan_converged({"order": ["a", "b"], "slices": {"a": _D, "b": _S}}), True)
        check("...not when every slice is skipped (nothing on the chain to land)",
              plan_converged({"order": ["a"], "slices": {"a": _S}}), False)
        check("...not with a slice still open",
              plan_converged({"order": ["a", "b"], "slices": {"a": _D, "b": _P}}), False)

        # --- #6 stale-seed rebase: a slice worktree cut from an OLDER chain tip -----
        _rb = tempfile.mkdtemp(prefix="slice-selftest-rebase-")
        try:
            _c = os.path.join(_rb, "chain")
            os.makedirs(_c)
            def _g(*args, cwd=_c, **kw):
                return subprocess.run(["git", "-C", cwd, *args], capture_output=True,
                                      text=True, **kw)
            _g("init", "-q", "-b", "main")
            _g("config", "user.email", "t@t"); _g("config", "user.name", "t")
            Path(_c, "t.txt").write_text("a\nb\nc\n")
            _g("add", "."); _g("commit", "-q", "-m", "seed")
            _seed = _g("rev-parse", "HEAD").stdout.strip()
            # the slice worktree is cut at the seed (subprocess, not a hand `git
            # worktree add` in a shell -- same call the scaffold makes)
            _w = os.path.join(_rb, "wt")
            _g("worktree", "add", "-q", "-b", "sl", _w, _seed)
            # a LATER slice lands on the chain: line c -> c2
            Path(_c, "t.txt").write_text("a\nb\nc2\n")
            _g("commit", "-q", "-am", "later slice")
            # our slice edits a different line in its (stale) worktree: a -> a1
            Path(_w, "t.txt").write_text("a1\nb\nc\n")
            Path(_w, "verify.sh").write_text(
                "grep -q a1 t.txt && grep -q c2 t.txt && echo VERIFY_OK\n")
            _oc, _msg = _stage_deliverable(_c, _w, "t.txt")
            check("a stale-seed deliverable is 3-way merged onto the chain tip, not copied",
                  (_oc, Path(_c, "t.txt").read_text()), ("ok", "a1\nb\nc2\n"))
            check("...the note says it was rebased and how far behind the seed was",
                  "rebased onto the chain tip" in _msg and "1 commit(s) behind" in _msg, True)
            check("...the slice worktree now carries the merged target too",
                  Path(_w, "t.txt").read_text(), "a1\nb\nc2\n")
            check("...and the merge is STAGED (not committed) on the chain",
                  _g("diff", "--cached", "--name-only").stdout.strip(), "t.txt")
            _g("reset", "-q", "HEAD"); _g("checkout", "--", "t.txt")
            # SEMANTIC conflict: merges textually, but the slice's own verify rejects
            # the merged result -> nothing staged, chain tree untouched.
            Path(_w, "t.txt").write_text("a1\nb\nc\n")
            Path(_w, "verify.sh").write_text(
                "grep -q c2 t.txt && exit 1; grep -q a1 t.txt && echo VERIFY_OK\n")
            _oc, _msg = _stage_deliverable(_c, _w, "t.txt")
            check("a merged target that FAILS the slice's verify is a conflict, not a land",
                  (_oc, "semantic conflict" in _msg), ("conflict", True))
            check("...leaving the chain tree and index untouched",
                  (Path(_c, "t.txt").read_text(), _g("diff", "--cached", "--name-only").stdout),
                  ("a\nb\nc2\n", ""))
            check("...and the slice worktree's target restored to what it delivered",
                  Path(_w, "t.txt").read_text(), "a1\nb\nc\n")
            # TEXTUAL conflict: both sides changed line c differently.
            Path(_w, "t.txt").write_text("a\nb\nc9\n")
            Path(_w, "verify.sh").write_text("echo VERIFY_OK\n")
            _oc, _msg = _stage_deliverable(_c, _w, "t.txt")
            check("a textual conflict with what landed since is refused",
                  (_oc, "conflicting hunk" in _msg and "does not merge cleanly" in _msg),
                  ("conflict", True))
            check("...with nothing staged",
                  _g("diff", "--cached", "--name-only").stdout.strip(), "")
            # CONTROL: seed == tip is the plain copy it always was.
            _g("worktree", "remove", "--force", _w)
            _g("worktree", "add", "-q", "-b", "sl2", _w, "HEAD")
            Path(_w, "t.txt").write_text("a\nb\nc2\nd\n")
            _oc, _msg = _stage_deliverable(_c, _w, "t.txt")
            check("CONTROL: a worktree seeded at the current tip stages by plain copy",
                  (_oc, _msg, Path(_c, "t.txt").read_text()), ("ok", "", "a\nb\nc2\nd\n"))
            _g("reset", "-q", "HEAD"); _g("checkout", "--", "t.txt")
            Path(_w, "t.txt").write_text("a\nb\nc2\n")
            check("CONTROL: an identical target is still the empty-deliverable outcome",
                  _stage_deliverable(_c, _w, "t.txt")[0], "empty")
        finally:
            shutil.rmtree(_rb, ignore_errors=True)
        _pend = inspect.getsource(execute)
        check("#3: after AUTO returns, ANY externally-changed status (not just done/skipped) "
              "stops this driver from re-routing the slice",
              "if fresh_status and fresh_status != PENDING:" in _pend
              and "if fresh_status in SATISFIED:" not in _pend, True)
        check("...and never for an empty plan", plan_converged({"order": [], "slices": {}}), False)
        check("a sub-plan (repo IS a chain worktree) is recognised",
              is_subplan({"repo": os.path.join(WT_ROOT, "wt-slice-x-chain")}), True)
        check("a top-level plan is not a sub-plan",
              is_subplan({"repo": "/Users/user/Desktop/GitHub Projects/x"}), False)
        check("no record -> integration is needed", integration_needed({}, "abc"), True)
        check("n/a (sub-plan) -> never", integration_needed({"integration": {"status": "n/a"}}, "abc"), False)
        check("staged at this tip -> not again",
              integration_needed({"integration": {"status": "staged", "chain_tip": "abc"}}, "abc"), False)
        check("staged at an OLDER tip (a reland moved it) -> re-stage",
              integration_needed({"integration": {"status": "staged", "chain_tip": "old"}}, "abc"), True)
        check("passed at this tip -> not again",
              integration_needed({"integration": {"status": "passed", "chain_tip": "abc"}}, "abc"), False)
        check("failed -> not re-fired by the sweep (announced; --integrate re-runs it)",
              integration_needed({"integration": {"status": "failed", "chain_tip": "abc"}}, "abc"), False)

        # --- (2026-09-24) A CACHED VERDICT EXPIRES WHEN main MOVES ------------------
        # Live failure: one sweep at 2026-09-23T22:41:15Z wrote eleven conflict-semantic
        # records (bg-actions, bg-alert, bg-detection, bg-escalation, bg-health,
        # bg-profile, bg-serpwatch, bg-state, bg-webui, scheduler, playwright_checks)
        # and one staged record (rt-costco-always-sites). Every sweep for the next ~26h
        # re-announced those frozen verdicts as live truth, because integration_needed()
        # only ever looked at the CHAIN tip. Chains whose content had since landed on
        # main kept escalating as "semantic conflict"; a stage main had diverged from
        # kept escalating as "clean, ready to land".
        _stgd = {"status": "staged", "chain_tip": "abc", "onto": "main", "onto_tip": "m0"}
        _conf = {"status": "failed", "verdict": "conflict-semantic", "onto": "main",
                 "onto_tip": "m0", "chain_tip": "abc"}
        check("a staged record is stale once main moves off the tip it was built on",
              base_moved(_stgd, "m1"), True)
        check("...and is NOT stale while main is still exactly there",
              base_moved(_stgd, "m0"), False)
        check("...nor when the current tip is unknowable (never guess staleness)",
              base_moved(_stgd, None), False)
        check("a CONFLICT verdict expires the same way (the 11 false conflicts)",
              base_moved(_conf, "m1"), True)
        check("...but a non-conflict failure is about the CHAIN, so main moving is moot",
              base_moved({"status": "failed", "verdict": None, "onto_tip": "m0"}, "m1"), False)
        check("a passed/landed record is a claim about the PAST -- main moving cannot expire it",
              (base_moved({"status": "passed", "verdict": "clean", "onto_tip": "m0"}, "m1"),
               base_moved({"status": "passed", "verdict": "redundant", "onto_tip": "m0"}, "m1")),
              (False, False))
        check("...and n/a (sub-plan) never expires",
              base_moved({"status": INTEGRATION_NA, "onto_tip": "m0"}, "m1"), False)
        check("a record written BEFORE freshness tracking (no onto_tip) is unprovable -> re-check",
              base_moved({"status": "staged", "onto_tip": None}, "m1"), True)
        check("integration_needed re-fires a staged record whose main moved, tip unchanged",
              integration_needed({"integration": dict(_stgd)}, "abc", "m1"), True)
        check("...and does NOT re-fire it while main sits where it was staged",
              integration_needed({"integration": dict(_stgd)}, "abc", "m0"), False)
        check("integration_needed re-fires a cached conflict once main moves",
              integration_needed({"integration": dict(_conf)}, "abc", "m1"), True)
        check("a `stale` record always re-stages",
              integration_needed({"integration": {"status": INTEGRATION_STALE}}, "abc"), True)
        check("...and staleness never overrides n/a (a sub-plan still never touches main)",
              integration_needed({"integration": {"status": INTEGRATION_NA, "onto_tip": "m0"}},
                                 "abc", "m1"), False)
        _conv = {"label": "z", "order": ["a"], "slices": {"a": _D}}
        check("the sweep kicks a converged plan that has NO integration record",
              "integration record" in (plan_needs_kick(_conv, {}, lambda j: None, None, False) or ""), True)
        check("...but not once ANY record exists (one stage per plan, never a storm)",
              plan_needs_kick(dict(_conv, integration={"status": "failed"}), {},
                              lambda j: None, None, False), None)
        check("a bare identifier that is only imported at baseline becomes its call form",
              refine_call_site_literals(["upsert_schedule"],
                                        "from db import upsert_schedule\n"),
              (["upsert_schedule("], True))
        check("...an identifier already CALLED at baseline is left alone (truly vacuous)",
              refine_call_site_literals(["f"], "from m import f\nf()\n"), (["f"], False))
        check("...a non-identifier literal is left alone",
              refine_call_site_literals(["x = 1"], "x = 1\n"), (["x = 1"], False))
        _vroot = tempfile.mkdtemp(prefix="slice-vac-")
        try:
            Path(os.path.join(_vroot, "t.py")).write_text("from db import upsert_schedule\n")
            _vs = {"must_contain": ["upsert_schedule"]}
            check("the vacuous guard REFINES an import-only literal instead of parking the slice",
                  (vacuous_gate_reason({"target": "t.py"}, _vs, PENDING, _vroot),
                   _vs["must_contain"], _vs.get("_refined_dirty")),
                  (None, ["upsert_schedule("], True))
            _vs2 = {"must_contain": ["upsert_schedule"]}
            Path(os.path.join(_vroot, "t.py")).write_text("from db import upsert_schedule\nupsert_schedule(x)\n")
            check("...and still parks a literal whose call form is ALSO at baseline",
                  vacuous_gate_reason({"target": "t.py"}, _vs2, PENDING, _vroot) is not None, True)
        finally:
            shutil.rmtree(_vroot, ignore_errors=True)
        check("execute() persists a refinement and STOPS at a vacuous slice",
              "_refined_dirty" in inspect.getsource(execute)
              and "dependents of {sid} are BLOCKED until" in inspect.getsource(execute), True)
        check("execute() stages integration when the plan converges",
              "integrate_chain(st" in inspect.getsource(execute)
              and "integration_needed(st" in inspect.getsource(execute), True)
        check("the levers exist and --land-integration is the only writer of main",
              "land_integration(st)" in inspect.getsource(main)
              and "integrate_chain(st)" in inspect.getsource(main)
              and "_ff_land(" not in inspect.getsource(integrate_chain), True)
        check("an identifier USED at baseline (not just imported) is not refined",
              refine_call_site_literals(["g"], "from m import g\nx = g\n"), (["g"], False))

        # End to end against a throwaway repo: stage, then land, then redundant.
        _ir = tempfile.mkdtemp(prefix="slice-integ-")
        try:
            _repo = os.path.join(_ir, "repo")
            os.makedirs(_repo)
            subprocess.run(["git", "init", "-q", "-b", "main", _repo], check=True)
            for k, v_ in (("user.email", "t@t"), ("user.name", "t")):
                subprocess.run(["git", "-C", _repo, "config", k, v_], check=True)
            Path(os.path.join(_repo, "foo.py")).write_text("def f():\n    return 1\n")
            subprocess.run(["git", "-C", _repo, "add", "."], check=True)
            subprocess.run(["git", "-C", _repo, "commit", "-q", "-m", "base"], check=True)
            _cwt = os.path.join(_ir, "chain")
            subprocess.run(["git", "-C", _repo, "worktree", "add", "-q", "-b", "slice/eps", _cwt, "main"],
                           check=True, capture_output=True)
            Path(os.path.join(_cwt, "foo.py")).write_text("def f():\n    return 2\n")
            Path(os.path.join(_cwt, "TASK.md")).write_text("scaffold\n")
            subprocess.run(["git", "-C", _cwt, "add", "."], check=True)
            subprocess.run(["git", "-C", _cwt, "commit", "-q", "-m", "slice s1"], check=True)
            _main0 = git(_repo, "rev-parse", "main", capture=True)
            _est = {"label": "epsilon", "repo": _repo, "target": "foo.py", "lang": "python",
                    "chain_branch": "slice/eps", "chain_worktree": _cwt,
                    "order": ["s1"], "slices": {"s1": {"status": DONE, "title": "t", "depends_on": []}}}
            _status = integrate_chain(_est, _cwt)
            _irec = _est.get("integration") or {}
            check("integrate_chain STAGES a converged chain (status, scope)",
                  (_status, _irec.get("scope")), ("staged", ["foo.py"]))
            check("...main is NOT moved by the stage half",
                  git(_repo, "rev-parse", "main", capture=True), _main0)
            check("...the scratch integrate/* branch exists and sits on main",
                  git(_repo, "rev-parse", f"{_irec.get('integrate_branch')}^", capture=True), _main0)
            check("...and its record names the exact landing command",
                  "merge --ff-only" in land_command(_est), True)
            check("integration_needed is False for the staged tip",
                  integration_needed(_est, git(_cwt, "rev-parse", "HEAD", capture=True)), False)
            _landed = land_integration(_est, pusher=lambda r, d: (None, "no remote"))
            check("--land-integration fast-forwards main to the staged commit",
                  (_landed, git(_repo, "rev-parse", "main", capture=True) != _main0), ("passed", True))
            check("...main now carries the deliverable and NOT the scaffold",
                  ("return 2" in git(_repo, "show", "main:foo.py", capture=True),
                   git(_repo, "cat-file", "-e", "main:TASK.md", check=False).returncode == 0),
                  (True, False))
            check("...the scratch branch is cleaned up after landing",
                  git(_repo, "rev-parse", "--verify", "--quiet",
                      f"refs/heads/{_irec.get('integrate_branch')}", capture=True), "")
            _again = integrate_chain(_est, _cwt)
            check("re-staging a landed chain is REDUNDANT -> passed, nothing written",
                  (_again, (_est["integration"] or {}).get("verdict")), ("passed", "redundant"))
            try:
                land_integration(_est)
                _refused = False
            except SystemExit:
                _refused = True
            check("--land-integration refuses when nothing is staged", _refused, True)

            # --- (2026-09-24) THE BASE MOVED UNDER A STAGE: rt-costco-always-sites ----
            # Reproduces the live near-miss end to end. A chain stages clean; THEN an
            # unrelated chain lands on main (rt-bfmr-pending-sync-scope did, at
            # 00:23:51Z, after rt-costco staged at 22:41:15Z). The stale scratch branch
            # now DELETES the files main gained, yet the record still said clean and the
            # escalation panel still said "ready to land".
            # NOTE (worth knowing, and NOT what this test is about): landing via
            # commit-tree means the chain branch never becomes an ancestor of main, so
            # merge-base(main, chain) stays at the ORIGINAL fork point forever. A second
            # slice touching the SAME already-landed file therefore classifies as
            # conflict-semantic on a fresh run too (base=v1, main=v2-landed,
            # chain=v3) -- `redundant` is decided by file CONTENT, not ancestry. That is
            # a classifier-semantics question, separate from staleness; this fixture uses
            # a NEW file so it exercises the base-moved bug and nothing else.
            Path(os.path.join(_cwt, "bar.py")).write_text("def g():\n    return 9\n")
            git(_cwt, "add", "bar.py", capture=True)
            git(_cwt, "commit", "-q", "-m", "slice s2", capture=True)
            _tipA = git(_cwt, "rev-parse", "HEAD", capture=True)
            check("a new chain commit stages clean again", integrate_chain(_est, _cwt), "staged")
            _recA = _est["integration"]
            _brA = _recA["integrate_branch"]
            _mainA = git(_repo, "rev-parse", "main", capture=True)
            check("...and the record CAPTURES the base + tip it was judged against "
                  "(the panel's `base commit compared against: none` was an unwritten key)",
                  (bool(_recA.get("base_rev")), _recA.get("onto_tip") == _mainA,
                   _recA.get("verified_onto_tip") == _mainA),
                  (True, True, True))
            check("...a freshly staged record is landable right now",
                  base_divergence(_repo, "main", _brA, _recA.get("onto_tip")), None)
            check("...and the sweep does not re-fire it",
                  integration_needed(_est, _tipA, current_onto_tip(_est)), False)
            # main moves on underneath the stage.
            Path(os.path.join(_repo, "bfmrSyncScope.ts")).write_text("export const scope = 1\n")
            git(_repo, "add", "bfmrSyncScope.ts", capture=True)
            git(_repo, "commit", "-q", "-m", "unrelated chain lands on main", capture=True)
            _mainB = git(_repo, "rev-parse", "main", capture=True)
            _anc1 = subprocess.run(["git", "-C", _repo, "merge-base", "--is-ancestor",
                                    "main", _brA], capture_output=True).returncode
            _anc2 = subprocess.run(["git", "-C", _repo, "merge-base", "--is-ancestor",
                                    _brA, "main"], capture_output=True).returncode
            check("main and the stage have genuinely DIVERGED (neither is an ancestor) "
                  "-- the exact by-hand check that caught rt-costco-always-sites",
                  (_anc1 != 0, _anc2 != 0), (True, True))
            check("...and the stale stage would DELETE what main gained",
                  git(_repo, "diff", "--name-only", "--diff-filter=D",
                      f"main..{_brA}", capture=True), "bfmrSyncScope.ts")
            _whyA = base_divergence(_repo, "main", _brA, _recA.get("onto_tip"))
            check("the diverged stage is reported NOT landable, naming what it would delete",
                  (_whyA is not None, "MOVED ON" in (_whyA or ""),
                   "bfmrSyncScope.ts" in (_whyA or "")), (True, True, True))
            check("the sweep now re-fires the staged record (main moved, chain tip did not)",
                  integration_needed(_est, _tipA, current_onto_tip(_est)), True)
            try:
                land_integration(_est, pusher=lambda r, d: (None, "no remote"))
                _refA = False
            except SystemExit:
                _refA = True
            check("--land-integration REFUSES a stage whose base moved, and records `stale` "
                  "(never 'clean, ready to land')",
                  (_refA, (_est["integration"] or {}).get("status")), (True, INTEGRATION_STALE))
            check("...and main is untouched by the refusal",
                  git(_repo, "rev-parse", "main", capture=True), _mainB)
            check("a `stale` record re-stages on the next sweep",
                  integration_needed(_est, _tipA, current_onto_tip(_est)), True)
            # Re-staging against the CURRENT tip is what makes it landable again.
            check("re-staging rebuilds the stage on the tip that exists now",
                  integrate_chain(_est, _cwt), "staged")
            _recB = _est["integration"]
            check("...the rebuilt stage no longer deletes main's newer work",
                  git(_repo, "diff", "--name-only", "--diff-filter=D",
                      f"main..{_recB['integrate_branch']}", capture=True), "")
            check("...and it is landable against current main",
                  base_divergence(_repo, "main", _recB["integrate_branch"],
                                  _recB.get("onto_tip")), None)
            _landB = land_integration(_est, pusher=lambda r, d: (None, "no remote"))
            check("...so the re-staged chain lands, KEEPING the work main gained meanwhile",
                  (_landB, "return 9" in git(_repo, "show", "main:bar.py", capture=True),
                   git(_repo, "cat-file", "-e", "main:bfmrSyncScope.ts",
                       check=False).returncode), ("passed", True, 0))

            # --- (2026-09-24) THE STALE-BASE FALSE CONFLICT: the 11 bg-*/scheduler ----
            # The chain's content is now ON main (landed just above), but the plan still
            # carries a conflict verdict computed against the OLD tip. That is the shape
            # of all eleven 22:41:15Z records: re-announced every sweep as a live
            # semantic conflict against a main that no longer existed. The fix is not a
            # better conflict classifier -- it is re-computing instead of replaying.
            _cached = {"status": "failed", "verdict": "conflict-semantic", "onto": "main",
                       "onto_tip": _mainA, "base_rev": _mainA, "chain_tip": _tipA,
                       "scope": ["foo.py"], "failed_stages": ["classify:conflict-semantic"],
                       "summary": "verdict conflict-semantic: MERGE BY HAND"}
            _est["integration"] = dict(_cached)
            check("a cached conflict verdict IS re-checked once main has moved",
                  integration_needed(_est, _tipA, current_onto_tip(_est)), True)
            check("...and re-running the stage half returns REDUNDANT, retiring the "
                  "escalation instead of replaying it forever",
                  (integrate_chain(_est, _cwt), (_est["integration"] or {}).get("verdict")),
                  ("passed", "redundant"))
            check("...after which no later movement of main can re-fire it",
                  integration_needed(_est, _tipA, "0" * 40), False)
            check("a cached conflict whose main has NOT moved still stays announced "
                  "(no retry storm)",
                  integration_needed({"integration": dict(_cached, onto_tip=_mainB)},
                                     _tipA, _mainB), False)

            # --- (2026-09-25) A NON-STAGING VERDICT ALSO RETIRES THE OLD STAGE --------
            # Retiring rt-costco-always-sites re-classified it `redundant`, which returns
            # before the stage step -- so its scratch branch survived while the new record
            # no longer named it: an ORPHAN that nothing would ever clean up and that
            # still deleted four live files if merged. A fresh verdict voids the previous
            # stage whatever the verdict is.
            # main's tip NOW (it advanced when the re-staged chain landed above).
            _mainC = git(_repo, "rev-parse", "main", capture=True)
            git(_repo, "branch", "integrate/p-orphan", _mainC, capture=True)
            _est["integration"] = dict(_cached, integrate_branch="integrate/p-orphan")
            check("a stale stage exists before the re-classify",
                  bool(git(_repo, "rev-parse", "--verify", "--quiet",
                           "refs/heads/integrate/p-orphan", capture=True)), True)
            check("re-classifying to REDUNDANT still retires the previous stage",
                  (integrate_chain(_est, _cwt),
                   git(_repo, "rev-parse", "--verify", "--quiet",
                       "refs/heads/integrate/p-orphan", capture=True)), ("passed", ""))
            check("...and it says so in the record",
                  "retired" in str((_est["integration"] or {}).get("retired_stage") or ""), True)
            # A branch we did NOT record, and one checked out elsewhere, stay untouched.
            git(_repo, "branch", "integrate/not-ours", _mainC, capture=True)
            _est["integration"] = dict(_cached, integrate_branch=None)
            integrate_chain(_est, _cwt)
            check("a scratch branch NO record names is never touched",
                  bool(git(_repo, "rev-parse", "--verify", "--quiet",
                           "refs/heads/integrate/not-ours", capture=True)), True)
            check("...and a non-integrate/* branch is refused outright",
                  _retire_stale_stage(_repo, {"integrate_branch": "main"}, "main"), None)
            check("...and main itself survived every one of those re-classifies",
                  git(_repo, "rev-parse", "main", capture=True), _mainC)

            # a sub-plan never stages against main
            _sub = dict(_est, repo=os.path.join(WT_ROOT, "wt-slice-parent-chain"), label="epsilon-s1")
            check("a sub-plan records n/a and touches nothing",
                  integrate_chain(_sub, _cwt), INTEGRATION_NA)
            for _lbl in ("epsilon", "epsilon-s1"):
                try:
                    os.unlink(state_path(_lbl))
                except OSError:
                    pass
        finally:
            subprocess.run(["git", "-C", _repo, "worktree", "remove", "--force", _cwt],
                           capture_output=True)
            shutil.rmtree(_ir, ignore_errors=True)
    finally:
        shutil.rmtree(STATE_ROOT, ignore_errors=True)
        STATE_ROOT = _saved

    # --- gate-verdict-aware landing (2026-09-23) ---------------------------------
    # Queue `done` + gate `fail` used to land on the chain (13 of 124 gated slice
    # coding jobs). The poll now routes on the gate's verdict.
    for _v in GATE_ESCALATE_VERDICTS:
        check(f"a gate {_v!r} on a queue-done coding job ESCALATES, never lands",
              coding_land_route(_v, 0), "escalate")
    check("a gate PASS lands", coding_land_route("pass", 0), "land")
    check("a gate 'skipped' lands (the empty-deliverable guard then decides)",
          coding_land_route("skipped", 0), "land")
    check("a gate 'concerns' (input/scope only, no code-high) lands with the verdict "
          "recorded", coding_land_route("concerns", 0), "land")
    check("no verdict yet -> WAIT for the gate", coding_land_route(None, 60), "wait")
    check("pass-pending-review is intermediate -> WAIT",
          coding_land_route("pass-pending-review", 60), "wait")
    check("a pending finding check is intermediate -> WAIT",
          coding_land_route("pending-finding-check", 60), "wait")
    check("a finding check that never reports ESCALATES (never lands on the live verify)",
          coding_land_route("pending-finding-check", GATE_VERDICT_WAIT_S), "escalate")
    check("an untimeable finding check escalates too",
          coding_land_route("pending-finding-check", None), "escalate")
    check("...but not forever: past the wait cap the live verify alone decides",
          coding_land_route(None, GATE_VERDICT_WAIT_S), "land")
    check("no sidecar to time the wait from -> land (cannot wait on nothing)",
          coding_land_route(None, None), "land")
    check("verdict case/whitespace is normalised", coding_land_route(" FAIL ", 0), "escalate")
    _grec = {"verdict": "fail", "counts": {"code_high": 1}, "review_verdict": "REAL_DEFECT",
             "issues": [{"severity": "high", "category": "code", "file": "x.py",
                         "line": 12, "what": "drops the None guard"},
                        {"severity": "high", "category": "input", "file": "", "line": 0,
                         "what": "dirty tree"}]}
    _er = gate_escalation_reason(_grec, "abc123def456", "s4")
    check("the escalation reason names the verdict, the CODE finding and the lever",
          all(t in _er for t in ("'fail'", "x.py:12", "drops the None guard",
                                 "--accept-slice s4", "abc123def456.gate.json")), True)
    check("...and does not list an INPUT finding as a code finding", "dirty tree" in _er, False)
    global LOG_DIR
    _saved_log = LOG_DIR
    try:
        LOG_DIR = tempfile.mkdtemp(prefix="slice-selftest-logs-")
        check("no gate record -> None", gate_record("nope"), None)
        Path(LOG_DIR, "j1.gate.json").write_text(json.dumps({"verdict": "concerns"}))
        check("gate_record reads the live record", (gate_record("j1") or {}).get("verdict"), "concerns")
        os.makedirs(os.path.join(LOG_DIR, "archive"))
        Path(LOG_DIR, "archive", "j2.gate.json").write_text(json.dumps({"verdict": "pass"}))
        check("...and falls back to archive/", (gate_record("j2") or {}).get("verdict"), "pass")
        Path(LOG_DIR, "j1.gate.json").write_text("{torn")
        check("a torn gate record reads as 'no verdict', never raises", gate_record("j1"), None)
        check("no done sidecar -> None (nothing to time from)", done_sidecar_age_s("j1"), None)
        Path(LOG_DIR, "j1.done.json").write_text("{}")
        _age = done_sidecar_age_s("j1", now=os.path.getmtime(os.path.join(LOG_DIR, "j1.done.json")) + 90)
        check("done_sidecar_age_s measures from the sidecar's mtime", int(_age or -1), 90)
    finally:
        shutil.rmtree(LOG_DIR, ignore_errors=True)
        LOG_DIR = _saved_log
    _esrc2 = inspect.getsource(execute)
    _enq = _esrc2.index("if status == ENQUEUED:")
    check("the ENQUEUED poll routes on the GATE verdict, not on queue 'done' alone",
          _esrc2.find("coding_land_route(", _enq) > 0, True)
    check("...and lands through the LIVE-verify core (_land_green_slice), never a "
          "bare stage+commit", _esrc2.find("_land_green_slice(", _enq) > 0
          and _esrc2.find("_stage_deliverable(", _enq) == -1, True)
    check("...and a gate FAIL stamps ESCALATED (halting the chain) not FAILED "
          "(which would re-author correct-but-flagged code)",
          "s[\"status\"] = ESCALATED" in _esrc2[_enq:], True)
    check("reconcile leaves a gate-escalated slice alone on a queue 'done'",
          "s.get(\"gate_verdict\")" in inspect.getsource(reconcile), True)

    # --- harvest-before-author (2026-09-23, Fable pass 3) -------------------------
    # A green, gate-PASSED later slice must land BEFORE the serial walk authors an
    # earlier one (live: pending-sync-scope s2 behind s1, aw-sched-runner s26 behind s23).
    _hst = {"label": "h", "target": "lib/x.ts", "order": ["s1", "s2", "s3", "s4", "s5"],
            "slices": {
                "s1": {"status": PENDING, "depends_on": [], "title": "one"},
                "s2": {"status": ENQUEUED, "job_id": "jdone", "depends_on": [], "title": "two"},
                "s3": {"status": ENQUEUED, "job_id": "jrun", "depends_on": [], "title": "three"},
                "s4": {"status": ENQUEUED, "job_id": "jfail", "depends_on": [], "title": "four"},
                "s5": {"status": ENQUEUED, "job_id": "jwait", "depends_on": [], "title": "five"},
            }}
    _landed_calls = []
    def _js(j): return {"jdone": "done", "jrun": "running", "jfail": "done", "jwait": "done"}[j]
    def _gr(j): return {"jdone": {"verdict": "pass"}, "jfail": {"verdict": "fail"}}.get(j)
    def _land(st_, sid, s, cwt, require_relevance=True):
        _landed_calls.append((sid, require_relevance)); s["status"] = DONE; return (True, "abcdef12")
    _got = harvest_ready_slices(_hst, "/nonexistent-cwt", job_status_fn=_js, gate_record_fn=_gr,
                                age_fn=lambda j: 10.0, land_fn=_land, save_fn=lambda st_: None)
    check("harvest lands the queue-done + gate-pass slice even though an EARLIER slice "
          "is still PENDING", _got, ["s2"])
    check("...through the relevance-guarded landing core", _landed_calls, [("s2", True)])
    check("...and stamps it DONE with the gate verdict recorded",
          (_hst["slices"]["s2"]["status"], _hst["slices"]["s2"].get("gate_verdict")), (DONE, "pass"))
    check("a still-running job is left alone", _hst["slices"]["s3"]["status"], ENQUEUED)
    check("a gate-FAILED job is left for the serial walk to ESCALATE (harvest never "
          "escalates)", _hst["slices"]["s4"]["status"], ENQUEUED)
    check("a done job with no gate verdict yet is left to WAIT", _hst["slices"]["s5"]["status"], ENQUEUED)
    check("a PENDING slice is never touched by the harvest", _hst["slices"]["s1"]["status"], PENDING)
    _hst["slices"]["s5"]["status"] = ENQUEUED
    _got2 = harvest_ready_slices(_hst, "/nonexistent-cwt", job_status_fn=_js, gate_record_fn=_gr,
                                 age_fn=lambda j: GATE_VERDICT_WAIT_S, land_fn=_land, save_fn=lambda st_: None)
    check("...but past the gate-wait cap the live verify alone decides (lands)", _got2, ["s5"])
    def _land_red(st_, sid, s, cwt, require_relevance=True): return (False, "verify.sh did NOT confirm (rc=1)")
    _hst["slices"]["s2"] = {"status": ENQUEUED, "job_id": "jdone", "depends_on": [], "title": "two"}
    _got3 = harvest_ready_slices(_hst, "/nonexistent-cwt", job_status_fn=_js, gate_record_fn=_gr,
                                 age_fn=lambda j: 10.0, land_fn=_land_red, save_fn=lambda st_: None)
    check("a harvest whose live verify is red stamps FAILED with the reason, lands nothing",
          (_got3, _hst["slices"]["s2"]["status"], "verify.sh" in _hst["slices"]["s2"].get("failure_reason", "")),
          ([], FAILED, True))
    _esrc_h = inspect.getsource(execute)
    check("execute() harvests BEFORE its serial walk authors anything",
          0 < _esrc_h.index("harvest_ready_slices(st, cwt)") < _esrc_h.index("for sid in st[\"order\"]:"), True)

    # --- queue-status -> slice-status mapping (unchanged contract) -------------
    check("a queue 'done' keeps the slice in ENQUEUED so the poll commits it",
          _QUEUE_TO_SLICE["done"], ENQUEUED)
    check("a queue 'failed' fails the slice", _QUEUE_TO_SLICE["failed"], FAILED)

    # --- Bug #12: an ESCALATED slice must HALT the chain, never be stepped over ---
    # Live regression (2026-09-18): ESCALATED had no branch in execute(), so the loop
    # fell through it and auto-authored the NEXT slice against a chain tip missing the
    # escalated slice's fix. Pin both halves: the predicate, and the branch's presence.
    # 2026-09-27 (the owner): an ESCALATED slice IS stepped over -- its dependents are held
    # by any_dep_failed (BLOCKED, cascading) exactly like a FAILED slice's, so only a
    # slice that does not depend on it proceeds. The bundle keeps working while
    # anything in it can run.
    check("an ESCALATED slice is stepped over (dependents held by any_dep_failed)",
          chain_may_pass(ESCALATED), True)
    check("any_dep_failed holds a dependent of an ESCALATED slice",
          any_dep_failed({"slices": {"a": {"status": ESCALATED, "depends_on": []},
                                     "b": {"status": PENDING, "depends_on": ["a"]}}}, "b"),
          True)
    check("a DONE slice is stepped over (it already landed)",
          chain_may_pass(DONE), True)
    check("a FAILED slice is still stepped over (dependents held by any_dep_failed)",
          chain_may_pass(FAILED), True)
    for _st in (PENDING, AWAITING_REVIEW, CONFIRMED, ENQUEUED, BLOCKED):
        check(f"an in-motion {_st} slice is NOT stepped over", chain_may_pass(_st), False)
    check("chain_may_pass rejects an unknown//future status by default",
          chain_may_pass("some-status-added-later"), False)
    _src = inspect.getsource(execute)
    check("execute() has an explicit ESCALATED branch (not a silent fall-through)",
          "if status == ESCALATED:" in _src, True)
    check("execute() names every recovery command for an ESCALATED slice",
          all(c in _src for c in ("--accept-slice", "--regate", "--retry-slice")), True)
    check("execute() guards the bottom of the loop with chain_may_pass",
          "if not chain_may_pass(status):" in _src, True)

    # --- Retry-storm guard (2026-09-19): bg-actions-s1-item s4 authored 9x ---------
    # The failure signature is the gate, not a bare attempt cap: a DIFFERENT failure
    # means the loop is still moving and must NOT be cut off.
    check("escalation threshold is 2 identical failures (matches loop-detect / "
          "reasoning-freeze convention, ~45-80min per attempt)",
          MAX_IDENTICAL_AUTHOR_FAILURES, 2)
    _s = {}
    check("first recorded authoring failure -> streak 1 (no escalation yet)",
          note_author_failure(_s, "/nonexistent-wt-a")[0], 1)
    check("same signature again -> streak 2 (escalates)",
          note_author_failure(_s, "/nonexistent-wt-a")[0], 2)
    check("attempts accumulate independently of the streak", _s["author_attempts"], 2)
    # TWO BUDGETS, NOT ONE. The streak resets whenever the failure REASON changes,
    # so on its own it can never stop a slice that fails differently every time.
    _alt = {"author_attempts": 0}
    _real_sig = globals()["author_failure_signature"]
    globals()["author_failure_signature"] = lambda wt: "FAIL: distinct reason %s" % wt
    try:
        _streaks = [note_author_failure(_alt, "wt-%d" % i)[0] for i in range(6)]
    finally:
        globals()["author_failure_signature"] = _real_sig
    check("a slice failing for a DIFFERENT reason each time never builds a streak",
          max(_streaks) < MAX_IDENTICAL_AUTHOR_FAILURES, True)
    check("...but the total-attempts budget still stops it",
          _alt["author_attempts"] >= MAX_AUTHOR_ATTEMPTS, True)
    # The retry-storm guard was EXTRACTED from execute() into
    # bound_stale_worktree_retry (2026-09-20) so the FAILED auto-heal shares the same
    # budget. These checks are about the AUTHORING PATH, which is now both functions:
    # grep them together, or the guard could be deleted from the helper unnoticed.
    _ex = inspect.getsource(execute) + inspect.getsource(bound_stale_worktree_retry)
    check("the authoring path enforces BOTH budgets, not just the streak",
          "attempts >= MAX_AUTHOR_ATTEMPTS" in _ex
          and "streak >= MAX_IDENTICAL_AUTHOR_FAILURES" in _ex, True)
    check("execute() still ROUTES a stale worktree into that guard "
          "(the extraction did not orphan it)",
          "bound_stale_worktree_retry(" in inspect.getsource(execute), True)
    _s2 = {"author_fail_sig": "FAIL: something else entirely", "author_fail_streak": 5,
           "author_attempts": 5}
    check("a DIFFERENT failure signature RESETS the streak (progress is being made)",
          note_author_failure(_s2, "/nonexistent-wt-b")[0], 1)
    clear_author_failures(_s2)
    check("clear_author_failures drops the streak but keeps the attempt tally",
          ("author_fail_streak" not in _s2 and "author_fail_sig" not in _s2
           and _s2["author_attempts"] == 6), True)
    # ---- 2026-09-26 (bfmr s2): a failed AUTO is diagnosed from what it SAID ----
    _refusal_tail = (
        "  $ ollama-dispatch-scaffold --label x\n"
        "!!!!!!!!\n"
        "REFUSING code-fix scaffold: sidecar/src/bfmr.js is BROWSER-AUTOMATION code.\n"
        "  markers found: page.evaluate\n"
        "!!!!!!!!\n"
