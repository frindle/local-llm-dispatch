STATE_ROOT = os.path.expanduser("~/.ollama-dispatch/slice-runs")

PENDING = "pending"
AWAITING_REVIEW = "awaiting_review"
CONFIRMED = "confirmed"
ENQUEUED = "enqueued"
DONE = "done"
FAILED = "failed"
BLOCKED = "blocked"
# ESCALATED: authoring converged but the MECHANICAL relevance gate (preflight)
# could not clear it -- there is no human relevance-review gate any more (the owner,
# 2026-09-18: "no human relevance review gate. there's only a claude gate, and
# even then that should be minimal"). The pipeline auto-confirms whatever the
# mechanical gate passes; the rare case it cannot pass ESCALATES to the Claude
# gate (surfaced in the run-status panel as needs-eyes) rather than PARKING for a
# human. Distinct from FAILED so the reason -- "relevance, not code" -- is legible.
ESCALATED = "escalated"
# SKIPPED (2026-09-19): the slice's property is ALREADY SATISFIED at the chain tip,
# so there is nothing for it to land. Until now this case had no legal representation
# at all -- the only way to record it was to hand-edit the run-state JSON, which is
# exactly the dishonest bypass this pipeline forbids. It is NOT a failure and NOT a
# DONE: nothing was landed, but every dependent may proceed, because the property a
# dependent waits on does hold. Live instance: bg-actions-s1-item s4, whose whole
# intent (email_confirm accepted + the exact six-key return set + status 'open') was
# already true because s1 created the module that way. See the retry-storm comment
# above harness_authored() for why that cost nine dispatches to discover.
SKIPPED = "skipped"
# Statuses that mean "this slice will never land anything more into the chain": the
# chain tip is final for it, so dependents and later slices may proceed.
SATISFIED = (DONE, SKIPPED)


def die(m, code=2):
    print("ERROR:", m, file=sys.stderr)
    sys.exit(code)


def q(s):
    return shlex.quote(str(s))


def run(cmd, **kw):
    print("  $ " + " ".join(q(c) for c in cmd))
    return subprocess.run(cmd, **kw)


def run_tee(cmd, keep=200):
    """run(), but ALSO keep the last `keep` lines of the child's combined output
    (returned as cp.tail) while still streaming every line live to our stdout --
    the advance log stays exactly as readable as before. Exists so a failed AUTO
    can be DIAGNOSED from what it actually said (auto_failure_reason) instead of
    from whatever stub files it happened to leave behind."""
    import collections
    print("  $ " + " ".join(q(c) for c in cmd))
    sys.stdout.flush()
    tail = collections.deque(maxlen=keep)
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, errors="replace", bufsize=1)
    for line in proc.stdout:
        sys.stdout.write(line)
        tail.append(line.rstrip("\n"))
    proc.wait()
    sys.stdout.flush()
    return subprocess.CompletedProcess(cmd, proc.returncode, stdout="\n".join(tail))


# WHY a failed AUTO failed, from its own output (2026-09-26, bfmr s2). The slicer used
# to derive the reason ONLY from the worktree (author_failure_signature). When AUTO
# died before the worktree existed -- the scaffold refused the target -- that read
# "unauthored -> TASK.md:missing, test_fixture.py:missing, refimpl.py:missing": true
# of the files, silent about the cause. The escalation then named a stub problem, the
# real refusal text never reached the slice state, and because the signature needed
# two identical sightings the same refusal was relaunched once more for nothing.
#
# A DETERMINISTIC failure is one a relaunch with the same inputs cannot get past: the
# scaffold refusing/erroring (AUTO's `ERROR: scaffold failed (rc=N)`), an argparse
# usage error, or an AUTO crash (Python traceback). Those escalate on FIRST sight.
_AUTO_DETERMINISTIC = (
    re.compile(r"^ERROR: scaffold failed \(rc=\d+\)"),
    re.compile(r"^(?:usage: .*|\S+: error: .*)$"),
    re.compile(r"^Traceback \(most recent call last\):"),
    # AUTO stopped its own continuation ladder: a majority of the harness's cases fail with
    # its OWN refimpl, identically across two self-checks (2026-10-06). Another launch cannot
    # change the shared cause, so escalate on first sight with the failing cases.
    re.compile(r"^ERROR: PLAN SUSPECT: "),
    # PRE-DISPATCH CONTRADICTION GATE (auto die()s before any authoring job): the SPEC
    # contradicts the base tree; an identical relaunch cannot change that.
    re.compile(r"^ERROR: SPEC_DEFECT: "),
)
_AUTO_REASON_LINE = re.compile(
    r"^(?:ERROR: .*|REFUSING .*|\S+: error: .*|\w*(?:Error|Exception): .*|"
    r"\s*FAIL: .*|\s*HARNESS ERROR: .*|\[auto\] (?:NO PROGRESS|hit the round cap).*)$")


_REVIEW_NOTES_HEADER = "NOTES FROM THE REVIEW OF A PREVIOUS FAILED ATTEMPT"


def _drop_echoed_review_notes(lines):
    """PURE. AUTO echoes its intent, and a retried slice's intent carries the review
    notes of the PREVIOUS failure (authoring_intent) -- which quote that failure's
    error lines verbatim. Parsing them as THIS run's output re-escalated Rivian s5
    "DETERMINISTICALLY" on a stale `scaffold: error: --symbol is required` after the
    retry had in fact scaffolded fine and failed on something else (2026-10-02).
    Drop the block from the header up to AUTO's next `[auto]` line."""
    out, skipping = [], False
    for ln in lines:
        t = ln.strip()
        if t.startswith(_REVIEW_NOTES_HEADER):
            skipping = True
            continue
        if skipping and t.startswith("[auto]"):
            skipping = False
        if not skipping:
            out.append(ln)
    return out


def auto_failure_reason(tail):
    """PURE. (reason, deterministic) from a failed AUTO's output tail, or
    (None, False) when it said nothing recognisable. `reason` joins the most
    specific lines (e.g. the scaffold's own REFUSING line + AUTO's ERROR line),
    capped so it stays a one-screen escalation reason."""
    lines = _drop_echoed_review_notes(
        [ln.rstrip() for ln in (tail or "").splitlines() if ln.strip()])
    deterministic = any(p.match(ln.strip()) for ln in lines
                        for p in _AUTO_DETERMINISTIC)
    picked = []
    for ln in lines:
        t = ln.strip()
        if _AUTO_REASON_LINE.match(t) and t not in picked:
            picked.append(t)
    if not picked:
        return None, deterministic
    # the LAST few are the terminal cause; the first REFUSING/error line (if any) is
    # the scaffold's own explanation and must survive the cap.
    head = [p for p in picked if p.startswith("REFUSING") or ": error:" in p][:1]
    keep = head + [p for p in picked[-3:] if p not in head]
    return " | ".join(keep)[:600], deterministic


# Pipeline commits on chain/dispatch branches run with hooks OFF: the machine's
# post-commit hook auto-pushes the CURRENT branch, which published dispatch/* and
# slice/* branches (harness, fixtures, refimpl) to PUBLIC repos (2026-10-02).
# Landing pushes the default branch explicitly (_push_branch), never via the hook.
CHAIN_COMMIT_GIT = ["git", "-c", "core.hooksPath=/dev/null"]


def git(repo, *args, check=True, capture=False):
    cmd = ["git", "-C", repo, *args]
    if capture:
        return subprocess.run(cmd, capture_output=True, text=True).stdout.strip()
    return subprocess.run(cmd, check=check)


# --- Authoring retry-storm guard (the owner 2026-09-19) -----------------------------
# Live failure: slice s4-email-confirm-return-key of bg-actions-s1-item was
# auto-author-dispatched NINE TIMES with byte-identical results -- ~45-80 min of GPU
# each, every one ending on the same `auto-harness-check.py` line
# ("FAIL: TASK.md still has TODO placeholders"), every one leaving refimpl.py /
# test_fixture.py / TASK.md as pristine scaffold stubs. The owner caught it by hand:
# "why am I having to manually catch this when you were supposed to be watching it."
#
# Why nothing stopped it. The slice never reached a terminal status at all. Two
# branches below conspire: AUTO's non-zero rc is only stamped FAILED when NO
# authoring job is live, and heal_status_for_live_job resets FAILED -> PENDING the
# moment a fresh dispatch appears. So the record sat at PENDING; the next --execute
# saw PENDING + harness_authored()==False, hit "clearing stale worktree before
# authoring", wiped the evidence and re-ran AUTO. Nothing counted attempts, and
# because the slice was never FAILED or ESCALATED it never surfaced in needs-eyes
# either -- an invisible, unbounded loop.
#
# The guard is deliberately NOT a bare attempt cap. A cap alone would also cut off a
# slice that is genuinely converging over rounds. What makes a retry pointless is
# that it fails for the IDENTICAL reason, so the signature is the actual gate: a
# DIFFERENT failure line means progress and RESETS the counter, and only repeats of
# the same line accumulate toward the escalation.
#
# (The underlying s4 defect was different again and is worth recording: the slice was
# already satisfied at the chain tip -- s1 had created the module with email_confirm
# and exactly the required key set. The harness contract is a both-ways proof, RED at
# baseline and GREEN only after refimpl.py, and an honest fixture for an
# already-satisfied property is GREEN at baseline, so no refimpl could ever exist. The
# task was unsatisfiable, not badly authored. That case has its own resolution now --
# see skip_slice / SKIPPED below.)
MAX_IDENTICAL_AUTHOR_FAILURES = 2  # identical recorded failures before escalating
                                   # (i.e. the THIRD launch is refused, not taken)

# The SECOND, independent budget (2026-09-19). These two are deliberately not one
# counter, and the difference is not cosmetic:
#
#   author_fail_streak  -- CONSECUTIVE failures with the IDENTICAL signature. It
#                          resets to 1 the moment the failure reason changes,
#                          because a loop that is producing new errors is still
#                          moving and deserves another go.
#   author_attempts     -- TOTAL authoring launches for this slice, ever. It never
#                          resets.
#
# The streak alone is not sufficient, and its own reset rule is why: a slice that
# fails for a DIFFERENT reason every time keeps resetting the streak to 1 and can
# never escalate, no matter how many dispatches it burns. Nothing in the current
# data exhibits that (the one 8-attempt storm on record repeated a single identical
# signature, which the streak catches) -- but that is an argument about today's
# sample, not about the mechanism, and the counter was already being recorded here
# with nothing enforcing it. Five is drawn from the observed shape: a converging
# slice authors inside ONE launch (AUTO gets --max-rounds 4 internally), and the
# storms on record ran to 8 and 11.
MAX_AUTHOR_ATTEMPTS = 5

# VERIFY-SANDBOX (2026-10-05): env for every verify.sh this slicer runs itself --
# code under test must never reach the REAL queue (ollama-queue.py refuses any
# mutating subcommand when DISPATCH_VERIFY_SANDBOX is set). See ollama-queue.py.
_SANDBOX_ENV = {**os.environ, "DISPATCH_VERIFY_SANDBOX": "1"}


_WT_LOCKS_HELD = set()


def _lane_stage(wt, cmd, timeout, stage, local_fn, bundle=None):
    """Run one WHOLE CPU stage (cmd, a shell string) in `wt` through the CPU lane (cpu_stage.run_stage):
    the Unraid runner when it can faithfully run there, else EXACTLY `local_fn()` -- the stage's own old
    code, returning (rc, stdout, stderr, timed_out). Callers keep their worktree tree lock. Never raises
    for lane reasons."""
    try:
        if str(Path(__file__).resolve().parent) not in sys.path:
            sys.path.insert(0, str(Path(__file__).resolve().parent))
        import cpu_stage as _cs
    except Exception:
        return local_fn()
    r = _cs.run_stage(wt, cmd, timeout, stage, bundle or _cs.bundle_key(wt=wt), local_fn,
                      env={"DISPATCH_VERIFY_SANDBOX": "1"})  # VERIFY-SANDBOX (lane path; local_fn carries its own)
    return r.exit_code, r.stdout, r.stderr, r.timed_out


def _verify_sh_lane(wt, stage):
    """subprocess.run(["bash","verify.sh"], cwd=wt, ..., env=_SANDBOX_ENV) -> CompletedProcess, via the lane."""
    def _local():
        vp = subprocess.run(["bash", "verify.sh"], cwd=wt, capture_output=True, text=True,
                            env=_SANDBOX_ENV)  # VERIFY-SANDBOX
        return vp.returncode, vp.stdout or "", vp.stderr or "", False
    rc, so, se, to = _lane_stage(wt, "bash verify.sh", 900, stage, _local)
    return subprocess.CompletedProcess(["bash", "verify.sh"], 124 if to else rc, so, se)


class _wt_tree_lock:
    """`with _wt_tree_lock(wt):` -- exclusive flock on <git-dir of wt>/dispatch-tree.lock
    (shared with auto's self-check, the gate's relevance step, the queue launch and
    preflight), polled up to `wait` s, then proceeds anyway (fail-open, same contract as
    the other holders). Never raises on lock trouble."""

    def __init__(self, wt, wait=1200):
        self.wt, self.wait, self.fh, self.lp, self.nested = wt, wait, None, None, False

    def __enter__(self):
        import fcntl
        try:
            g = subprocess.run(["git", "-C", str(self.wt), "rev-parse",
                                "--absolute-git-dir"], capture_output=True, text=True,
                               timeout=15).stdout.strip()
            if not g:
                return False
            self.lp = str(Path(g) / "dispatch-tree.lock")
            if self.lp in _WT_LOCKS_HELD:           # re-entrant within this process:
                self.nested = True                  # a second open+flock would block
                return True                         # on our own lock
            self.fh = open(self.lp, "a+")
        except Exception:
            self.fh = None
            return False
        end = time.time() + self.wait
        while True:
            try:
                fcntl.flock(self.fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                _WT_LOCKS_HELD.add(self.lp)
                # children (preflight) see that their parent holds it -> no wait
                self.prev_env = os.environ.get("OLLAMA_DISPATCH_TREE_LOCK_HELD")
                os.environ["OLLAMA_DISPATCH_TREE_LOCK_HELD"] = self.lp
                return True
            except OSError:
                if time.time() >= end:
                    return False
                time.sleep(1)

    def __exit__(self, *exc):
        if self.fh is not None:
            _WT_LOCKS_HELD.discard(self.lp)
            if getattr(self, "prev_env", None) is None:
                os.environ.pop("OLLAMA_DISPATCH_TREE_LOCK_HELD", None)
            else:
                os.environ["OLLAMA_DISPATCH_TREE_LOCK_HELD"] = self.prev_env
            try:
                self.fh.close()
            except OSError:
                pass
        return False


def harness_self_check_fail(wt, timeout=600):
    """None when the worktree's auto-harness-check.py prints VERIFY_OK (exit 0), else
    a one-line reason. Used by the PENDING resume (2026-10-06): harness_authored() is
    a file-presence test, so a harness whose authoring round was INTERRUPTED (driver
    killed mid-author, canary soak seed 2) looked "already authored", was preflighted,
    failed refimpl-tests and was ESCALATED -- instead of continuing its authoring."""
    if not (Path(wt) / "auto-harness-check.py").is_file():
        return "no auto-harness-check.py"
    # The check rewrites the target and restores it: hold the worktree tree lock
    # (<git-dir>/dispatch-tree.lock, shared with auto's self-check, the gate and the
    # queue launch) so it never interleaves with them. Not taken in 1200s -> run anyway.
    import fcntl
    lk = None
    try:
        g = subprocess.run(["git", "-C", str(wt), "rev-parse", "--absolute-git-dir"],
                           capture_output=True, text=True, timeout=15).stdout.strip()
        if g:
            lk = open(Path(g) / "dispatch-tree.lock", "a+")
            end = time.time() + 1200
            while True:
                try:
                    fcntl.flock(lk.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except OSError:
                    if time.time() >= end:
                        break
                    time.sleep(2)
    except Exception:
        lk = None
    try:
        _rc, _so, _se, _to = _lane_stage(
            wt, "python3 auto-harness-check.py", timeout, "harness-check",
            lambda: _pgrun().run_group(["python3", "auto-harness-check.py"], cwd=wt, timeout=timeout,
                                       shell=False))
    except Exception as e:
        return f"auto-harness-check could not run: {type(e).__name__}"
    finally:
        if lk is not None:
            try:
                lk.close()
            except OSError:
                pass
    if _to:
        return f"auto-harness-check TIMED OUT after {timeout}s"
    out = (_so or "") + (_se or "")
    if _rc == 0 and "VERIFY_OK" in out:
        return None
    for line in out.splitlines():
        if "FAIL" in line:
            return line.strip()[:200]
    return f"auto-harness-check exited {_rc} without VERIFY_OK"


def author_failure_signature(wt):
    """A stable one-line signature of WHY this worktree's authoring did not finish.

    Prefers the scaffold's own self-check, because that is the exact verdict the
    authoring loop is bouncing off -- same string the model saw, so "identical
    failure" means identical to the thing that actually gated it. Falls back to
    naming which scaffold files are still stubs when the check cannot be run."""
    chk = Path(wt) / "auto-harness-check.py"
    if chk.is_file():
        try:
            # Own process group, whole group killed on timeout (pgrun.py): the
            # check's `bash verify.sh` grandchildren survived a plain timeout.
            _rc, _so, _se, _to = _lane_stage(
                wt, "python3 auto-harness-check.py", 120, "harness-check",
                lambda: _pgrun().run_group(["python3", "auto-harness-check.py"], cwd=wt, timeout=120,
                                           shell=False))
            if _to:
                return "auto-harness-check TIMED OUT after 120s (verify hang -- killed)"
            cp = subprocess.CompletedProcess([], _rc, _so, _se)
            for line in (cp.stdout + cp.stderr).splitlines():
                t = line.strip()
                if "FAIL" in t or "SCAFFOLD_INCOMPLETE" in t:
                    return t
            if cp.returncode != 0:
                return f"auto-harness-check exited {cp.returncode} with no FAIL line"
        except Exception as e:
            return f"auto-harness-check could not run: {type(e).__name__}"
    # A COMPLETE harness that still failed is a different animal from an unauthored
    # one, and "unauthored -> (no signal)" would have libelled it as a stub. This
    # branch is reachable only from the FAILED auto-heal below (both older callers
    # reach the fallback exclusively when the harness is NOT complete), and it gives
    # that path a stable, honest signature to count repeats against.
    if harness_authored(wt):
        return ("harness is COMPLETE but the slice reached FAILED with no live job "
                "(the dispatch/land step failed, not the authoring)")
    stubs = []
    fixture = _fixture_path(wt)
    fixture_rel = fixture.name if fixture else "fixture (" + "|".join(FIXTURE_NAMES) + ")"
    for rel, marker in (("TASK.md", "TODO"),
                        (fixture_rel, "THE ONE THING THE GENERATOR CANNOT WRITE"),
                        ("refimpl.py", "TODO -- the exact text to replace")):
        p = Path(wt) / rel
        if not p.is_file():
            stubs.append(f"{rel}:missing")
        elif marker in p.read_text(errors="ignore"):
            stubs.append(f"{rel}:stub")
    return "unauthored -> " + (", ".join(stubs) if stubs else "(no signal)")


def _sig_shape(sig):
    """PURE. A failure signature with its volatile tokens (job ids, hashes, counts,
    timestamps) masked, so the same failure on a new job compares equal."""
    if not sig:
        return None
    # ONLY ids: a hex run of >=8 that contains a digit (job ids, commit hashes) and
    # ISO timestamps. Other numbers are kept -- "3 survivors" -> "2 survivors" is a
    # changed reason (progress), not the same failure.
    t = re.sub(r"\d{4}-\d\d-\d\dt\d\d:\d\d:\d\d(?:\.\d+)?(?:z|[+-]\d\d:?\d\d)?", "<ts>",
               str(sig).lower())
    t = re.sub(r"\b(?=[0-9a-f]*\d)[0-9a-f]{8,}\b", "<id>", t)
    return re.sub(r"\s+", " ", t).strip()


# AUTHOR-JOB BUDGET (2026-10-03, replay-endorse s3: 15 author/refine jobs, the owner caught
# it by hand). MAX_AUTHOR_ATTEMPTS counts SLICER attempts, but one attempt is 1-8
# queue jobs (author, -c1, -c2, -esc, refine -r1..-r4), so 5 attempts allowed ~35
# dispatches. This counts the QUEUE JOBS themselves -- only this slice's
# auto-author-<run>-<sid>[-cN|-esc] and auto-refine-<run>-<sid>-rN rows, never its
# coding job -- accumulated in state (s["author_job_ids"]) so queue pruning cannot
# un-count one. Per-run override: st["author_job_budget"] (set with
# --author-job-budget N). A human --retry-slice starts a fresh budget.
MAX_AUTHOR_JOBS = 8

# THE attempt counter lives in failure_ledger.py (2026-10-06, rt-egift-link-s1-s4: the
# dashboard said "attempt 14", this status said "3/8 jobs" because every human retry resets
# the WINDOW, so nothing ever visibly hit a cap). Lifetime ids come from the never-pruned
# queue sidecars; status text, the budget refusal and the dashboard all use slice_counter.
try:
    sys.path.insert(0, str(Path(__file__).resolve().parent))
    import failure_ledger as _FL
except Exception:                                    # fail-open: the slicer must never need it
    _FL = None


def _author_job_label_re(st, sid):
    run_l = re.escape(str(st["label"]))
    s_l = re.escape(str(sid))
    return re.compile(r"^(?:auto-author-%s-%s(?:-c\d+|-esc)?|auto-refine-%s-%s-r\d+)$"
                      % (run_l, s_l, run_l, s_l))


def queue_rows():
    """[(job_id, status, label)] for EVERY row of the queue status table (unlike
    all_job_statuses' by_label, duplicate labels are all kept)."""
    out = subprocess.run(["python3", QUEUE, "status"], capture_output=True, text=True).stdout
    rows = []
    for line in out.splitlines():
        t = line.lstrip()
        if not t.startswith("["):
            continue
        status = t.split("]")[0].lstrip("[").strip()
        rest = t.split("]", 1)[1].split()
        if len(rest) >= 2:
            rows.append((rest[0], status, rest[1]))
    return rows


def refresh_author_job_ids(st, sid, s=None, rows=None):
    """Union this slice's author/refine job ids seen in the queue into state; returns
    the number counted against the CURRENT budget (since the last human retry)."""
    if s is None:
        s = st["slices"][sid]
    try:
        rows = queue_rows() if rows is None else rows
    except Exception:
        rows = []
    ids = list(s.get("author_job_ids") or [])
    rx = _author_job_label_re(st, sid) if (st or {}).get("label") else None
    for jid, _qs, lbl in (rows if rx else []):
        if rx.match(lbl) and jid not in ids:
            ids.append(jid)
    if _FL is not None and (st or {}).get("label"):      # sidecar history: survives pruning AND state resets
        for jid in _FL.lifetime_job_ids(st["label"], sid):
            if jid not in ids:
                ids.append(jid)
    s["author_job_ids"] = ids
    return len(ids) - int(s.get("author_jobs_at_retry") or 0)


def author_job_budget(st):
    try:
        b = int((st or {}).get("author_job_budget") or 0)
    except (TypeError, ValueError):
        b = 0
    return b if b > 0 else MAX_AUTHOR_JOBS


# HARD LIFETIME CAP (2026-10-05, s3fix). The per-window budget above is reset by
# every --retry-slice -- and dispatch-self-heal.py issues --retry-slice AUTOMATICALLY
# (DISPATCH_SELF_HEAL=1, up to its own MAX_ATTEMPTS), so s3 got three fresh windows
# and burned 25 author/refine jobs. Two rules close that:
#   * an AUTOMATED retry never opens a new window (only a human's does), and
#   * the TOTAL author/refine jobs a slice may ever burn is capped at
#     AUTHOR_JOB_LIFETIME_FACTOR x the budget, whatever reset the window. Raising it
#     is a deliberate human act: --author-job-budget N scales both.
AUTHOR_JOB_LIFETIME_FACTOR = 3


def author_job_lifetime_cap(st):
    return AUTHOR_JOB_LIFETIME_FACTOR * author_job_budget(st)


def author_budget_block(st, sid, s, rows=None):
    """Why another authoring launch for `sid` is refused by the job budget, or None.
    Checks BOTH the current window (since the last HUMAN retry) and the lifetime cap."""
    n_window = (refresh_author_job_ids(st, sid, s) if rows is None
                else refresh_author_job_ids(st, sid, s, rows=rows))
    n_total = len(s.get("author_job_ids") or [])   # refresh_author_job_ids merged the sidecar history in
    budget, cap = author_job_budget(st), author_job_lifetime_cap(st)
    if n_total >= cap:
        return (f"authoring has burned {n_total} author/refine queue jobs for this "
                f"slice in its LIFETIME (hard cap {cap} = {AUTHOR_JOB_LIFETIME_FACTOR} x "
                f"budget {budget}; no retry resets it -- raise it deliberately with "
                f"--author-job-budget N)")
    if n_window >= budget:
        return (f"authoring has burned {n_window} author/refine queue jobs for this "
                f"slice (budget {budget}; override per run with --author-job-budget N)")
    return None


_ESC_KINDS = (  # (regex on escalation_reason, short TRUE label) -- FIRST match wins
    (r"SPEC_DEFECT: already satisfied at base", "spec defect -- already satisfied at base (skip, or restate)"),
    (r"SPEC_DEFECT: ", "spec defect -- spec contradicts the base tree (RE-SPEC the intent)"),
    (r"^HARNESS CONVERGED, PREFLIGHT NO-GO", "converged harness, preflight NO-GO (worktree kept; --regate)"),
    (r"^PIPELINE BUG SUSPECTED", "baseline-green claim disagrees with a re-run (pipeline bug?)"),
    (r"GREEN at the untouched baseline", "verify green at baseline (already satisfied, or leaky fixture)"),
    (r"^PLAN LINT", "plan lint -- header-pair literal / body-shape conflict (fix the plan)"),
    (r"PLAN SUSPECT: ", "plan suspect -- refimpl fails its own verify on most cases (fix plan/refimpl)"),
    (r"^vacuous must_contain gate", "vacuous must_contain -- plan defect (restate literals)"),
    (r"^invariant slice declares NO must_contain", "invariant slice with no must_contain -- plan defect"),
    (r"^authoring failed DETERMINISTICALLY", "deterministic authoring failure"),
    (r"^authoring has burned \d+ author/refine queue jobs", "authoring job budget exhausted"),
    (r"^authoring (made no progress|has now been launched)", "authoring retry budget exhausted"),
    (r"^context-budget gate", "context-budget block"),
    (r"^coding job\(s\) .* VANISHED", "coding job vanished from the queue"),
    (r"^coding job \S+ converged .* gate's verdict", "gate verdict on a green coding job (needs-eyes)"),
    (r"^auto-land of gate-PASSED job", "auto-land refused"),
    (r"^sub-plan .* could NOT be merged", "sub-plan merge-back failed"),
    (r"^preflight cwd-exclusive collision", "preflight cwd collision"),
    (r"^mechanical relevance gate \(preflight\) NO-GO", "relevance NO-GO (preflight)"),
)


def escalation_kind(reason):
    """PURE. A short, TRUE label for an escalation reason (run summary line)."""
    r = str(reason or "")
    for rx, lbl in _ESC_KINDS:
        if re.search(rx, r):
            return lbl
    return (r[:90] + "...") if len(r) > 90 else (r or "(no reason recorded)")


_ROUND_CAP_NOGO = "[auto] hit the round cap without a GO"
_NO_PROGRESS_NOGO = "[auto] NO PROGRESS for"   # preflight-loop early abort, same class


def converged_harness_preflight_nogo(auto_out, wt):
    """PURE-ish. The blockers line when AUTO failed ONLY at preflight (it printed the
    round-cap-without-GO line) on a COMPLETE authored harness, else ''.

    replay-endorse s3 attempt 1 (2026-10-03): authoring converged (c2), preflight
    NO-GO'd 4/4 rounds on one blocker, AUTO exited 1, the slice went FAILED and the
    next advance's auto-retry WIPED the converged harness and re-authored from
    scratch -- 11 more jobs. A converged harness is evidence; it is escalated with
    its worktree kept and resumed with --regate, never silently discarded."""
    out = str(auto_out or "")
    if not (_ROUND_CAP_NOGO in out or _NO_PROGRESS_NOGO in out) or not harness_authored(wt):
        return ""
    blk = re.findall(r"verdict=NO-GO\s+blockers=(\[[^\]]*\])", out)
    return "preflight NO-GO every round, last blockers=%s" % (blk[-1] if blk else "?")


def note_author_failure(s, wt):
    """Record one failed authoring attempt. Returns (n_identical, signature).

    A signature DIFFERENT from the last one resets the count to 1: the loop is
    still moving, and only a loop that is not moving deserves to be cut off.

    AUTO's own failure line (s["last_auto_error"], recorded by execute() from its
    output) wins over the worktree-derived signature: it is the cause, where the
    worktree only shows the symptom (e.g. no harness files because the scaffold
    refused)."""
    sig = s.get("last_auto_error") or author_failure_signature(wt)
    # Compare the SHAPE, not the bytes (2026-10-03, replay-endorse s3): AUTO's line
    # embeds the failing job id ("job 63d688b784e8 failed (exit 1)"), so two
    # identical failures never compared equal and the streak sat at 1 through 11 jobs.
    if _sig_shape(s.get("author_fail_sig")) == _sig_shape(sig):
        s["author_fail_streak"] = int(s.get("author_fail_streak") or 0) + 1
    else:
        s["author_fail_streak"] = 1
    s["author_fail_sig"] = sig
    s["author_attempts"] = int(s.get("author_attempts") or 0) + 1
    return s["author_fail_streak"], sig


RESPEC_CAP = 1   # bounded: one re-spec per slice, then the old ESCALATED park applies


def respec_on_cap(s, sig, streak, attempts):
    """RETRY-STORM -> RE-SPEC (Phase 2, 2026-10-08). The author-attempt cap used to park the
    slice (ESCALATED) no matter why it stalled -- but 'N attempts, same or changing failure'
    is evidence the SPEC is the problem. At the cap, once per slice, fold the observed failure
    into the slice intent as a mandatory pitfall note, zero the attempt counters, and let the
    caller re-author from a clean baseline. Returns True when a re-spec was applied; False when
    the RESPEC_CAP is spent (caller parks). Counts attempts regardless of failure signature
    (the cap trigger is `attempts >= MAX_AUTHOR_ATTEMPTS`, signature-blind)."""
    n = int(s.get("respec_count") or 0)
    if n >= RESPEC_CAP:
        return False
    s["respec_count"] = n + 1
    note = (f"RE-SPEC NOTE (auto, {attempts} prior author attempt(s) failed, last streak "
            f"{streak}): the previous harness attempts ended on: {str(sig)[:300]}. Do NOT repeat "
            f"that; keep TASK.md must_contain literals real and present in the target or "
            f"introduced by refimpl.py, and author >= 3 adversarial cases.")
    if is_spec_defect(sig):
        note += (" The failure was a SPEC_DEFECT: the spec contradicts the BASE tree. Do not "
                 "'create' files that already exist at base (modify/extend them instead) and "
                 "do not demand literals the base already satisfies.")
    s["intent"] = (s.get("intent") or "").rstrip() + "\n\n" + note
    s["respec_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
    s["respec_history"] = (s.get("respec_history") or []) + [{"sig": str(sig)[:300], "attempts": attempts}]
    s["author_attempts"] = 0
    clear_author_failures(s)
    return True


def clear_author_failures(s):
    """Authoring got somewhere -- forget the streak so a later, unrelated stall
    starts from a clean count rather than inheriting an old one."""
    for k in ("author_fail_streak", "author_fail_sig", "last_auto_error"):
        s.pop(k, None)


# Every fixture filename the scaffold emits, by language (ollama-dispatch-auto's
# _FIXTURE_NAME_BY_LANG). Checking only test_fixture.py made every complete JS/TS
# harness read as "unauthored -> test_fixture.py:missing": the slicer re-authored
# it forever and escalated on the identical signature (bfmr s2, 2026-09-26).
FIXTURE_NAMES = ("test_fixture.py", "verify.test.ts", "verify.test.mts",
                 "Tests/verifyTests.swift", "DispatchTests/VerifyImpl.cs")


# Harness files the scaffold writes that are NOT the fixture (so the manifest's
# remaining authored entry is the fixture, whatever --test-file named it).
_NON_FIXTURE_HARNESS = {"TASK.md", "check_literals.py", "refimpl.py", "verify.sh",
                        "fix.patch", "Package.swift", "REPO_MAP.md",
                        # the C# scaffold's DispatchTests/ project + MSBuild isolation
                        "DispatchTests.csproj", "Directory.Build.props",
                        "Directory.Build.targets", "Directory.Packages.props", ".gitignore"}


def _fixture_path(wt):
    """The slice's fixture file, or None. The scaffold's own manifest
    (.dispatch-harness.json "authored") is the source of truth -- it names the
    fixture for every language and any --test-file; the hand-kept FIXTURE_NAMES
    list is only the fallback for a worktree without a manifest. Reading the
    list alone is what broke JS/TS slices (a second copy that never learned
    verify.test.ts)."""
    try:
        man = json.loads((Path(wt) / ".dispatch-harness.json").read_text())
        for rel in man.get("authored") or []:
            if Path(rel).name not in _NON_FIXTURE_HARNESS and (Path(wt) / rel).is_file():
                return Path(wt) / rel
    except (OSError, ValueError, AttributeError):
        pass
    for rel in FIXTURE_NAMES:
        p = Path(wt) / rel
        if p.is_file():
            return p
    return None


def harness_authored(wt):
    """True if wt already holds a complete authored harness -- lets --execute
    RESUME an already-authored slice instead of re-running AUTO and colliding
    on the existing worktree."""
    t = Path(wt) / "TASK.md"
    if not (t.exists() and _fixture_path(wt) is not None
            and (Path(wt) / "refimpl.py").exists()):
        return False
    txt = t.read_text(errors="ignore")
    return "TODO" not in txt and "## Must contain" in txt


def _git_tracked(wt, rel):
    """True if `rel` is tracked in the worktree's git index."""
    return subprocess.run(["git", "-C", wt, "ls-files", "--error-unmatch", "--", rel],
                          capture_output=True, text=True).returncode == 0


def _seal_creation_target(wt):
    """Bug #2 (2026-09-18): ensure a CREATION-task target is git-TRACKED in the
    sealed baseline (as its stub). If it is left untracked, the gate's baseline-revert
    DELETES the model's authored file rather than restoring a stub -- the target
    reverts to nothing, the gate reports "EDIT DID NOT LAND", and the slice spins an
    unwinnable refine loop. This is the SLICER-chain path of the same fault the
    scaffold seal-baseline fix covers: if the seal still left a creation-task target
    untracked, commit its stub into the baseline so the model's later edit persists
    (the revert restores the stub, not empty).

    Returns one of: 'noop' (not a creation task / already tracked), 'sealed'
    (was untracked, now committed), 'missing' (target neither tracked nor present),
    'error' (add/commit failed). PURE w.r.t. the queue -- only touches `wt`'s git."""
    hj = Path(wt) / ".dispatch-harness.json"
    if not hj.exists():
        return "noop"
    try:
        meta = json.loads(hj.read_text())
    except Exception:
        return "noop"
    tgt = meta.get("target")
    if not (meta.get("creation_task") and tgt):
        return "noop"
    if _git_tracked(wt, tgt):
        return "noop"  # seal already tracked the stub -- the fix is in place
    if not (Path(wt) / tgt).is_file():
        print(f"# WARNING: creation-task target {tgt!r} is neither tracked nor present "
              f"after seal -- the gate baseline-revert would report EDIT DID NOT LAND. "
              f"Check the scaffold seal-baseline step.")
        return "missing"
    add = subprocess.run(["git", "-C", wt, "add", "--", tgt], capture_output=True, text=True)
    # hooks OFF (--no-verify does NOT skip post-commit, whose auto-push published
    # dispatch/* branches to PUBLIC repos).
    cm = subprocess.run(["git", "-c", "core.hooksPath=/dev/null", "-C", wt, "commit", "--no-verify", "-m",
                         f"seal: track creation-task target {tgt}"],
                        capture_output=True, text=True)
    if add.returncode == 0 and _git_tracked(wt, tgt):
        print(f"# sealed creation-task target {tgt} into the baseline (was untracked) "
              f"so the model's edit will persist across the gate baseline-revert.")
        return "sealed"
    print(f"# WARNING: could not seal creation-task target {tgt!r}: "
          f"{(cm.stderr or add.stderr).strip()}")
    return "error"


def clean_and_seal(wt):
    """Drop auto-flow scratch and seal the authored harness so the launch tree
    is clean (otherwise the gate flags a dirty tree / uncommitted harness). Also
    guarantees a creation-task target is tracked in the baseline (Bug #2).

    DO NOT DELETE THE AUTO SCRATCH HERE (bug fixed 2026-09-19, second occurrence).
    This function used to `unlink()` AUTO-TASK.md + auto-harness-check.py to get a
    clean launch baseline. That is destroying a file a LIVE queue job depends on:
    every author/refine job is enqueued with `--verify python3 auto-harness-check.py`
    and runs LONG AFTER its enqueue (it sits in the depth-first queue waiting for the
    GPU). Any clean_and_seal() that fires in that window -- the PENDING/resume branch
    of execute() is the one that did it -- leaves the job's acceptance test unable to
    do anything but ENOENT. The worker then answers every task_complete with "NOT
    ACCEPTED ... keep working" however good the model's work is, the model burns its
    whole iteration budget, and the round is recorded as DID-NOT-CONVERGE and misread
    as model incapacity (esim-global-s1-parse-global job 0f3f0e7af69a; bg-captcha-s3-vision
    job acf67b79baf1, which got a genuine VERIFY_OK from its own tree and still had
    task_complete rejected).

    The enqueue-side repair (ollama-dispatch-auto.dispatch_model() regenerates a
    missing script) CANNOT fix this: it runs at enqueue, and the deletion happens
    afterwards. Neither can a label-matching in-flight guard alone -- slice_job_inflight()
    never recognised the `auto-refine-...-rN` label shape, which is exactly how the
    resume branch got here with a live refine job in the queue.

    So the file simply stops being deleted. The ONLY reason it was deleted was to keep
    it out of the launch baseline (an untracked harness file makes the queue record a
    DIRTY launch tree and the gate flags "the diff is not attributable to this job").
    seal_baseline() already solves that for .preflight-state.json / .dispatch-harness.json
    the non-destructive way -- a local `.git/info/exclude` entry -- and now covers the
    auto scratch too. git then ignores these files entirely: not tracked, not untracked,
    invisible to `git status --porcelain`, so they are also immune to every untracked-file
    revert() in the self-check, the preflight and the gate."""
    subprocess.run([SCAFFOLD, "--seal-baseline", wt], check=False)
    _seal_creation_target(wt)


def _stage_deliverable(cwt, wt, target, st=None, sid=None):
    """Bug #5 (2026-09-18): copy a slice's target from its worktree onto the chain
    worktree and STAGE it, guarding against an empty/nonexistent deliverable. A "done"
    verdict is NOT proof the work landed: a job can report done+PASS over an EMPTY diff
    (the gate rubber-stamps zero changed files -- arr-codec-floor s1-codec-rank:
    verdict=pass, counts.total=0, target unchanged). Committing that would launder an
    untouched baseline onto the chain as a DONE slice. Returns:
      ('ok', '')         -- target present AND differs from chain baseline; staged.
      ('missing', msg)   -- target absent in the worktree (no deliverable).
      ('empty', msg)     -- target identical to the chain baseline (empty-diff pass).
      ('conflict', msg)  -- the worktree was seeded from an OLDER chain tip and its
                            change does not merge onto the current tip (or the merged
                            result no longer passes the slice's own verify.sh).
    On a non-ok outcome the index is reset so nothing is left staged.

    STALE-SEED REBASE (#6, 2026-09-23). A slice worktree is cut from the chain tip
    at AUTHORING time and never moves. If other slices land after that -- a lever
    (--complete-slice / --accept-slice) on a later slice, a --regate of an ESCALATED
    slice whose worktree predates them, an operator landing out of order -- this
    used to COPY the whole target over the chain's, silently reverting every
    commit the chain gained since the seed. The base is now measured (merge-base of
    the slice worktree and the chain tip) and, when it is behind, the deliverable is
    3-way merged onto the tip (git merge-file: chain = ours, seed = base, slice =
    theirs), written back into the slice worktree and RE-VERIFIED there with the
    slice's own verify.sh before anything is staged. Byte-identical to the old copy
    when the seed IS the tip, which is the ordinary case."""
    src = os.path.join(wt, target)
    dst = os.path.join(cwt, target)
    if not os.path.isfile(src):
        return "missing", f"the target {target!r} does NOT exist in the worktree"
    os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
    note = ""
    tip = git(cwt, "rev-parse", "HEAD", capture=True)
    base = subprocess.run(["git", "-C", wt, "merge-base", "HEAD", tip],
                          capture_output=True, text=True).stdout.strip() if tip else ""
    if base and tip and base != tip:
        behind = git(cwt, "rev-list", "--count", f"{base}..{tip}", capture=True) or "?"
        merged, err = _rebase_deliverable(cwt, wt, target, base, tip)
        resolved_note = ""
        if merged is None and st is not None and sid is not None:
            # SHARED-TAIL APPEND RESOLVER -- see resolve_shared_tail_appends. Only for
            # the one conflict shape a single-file plan hits by construction when a
            # slice was authored ahead of its predecessor's integration; everything
            # else still refuses below.
            merged, rerr = _try_shared_tail_resolve(st, sid, cwt, wt, target, base, tip)
            if merged is None:
                err = f"{err}; shared-tail resolver: {rerr}"
            else:
                resolved_note = (" (textual conflict AUTO-RESOLVED: both sides appended "
                                 "before the shared tail; blocks kept in plan order, "
                                 "export lists unioned, re-verified against every "
                                 f"landed slice's verify.sh: {rerr})")
        if merged is None:
            return "conflict", (f"the slice worktree was seeded from chain tip {base[:8]} "
                                f"but the chain is now at {tip[:8]} ({behind} commit(s) "
                                f"landed since) and its change does not merge cleanly: "
                                f"{err}. Nothing staged; --retry-slice re-authors it off "
                                f"the current tip")
        prev_src = Path(src).read_bytes()
        Path(src).write_bytes(merged)
        if os.path.isfile(os.path.join(wt, "verify.sh")):
            vp = _verify_sh_lane(wt, "merge-verify")
            vout = (vp.stdout or "") + (vp.stderr or "")
            if vp.returncode != 0 or "VERIFY_OK" not in vout:
                Path(src).write_bytes(prev_src)
                return "conflict", (f"the slice worktree was seeded from chain tip "
                                    f"{base[:8]} but the chain is now at {tip[:8]} "
                                    f"({behind} commit(s) landed since); its change merges "
                                    f"textually but the merged target FAILS the slice's own "
                                    f"verify.sh (rc={vp.returncode}) -- a semantic conflict "
                                    f"with what landed in between. Nothing staged")
        note = (f"rebased onto the chain tip: the worktree was seeded from {base[:8]}, "
                f"{behind} commit(s) behind {tip[:8]}; merged 3-way and re-verified"
                + resolved_note)
        Path(dst).write_bytes(merged)
    else:
        shutil.copy2(src, dst)
    git(cwt, "add", "--", target)
    staged = git(cwt, "diff", "--cached", "--name-only", capture=True)
    if not staged.strip():
        git(cwt, "reset", "-q", "HEAD", check=False)
        return "empty", (f"the target is IDENTICAL to the chain baseline "
                         f"(empty deliverable / empty-diff pass)")
    return "ok", note


def _rebase_deliverable(cwt, wt, target, base, tip):
    """3-way merge the slice worktree's `target` (theirs) onto the chain tip's
    (ours) using their common seed `base`. Returns (merged_bytes, None) on a clean
    merge, (None, why) on conflicts or error. Pure w.r.t. both trees: reads only,
    via temp files; `git merge-file` exits with the conflict count (0 = clean,
    <0 = error). A target absent at `base` (creation slice) merges from empty."""
    import tempfile
    def _show(rev):
        cp = subprocess.run(["git", "-C", cwt, "show", f"{rev}:{target}"],
                            capture_output=True)
        return cp.stdout if cp.returncode == 0 else b""
    ours, basev = _show(tip), _show(base)
    try:
        theirs = Path(os.path.join(wt, target)).read_bytes()
    except OSError as e:
        return None, f"cannot read the slice's target: {e}"
    with tempfile.TemporaryDirectory(prefix="slice-rebase-") as td:
        po, pb, pt = (os.path.join(td, n) for n in ("chain", "seed", "slice"))
        Path(po).write_bytes(ours); Path(pb).write_bytes(basev); Path(pt).write_bytes(theirs)
        cp = subprocess.run(["git", "merge-file", "-p", "-L", "chain-tip", "-L", "seed",
                             "-L", "slice", po, pb, pt], capture_output=True)
        if cp.returncode < 0 or cp.returncode >= 128:
            return None, f"git merge-file failed: {(cp.stderr or b'').decode(errors='replace')[-200:]}"
        if cp.returncode > 0:
            return None, f"{cp.returncode} conflicting hunk(s)"
        return cp.stdout, None


# SHARED-TAIL APPEND RESOLVER (2026-09-27, BFMR s2). A single-file JS/TS plan grows
# one module: every slice appends its function above the SAME tail line and adds
# its name to the SAME export list (`module.exports = { ORDERS_URL, isLoggedOut, X };`).
# A slice authored ahead of its predecessor's integration therefore always conflicts
# on that one hunk when it is rebased -- s2 (seeded at c0f0c08) vs s3 (landed at
# 56f49a7) -- although the two changes are independent. Ahead-authoring makes this the
# normal case, so it is resolved here, and ONLY this shape:
#   * each side's diff against the seed is pure INSERTIONS, plus at most a rewrite
#     of single-line export statements (CommonJS `module.exports = {...}` / ES
#     `export {...}`);
#   * any deletion or rewrite of any other line -> refuse (the old behaviour);
#   * inserts at the same point keep both blocks, in PLAN order; export lists are
#     unioned (chain's order, then the slice's new names).
# The result is then re-verified by the slice's own verify.sh AND the verify.sh of
# every slice already DONE on the chain -- a missing one refuses.
_EXPORT_LINE_RE = re.compile(
    r"^(?P<pre>\s*(?:module\.exports\s*=\s*|export\s+))\{(?P<names>[^{}]*)\}(?P<post>\s*;?\s*)$")


def _export_names(line):
    m = _EXPORT_LINE_RE.match(line.rstrip("\n"))
    if not m:
        return None
    return m, [n.strip() for n in m.group("names").split(",") if n.strip()]


def _side_edits(base, side):
    """(inserts {pos: [lines]}, exports {pos: line}) of `side` vs `base`, or None when
    the side does anything but insert lines / rewrite single-line export statements."""
    import difflib
    ins, exp = {}, {}
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, base, side,
                                                       autojunk=False).get_opcodes():
        if tag == "equal":
            continue
        if tag == "insert":
            ins.setdefault(i1, []).extend(side[j1:j2])
            continue
        if tag == "replace" and i2 - i1 == 1 and _export_names(base[i1]) \
                and _export_names(side[j2 - 1]):
            # the export line rewritten, optionally with lines inserted before it
            if any(_export_names(l) for l in side[j1:j2 - 1]):
                return None
            if j2 - 1 > j1:
                ins.setdefault(i1, []).extend(side[j1:j2 - 1])
            exp[i1] = side[j2 - 1]
            continue
        return None
    return ins, exp


def resolve_shared_tail_appends(base, ours, theirs, theirs_first):
    """PURE. Resolve the both-sides-appended-before-a-shared-tail conflict (see above).
    Texts are str; `ours` = chain tip, `theirs` = the slice. Returns (merged, None)
    or (None, why)."""
    b, o, t = (x.splitlines(keepends=True) for x in (base, ours, theirs))
    eo, et = _side_edits(b, o), _side_edits(b, t)
    if eo is None:
        return None, "the chain side does more than append/extend exports"
    if et is None:
        return None, "the slice side does more than append/extend exports"
    (io_, xo), (it, xt) = eo, et
    if not (set(io_) & set(it)) and not (set(xo) & set(xt)):
        return None, "no shared insertion point -- not the shared-tail shape"
    for i, line in list(xo.items()) + list(xt.items()):
        if not set(_export_names(b[i])[1]) <= set(_export_names(line)[1]):
            return None, "a side REMOVES an exported name -- not an append"
    out = []
    for i in range(len(b) + 1):
        a_blk, t_blk = io_.get(i, []), it.get(i, [])
        blocks = [t_blk, a_blk] if theirs_first else [a_blk, t_blk]
        for blk in blocks:
            if blk and out and not out[-1].endswith("\n"):
                out[-1] += "\n"
            out.extend(blk)
        if i == len(b):
            break
        if i in xo and i in xt:
            mo, no = _export_names(xo[i])
            _mt, nt = _export_names(xt[i])
            _mb, nb = _export_names(b[i])
            new_o = [n for n in no if n not in nb]
            new_t = [n for n in nt if n not in nb and n not in no]
            names = [n for n in no if n in nb] + (new_t + new_o if theirs_first
                                                  else new_o + new_t)
            eol = "\n" if xo[i].endswith("\n") else ""
            out.append(f"{mo.group('pre')}{{ {', '.join(names)} }}"
                       f"{mo.group('post').rstrip(chr(10))}{eol}")
        elif i in xo:
            out.append(xo[i])
        elif i in xt:
            out.append(xt[i])
        else:
            out.append(b[i])
    return "".join(out), None


def _landed_since(cwt, base, tip):
    """Slice ids whose chain commits ("slice <sid>: ...") landed in base..tip."""
    cp = subprocess.run(["git", "-C", cwt, "log", "--format=%s", f"{base}..{tip}"],
                        capture_output=True, text=True)
    return [m.group(1) for m in (re.match(r"slice (\S+):", l)
                                 for l in (cp.stdout or "").splitlines()) if m]


def _try_shared_tail_resolve(st, sid, cwt, wt, target, base, tip):
    """Apply resolve_shared_tail_appends for slice `sid` and prove the result with
    the slice's own verify.sh plus every DONE slice's verify.sh. Returns (bytes, note)
    or (None, why). Leaves every worktree's target exactly as it found it."""
    order = st.get("order") or []
    if sid not in order:
        return None, f"{sid} is not in the plan order"
    landed = _landed_since(cwt, base, tip)
    if not landed or any(x not in order for x in landed):
        return None, "cannot attribute the commits landed since the seed to slices"
    pos = order.index(sid)
    later = [x for x in landed if order.index(x) > pos]
    if later and len(later) != len(landed):
        return None, ("slices landed since the seed are on BOTH sides of this one in "
                      "plan order -- no single honest block order")
    theirs_first = bool(later)

    def _show(rev):
        cp = subprocess.run(["git", "-C", cwt, "show", f"{rev}:{target}"], capture_output=True)
        return cp.stdout.decode("utf-8", "replace") if cp.returncode == 0 else ""
    try:
        theirs = Path(os.path.join(wt, target)).read_text()
    except OSError as e:
        return None, f"cannot read the slice's target: {e}"
    merged, why = resolve_shared_tail_appends(_show(base), _show(tip), theirs, theirs_first)
    if merged is None:
        return None, why
    done = [x for x in order if x != sid
            and (st["slices"].get(x) or {}).get("status") == DONE]
    wts = []
    for x in done:
        xwt = (st["slices"][x] or {}).get("worktree")
        if not xwt or not os.path.isfile(os.path.join(xwt, "verify.sh")):
            return None, (f"landed slice {x}'s verify.sh is gone ({xwt}) -- cannot prove "
                          f"the resolution keeps it green")
        wts.append((x, xwt))
    for x, xwt in [(sid, wt)] + wts:
        f = Path(xwt) / target
        prev = f.read_bytes() if f.exists() else None
        try:
            f.write_text(merged)
            vp = _verify_sh_lane(xwt, "resolve-verify")
            vout = (vp.stdout or "") + (vp.stderr or "")
            if vp.returncode != 0 or "VERIFY_OK" not in vout:
                return None, f"the resolved file FAILS {x}'s verify.sh (rc={vp.returncode})"
        finally:
            if prev is None:
                f.unlink(missing_ok=True)
            else:
                f.write_bytes(prev)
    return merged.encode(), (f"blocks {'slice-first' if theirs_first else 'chain-first'}; "
                             f"verified by {', '.join([sid] + [x for x, _ in wts])}")


# iCLOUD-EVICTED GIT FILES (2026-10-02, ev-service s3: a CONVERGED slice -- verify
# green, gate GO -- failed to land with "fatal: could not open .../worktrees/<chain>/
# COMMIT_EDITMSG: Resource deadlock avoided"). Repos under ~/Desktop sync to iCloud with
# Optimize Storage, which turns files inside .git into dataless placeholders; git's
# open()/mmap() of one fails with EDEADLK / ECANCELED ("mmap failed: Operation
# canceled", the scaffold's worktree-add failure). Same root cause, different call
# site. Fault the files back in (a plain read; `brctl download` as fallback) and retry
# the commit ONCE. Durable fix (the owner): keep the repos out of iCloud Desktop sync.
_DATALESS_SYMPTOMS = ("Resource deadlock avoided", "mmap failed", "Operation canceled")
_SF_DATALESS = 0x40000000


def _is_dataless(p):
    try:
        return bool(os.lstat(p).st_flags & _SF_DATALESS)
    except (OSError, AttributeError):
        return False


def materialize_git_dirs(wt, read=None, download=None):
    """Fault in every dataless file in `wt`'s own git dir and its common dir (not
    other worktrees' dirs). Returns the paths still dataless. Never raises."""
    read = read or (lambda fp: open(fp, "rb").read())
    download = download or (lambda fp: subprocess.run(["brctl", "download", fp],
                                                      capture_output=True, timeout=120))
    files = []
    try:
        dirs = []
        for flag in ("--git-dir", "--git-common-dir"):
            cp = subprocess.run(["git", "-C", wt, "rev-parse", "--path-format=absolute", flag],
                                capture_output=True, text=True, timeout=60)
            if cp.returncode == 0 and cp.stdout.strip():
                dirs.append(cp.stdout.strip())
        seen = set()
        for i, d in enumerate(dirs):
            for dp, dn, fn in os.walk(d):
                # the common dir: skip OTHER worktrees' private dirs (ours is dirs[0])
                if i == 1 and os.path.realpath(dp) == os.path.realpath(d):
                    dn[:] = [x for x in dn if x != "worktrees"]
                for f in fn:
                    fp = os.path.join(dp, f)
                    if fp not in seen and _is_dataless(fp):
                        seen.add(fp)
                        files.append(fp)
    except Exception:
        return []
    if not files:
        return []
    print(f"# materializing {len(files)} iCloud-evicted git file(s) under {wt}'s git dirs",
          file=sys.stderr)

    def one(fp):
        try:
            read(fp)
        except OSError:
            pass
        if _is_dataless(fp):
            try:
                download(fp)
            except Exception:
                pass
        return fp if _is_dataless(fp) else None
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=16) as ex:
        return [fp for fp in ex.map(one, files) if fp]


def _commit_deliverable(cwt, sid, title, target):
    """Bug #9 (2026-09-19): commit the STAGED deliverable onto the chain and PROVE
    the branch tip actually advanced before anyone records the slice DONE.

    The old code ran `git commit` with check=False, read `rev-parse HEAD` and
    stamped DONE unconditionally. A commit can fail for reasons that have nothing
    to do with the model's work -- a repo-level pre-commit hook that exits non-zero,
    a stale .git/index.lock, missing user.email in a fresh chain worktree -- and in
    every one of those cases the slice was recorded DONE while HEAD never moved.
    That is the classic two-records-of-one-fact drift: the run-state says "landed on
    the chain", the chain branch says otherwise. The damage is silent and
    compounding: the NEXT slice is cut from the UNADVANCED tip, so it never sees the
    predecessor's code, and the closing "converged slices are commits on
    slice/<label>" message is simply false.

    On failure the chain worktree is put back exactly at its tip (unstage +
    checkout the target), so the tree and the recorded tip stay consistent and
    --retry-slice starts from a clean baseline.

    Returns ('ok', sha) or ('error', msg)."""
    before = git(cwt, "rev-parse", "HEAD", capture=True)
    # hooks OFF: post-commit auto-push would publish the chain branch (landing
    # pushes main explicitly via _push_branch, it never relied on the hook).
    cp = subprocess.run(CHAIN_COMMIT_GIT + ["-C", cwt, "commit", "-m", f"slice {sid}: {title}"],
                        capture_output=True, text=True)
    after = git(cwt, "rev-parse", "HEAD", capture=True)
    if cp.returncode == 0 and after and after != before:
        return "ok", after
    _out = (cp.stderr or "") + (cp.stdout or "")
    if cp.returncode != 0 and any(x in _out for x in _DATALESS_SYMPTOMS):
        left = materialize_git_dirs(cwt)
        print(f"# {sid}: chain commit hit an iCloud-evicted git file -- materialized"
              + (f" ({len(left)} still dataless)" if left else "") + ", retrying once.")
        cp = subprocess.run(CHAIN_COMMIT_GIT + ["-C", cwt, "commit", "-m", f"slice {sid}: {title}"],
                            capture_output=True, text=True)
        after = git(cwt, "rev-parse", "HEAD", capture=True)
        if cp.returncode == 0 and after and after != before:
            return "ok", after
    # Put the chain tree back at its tip so a half-applied deliverable cannot leak
    # into the NEXT slice's commit.
    subprocess.run(["git", "-C", cwt, "reset", "-q", "HEAD", "--", target],
                   capture_output=True, text=True)
    subprocess.run(["git", "-C", cwt, "checkout", "--", target],
                   capture_output=True, text=True)
    detail = ((cp.stderr or "") + (cp.stdout or "")).strip()[-400:]
    return "error", (f"the chain commit did NOT land (rc={cp.returncode}, HEAD still "
                     f"{(before or '?')[:8]}) -- the slice is NOT on {'/'.join(cwt.split('/')[-1:])} "
                     f"and must not be recorded DONE: {detail or 'no git output'}")


# --- WHOLE-CHAIN INTEGRATION (2026-09-23, Fable pass 2) ---------------------------
# THE DEAD END. A plan that converged -- every slice DONE or SKIPPED -- printed
# "converged slices are commits on slice/<label> ... integrate by copying that tree
# onto main" and stopped. Nothing did the copying. ollama-dispatch-integrate could
# classify a chain worktree, but a chain carries no recorded contract, so it came
# back scope-INFERRED and --stage refused it; every landing on record (broker-guard
# main 2026-09-20/21: "integrate: <file> (code-only, scaffold stripped)" + "merge
# integrate/slice-<label>-<sha> into main") was a human running the steps by hand.
# On 2026-09-23 twenty converged plans sat with chain branches 1-9 commits ahead of
# main and no integration record at all. The escalation watcher's source E was
# already waiting on an `integration` record "written by dispatch-integration-check.py"
# -- a tool that was never built.
#
# Integration is now part of ordinary state advancement, in two deliberate halves:
#   1. STAGE (automatic, at convergence and from the sweep): classify the chain
#      against the repo's LOCAL default branch with the scope the chain actually
#      committed (integrate --scope/--onto), --stage the code-only diff onto a scratch
#      integrate/* branch built on that exact tip, and record `integration` with
#      status "staged" plus the one command that lands it. main is NOT written.
#   2. LAND (explicit, `--land-integration`): fast-forward the default branch to the
#      staged commit and push. Writing main stays a reviewed act -- the same contract
#      as --complete-slice: the operator invoking it IS the review.
# Both halves are fail-closed: anything but a CLEAN (or already REDUNDANT) verdict,
# a scaffold leak, a non-fast-forward, or a default branch checked out in another
# worktree records `failed` and touches nothing. The record is what the escalation
# watcher's source E announces (bad statuses AND a staged chain waiting to land).
INTEGRATE = os.path.expanduser("~/bin/ollama-dispatch-integrate")
# What a chain commit may carry that is NOT the deliverable. Mirrors SCAFFOLD_FILES in
# ollama-dispatch-integrate plus the authoring-side scratch; used only to decide the
# SCOPE we hand that tool -- it strips by its own list too.
_SCAFFOLD_BASENAMES = {
    "TASK.md", "verify.sh", "verify_impl.mts", "verify_impl.mjs", "verify_impl.js",
    "test_fixture.py", "check_literals.py", "refimpl.py", "fix.patch", "Package.swift",
    ".preflight-state.json", ".dispatch-harness.json", "auto-harness-check.py",
    "REPO_MAP.md",
}
INTEGRATION_NA = "n/a"        # sub-plan: lands on the PARENT chain, never main directly
# A stage the default branch MOVED OUT FROM UNDER. Not a failure of the chain and not
# landable either: the verdict and the scratch commit were both built on a tip that no
# longer exists, so the only honest answer is "re-stage against the current tip".
INTEGRATION_STALE = "stale"
INTEGRATE_TIMEOUT_S = 900


def plan_converged(st):
    """PURE. True iff every slice is SATISFIED (done/skipped) and at least one is DONE.
    All-skipped is not converged-with-work: there is nothing on the chain to land."""
    slices = st.get("slices") or {}
    order = st.get("order") or list(slices)
    if not order:
        return False
    sts = [(slices.get(i) or {}).get("status") for i in order]
    return all(x in SATISFIED for x in sts) and DONE in sts


def is_subplan(st):
    """A re-sliced ESCALATED slice runs as a sub-plan whose `repo` IS the parent's
    chain worktree (under WT_ROOT). Its commits reach main only through the parent
    chain (merge_subplan_into_chain), so it must never integrate on its own."""
    repo = st.get("repo") or ""
    if not repo:
        return False
    root = os.path.realpath(WT_ROOT)
    rp = os.path.realpath(repo)
    return rp == root or rp.startswith(root + os.sep)


def base_moved(rec, onto_tip):
    """PURE. True iff `rec` makes a claim ABOUT THE DEFAULT BRANCH that the branch
    has since invalidated by moving. `onto_tip` is that branch's tip RIGHT NOW
    (None = unknowable, so nothing is claimed stale).

    THE BUG THIS EXISTS FOR (2026-09-24). An `integration` record was computed once
    and then believed forever. Two of its statuses are claims about a MOVING target:

      staged  -- "this code-only commit fast-forwards onto <onto_tip>"
      failed with a conflict verdict
              -- "this chain conflicts with <onto_tip>"

    Neither survives `main` advancing, but integration_needed() only ever re-fired
    when the CHAIN tip moved. So on 2026-09-23T22:41:15Z one sweep wrote eleven
    `conflict-semantic` records (bg-actions, bg-alert, bg-detection, bg-escalation,
    bg-health, bg-profile, bg-serpwatch, bg-state, bg-webui, scheduler,
    playwright_checks) and one `staged` record (rt-costco-always-sites), and every
    sweep for the next ~26h re-announced those frozen verdicts as live truth --
    even for chains whose content had since LANDED on main and been hardened
    further there. 14/14 Opus integration reviews came back "the gate is broken,
    not the code", which was correct.

    Every OTHER status is a claim about the PAST -- `passed`/redundant means the
    content is already on main, `n/a` means a sub-plan lands via its parent -- and
    main moving forward cannot make those untrue. Excluding them is what keeps this
    from becoming the re-classify-everything-on-every-push storm this file keeps
    stamping out: a record re-fires at most once per movement of main, and the
    re-check then writes the fresh tip (or retires to `passed`/redundant)."""
    if not isinstance(rec, dict) or not onto_tip:
        return False
    status = rec.get("status")
    if status == "staged":
        pass                                        # forward-looking: "it lands"
    elif status == "failed" and str(rec.get("verdict") or "").startswith("conflict"):
        pass                                        # forward-looking: "it conflicts"
    else:
        return False
    return rec.get("onto_tip") != onto_tip


def current_onto_tip(st, rec=None):
    """LIVE tip of the local branch a record was classified against. None when that
    is unknowable (no record, no `onto`, repo gone) -- never a guess."""
    rec = rec if isinstance(rec, dict) else (st.get("integration") or {})
    repo, dref = st.get("repo") or "", rec.get("onto")
    if not dref or not os.path.isdir(repo):
        return None
    return git(repo, "rev-parse", "--verify", "--quiet",
               f"refs/heads/{dref}", capture=True) or None


def integration_needed(st, tip, onto_tip=None):
    """PURE. Should a converged plan whose chain tip is `tip` (re)run the STAGE half?
      no record            -> yes (never staged)
      n/a                  -> no  (sub-plan)
      stale                -> yes: a stage the default branch moved out from under
      staged               -> if the chain tip MOVED since (a --reland-slice
                              re-landed something; the staged commit is stale) OR
                              the default branch moved (base_moved)
      passed               -> re-stage only when the tip moved after landing
      failed               -> only when it is a CONFLICT verdict and the default
                              branch has moved since (base_moved): the conflict was
                              against a main that no longer exists, so the verdict
                              must be re-computed, not re-announced. Other failures
                              (dirty chain, empty scope, scaffold leak) are about the
                              CHAIN, so they stay announced until --integrate re-runs
                              them; re-firing those every sweep would be a retry storm.
      unavailable          -> no: the tool did not run; --integrate re-runs it.

    `onto_tip` is the default branch's tip right now -- pass current_onto_tip(st)."""
    rec = st.get("integration")
    if not isinstance(rec, dict):
        return True
    status = rec.get("status")
    if status == INTEGRATION_NA:
        return False
    if status == INTEGRATION_STALE:
        return True
    if base_moved(rec, onto_tip):
        return True
    if status in ("staged", "passed"):
        return bool(tip) and rec.get("chain_tip") != tip
    return False


def local_default_branch(repo):
    """The LOCAL branch integration lands on: what origin/HEAD points at if that
    branch exists locally, else main, else master. None if none exists."""
    head = git(repo, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD",
               capture=True)
    cands = []
    if head and "/" in head:
        cands.append(head.split("/", 1)[1])
    cands += ["main", "master"]
    for c in cands:
        if c and git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{c}", capture=True):
            return c
    return None


def chain_scope(cwt, base_ref):
    """Files the chain branch changed since it forked from `base_ref`, minus scaffold
    basenames. This is the PROVEN scope handed to ollama-dispatch-integrate --scope."""
    mb = git(cwt, "merge-base", base_ref, "HEAD", capture=True)
    if not mb:
        return []
    out = git(cwt, "diff", "--name-only", f"{mb}..HEAD", capture=True)
    return [p for p in out.splitlines()
            if p.strip() and os.path.basename(p) not in _SCAFFOLD_BASENAMES]


def plan_targets(st):
    """The plan's in-scope file path(s), as a list. `target` is a single path on every
    plan written to date, but tolerate a list so this never becomes the thing that
    breaks when it stops being one."""
    t = st.get("target")
    if isinstance(t, str):
        return [t] if t.strip() else []
    if isinstance(t, (list, tuple)):
        return [p for p in t if isinstance(p, str) and p.strip()]
    return []


def slice_target(st, s):
    """The file THIS slice's harness targets: the slice's own `target`, else the plan's.

    PER-SLICE SCOPE (2026-10-05, rt-egift-link-s1). A "single-file OMNIBUS" plan handed
    every slice the plan target (lib/egiftLink.ts) -- including s0, whose whole intent was
    a prisma/schema.prisma model, s4 (a new API route) and s5 (a component + the page that
    mounts it). The authored TASK.md then said "Only edit `lib/egiftLink.ts`" while its
    Must-contain needed other files, and landing staged ONLY the plan target, so the
    other files could never reach the chain even on a PASS."""
    t = (s or {}).get("target")
    return t if isinstance(t, str) and t.strip() else st["target"]


def slice_edit_files(st, s):
    """Extra in-scope files a multi-file slice edits besides slice_target()."""
    tgt = slice_target(st, s)
    out = []
    for f in (s or {}).get("edit_files") or []:
        if isinstance(f, str) and f.strip() and f != tgt and f not in out:
            out.append(f)
    return out


_INTENT_EDIT_FILE_RE = re.compile(
    r"\b(?:to|into|in|edit|modify|update|extend|create(?:\s+(?:a\s+)?new)?(?:\s+[\w-]+){0,2}"
    r"|mounted\s+in|add(?:s|ed)?\s+to)\s+['\"`]?"
    r"((?:[\w.\[\]-]+/)+[\w.\[\]-]+\.(?:prisma|sql|tsx|ts|jsx|js|mjs|cjs|py|css|html|json|swift))(?![\w-])",
    re.I)


_PLAN_LINT_MOD = []


def _plan_lint():
    """~/bin/plan_lint.py, loaded once; None when it cannot be loaded (callers fail CLOSED)."""
    if not _PLAN_LINT_MOD:
        try:
            import importlib.util as _ilu
            _s = _ilu.spec_from_file_location("plan_lint", Path(__file__).resolve().parent / "plan_lint.py")
            _m = _ilu.module_from_spec(_s)
            _s.loader.exec_module(_m)
            _PLAN_LINT_MOD.append(_m)
        except Exception:
            _PLAN_LINT_MOD.append(None)
    return _PLAN_LINT_MOD[0]


def pre_author_lint_reason(st, s):
    """PURE-ish. Why this slice must NOT be authored yet because its PLAN is unsatisfiable by
    construction, else None (root cause of rt-egift-link-s1-s4's ~10 wasted author jobs:
    a must_contain `Cache-Control: no-store` the author used as ONE header name; an intent
    that disagrees with its own verify_shape about the body shape). Checked BEFORE any author
    job is enqueued. `lint_ack: true` on the slice entry overrides (human decision). Fail
    closed when plan_lint.py is unavailable."""
    if (s or {}).get("lint_ack"):
        return None
    pl = _plan_lint()
    if pl is None:
        return "plan_lint.py could not be loaded (fail-closed)"
    problems = []
    for _sid, lit in pl.header_pair_literals([dict(s, id=(s or {}).get("id"))]):
        problems.append(f"must_contain {lit!r} is a `Name: value` header pair -- the author "
                        f"makes it ONE header name and every handler 500s; list the two tokens "
                        f"separately")
    for _sid, msg in pl.intent_shape_conflicts(dict(s)):
        problems.append(msg)
    return "; ".join(problems) or None


_HG_MOD = []


def _hg():
    """~/bin/dispatch_harness_gates.py, loaded once; None when unloadable (callers fail OPEN
    for this advisory lint -- preflight's harness-complete is the fail-closed backstop)."""
    if not _HG_MOD:
        try:
            import importlib.util as _ilu
            _sp = _ilu.spec_from_file_location(
                "dispatch_harness_gates", Path(__file__).resolve().parent / "dispatch_harness_gates.py")
            _m = _ilu.module_from_spec(_sp)
            _sp.loader.exec_module(_m)
            _HG_MOD.append(_m)
        except Exception:
            _HG_MOD.append(None)
    return _HG_MOD[0]


def spec_satisfiability_reason(st, s, baseline_root):
    """SPEC-SATISFIABILITY LINT (Phase 2, 2026-10-08). Why this slice's must_contain can never
    be satisfied, else None. A literal with ZERO occurrences in the target at the chain tip AND
    not named anywhere in the slice's own intent/title/verify_shape is unreachable by
    construction (the author cannot know to write it): 8a4941aa8521 / a580c8793aa7 burned their
    whole author budget on such a literal. Checked BEFORE any author job. `lint_ack: true`
    overrides. Missing/unreadable target (creation slice) or unloadable module -> None."""
    if (s or {}).get("lint_ack"):
        return None
    hg = _hg()
    rel = (st or {}).get("target") or slice_target(st, s)
    lits = [str(l) for l in ((s or {}).get("must_contain") or []) if str(l).strip()]
    if hg is None or not lits or not rel:
        return None
    try:
        body = Path(os.path.join(baseline_root, rel)).read_text(errors="replace")
    except OSError:
        return None
    spec = " ".join(str((s or {}).get(k) or "") for k in
                    ("intent", "title", "verify_shape", "interface", "description", "notes"))
    # ONLY bare identifiers (MANUAL_SYNC_INIT, fooBar). A multi-token literal such as
    # `if (x < lo) return lo;` is NEW CODE the author is asked to write -- it is absent from
    # the target by construction, and refimpl-passes/check_literals prove it satisfiable once
    # the refimpl exists. (The first cut linted those too and ESCALATED every pipeline-canary
    # slice before authoring.)
    lits = [l for l in lits if _IDENT_RE.match(l)]
    bad = hg.literal_findings(lits, body, spec)
    if not bad:
        return None
    return "; ".join(f"must_contain {lit!r}: {why}" for lit, why in bad)


def uncovered_edit_files(st, s):
    """PURE. Files the slice INTENT says to create/edit/add-to/mount-in that are not in
    the slice's scope (slice_target + edit_files) and not declared read-only (`reads`).
    Non-empty = a plan defect: the harness would be self-contradictory and the landing
    would drop those files."""
    have = {slice_target(st, s), *slice_edit_files(st, s), *((s or {}).get("reads") or [])}
    out = []
    for m in _INTENT_EDIT_FILE_RE.finditer((s or {}).get("intent") or ""):
        f = m.group(1).strip("'\"`.,;:)")
        if f not in have and f not in out:
            out.append(f)
    return out


def _stage_slice(cwt, wt, st, sid, s):
    """Stage slice_target() (via _stage_deliverable: rebase, empty guard) and then every
    slice_edit_files() entry the worktree changed. An extra file the chain ALSO changed
    since this worktree was seeded is a conflict (no 3-way merge for extras). On any
    non-ok outcome the index is reset.

    READ UNDER THE TREE LOCK (2026-10-06, soak seed 3): the deliverable is read (and
    re-verified) from the slice worktree's live files. A self-check / gate relevance
    pass holding the tree lock resets the target to HEAD for its baseline measurement
    and restores it afterwards; reading in that window saw the baseline, called a green
    PASS an "empty deliverable" and FAILED the slice (then auto-landed it moments
    later). Wait for the in-place mutators like every other holder does."""
    with _wt_tree_lock(wt):
        return _stage_slice_unlocked(cwt, wt, st, sid, s)


def _stage_slice_unlocked(cwt, wt, st, sid, s):
    outcome, msg = _stage_deliverable(cwt, wt, slice_target(st, s), st=st, sid=sid)
    if outcome != "ok":
        return outcome, msg
    extras = slice_edit_files(st, s)
    if not extras:
        return outcome, msg
    tip = git(cwt, "rev-parse", "HEAD", capture=True)
    base = subprocess.run(["git", "-C", wt, "merge-base", "HEAD", tip],
                          capture_output=True, text=True).stdout.strip() if tip else ""
    staged = []
    for f in extras:
        src = os.path.join(wt, f)
        if not os.path.isfile(src):
            continue
        new = Path(src).read_bytes()
        if new == (blob_at(cwt, "HEAD", f) or None):
            continue
        if base and tip and base != tip and subprocess.run(
                ["git", "-C", cwt, "diff", "--quiet", base, tip, "--", f]).returncode != 0:
            git(cwt, "reset", "-q", "HEAD", check=False)
            return "conflict", (f"edit file {f!r} changed on the chain since this worktree "
                                f"was seeded ({base[:8]} -> {tip[:8]}); nothing staged")
        dst = os.path.join(cwt, f)
        os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
        Path(dst).write_bytes(new)
        git(cwt, "add", "--", f)
        staged.append(f)
    return "ok", (msg + ("; " if msg else "") + ("also staged " + ", ".join(staged)
                                                    if staged else "")).strip("; ")


def _commit_slice(cwt, sid, s, st):
    cout, cmsg = _commit_deliverable(cwt, sid, s["title"], slice_target(st, s))
    if cout != "ok":
        for f in slice_edit_files(st, s):
            subprocess.run(["git", "-C", cwt, "reset", "-q", "HEAD", "--", f], capture_output=True)
            subprocess.run(["git", "-C", cwt, "checkout", "--", f], capture_output=True)
    return cout, cmsg


def blob_at(repo, ref, path):
    """`git show <ref>:<path>` as bytes, or None when the path does not exist there."""
    cp = subprocess.run(["git", "-C", repo, "show", f"{ref}:{path}"], capture_output=True)
    return cp.stdout if cp.returncode == 0 else None


def chain_already_landed(cwt, base_ref, targets):
    """Disambiguate an EMPTY `chain_scope`. Returns (landed: bool, why: str).

    Landed requires BOTH:
      1. the chain worktree's HEAD is reachable from `base_ref` -- every commit of
         the chain is literally on the default branch, so there is provably nothing
         forward to stage; and
      2. each of the plan's in-scope targets EXISTS on `base_ref` and does not carry
         the scaffold stub marker `ollama-dispatch-scaffold` writes for that path.

    (1) alone is not enough and asserting it alone would be a proxy, not the
    property: a chain that never committed anything also has HEAD == its fork point,
    which is trivially an ancestor of the default branch. (2) is what separates "the
    work is on main" from "the chain did nothing" -- and, deliberately, it is the
    same evidence `still_scaffold_stub` uses (our own scaffold's marker), not an
    inference about content.

    Never raises; anything unreadable is reported as NOT landed, so the conservative
    path (fail the gate, escalate) stays the default."""
    cp = subprocess.run(["git", "-C", cwt, "merge-base", "--is-ancestor", "HEAD", base_ref],
                        capture_output=True, text=True)
    if cp.returncode != 0:
        return False, f"the chain tip is not an ancestor of {base_ref}"
    if not targets:
        return False, "the plan names no target to check on " + base_ref
    for p in targets:
        blob = blob_at(cwt, base_ref, p)
        if blob is None:
            return False, f"{p} does not exist on {base_ref}"
        if f"Stub for {p} -- implement per TASK.md".encode() in blob:
            return False, f"{p} on {base_ref} is still the scaffold stub"
    return True, f"{', '.join(targets)} implemented on {base_ref}"


def _run_integrate(args):
    """Run ollama-dispatch-integrate with --json. Returns (rc, parsed-or-None, stderr).
    Prefers the sibling copy next to THIS file (a branch checkout under test), then
    the installed ~/bin one."""
    sib = os.path.join(os.path.dirname(os.path.realpath(__file__)), "ollama-dispatch-integrate")
    tool = sib if os.path.exists(sib) else INTEGRATE
    try:
        cp = subprocess.run([tool, *args, "--json"], capture_output=True, text=True,
                            timeout=INTEGRATE_TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, None, f"{type(e).__name__}: {e}"
    data = None
    if (cp.stdout or "").strip():
        try:
            data = json.loads(cp.stdout)
        except ValueError:
            data = None
    return cp.returncode, data, (cp.stderr or "").strip()[-600:]


def _integration_finish(st, rec, status, summary, stage=None, **extra):
    rec["status"] = status
    rec["summary"] = summary
    if stage:
        rec.setdefault("failed_stages", []).append(stage)
    rec.update(extra)
    st["integration"] = rec
    save_state(st)
    print(f"# integration [{st['label']}]: {status.upper()} -- {summary}")
    return status


def land_command(st):
    """The exact by-hand landing for a staged record (also what --land-integration runs)."""
    rec = st.get("integration") or {}
    return (f"git -C {q(st.get('repo', ''))} merge --ff-only {rec.get('integrate_branch', '?')}"
            f"  &&  git -C {q(st.get('repo', ''))} push")


def base_divergence(repo, dref, integ_branch, staged_onto_tip=None):
    """LIVE re-check of a STAGED integration against the CURRENT default branch.
    Returns None when the stage is still landable, else the human reason it is not.
    Reads git NOW; a recorded tip or a cached verdict is never evidence about the
    tree that exists at this moment.

    THE BUG THIS EXISTS FOR (2026-09-24, rt-costco-always-sites, resell-tracker).
    `integration` was recorded `staged`/`clean` at 2026-09-23T22:41:15Z and then
    believed indefinitely: integration_needed() only re-fired on a CHAIN tip move
    and land_integration() only compared chain tips, so nothing ever looked at main
    again. Meanwhile rt-bfmr-pending-sync-scope landed on that same main at
    2026-09-24T00:23:51Z. The escalation watcher went on announcing "the whole chain
    replays cleanly onto the default branch ... verdict: clean ... land it with
    --land-integration", while by then:

        git merge-base --is-ancestor integrate/slice-rt-costco-always-sites-025f21ad main -> NO
        git merge-base --is-ancestor main integrate/slice-rt-costco-always-sites-025f21ad -> NO

    i.e. genuinely diverged, and `git diff main..integrate/...` DELETED four live
    files (lib/bfmrSyncScope.ts, lib/bfmrSyncTrigger.ts, sidecar/src/walmartDetail-
    Signals.js, sidecar/src/walmartTracking.js) because the scratch branch was
    commit-tree'd onto the OLD main and never rebuilt. _ff_land() would have refused
    the fast-forward, so the lever itself was safe -- but the word "clean" and the
    panel's advertised by-hand `git merge --ff-only` alternative were both false, and
    a hand-run non-ff merge would have reverted that work.

    THE BAR is the one the operator used by hand and nothing weaker: the CURRENT tip
    of `dref` must be an ancestor of the integrate branch. That single test covers
    both shapes -- main advanced with commits the stage lacks (divergence), and main
    rewritten underneath it."""
    cur = git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{dref}", capture=True)
    if not cur:
        return f"{dref!r} no longer resolves to a local branch in {repo}"
    if not integ_branch:
        return "the record names no integrate branch"
    new = git(repo, "rev-parse", "--verify", "--quiet",
              f"refs/heads/{integ_branch}", capture=True)
    if not new:
        return (f"the staged branch {integ_branch!r} no longer exists in {repo} "
                f"(deleted, or landed and cleaned up)")
    if cur == new:
        return None                     # already fast-forwarded to exactly this stage
    if subprocess.run(["git", "-C", repo, "merge-base", "--is-ancestor", cur, new],
                      capture_output=True).returncode != 0:
        missing = git(repo, "rev-list", "--count", f"{new}..{cur}", capture=True) or "?"
        names = git(repo, "diff", "--name-only", "--diff-filter=D",
                    f"{cur}..{new}", capture=True).splitlines()
        drop = ((" -- landing it would DELETE %s" % ", ".join(names[:6]))
                if names else "")
        return (f"{dref} has MOVED ON: its tip {cur[:8]} is not an ancestor of the staged "
                f"{integ_branch} ({new[:8]}), so {missing} commit(s) now on {dref} are "
                f"missing from the stage{drop}. The stage is NOT landable -- re-run "
                f"--integrate to re-stage and re-classify against the current tip")
    if staged_onto_tip and staged_onto_tip != cur:
        return (f"{dref} moved {staged_onto_tip[:8]} -> {cur[:8]} after this was classified; "
                f"the verdict was computed against the older tip -- re-run --integrate")
    return None


def _retire_stale_stage(repo, prev, dref):
    """Delete the scratch integrate/* branch a PREVIOUS record staged, so a re-stage
    can rebuild it on the tip that exists now. Returns a note, or None if nothing
    was retired.

    THE BUG THIS EXISTS FOR (2026-09-24, found by this file's own new self-test).
    ollama-dispatch-integrate names the branch `integrate/<slug>-<chain head[:8]>`
    and refuses when it already exists -- a correct no-clobber guard for a tool that
    cannot know who owns the ref. But that name is keyed on the CHAIN head ALONE, so
    when `main` moves and the chain does not, the re-stage that a moved base requires
    was flatly impossible: "REFUSE stage: target branch already exists". Without this,
    every fix above would tell an operator to re-run --integrate and every re-run
    would fail identically -- rt-costco-always-sites would have been stuck reporting
    `stale` forever instead of becoming landable again.

    The slicer genuinely owns this ref: it recorded the name itself, it is a scratch
    `integrate/*` branch, it is never pushed, and it is fully regenerable from (chain
    tip, main tip) by construction -- so deleting it discards no work. Anything we did
    not record, anything not named integrate/*, and anything checked out in a worktree
    stays untouched."""
    br = (prev or {}).get("integrate_branch")
    if not br or not str(br).startswith("integrate/"):
        return None
    if not git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{br}", capture=True):
        return None
    if _branch_checked_out_elsewhere(repo, br):
        return f"KEPT {br}: it is checked out in another worktree of {repo}"
    cp = subprocess.run(["git", "-C", repo, "branch", "-D", br],
                        capture_output=True, text=True)
    if cp.returncode != 0:
        return f"could NOT retire {br}: {(cp.stderr or cp.stdout).strip()[-200:]}"
    return f"retired the previous scratch stage {br} (regenerable, never pushed)"


def integrate_chain(st, cwt=None, run_integrate=None):
    """STAGE half: classify + stage a CONVERGED plan's chain as a code-only commit on a
    scratch integrate/* branch built on the repo's local default branch, and record
    `integration` on the run state. NEVER writes the default branch, never pushes.
    Returns the recorded status. `run_integrate` is injectable for --self-test."""
    ri = run_integrate or _run_integrate
    prev = st.get("integration") if isinstance(st.get("integration"), dict) else {}
    rec = {"at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
           "status": None, "summary": "", "failed_stages": []}
    fin = lambda *a, **k: _integration_finish(st, rec, *a, **k)
    if is_subplan(st):
        return fin(INTEGRATION_NA, "sub-plan: its commits reach the PARENT chain via "
                   "merge_subplan_into_chain and land on main with the parent")
    repo = st.get("repo") or ""
    if not os.path.isdir(repo):
        return fin("unavailable", f"repo {repo!r} is not a directory", "repo")
    cwt = cwt or ensure_chain_worktree(st)
    tip = git(cwt, "rev-parse", "HEAD", capture=True)
    rec["chain_tip"] = tip
    rec["chain_branch"] = st.get("chain_branch")
    dref = local_default_branch(repo)
    if not dref:
        return fin("failed", f"{repo} has no local main/master branch to land on", "default-branch")
    rec["onto"] = dref
    # THE BASE, RECORDED (2026-09-24). Every escalation panel ever emitted said
    # "base commit compared against: `none`" -- dispatch-escalation-watcher.py reads
    # rec["base_rev"], and NOTHING wrote it. The merge-base was always computed
    # (here, and again inside ollama-dispatch-integrate's classify()); it was just
    # never captured, so 14/14 Opus integration reviews correctly read the panel as
    # "this gate has no merge-base" and concluded the gate was broken. Recorded
    # BEFORE the clean/dirty/scope gates so even a record that fails early carries
    # the base and tip it was judged against, and freshness stays checkable.
    rec["base_rev"] = git(cwt, "merge-base", dref, "HEAD", capture=True) or None
    rec["onto_tip"] = git(repo, "rev-parse", "--verify", "--quiet",
                          f"refs/heads/{dref}", capture=True) or None
    dirty = git(cwt, "status", "--porcelain", "--untracked-files=no", capture=True)
    if dirty.strip():
        return fin("failed", f"the chain worktree {cwt} has uncommitted tracked changes "
                   f"({dirty.splitlines()[:4]}) -- commit or revert them, then --integrate",
                   "chain-clean")
    scope = chain_scope(cwt, dref)
    rec["scope"] = scope
    if not scope:
        # AN EMPTY FORWARD SCOPE IS AMBIGUOUS (2026-09-25). `chain_scope` diffs
        # merge-base(dref, HEAD)..HEAD, so it is empty in TWO opposite situations:
        #   (a) the chain never did anything -- genuinely nothing to land; and
        #   (b) the chain ALREADY LANDED -- its tip is an ancestor of dref, the
        #       merge-base IS the tip, and the forward diff is empty BECAUSE the
        #       work is on main already.
        # This branch called both (a) and failed the gate, and it does so BEFORE
        # ollama-dispatch-integrate is ever invoked -- so `landed_on_default()`
        # (558a17b), which exists precisely to recognise (b), never got to run.
        # That is the whole of the bg-brokers / bg-captcha / bg-formfill /
        # bg-interpret escalation wave: four chains whose tip 996627a is a literal
        # ancestor of main, each escalated repeatedly as "the gate is broken".
        # Ancestry is the strongest evidence available -- if the tip commit is
        # reachable from dref, every commit of the chain is on dref by definition --
        # so it decides (b) here, and (a) keeps the failure it earned.
        landed, why = chain_already_landed(cwt, dref, plan_targets(st))
        rec["landed_ancestor"] = landed
        rec["empty_scope_why"] = why
        if landed:
            return fin("passed", f"already on {dref}: the chain tip {tip[:8]} is an "
                       f"ancestor of {dref} and {why}, so the empty forward scope means "
                       f"LANDED, not empty -- nothing left to stage", landed=None)
        return fin("failed", f"the chain branch {st.get('chain_branch')} changed nothing "
                   f"outside the scaffold relative to {dref} -- nothing to land ({why})",
                   "scope")
    scope_args = [f"--scope={p}" for p in scope]
    rc, v, err = ri([cwt, "--onto", dref, *scope_args])
    if not isinstance(v, dict):
        return fin("unavailable", f"ollama-dispatch-integrate produced no verdict "
                   f"(rc={rc}): {err or 'no stderr'}", "classify")
    if v.get("error"):
        return fin("failed", f"classify error: {v['error']}", "classify")
    overall = v.get("overall")
    per = {f.get("path"): f.get("status") for f in (v.get("files") or []) if isinstance(f, dict)}
    rec["verdict"] = overall
    rec["files"] = per
    # The classifier's OWN view of the base it judged against, kept alongside ours so a
    # disagreement is visible in the record instead of being averaged away in prose.
    rec["classified_base"] = v.get("merge_base")
    rec["classified_onto_tip"] = v.get("main_tip")
    # A FRESH VERDICT VOIDS THE PREVIOUS STAGE, whatever the new verdict is -- so retire
    # that scratch branch HERE, not only on the path that re-stages.
    #
    # THE BUG THIS FIXES (2026-09-25, found by retiring rt-costco-always-sites). Retiring
    # that chain re-classified it `redundant`, which returns below without ever reaching
    # the stage step -- so `integrate/slice-rt-costco-always-sites-025f21ad` survived,
    # while the new record (correctly) no longer names it. The result was strictly worse
    # than before: an ORPHAN branch that no record references, that nothing will ever
    # clean up, and that still deletes lib/bfmrSyncScope.ts, lib/bfmrSyncTrigger.ts,
    # sidecar/src/walmartDetailSignals.js and sidecar/src/walmartTracking.js if a human
    # merges it. Placed after the verdict so a classify error or an unavailable tool
    # never destroys a stage we have not managed to re-judge.
    retired = _retire_stale_stage(repo, prev, dref)
    if retired:
        rec["retired_stage"] = retired
        print(f"# integration [{st['label']}]: {retired}")
    if overall == "redundant":
        return fin("passed", f"already on {dref} (redundant): {per}", landed=None)
    if overall != "clean":
        return fin("failed", f"verdict {overall}: {v.get('recommendation') or ''} files={per}",
                   f"classify:{overall}")
    # The previous stage was already retired above (a fresh verdict voids it), which is
    # also what frees the branch NAME this stage needs -- see _retire_stale_stage.
    rc, r, err = ri([cwt, "--stage", "--onto", dref, *scope_args])
    if not isinstance(r, dict) or not r.get("staged"):
        why = r.get("refuse") if isinstance(r, dict) else None
        return fin("failed", f"stage refused: {why or err or f'rc={rc}'}", "stage")
    br = r.get("target_branch")
    rec["integrate_branch"] = br
    rec["staged_commit"] = r.get("commit")
    if r.get("scaffold_leaked"):
        return fin("failed", f"staged {br} but scaffold LEAKED into it: "
                   f"{r['scaffold_leaked']} -- not landable", "stage:scaffold-leak")
    st["integration"] = rec
    # PROVE the stage against the tip that exists NOW, not the one we read before
    # classifying. main can advance during the classify+stage window (another chain
    # landing, an operator push), and "staged/clean" is the one word in this pipeline
    # that an operator acts on destructively -- it is never emitted unclaimed.
    why = base_divergence(repo, dref, br, rec.get("onto_tip"))
    if why:
        return fin(INTEGRATION_STALE,
                   f"staged {br} but it is ALREADY not landable: {why}", "stage:base-moved")
    rec["verified_onto_tip"] = git(repo, "rev-parse", "--verify", "--quiet",
                                  f"refs/heads/{dref}", capture=True) or None
    rec["verified_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
    return fin("staged", f"code-only commit {str(r.get('commit'))[:8]} for {', '.join(scope)} is "
               f"on {br} (built on {dref} @ {str(rec.get('onto_tip') or '?')[:8]}, base "
               f"{str(rec.get('base_rev') or '?')[:8]}, PROVEN a fast-forward from that exact "
               f"tip just now); land it with `ollama-dispatch-slice <plan> "
               f"--land-integration` or: {land_command(st)}")


def _branch_checked_out_elsewhere(repo, branch):
    out = git(repo, "worktree", "list", "--porcelain", capture=True)
    return f"branch refs/heads/{branch}" in [l.strip() for l in out.splitlines()]


def _ff_land(repo, dref, integ_branch):
    """Fast-forward the LOCAL `dref` to `integ_branch`. Returns (ok, detail).

    Two safe paths and nothing else:
      * dref is the branch checked out in `repo` itself -> `git merge --ff-only`
        there, so index and working tree move with the ref (git refuses by itself
        if a dirty file would be overwritten).
      * dref is not checked out anywhere -> `git update-ref` with the expected old
        value (compare-and-swap), after proving old is an ancestor of new.
    dref checked out in ANOTHER worktree -> refuse: moving the ref behind that tree
    would make it show phantom reverted changes."""
    new = git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{integ_branch}", capture=True)
    old = git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{dref}", capture=True)
    if not new or not old:
        return False, f"cannot resolve {integ_branch!r} or {dref!r} in {repo}"
    anc = subprocess.run(["git", "-C", repo, "merge-base", "--is-ancestor", old, new],
                         capture_output=True)
    if anc.returncode != 0:
        return False, (f"{dref} moved since the integration commit was staged "
                       f"({old[:8]} is not an ancestor of {new[:8]}) -- not a fast-forward; "
                       f"re-run --integrate to re-stage on the current tip")
    cur = git(repo, "symbolic-ref", "--quiet", "--short", "HEAD", capture=True)
    if cur == dref:
        cp = subprocess.run(["git", "-C", repo, "merge", "--ff-only", "--no-edit", new],
                            capture_output=True, text=True)
        if cp.returncode != 0:
            return False, (f"git merge --ff-only refused in {repo}: "
                           f"{(cp.stderr or cp.stdout).strip()[-400:]}")
        return True, f"fast-forwarded the checked-out {dref} {old[:8]} -> {new[:8]}"
    if _branch_checked_out_elsewhere(repo, dref):
        return False, (f"{dref} is checked out in another worktree of {repo}; moving the "
                       f"ref behind that tree would desync it")
    cp = subprocess.run(["git", "-C", repo, "update-ref", "-m",
                         f"ollama-dispatch-slice --land-integration: {integ_branch}",
                         f"refs/heads/{dref}", new, old], capture_output=True, text=True)
    if cp.returncode != 0:
        return False, f"git update-ref refused: {(cp.stderr or cp.stdout).strip()[-400:]}"
    return True, f"moved {dref} {old[:8]} -> {new[:8]} (branch not checked out here)"


def _push_branch(repo, dref):
    """(pushed: True/False/None, detail). None = no remote to push to."""
    remotes = [r for r in git(repo, "remote", capture=True).splitlines() if r.strip()]
    if not remotes:
        return None, "no remote"
    remote = "origin" if "origin" in remotes else remotes[0]
    try:
        cp = subprocess.run(["git", "-C", repo, "push", remote, f"{dref}:{dref}"],
                            capture_output=True, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        return False, f"git push {remote} {dref} timed out"
    if cp.returncode != 0:
        return False, f"git push {remote} {dref} failed: {(cp.stderr or cp.stdout).strip()[-300:]}"
    return True, f"pushed {dref} to {remote}"


def open_slice_obligations(st, root=None):
    """Open deferred-concern obligations of this run (slice_obligations.py). Never raises."""
    try:
        import importlib.util as _ilu
        spec = _ilu.spec_from_file_location(
            "slice_obligations", os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                              "slice_obligations.py"))
        so = _ilu.module_from_spec(spec)
        spec.loader.exec_module(so)
        return so.open_obligations(st["label"], root=root or STATE_ROOT)
    except Exception:
        return []


def land_integration(st, ff_land=None, pusher=None, push=True):
    """LAND half (operator lever --land-integration): fast-forward the repo's default
    branch to the STAGED integration commit and push. Refuses unless the record says
    staged and the chain tip has not moved since. Returns the recorded status."""
    rec = st.get("integration")
    if not isinstance(rec, dict) or rec.get("status") != "staged":
        die(f"{st['label']}: nothing staged to land (integration record: "
            f"{(rec or {}).get('status')!r}). Run --integrate first.")
    # DEFERRED-CONCERN OBLIGATIONS (2026-10-03, slice_obligations): an intermediate
    # slice's concerns that its gate MOVED onto a dependent must have been discharged
    # by that dependent's green PASS. Any still open (dependent skipped, dropped,
    # never gated, or answered NOT-RESTORED) blocks the land -- a human decides.
    _open = open_slice_obligations(st)
    if _open:
        die(f"{st['label']}: {len(_open)} deferred concern(s) still OPEN -- refusing to "
            f"land:\n" + "\n".join(f"  {o['oid']} (from {o['from_slice']}, owed by "
                                    f"{o['restored_by']}): {o.get('what')}" for o in _open)
            + f"\n(see {STATE_ROOT}/_obligations/{st['label']}.json)")
    repo, dref, br = st.get("repo") or "", rec.get("onto"), rec.get("integrate_branch")
    cwt = st.get("chain_worktree")
    tip = git(cwt, "rev-parse", "HEAD", capture=True) if cwt and os.path.isdir(cwt) else None
    if tip and rec.get("chain_tip") and tip != rec["chain_tip"]:
        die(f"{st['label']}: the chain tip moved ({rec['chain_tip'][:8]} -> {tip[:8]}) since "
            f"{br} was staged -- re-run --integrate to re-stage, then land.")
    # ...and the OTHER side of the merge, which nothing used to check (2026-09-24).
    # The chain-tip test above proves the stage still reflects the chain; it says
    # nothing about main. Re-check main LIVE before touching it, and record `stale` so
    # the sweep re-stages and the watcher announces re-staging instead of re-announcing
    # a dead "clean". _ff_land() would also refuse this as a non-fast-forward, but by
    # then the operator has already been told the chain was clean and ready.
    why = base_divergence(repo, dref, br, rec.get("onto_tip"))
    if why:
        _integration_finish(st, dict(rec), INTEGRATION_STALE,
                            f"the stage on {br} is NO LONGER landable: {why}",
                            "land:base-moved")
        die(f"{st['label']}: refusing to land {br} onto {dref} -- {why}")
    ok, detail = (ff_land or _ff_land)(repo, dref, br)
    rec = dict(rec)
    if not ok:
        return _integration_finish(st, rec, "failed", f"could not land {br} onto {dref}: {detail}",
                                   "land")
    landed = git(repo, "rev-parse", dref, capture=True)
    # The scratch branch now equals dref; it existed only to be fast-forwarded.
    subprocess.run(["git", "-C", repo, "branch", "-D", br], capture_output=True)
    pushed, pdetail = (None, "push disabled") if not push else (pusher or _push_branch)(repo, dref)
    if pushed is False:
        print(f"# WARNING integration [{st['label']}]: landed but {pdetail} -- "
              f"`git -C {repo} push` by hand")
    return _integration_finish(st, rec, "passed",
                               f"landed {', '.join(rec.get('scope') or [])} onto {dref} @ "
                               f"{(landed or '?')[:8]} ({detail}; {pdetail})",
                               landed=landed, landed_at=datetime.now(timezone.utc)
                               .isoformat(timespec="seconds"), pushed=pushed)


def remove_worktree(cwt, wt):
    """Tear down a stale/partial slice worktree so AUTO can scaffold fresh."""
    subprocess.run(["git", "-C", cwt, "worktree", "remove", "--force", wt],
                   capture_output=True, text=True)
    if Path(wt).exists():
        subprocess.run(["rm", "-rf", wt], capture_output=True, text=True)
    # rm -rf alone leaves the worktree REGISTERED (prunable) with its branch still
    # "checked out" there, and the next scaffold's `git worktree add` for the same
    # slice then failed deterministically (Rivian s3, 2026-10-02: "git worktree
    # add failed: fatal: not a git repository: (null)" -> AUTO rc=2 -> escalated).
    subprocess.run(["git", "-C", cwt, "worktree", "prune"], capture_output=True, text=True)


def topo_sort(slices):
    """Kahn's algorithm; stable in plan order among ready nodes. Aborts on a
    cycle or an unknown dependency id."""
    by_id = {s["id"]: s for s in slices}
    if len(by_id) != len(slices):
        die("duplicate slice id in plan")
    indeg = {s["id"]: 0 for s in slices}
    adj = {s["id"]: [] for s in slices}
    for s in slices:
        for dep in s.get("depends_on", []):
            if dep not in by_id:
                die(f"slice {s['id']} depends_on unknown id {dep!r}")
            adj[dep].append(s["id"])
            indeg[s["id"]] += 1
    ready = [s["id"] for s in slices if indeg[s["id"]] == 0]
    order = []
    while ready:
        n = ready.pop(0)
        order.append(n)
        for m in adj[n]:
            indeg[m] -= 1
            if indeg[m] == 0:
                ready.append(m)
    if len(order) != len(slices):
        die("dependency cycle in plan (topo sort could not order all slices)")
    return order


def plan_candidates(arg):
    """The places a BARE plan label may live: the canonical plan-file store, then a
    same-named file in the cwd. Empty for anything that looks like a path."""
    if not arg or os.sep in arg or arg.startswith("~") or arg.endswith(".json"):
        return []
    return [os.path.join(os.path.expanduser("~/.ollama-dispatch/slice-plans"),
                         f"{arg}.slices.json"),
            os.path.abspath(f"{arg}.slices.json")]


def resolve_plan_arg(arg):
    """`ollama-dispatch-slice <plan>` takes a plan-file PATH; a bare LABEL (what the
    dashboard, qctl and the cancel marker all call a plan) used to die with a
    FileNotFoundError traceback (2026-10-08). An existing path wins; otherwise a bare
    label resolves to slice-plans/<label>.slices.json. Returns the path to use, or
    raises FileNotFoundError naming every candidate tried."""
    if os.path.exists(os.path.expanduser(arg)):
        return arg
    cands = plan_candidates(arg)
    for c in cands:
        if os.path.exists(c):
            return c
    if not cands:
        raise FileNotFoundError(f"no such plan file: {arg}")
    raise FileNotFoundError(f"no such plan {arg!r}: not a file, and as a bare label "
                            f"neither {cands[0]} nor {cands[1]} exists")


def load_plan(path):
    plan = json.loads(Path(os.path.expanduser(path)).read_text())
    for k in ("repo", "target", "slices"):
        if k not in plan:
            die(f"plan missing required key {k!r}")
    plan["repo"] = os.path.expanduser(plan["repo"])
    return plan


def plan_behavior_gap(plan):
    """BEHAVIOR COVERAGE (2026-10-03, replay-bfmr-replace-tracking): a plan whose
    slices dropped the top-level intent's behavioral clauses (throw/never/must/
    trim/exactly...) gates every slice on SHAPE only, so wrong code lands green.
    Returns a one-line reason when some behavioral clause reaches no slice intent,
    else None. Fail-OPEN only on a plan with no top-level intent (nothing to
    compare); fail-CLOSED if the shared checker cannot be loaded."""
    top = plan.get("intent")
    if not isinstance(top, str) or not top.strip():
        return None
    try:
        import importlib.util
        spec = importlib.util.spec_from_file_location(
            "omnibus_slice_cov", os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                              "omnibus_slice.py"))
        m = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(m)
        miss = m.uncovered_behavior(top, [s for s in plan.get("slices") or []
                                          if isinstance(s, dict)])
    except Exception as e:
        return f"behavior-coverage check could not run ({e.__class__.__name__}: {e})."
    if not miss:
        return None
    return (f"{len(miss)} behavioral clause(s) of the top-level intent are carried by "
            f"NO slice (e.g. {miss[0][:120]!r}); every slice gate would verify shape only.")


def state_path(label):
    return os.path.join(STATE_ROOT, f"{label}.json")


# ==============================================================================
# AUTO-FEED (the owner 2026-09-18: "auto needs to auto ... one job creates the next ...
# can we do the auto author and have the code work then auto feed from the output
# of the auto author?").
#
# WHAT WAS MISSING. --execute is a resumable state machine that advances ONE
# checkpoint and returns. Authoring a slice already flows straight into its CODING
# enqueue inside a single --execute (auto-confirm -> preflight -> enqueue). What it
# could NOT do was carry on by itself: when that coding job finished, NOTHING
# committed it onto the chain or started the next slice until a human ran --execute
# again. So features landed hours apart, targets sat as authored-but-unimplemented
# stubs, and the queue only ever showed one job per chain.
#
# THE FIX IS EVENT-DRIVEN, NOT A POLLING LOOP:
#   * gate-on-complete.py (which ALREADY runs on every job completion) recognises a
#     job label that belongs to a slice run and fires `--advance-detached` here;
#   * `--advance-detached` re-enters --execute in a DETACHED process under a
#     per-plan lock, so at most one advance is ever in flight and a dead/finished
#     coordinator session never stalls the chain;
#   * --execute then does exactly what it always did -- commit the converged slice
#     forward, author the next one, enqueue its coding job -- with no human step.
# The chain therefore self-drives: author -> code -> commit -> next author -> ...
LOCK_SUFFIX = ".advance.lock"
# --execute exit code when another --execute already holds this plan's lock: a
# machine-readable abstain, distinct from a real failure (1) or a usage error (2).
EXIT_DRIVER_LIVE = 4


def lock_path(label):
    return os.path.join(STATE_ROOT, f"{label}{LOCK_SUFFIX}")


def _pid_is_zombie(pid):
    """True if `pid` is a ZOMBIE (exited, not yet reaped). Unknown -> False."""
    try:
        out = subprocess.run(["ps", "-o", "stat=", "-p", str(int(pid))],
                             capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return False
    return out.startswith("Z")


def _pid_alive(pid):
    """PURE-ish (one signal 0 [+ one ps]). True if a LIVE process with this pid exists.

    ZOMBIES ARE DEAD (2026-10-06, soak seed 31). signal 0 succeeds on a zombie, so a
    driver SIGKILLed while its parent never reaps it (any long-lived spawner that
    Popen()s an --execute and does not wait) kept the per-plan advance lock "live":
    every later --execute and completion hook abstained ("another --execute is
    already driving this plan (pid N)") and the chain sat idle for 20+ minutes with
    nothing to kill. A zombie holds no lock, no worktree, nothing -- treat it as gone."""
    try:
        os.kill(int(pid), 0)
    except OSError as e:
        if e.errno != errno.EPERM:          # EPERM: exists, just not ours
            return False
    except (TypeError, ValueError):
        return False
    return not _pid_is_zombie(pid)


def lock_is_stale(payload, alive=_pid_alive, now=None, max_age_s=24 * 3600):
    """PURE given `alive`/`now`. Is an existing advance lock dead wood?

    A lock is stale when its owner pid is gone, or when it is older than max_age_s
    (a wedged authoring run must not block the chain forever). Unparsable payload =>
    stale: a lock we cannot read is worse than no lock, because it would jam the
    pipeline permanently with nothing to kill.

    max_age_s was 6h while the lock only covered the short-lived --advance-detached
    spawner. Since 2026-09-23 EVERY --execute holds it for its whole run -- and an
    --execute that authors a slice blocks on AUTO's author + refine ladder, whose
    honest worst case (~168 iterations plus queue waits behind other jobs) can pass
    6h while perfectly healthy. Reclaiming a LIVE owner's lock re-opens the exact
    two-drivers-one-worktree race the lock exists to prevent, so the age cap is a
    last resort for a wedged-but-alive process, not a normal path: 24h."""
    if not isinstance(payload, dict):
        return True
    pid = payload.get("pid")
    if not pid or not alive(pid):
        return True
    started = payload.get("started_at")
    if not started:
        return False
    try:
        t0 = datetime.fromisoformat(str(started))
        if t0.tzinfo is None:
            t0 = t0.replace(tzinfo=timezone.utc)
    except Exception:
        return True
    ref = now or datetime.now(timezone.utc)
    return (ref - t0).total_seconds() > max_age_s


def acquire_advance_lock(label):
    """Take the per-plan advance lock, or return None if a live advance holds it.
    O_CREAT|O_EXCL so two completion hooks firing in the same instant cannot both
    win. A stale lock (dead owner / >6h old) is reclaimed."""
    os.makedirs(STATE_ROOT, exist_ok=True)
    p = lock_path(label)
    # ATOMIC PUBLISH (2026-10-05, pipeline-canary: two --execute drivers started
    # together BOTH took the lock). O_CREAT|O_EXCL made the file visible EMPTY and
    # the payload was written after; the second driver read "", which parses as no
    # payload -> lock_is_stale() -> unlinked the winner's lock and took its own.
    # The payload is now written to a private temp file and hard-linked into place:
    # link() fails if the lock exists, and the lock is never visible without its
    # payload.
    for _ in range(2):
        tmp = f"{p}.{os.getpid()}.{time.monotonic_ns()}.tmp"
        try:
            with open(tmp, "w") as f:
                json.dump({"pid": os.getpid(),
                           "started_at": datetime.now(timezone.utc).isoformat()}, f)
            os.link(tmp, p)
        except FileExistsError:
            try:
                payload = json.loads(Path(p).read_text())
            except Exception:
                payload = None
            if not lock_is_stale(payload):
                return None
            try:
                os.unlink(p)
            except OSError:
                return None
            continue
        finally:
            try:
                os.unlink(tmp)
            except OSError:
                pass
        return p
    return None


def release_advance_lock(label):
    try:
        os.unlink(lock_path(label))
    except OSError:
        pass


def read_lock_owner(label):
    """The payload of this plan's advance lock ({pid, started_at}) if a LIVE driver
    holds it, else None. PURE-ish (one file read + one signal 0)."""
    try:
        payload = json.loads(Path(lock_path(label)).read_text())
    except Exception:
        return None
    return None if lock_is_stale(payload) else payload


def _write_lock_owner(path, pid):
    """Re-point an existing lock at `pid`. The lock is only as good as the pid it
    names: _pid_alive() decides staleness, so a lock naming a process that has
    already exited is reclaimed by the very next hook fire."""
    # tmp + os.replace: a plain write_text() truncates first, and a hook reading
    # the lock in that instant saw "" -> stale -> reclaimed a LIVE driver's lock.
    try:
        tmp = f"{path}.{os.getpid()}.{time.monotonic_ns()}.tmp"
        Path(tmp).write_text(json.dumps(
            {"pid": int(pid), "started_at": datetime.now(timezone.utc).isoformat()}))
        os.replace(tmp, path)
        return True
    except Exception:
        return False


# ------------------------------------------------------------------------------
# COALESCED RE-TRIGGER (2026-09-23). When a completion hook fires while a live
# --execute already holds this plan's lock, the event must not be LOST -- the
# holder may be blocked inside AUTO for an hour and will exit without knowing a
# later job (its own refine round, a coding job it did not start) has completed.
# The blocked hook leaves a one-byte "advance requested" marker; the holder
# consumes it on exit and fires exactly ONE fresh detached advance, which re-reads
# the state and does whatever is now due. Many events while blocked => one marker
# => one advance: no storm, nothing dropped.
REQUEST_SUFFIX = ".advance.requested"


def requested_path(label):
    return os.path.join(STATE_ROOT, f"{label}{REQUEST_SUFFIX}")


def request_advance(label):
    """Ask the lock holder to run one fresh advance when it exits. Idempotent."""
    try:
        os.makedirs(STATE_ROOT, exist_ok=True)
        Path(requested_path(label)).write_text(
            datetime.now(timezone.utc).isoformat())
        return True
    except Exception:
        return False


def consume_requested_advance(label):
    """True exactly once per request: removes the marker and reports it was there."""
    try:
        os.unlink(requested_path(label))
        return True
    except OSError:
        return False


# ------------------------------------------------------------------------------
# STRANDED-EVENT SWEEP (2026-09-23, Fable pass 2 -- "the chain didn't advance").
#
# ROOT CAUSE. The chain has exactly ONE re-arm trigger: the job-completion hook
# (gate-on-complete -> --advance-detached). Every other way the run state can
# change leaves NO future event behind, so the plan goes silently idle:
#
#   1. A blocked hook leaves the .advance.requested marker for the lock holder to
#      consume ON EXIT -- but a holder that dies without running its `finally`
#      (SIGTERM/SIGHUP from a Bash-tool timeout or a closed terminal, kill -9, a
#      reboot) strands the marker forever. Live on 2026-09-23:
#      arr-webhook-yearly-upgrade-batches -- jobs 8339c3ee0a3f (16:40Z) and
#      26b6b62cbce9 (16:56Z) each logged `slice-autofeed (advance)` in the daemon
#      log, neither produced an `===== advance` header, and the marker was only
#      consumed 40 minutes later by the owner's hand-run --execute (the lone 17:37:11Z
#      header IS that consume). Nothing swept it; nothing ever would have.
#   2. The operator levers (--skip/--retry/--reland/--accept/--complete/
#      --confirm-slice) change the state and print "Re-run --execute" -- an
#      instruction to a human, not an event. 15 plans on this machine were
#      resolved by a lever AFTER their last advance and never advanced again
#      (bg-state-s1-init-db s3..s9 skipped 23:11Z on 2026-09-19, last advance
#      22:08Z; bg-profile, bg-eraser, bg-health-s3-heartbeat, aw-alert-filters,
#      ... same shape). Those levers now re-arm the plan themselves (see main()).
#   3. A hook that fires while its target job is not yet visible, or a hook
#      process that dies, or SLICE_AUTOFEED off: an ENQUEUED slice whose job is
#      long finished with no driver ever polling it.
#   4. (2026-09-24, Fable pass 4 -- the owner: "shouldn't the jobs relaunch without
#      us?") A plan with DUE work and NO event in flight at all: its next slice
#      is PENDING/CONFIRMED (or FAILED/BLOCKED that execute() would auto-retry/
#      revive) with no job_id, no marker, and no live driver. Cases 1-3 cannot
#      see it: each needs a marker or an ENQUEUED job to age out. How a plan
#      gets here: a driver SIGKILLed / a reboot between AUTO returning and the
#      coding enqueue (no job in flight => no completion hook will ever fire),
#      `--publish-dag` with no --execute, a lever run with --no-advance, a
#      plan registered and never driven. main() has promised since 09-23 that
#      "the --sweep covers [SIGKILL] from launchd"; until this case it did not.
#      The signal is the plan's own IDLE CLOCK: seconds since its run-state
#      file or its .advance.log was last written (every state change rewrites
#      the file; every detached advance appends a header), past
#      LOST_EVENT_GRACE_S. That same clock makes it storm-proof: the kick
#      appends the header, so even an --execute that changes nothing costs one
#      process per grace window, not one per pass.
#      NOT a kick: a chain stopped on ESCALATED or AWAITING_REVIEW (human
#      decisions -- the existing rule below, preserved), a PENDING slice
#      waiting on an unsatisfied dependency, or a plan with ANY slice ENQUEUED
#      (the hook and cases 1-3 own it). 09-24 audit: the four plans the owner's
#      question was about (bo-O-qwen36-35b-a3b-studio, arr-codec-floor,
#      aw-sched-routes, rt-bfmr-*) were all ESCALATED before dispatch (vacuous
#      must_contain gate / preflight NO-GO), which this case correctly leaves
#      alone; what silenced them was dispatch-escalation-watcher crashing on
#      every pass since 2026-09-23T22:42Z -- fixed alongside this.
#
# THE SWEEP is the missing periodic consumer for all four. It is idempotent and
# storm-proof by construction: it fires at most ONE detached advance per plan per
# pass, only when NO live driver holds the plan's lock, and only for a positive
# signal (a marker, a terminal job past a grace window, or due work idle past
# it). A plan parked in ESCALATED with nothing else due is left alone -- that is
# a human decision, and --execute on it would just print the ESCALATED stanza
# again every 5 minutes.
# dispatch-ack-reconcile (launchd, StartInterval 300) calls `--sweep` each pass.
LOST_EVENT_GRACE_S = 20 * 60
_TERMINAL_QSTATES = ("done", "failed", "error", "done_unconverged", "cancelled")


COLLISION_RETRY_GRACE_S = 10 * 60


def _dep_statuses(st, sid):
    """PURE. The statuses of this slice's declared dependencies (None for a dep the
    plan does not declare -- never satisfied, never failed: a wait)."""
    slices = st.get("slices") or {}
    return [(slices.get(d) or {}).get("status")
            for d in ((slices.get(sid) or {}).get("depends_on") or [])]


def first_due_slice(st):
    """PURE. (sid, status) of the first slice a fresh --execute would ACT on with no
    human step in between, or None when the chain is stopped, waiting or in flight.

    Mirrors execute()'s walk of `order` (sweep case 4 must agree with it, or the
    kick is a no-op every pass): SATISFIED slices are stepped over; the first
    slice that is not decides. ESCALATED is stepped over (2026-09-27: its
    dependents are BLOCKED, independent slices still run); AWAITING_REVIEW is a
    human park (--manual-review) and is never kicked.
    ENQUEUED is in flight (the completion hook and sweep cases 1-3 own it). A
    CONFIRMED slice with a collision record belongs to the collision retry. A
    PENDING/CONFIRMED slice with a FAILED/BLOCKED/ESCALATED dependency is marked
    BLOCKED and stepped over by execute(); one waiting on a dependency that is
    merely unfinished is a real wait ("stop here"). FAILED follows execute() too:
    auto-retried when its deps are satisfied, stepped over (chain_may_pass) when
    not. BLOCKED is revived once no dependency is failed, else stepped over."""
    slices = st.get("slices") or {}
    for sid in st.get("order") or list(slices):
        s = slices.get(sid) or {}
        status = s.get("status")
        if status in SATISFIED:
            continue
        deps = _dep_statuses(st, sid)
        dep_bad = any(d in (FAILED, BLOCKED, ESCALATED) for d in deps)
        deps_ok = all(d in SATISFIED for d in deps)
        if status == BLOCKED:
            if dep_bad:
                continue
            return (sid, status)
        if status == FAILED:
            if not deps_ok:
                continue
            return (sid, status)
        if status in (PENDING, CONFIRMED):
            if status == CONFIRMED and isinstance(s.get("last_collision"), dict):
                return None
            if dep_bad:
                continue
            if not deps_ok:
                return None
            return (sid, status)
        if status == ESCALATED:
            continue         # its dependents are BLOCKED above; independents are due
        return None          # AWAITING_REVIEW (a human park) / ENQUEUED / unknown
    return None


def plan_idle_age_s(label, state_file, now=None):
    """Seconds since this plan last showed any life on disk: the newer of its
    run-state file (every state change rewrites it) and its .advance.log (every
    detached advance appends a header before --execute runs). None when the state
    file cannot be timed -- the sweep then abstains from case 4 for it."""
    try:
        t = os.path.getmtime(state_file)
    except OSError:
        return None
    try:
        t = max(t, os.path.getmtime(os.path.join(STATE_ROOT, f"{label}.advance.log")))
    except OSError:
        pass
    return max(0.0, (time.time() if now is None else now) - t)


def plan_needs_kick(st, by_id, sidecar_age, live_owner, marker, now=None,
                    idle_age=None, passed_land=None):
    """PURE given its inputs. Why this plan needs a detached advance, or None.

    `by_id`        queue job id -> status (from all_job_statuses()[0]);
    `sidecar_age`  job id -> seconds since its done.json (done_sidecar_age_s);
    `live_owner`   read_lock_owner(label) -- a live driver means NOT ours to kick;
    `marker`       whether an .advance.requested marker exists for the plan;
    `now`          epoch seconds (for the cwd-collision retry window);
    `idle_age`     plan_idle_age_s(...) -- seconds since the plan last wrote its
                   state or advance log; None (unknown) disables case 4;
    `passed_land`  (st, sid) -> job id when that slice's newest coding job passed its
                   gate but the slice never landed (auto_land_passed); None skips."""
    if live_owner:
        return None
    now = time.time() if now is None else now
    if marker:
        return ("a completion event was left as an .advance.requested marker and "
                "the lock holder that should have consumed it on exit never did")
    # A plan that converged before the integration stage existed (or whose last
    # driver died between its final land and the stage) has no `integration`
    # record at all. One advance stages it and records the outcome, so this fires
    # at most once per plan: every outcome -- staged, passed, failed, unavailable,
    # n/a -- leaves a record, and a record is never re-kicked from here.
    if plan_converged(st) and not isinstance(st.get("integration"), dict):
        return "converged with no integration record -- staging its chain for landing"
    slices = st.get("slices") or {}
    if passed_land is not None:
        for sid in st.get("order") or list(slices):
            if (slices.get(sid) or {}).get("status") not in (ESCALATED, ENQUEUED):
                continue
            try:
                jid = passed_land(st, sid)
            except Exception:
                jid = None
            if jid:
                return (f"slice {sid} is {slices[sid].get('status')} but its newest coding "
                        f"job {jid} PASSED its gate -- auto-landing it")
    for sid in st.get("order") or list(slices):
        s = slices.get(sid) or {}
        # A CONFIRMED slice that bounced off a cwd-exclusive collision (another
        # queue job owned its worktree) was deliberately left CONFIRMED, not
        # escalated (#5). Nothing else re-drives it: its own advance already ran
        # and returned. Re-kick once the grace window has passed so the gate gets
        # another look when the colliding job has likely finished.
        if s.get("status") == CONFIRMED and isinstance(s.get("last_collision"), dict):
            try:
                age = now - float(s["last_collision"].get("at") or 0)
            except (TypeError, ValueError):
                age = None
            if age is not None and age >= COLLISION_RETRY_GRACE_S:
                return (f"slice {sid} is CONFIRMED but its last preflight hit a "
                        f"cwd-exclusive collision {int(age // 60)} min ago -- re-gating")
            continue
        if s.get("status") != ENQUEUED:
            continue
        jid = s.get("job_id")
        if not jid:
            continue
        qs = by_id.get(jid)
        if qs is None:
            qs = _sidecar_status(jid)
        if qs is None and by_id:
            # VANISHED: a readable, non-empty queue table without this job and no
            # sidecar. Nothing else will ever fire an advance for it (no completion
            # event exists), so the sweep must. A fresh enqueue gets a short grace
            # in case the table read raced the enqueue; a legacy record with no
            # stamp is kicked outright -- the table is positive evidence.
            enq_at = s.get("enqueued_at")
            try:
                age = (now - float(enq_at)) if enq_at else None
            except (TypeError, ValueError):
                age = None
            if enq_at is None or (age is not None and age >= VANISHED_JOB_GRACE_S):
                return (f"slice {sid}'s coding job {jid} is unknown to the queue and has "
                        f"no completion sidecar (vanished) -- re-gating it")
            continue
        if qs not in _TERMINAL_QSTATES:
            continue
        age = sidecar_age(jid)
        if age is None or age < LOST_EVENT_GRACE_S:
            continue
        return (f"slice {sid}'s coding job {jid} has been {qs} for {int(age // 60)} min "
                f"and no driver ever polled it (lost completion event)")
    # Case 4: due work, nothing in flight, nobody driving, idle past the window.
    if idle_age is not None and idle_age >= LOST_EVENT_GRACE_S \
            and not any((s or {}).get("status") == ENQUEUED for s in slices.values()):
        due = first_due_slice(st)
        if due:
            sid, status = due
            return (f"slice {sid} is {status} with no job in flight and no driver, and "
                    f"the plan has been idle for {int(idle_age // 60)} min -- nothing "
                    f"else will ever fire an advance for it")
    return None


def sweep_stranded_advances(fire=None, statuses=None, now=None, verbose=True,
                            passed_land=None):
    """Fire ONE detached advance for every plan under STATE_ROOT that has a
    stranded completion event and no live driver. Returns the labels fired.
    `fire`/`statuses`/`now` exist so --self-test can run this offline."""
    fire = fire or advance_detached
    if passed_land is None:
        passed_land = lambda st_, sid_: passed_job_to_land(          # noqa: E731
            st_, sid_, slice_coding_jobs(st_, sid_))[0]
    fired, checked, attention = [], 0, []
    try:
        names = sorted(os.listdir(STATE_ROOT))
    except OSError:
        return fired
    by_id = statuses
    for n in names:
        if not n.endswith(".json") or ".bak" in n:
            continue
        label = n[:-5]
        try:
            st = json.loads(Path(os.path.join(STATE_ROOT, n)).read_text())
        except Exception:
            continue
        if not isinstance(st, dict) or st.get("label") != label or not st.get("slices"):
            continue
        checked += 1
        if _plan_cancelled(label):
            continue            # a HUMAN cancel is terminal: never re-armed by a sweep
        marker = os.path.exists(requested_path(label))
        live = read_lock_owner(label)
        has_enq = any((s or {}).get("status") == ENQUEUED for s in st["slices"].values())
        if has_enq and by_id is None and not live:
            # One queue round-trip per sweep, and only when some plan needs it.
            by_id = all_job_statuses()[0]
        reason = plan_needs_kick(st, by_id or {}, lambda j: done_sidecar_age_s(j, now),
                                 live, marker, now=now,
                                 idle_age=plan_idle_age_s(label, os.path.join(STATE_ROOT, n),
                                                          now),
                                 passed_land=passed_land)
        if not reason:
            continue
        plan_arg = st.get("plan_path")
        if not plan_arg or not os.path.exists(plan_arg):
            attention.append(label)
            if verbose:
                print(f"# sweep: {label} needs an advance ({reason}) but its plan file is "
                      f"missing ({plan_arg!r}) -- run --execute by hand once to register it")
            continue
        # The sweep IS the consumer of a stranded marker: clear it before firing so
        # the fresh driver's own exit does not fire a second, redundant advance.
        consume_requested_advance(label)
        if verbose:
            print(f"# sweep: {label}: {reason} -- firing one detached advance")
        fire(st, plan_arg)
        fired.append(label)
    if verbose and (fired or attention):
        print(f"# sweep: {checked} plan(s) checked, {len(fired)} advance(s) fired"
              + (f", {len(attention)} need(s) a hand --execute" if attention else ""))
    return fired


def _plan_cancelled(label):
    """The human-cancel record covering this plan (see plan_cancel.py), or None."""
    try:
        import plan_cancel
        return plan_cancel.cancelled(label, runs_dir=STATE_ROOT)
    except Exception:
        return None


HANDOFF_EMIT = os.path.expanduser("~/bin/handoff-emit.py")

# FOREIGN TRACKED HARNESS (2026-10-05, s3fix). replay-endorse-20261003 was snapshotted
# from resell-tracker main while main still TRACKED a leaked Sep-19 `bfmr-split-wiring`
# harness (stripped upstream later in 980cf77). Every slice worktree inherited it, so
# the scaffold's TASK.md/verify.sh/refimpl.py/check_literals.py were MODIFICATIONS of
# tracked files -> every author job launched "dirty (4 paths)" -> UNTRUSTED, and the
# model started from another task's harness. The launch-dirty check is right to count
# tracked edits; the defect is the base. Refuse to author on such a base (no GPU spent)
# and name the one-line fix, instead of burning jobs on an unattributable tree.
_HARNESS_ROOT_FILES = ("TASK.md", "verify.sh", "refimpl.py", "check_literals.py",
                       "AUTO-TASK.md", "auto-harness-check.py", ".dispatch-harness.json")


def foreign_tracked_harness(tree, label):
    """Harness files TRACKED at `tree`'s HEAD that belong to ANOTHER task (TASK.md's
    `# TASK: <name>` is not this plan's / its parent's), else []. A sub-plan whose base
    is its parent's own sealed harness is not foreign. Fail-open ([]) on any error."""
    try:
        r = subprocess.run(["git", "-C", str(tree), "ls-files", "--", *_HARNESS_ROOT_FILES],
                           capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            return []
        tracked = [p for p in r.stdout.splitlines() if p.strip()]
        if "TASK.md" not in tracked:
            return []
        t = subprocess.run(["git", "-C", str(tree), "show", "HEAD:TASK.md"],
                           capture_output=True, text=True, timeout=30)
        m = re.search(r"^#\s*TASK:\s*(\S+)", t.stdout or "", re.M)
        if not m:
            return []
        name, lab = m.group(1), str(label or "")
        root = re.sub(r"-chain$", "", name)
        if lab and (name.startswith(lab) or lab.startswith(root)):
            return []
        return tracked
    except Exception:
        return []


def plan_handoff_row_re(st):
    """Regex for every queue/handoff label a plan's slices produce: the coding job
    <plan>-<sid>, its auto-author-/auto-refine-/gate-/regate-/secondop- relatives, and
    -cN/-rN/-esc decorations (a sub-plan <plan>-<sid>-... is covered too: it inherits
    the cancel)."""
    sids = sorted((st.get("slices") or {}).keys(), key=len, reverse=True)
    if not sids:
        return None
    return re.compile(r"^(?:auto-(?:author|refine)-|gate-|regate-|secondop-)?%s-(?:%s)(?:-.*)?$"
                      % (re.escape(str(st["label"])), "|".join(re.escape(s) for s in sids)))


def retire_cancelled_handoff_rows(st, run=subprocess.run, handoff=None):
    """CANCEL RETIRES ITS HANDOFF ROWS (2026-10-05, s3fix: replay-endorse was cancelled
    at 17:04Z but its 16 failed s3 rows sat in the handoff panel awaiting action).
    Marks every COMPLETE handoff row of this plan acted, with a fixed reason naming the
    cancel. Never touches a row awaiting sign-off, nor a pending (in-flight) row.
    Returns the ids marked. Never raises -- the cancel itself has already happened."""
    handoff = handoff or HANDOFF_EMIT
    rx = plan_handoff_row_re(st)
    if rx is None:
        return []
    try:
        cp = run([sys.executable, handoff, "--json"], capture_output=True, text=True,
                 timeout=120)
        data = json.loads(cp.stdout or "{}")
    except Exception as e:
        print(f"# {st['label']}: could not read the handoff panel ({e}); its rows are "
              f"NOT retired -- clear them with handoff-emit.py --acted.")
        return []
    rows = (data.get("complete") or []) + (data.get("eval_arms_complete") or [])
    ids = [r["id"] for r in rows
           if r.get("id") and rx.match(str(r.get("label") or ""))
           and not r.get("awaiting_signoff")]
    if not ids:
        return []
    # A FIXED reason: the human's free-text cancel reason can contain words like
    # "landed"/"live" that handoff-emit's merge-claim guard refuses without --commit.
    why = (f"plan {st['label']} cancelled via ollama-dispatch-slice --cancel "
           f"(record: {st['label']}.cancelled) -- row retired, not reviewed")
    try:
        cp = run([sys.executable, handoff, "--acted", *ids, "--reason", why],
                 capture_output=True, text=True, timeout=300)
        ok = cp.returncode == 0
    except Exception:
        ok = False
    if not ok:
        print(f"# {st['label']}: handoff-emit refused/failed retiring {len(ids)} row(s) -- "
              f"clear them by hand: python3 {handoff} --acted {' '.join(ids)}")
        return []
    print(f"# {st['label']}: retired {len(ids)} handoff row(s) of the cancelled plan: "
          f"{' '.join(ids)}")
    return ids


def warn_if_driver_live(st, what):
    """Operator levers (--retry-slice, --regate, --accept/--complete/--skip/
    --reland-slice) act on a slice's worktree/state directly. If a live --execute
    is driving this plan, its in-flight AUTO may touch the SAME worktree right
    after the operator does (2026-09-23: --complete-slice landed aw-sched-runner
    s19 under a detached --execute that then re-sealed the tree). Warn, do not
    refuse: the operator is the reviewer, and killing the driver first is the
    documented recovery."""
    owner = read_lock_owner(st["label"])
    if not owner:
        return False
    print(f"# WARNING: a live --execute (pid {owner.get('pid')}, since "
          f"{owner.get('started_at')}) is driving plan {st['label']!r}. {what} acts "
          f"on a worktree that driver may also act on. To be safe: "
          f"`kill {owner.get('pid')}` first, or expect its next step to race yours.")
    return True


def planned_label(plan_label, sid):
    """PURE. The queue label a slice's CODING job will carry -- and therefore the
    label its PLANNED placeholder row is published under, so enqueuing the real job
    releases the placeholder automatically (ollama-queue._release_planned_rows)."""
    return f"{plan_label}-{sid}"


def dag_rows(st):
    """PURE. The planned-row spec for the WHOLE plan, in topological order:
    [{label, note, after}], where `after` is the previous slice's planned label
    (None for the first). The owner's ask is visibility of the worklist, so this
    publishes one row per slice -- a slice's author job and coding job are two
    phases of the same worklist item, and the real jobs replace the row as they
    materialise.

    A slice that is already DONE is NOT published: it has landed on the chain, so a
    placeholder for it would be a phantom worklist item."""
    rows, prev = [], None
    pos = {sid: i for i, sid in enumerate(st["order"])}
    for sid in st["order"]:
        s = st["slices"][sid]
        if s["status"] in SATISFIED:
            continue
        lbl = planned_label(st["label"], sid)
        # The edge names the slice's REAL dependency when it has an unsatisfied one
        # (2026-09-23, Fable pass 3): a restated plan re-wired rt-bfmr-pending-
        # sync-scope s3 from s2 to s1, but the row still read "held-on-dep -> s2"
        # after s2 landed, so the queue showed a satisfied dependency on a slice
        # that execute() was (correctly) holding for s1. With no declared
        # dependency the row chains on the previous unsatisfied slice, which is
        # the serial order execute() walks anyway.
        deps = [d for d in (s.get("depends_on") or [])
                if d in st["slices"] and st["slices"][d]["status"] not in SATISFIED]
        after = (planned_label(st["label"], max(deps, key=lambda d: pos.get(d, -1)))
                 if deps else prev)
        rows.append({"label": lbl, "note": (s.get("title") or sid)[:120], "after": after})
        prev = lbl
    return rows


def publish_dag(st):
    """Publish the whole plan into the queue as dependency-gated PLANNED rows, so
    The owner sees the entire worklist immediately instead of one job at a time. Each row
    names the previous slice's label as its `--after`, and the queue releases a row
    when the real job for that label is enqueued (re-pointing the downstream at the
    real id). Idempotent: `plan-add` is a no-op for a label already published or
    already materialised."""
    rows = dag_rows(st)
    group = f"slice-{st['label']}"
    published, failed = [], []
    for r in rows:
        cmd = ["python3", QUEUE, "plan-add", "--label", r["label"],
               "--group", group, "--note", r["note"], *_bundle_args(st)]
        if r["after"]:
            cmd += ["--after", r["after"]]
        cp = subprocess.run(cmd, capture_output=True, text=True)
        out = (cp.stdout or "").strip()
        if cp.returncode != 0:
            print(f"# WARNING: could not publish planned row {r['label']}: "
                  f"{(cp.stderr or out).strip()[:200]}")
            failed.append(r["label"])
            continue
        published.append(r["label"])
        print(f"#   {out}")
    # ROOT CAUSE (2026-09-21, the owner: "we should already have a planned placeholder
    # that should be getting used" -- esim-global-s4 had no row, live or planned,
    # though it was still `blocked`). This used to set dag_published=True no
    # matter what -- one dropped row (a plan-add call that hard-failed) was gone
    # for the rest of the chain's life, because `execute()` only calls
    # publish_dag while `not st.get("dag_published")`. Only latch it once EVERY
    # row actually published, so a partial failure retries -- and republishes
    # -- on the next `--execute` instead of being silently given up on forever.
    if not failed:
        st["dag_published"] = True
    save_state(st)
    print(f"# published {len(published)} planned row(s) for {st['label']} "
          f"-- the whole DAG is visible in `ollama-queue.py status`."
          + (f" ({len(failed)} row(s) failed to publish and will be retried "
             f"next --execute: {', '.join(failed)})" if failed else ""))
    return published


def advance_detached(st, plan_arg, extra_args=None):
    """Re-enter `--execute` in a DETACHED process under the per-plan lock. This is
    what the job-completion hook calls: the chain advances itself without any live
    session, and the lock makes a double-fire a no-op instead of two colliding
    dispatches on one worktree."""
    label = st["label"]
    lk = acquire_advance_lock(label)
    if lk is None:
        # Not lost: the holder fires one fresh advance when it exits (see
        # REQUEST_SUFFIX). Before 2026-09-23 this event simply vanished.
        request_advance(label)
        owner = read_lock_owner(label) or {}
        print(f"# {label}: an advance is already in flight (pid {owner.get('pid')}) "
              f"-- not starting a second one; queued ONE follow-up advance for when "
              f"it exits.")
        return 0
    os.makedirs(STATE_ROOT, exist_ok=True)
    log = os.path.join(STATE_ROOT, f"{label}.advance.log")
    cmd = [sys.executable, os.path.abspath(__file__), plan_arg, "--execute",
           "--release-lock-for", label] + list(extra_args or [])
    with open(log, "a") as lf:
        lf.write(f"\n===== advance {datetime.now(timezone.utc).isoformat()} =====\n")
        lf.flush()
        proc = subprocess.Popen(cmd, stdout=lf, stderr=subprocess.STDOUT,
                                stdin=subprocess.DEVNULL, start_new_session=True)
    # ROOT CAUSE (2026-09-23, arr-webhook-yearly-upgrade-batches s1/s6/s7/s8 and
    # aw-sched-runner s19 -- five two-drivers-one-worktree races in one day). The
    # lock named THIS spawner's pid, and this process exits milliseconds after
    # Popen. From then on lock_is_stale() saw a dead owner, so the NEXT completion
    # hook reclaimed the lock and started a second detached --execute alongside the
    # first, which was still blocked inside AUTO's author/refine ladder. The lock
    # therefore excluded nothing beyond the same instant. Name the CHILD instead:
    # it is alive by the time Popen returns, and it releases the lock itself
    # (--release-lock-for) however it ends.
    _write_lock_owner(lk, proc.pid)
    print(f"# {label}: advance started (detached, pid {proc.pid}) -> {log}")
    return 0


# Fields that are the PLAN's to state, not the run's to remember. Everything else in
# a slice row (status, job_id, worktree, counters, reasons) is run history.
# target / edit_files / reads (2026-10-05, rt-egift-link-s1): per-slice file scope --
# see slice_target().
SPEC_FIELDS = ("title", "intent", "must_contain", "verify_shape", "kind", "entry_point",
               "target", "edit_files", "reads")


def refresh_spec_from_plan(st, plan):
    """Re-read the plan's SPEC fields into the run state for every slice that has not
    landed yet. Returns the number of slices whose spec changed.

    THE BUG THIS FIXES (2026-09-19). load_state() copied intent/must_contain/
    verify_shape out of the plan EXACTLY ONCE, when the run state was first created,
    and never looked at the plan again. So editing the plan had no effect on a run in
    progress -- and the pipeline's own escalation message tells you to do exactly
    that: "Restate this slice's must_contain in the plan ... then --retry-slice <sid>".
    Following that instruction silently re-ran the slice against the OLD, still-vacuous
    literals; the only thing that ever worked was hand-editing the run-state JSON,
    which is the dishonest bypass this pipeline forbids. (Hence the
    `.bak-mustcontainfix` / `.bak-intentfix` files sitting next to both the plans AND
    the run states: every previous spec fix had to be applied twice, by hand.)

    SAFE BY CONSTRUCTION. A slice in SATISFIED is never touched: its work is already
    committed on the chain under the spec it was authored against, and rewriting that
    row would make the run state misdescribe a landed commit. Only slices with nothing
    landed take the new spec -- which is precisely the set a plan edit is meant to
    affect. depends_on is refreshed the same way, and the execution order is recomputed
    from the plan so a re-wired dependency actually re-orders the chain."""
    p_sl = {s["id"]: s for s in plan.get("slices", [])}
    changed = []
    for sid, s in st.get("slices", {}).items():
        ps = p_sl.get(sid)
        if not ps or s.get("status") in SATISFIED:
            continue
        for k in SPEC_FIELDS:
            if k not in ps:
                continue
            if s.get(k) != ps[k]:
                s[k] = ps[k]
                changed.append(f"{sid}.{k}")
        dep = ps.get("depends_on", [])
        if s.get("depends_on") != dep:
            s["depends_on"] = dep
            changed.append(f"{sid}.depends_on")
    # New slices added to the plan after the run started must still be picked up.
    for sid, ps in p_sl.items():
        if sid not in st.get("slices", {}):
            st["slices"][sid] = {
                "status": PENDING, "title": ps.get("title", ""), "intent": ps["intent"],
                "depends_on": ps.get("depends_on", []),
                "must_contain": ps.get("must_contain", []),
                "verify_shape": ps.get("verify_shape", ""),
                "worktree": None, "job_id": None,
            }
            if ps.get("kind"):
                st["slices"][sid]["kind"] = ps["kind"]
            changed.append(f"{sid}.NEW")
    try:
        order = topo_sort(plan["slices"])
    except SystemExit:
        order = None
    if order and st.get("order") != order:
        st["order"] = order
        changed.append("order")
    # The bundle tag is plan-level metadata, refreshed like a spec field so a
    # tag added to the plan mid-run reaches the rows created from here on.
    if (plan.get("bundle") or None) != st.get("bundle"):
        st["bundle"] = plan.get("bundle") or None
        changed.append("bundle")
    # A re-wired dependency or a new order changes the planned rows' edges, so the
    # next --execute must re-publish the DAG (plan-add re-points existing rows).
    if any(c == "order" or c.endswith((".depends_on", ".NEW")) for c in changed):
        st["dag_published"] = False
    if changed:
        save_state(st)
        print(f"# spec refreshed from the plan for {len(changed)} field(s): "
              + ", ".join(changed[:12]) + (" ..." if len(changed) > 12 else ""))
    return len(changed)


def read_state(label):
    """The run state for `label` exactly as it sits on disk, or None if there is
    none / it is unreadable. A PURE READ: no plan file, no spec refresh, no write.

    load_state() is the wrong tool for a read-back. It takes the PLAN dict (it
    needs plan["slices"] to build a fresh state and to run refresh_spec_from_plan)
    and, on an existing run, it can save_state() as a side effect. A caller that
    only wants to know "what does this slice's status say on disk RIGHT NOW"
    (execute() after AUTO returns) must not re-read the plan or write anything
    back -- the in-memory state it is holding is older than the file. Never
    raises: a missing or torn state file simply means "no evidence"."""
    p = state_path(label)
    try:
        if os.path.exists(p):
            return json.loads(Path(p).read_text())
    except Exception:
        pass
    return None


_SETTLED_VERDICTS = ("pass", "concerns", "fail")


def refresh_done_gate_verdicts(st, gate_record_fn=None):
    """The AUTHORITATIVE re-gate can land AFTER its slice was already landed DONE on
    the pre-gate's verdict (2026-10-05, chat-frontend-plan s7-cli: pre-gate PASS ->
    slice DONE with gate_verdict 'pass'; the regate then said 'concerns' but the
    slice record kept 'pass' forever, because gate_verdict is only written on the
    ENQUEUED->DONE transition and the completion hook does not feed a 'concerns'
    back). Same class as the archived-parent merge bug: a late verdict with nowhere
    to land. Re-read each DONE slice's gate record (live or archive/, via
    gate_record) and, when its authoritative regate is done with a settled verdict
    that differs, record it -- keeping the prior one -- WITHOUT touching status:
    the chain commit already landed, so this is truth-in-reporting (and what land
    readiness reads), never a re-land. Returns the slice ids changed."""
    gate_record_fn = gate_record_fn or gate_record
    changed = []
    for sid in st.get("order") or []:
        s = (st.get("slices") or {}).get(sid) or {}
        if s.get("status") != DONE or not s.get("job_id"):
            continue
        rec = gate_record_fn(s["job_id"]) or {}
        v = rec.get("verdict")
        if rec.get("regate") != "done" or v not in _SETTLED_VERDICTS:
            continue
        if s.get("gate_verdict") == v:
            continue
        s["gate_verdict_prior"] = s.get("gate_verdict")
        s["gate_verdict"] = v
        s["gate_verdict_source"] = (f"authoritative regate of {s['job_id']} "
                                    f"(landed after the slice was DONE)")
        changed.append(sid)
    return changed


def load_state(plan, plan_path=None):
    label = plan.get("label", "sliced")
    p = state_path(label)
    if os.path.exists(p):
        st = json.loads(Path(p).read_text())
        _remember_base(label, st)
        _late = refresh_done_gate_verdicts(st)
        if _late:
            for _sid in _late:
                print(f"# {_sid}: gate verdict updated by the late authoritative regate: "
                      f"{st['slices'][_sid].get('gate_verdict_prior')!r} -> "
                      f"{st['slices'][_sid]['gate_verdict']!r} (status unchanged)")
            save_state(st)
        # The completion hook needs to find the PLAN file from the job label alone,
        # so the run state is the registry: record (and refresh) the plan path.
        if plan_path and st.get("plan_path") != os.path.abspath(os.path.expanduser(plan_path)):
            st["plan_path"] = os.path.abspath(os.path.expanduser(plan_path))
            save_state(st)
        refresh_spec_from_plan(st, plan)
        for k in ("kind", "anchor", "symbol"):     # plan-level harness shape
            st[k] = plan.get(k) or None
        return st
    order = topo_sort(plan["slices"])
    return {
        "label": label,
        "plan_path": os.path.abspath(os.path.expanduser(plan_path)) if plan_path else None,
        "dag_published": False,
        "repo": plan["repo"],
        "target": plan["target"],
        "lang": plan.get("lang", "python"),
        # Explicit queue bundle tag (ollama-queue.py `enqueue --bundle`): every
        # row this plan creates -- planned placeholders, authoring, coding --
        # joins that bundle so several plans/fixes for one project schedule and
        # render together (the owner 2026-09-23, the three rt-* resell fixes).
        "bundle": plan.get("bundle") or None,
        # TS/JS harness shape, forwarded to every slice's AUTO (2026-09-27):
        # `kind: "expression"` + `anchor` was unreachable from a plan (the slicer
        # passed only intent/target/lang), and `symbol` could only be guessed
        # from each slice's intent prose. Absent -> AUTO's defaults, as before.
        "kind": plan.get("kind") or None,
        "anchor": plan.get("anchor") or None,
        "symbol": plan.get("symbol") or None,
        "chain_branch": f"slice/{label}",
        "chain_worktree": os.path.join(WT_ROOT, f"wt-slice-{label}-chain"),
        "order": order,
        "slices": {
            s["id"]: {
                "status": PENDING,
                "title": s.get("title", ""),
                "intent": s["intent"],
                "depends_on": s.get("depends_on", []),
                "must_contain": s.get("must_contain", []),
                "verify_shape": s.get("verify_shape", ""),
                # kind=="invariant" marks a negative/totality property that
                # must_contain provably cannot discriminate -- see the invariant
                # branch in execute().
                "kind": s.get("kind"),
                "worktree": None,
                "job_id": None,
            }
            for s in plan["slices"]
        },
    }


def merge_terminal_facts(disk, mem, unsatisfy=None):
    """Fold facts from DISK that must never be undone back into the in-memory state.

    THE BUG THIS FIXES (2026-09-19, caught live). save_state() was a blind
    whole-file write of a dict `--execute` holds in memory for MINUTES while it
    polls an authoring job. Any other write during that window -- a `--skip-slice`
    from an operator, a `--retry-slice`, a reconcile -- was silently erased when
    the long-running process finally saved. Observed exactly: s4 of
    bg-actions-s1-item was retired as SKIPPED and verified through the API (the
    bundle read 4/6), then an `--execute` that had loaded state BEFORE the skip
    saved afterwards and stamped it back to FAILED. A FAILED slice is eligible for
    re-authoring, so the clobber silently re-armed the 11-dispatch retry storm the
    skip existed to end.

    Only ever WIDENS what is considered finished, never narrows it:
      - a slice DONE/SKIPPED on disk stays that way (terminal + operator intent);
      - its reason/skip fields come with it, so the row still explains itself;
      - a slice on disk but absent from memory is kept;
      - baseline_green_confirmed is sticky once true.
    Anything else is left to the caller's in-memory value, so normal progress
    (pending -> enqueued -> done) still writes through."""
    if not isinstance(disk, dict) or not isinstance(mem, dict):
        return mem
    unsat = unsatisfy or ()
    d_sl, m_sl = disk.get("slices"), mem.get("slices")
    if isinstance(d_sl, dict) and isinstance(m_sl, dict):
        for sid, d_s in d_sl.items():
            if not isinstance(d_s, dict):
                continue
            m_s = m_sl.get(sid)
            if not isinstance(m_s, dict):
                m_sl[sid] = d_s               # never drop a slice we did not load
                continue
            if sid in unsat:
                # DELIBERATE operator narrowing (--reland-slice). The guard below
                # exists to stop a STALE in-memory dict from silently undoing a
                # terminal fact; it must not also block an operator who is holding
                # fresh state and has said, explicitly and for one named slice,
                # "this DONE is wrong". Only an explicit caller can populate this,
                # and only for the slice it names -- every other slice in the same
                # write keeps the full clobber protection.
                continue
            if d_s.get("status") in SATISFIED and m_s.get("status") not in SATISFIED:
                m_s["status"] = d_s["status"]
                for k in ("skip_reason", "escalation_reason", "job_id",
                          "author_job_id"):
                    if d_s.get(k) is not None:
                        m_s[k] = d_s[k]
    if disk.get("baseline_green_confirmed"):
        mem["baseline_green_confirmed"] = True
    return mem


# FIELD-SCOPED READ-MODIFY-WRITE (2026-09-27, the BFMR s2 lost update).
#
# THE BUG. merge_terminal_facts() only protected DONE/SKIPPED. Every other fact
# written by another process was still erased by a whole-state write-back from a
# process holding an older copy. Live, sidecar-bfmr-login-fetch: the detached
# driver (pid 83213) loaded state at 19:36:48 with s2 ESCALATED; the self-heal's
# `--regate s2` (a second slicer process) enqueued coding job 0a7ff4902d90 at
# 19:37:13 and saved s2 = ENQUEUED/job_id; the driver's next save_state() wrote
# its stale s2 back -- ESCALATED, job_id None. The job then passed its gate and
# nothing ever landed it: the passed deliverable was orphaned and the slice read
# "escalated".
#
# THE RULE. A writer persists only the fields IT changed, relative to the state it
# last read or wrote (its per-process BASE), applied onto the file re-read UNDER an
# exclusive lock. Every field it did not touch keeps whatever another writer put
# there. After the write the caller's dict is refreshed IN PLACE from the merged
# result (slice dicts keep their identity, so a held `s = st["slices"][sid]` stays
# live), so the process also stops acting on the other writer's old values.
# Two extra rules on top of the field merge:
#   * NEWER JOB WINS: if another writer moved a slice to a different job_id since
#     our base, and we did not, our edits to that slice are dropped -- we were
#     acting on a superseded attempt (exactly the stale-escalate shape above);
#   * merge_terminal_facts still runs last, so DONE/SKIPPED stay un-undoable
#     (except for an explicit `unsatisfy`).
# Every writer of slice-runs/<plan>.json goes through save_state (the driver,
# --regate / --retry-slice / --accept-slice / cancel levers, and the self-heal and
# watcher, which launch those levers); nothing else writes that file.
import copy as _copy
import fcntl as _fcntl
from contextlib import contextmanager as _contextmanager

_STATE_BASE = {}          # label -> deep copy of the state this process last read/wrote
_MISSING = object()


def _remember_base(label, st):
    _STATE_BASE[label] = _copy.deepcopy(st)


@_contextmanager
def _state_lock(p):
    """Exclusive advisory lock serialising every read-modify-write of one state file."""
    fd = os.open(f"{p}.lock", os.O_CREAT | os.O_RDWR, 0o644)
    try:
        _fcntl.flock(fd, _fcntl.LOCK_EX)
        yield
    finally:
        try:
            _fcntl.flock(fd, _fcntl.LOCK_UN)
        finally:
            os.close(fd)


def fold_state_changes(disk, mem, base, unsatisfy=None, warn=None):
    """PURE. The state to persist: DISK, plus exactly the fields MEM changed relative
    to BASE (see FIELD-SCOPED READ-MODIFY-WRITE). Returns a new dict; inputs are not
    mutated."""
    out = _copy.deepcopy(disk)
    for k in set(mem) | set(base):
        if k == "slices":
            continue
        mv, bv = mem.get(k, _MISSING), base.get(k, _MISSING)
        if mv != bv:
            if mv is _MISSING:
                out.pop(k, None)
            else:
                out[k] = _copy.deepcopy(mv)
    m_sl = mem.get("slices") if isinstance(mem.get("slices"), dict) else {}
    b_sl = base.get("slices") if isinstance(base.get("slices"), dict) else {}
    o_sl = out.setdefault("slices", {})
    for sid, m_s in m_sl.items():
        if not isinstance(m_s, dict):
            continue
        b_s = b_sl.get(sid) if isinstance(b_sl.get(sid), dict) else {}
        d_s = o_sl.get(sid)
        if not isinstance(d_s, dict):
            o_sl[sid] = _copy.deepcopy(m_s)
            continue
        changed = [f for f in set(m_s) | set(b_s)
                   if m_s.get(f, _MISSING) != b_s.get(f, _MISSING)]
        if not changed:
            continue
        if (d_s.get("job_id") != b_s.get("job_id")
                and m_s.get("job_id") == b_s.get("job_id")):
            if warn:
                warn(f"# {sid}: another writer moved this slice to job "
                     f"{d_s.get('job_id')} ({d_s.get('status')}) since this process "
                     f"read it -- NOT writing this process's stale edits "
                     f"({', '.join(sorted(changed))}).")
            continue
        for f in changed:
            mv = m_s.get(f, _MISSING)
            if mv is _MISSING:
                d_s.pop(f, None)
            else:
                d_s[f] = _copy.deepcopy(mv)
    return merge_terminal_facts(disk, out, unsatisfy=unsatisfy)


def _sync_in_place(st, new):
    """Make `st` equal `new` while keeping the identity of st['slices'] and of every
    slice dict in it (callers hold references to them across saves)."""
    for k in list(st):
        if k not in new:
            del st[k]
    for k, v in new.items():
        if k == "slices" and isinstance(st.get("slices"), dict) and isinstance(v, dict):
            sl = st["slices"]
            for sid, sv in v.items():
                if isinstance(sl.get(sid), dict) and isinstance(sv, dict):
                    sl[sid].clear()
                    sl[sid].update(_copy.deepcopy(sv))
                else:
                    sl[sid] = _copy.deepcopy(sv)
        else:
            st[k] = _copy.deepcopy(v)


def _stamp_escalations(st, base):
    """Record WHEN a slice entered ESCALATED (escalated_at), centrally, so the driver
    can tell a job enqueued AFTER the escalation (a --regate) from the attempt that
    escalated -- see adopt_post_escalation_job."""
    b_sl = (base or {}).get("slices") or {}
    now = datetime.now(timezone.utc).isoformat(timespec="seconds")
    for sid, s in (st.get("slices") or {}).items():
        if not isinstance(s, dict):
            continue
        was = (b_sl.get(sid) or {}).get("status") if isinstance(b_sl.get(sid), dict) else None
        if s.get("status") == ESCALATED and was != ESCALATED:
            s["escalated_at"] = now


def save_state(st, unsatisfy=None):
    """Persist run state as a locked, field-scoped read-modify-write (see FIELD-SCOPED
    READ-MODIFY-WRITE). `unsatisfy` names slices whose DONE/SKIPPED the CALLER is
    deliberately undoing (--reland-slice); every other slice keeps the clobber
    protection. Callers that are not an explicit operator transition pass nothing.
    On return `st` holds the merged state as written."""
    os.makedirs(STATE_ROOT, exist_ok=True)
    label = st["label"]
    p = state_path(label)
    with _state_lock(p):
        base = _STATE_BASE.get(label)
        _stamp_escalations(st, base)
        _stamp_failed_tree(st, base)
        disk = None
        try:
            if os.path.exists(p):
                disk = json.loads(Path(p).read_text())
        except Exception:
            disk = None                        # unreadable/torn -> write ours
        if isinstance(disk, dict) and base is not None:
            out = fold_state_changes(disk, st, base, unsatisfy=unsatisfy,
                                     warn=lambda m: print(m, file=sys.stderr))
        elif isinstance(disk, dict):
            # No base (a state this process built rather than loaded): the legacy
            # whole-write, still with the terminal-fact guard.
            out = merge_terminal_facts(disk, _copy.deepcopy(st), unsatisfy=unsatisfy)
        else:
            out = _copy.deepcopy(st)
        # ATOMIC: write a sibling temp file then rename(2). A plain write_text()
        # truncates first, so a kill/timeout landing in that window leaves a torn
        # (usually empty) run-state on disk -- and the merge above then reads it,
        # fails, and silently falls back to "write ours", losing every terminal fact
        # the file held. The rename is atomic within the same directory, so a reader
        # sees either the whole old file or the whole new one, never a prefix.
        tmp = f"{p}.tmp.{os.getpid()}"
        try:
            Path(tmp).write_text(json.dumps(out, indent=2))
            os.replace(tmp, p)
        finally:
            if os.path.exists(tmp):
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
    _sync_in_place(st, out)
    _remember_base(label, out)


def refresh_state(st):
    """Fold what OTHER writers persisted since this process last read/wrote into the
    in-memory `st`, keeping this process's own unsaved edits (same merge rules as
    save_state, no write). The driver calls it before acting on each slice, so a
    --regate/--accept/--skip landed by another process while it was busy is what it
    acts on -- never its own stale copy."""
    label = st.get("label")
    base = _STATE_BASE.get(label)
    disk = read_state(label) if label else None
    if not isinstance(disk, dict):
        return st
    merged = (fold_state_changes(disk, st, base) if base is not None
              else merge_terminal_facts(disk, _copy.deepcopy(st)))
    _sync_in_place(st, merged)
    _remember_base(label, disk)
    # our unsaved edits are exactly merged-vs-disk now; base = disk keeps them dirty
    return st


def adopt_post_escalation_job(st, sid, s, by_label=None, enqueued_at_of=None):
    """DRIVER RE-READ OF QUEUE TRUTH for an ESCALATED slice. If the slice's CODING
    job label has a job in the queue that was enqueued AFTER the slice escalated
    (a --regate/self-heal re-enqueue whose state write was lost, or is racing us),
    the slice is not escalated any more: adopt that job as ENQUEUED so the normal
    ENQUEUED branch polls it and lands it through the gate-verdict-aware path.
    Returns the adopted job id, else None. Needs escalated_at (stamped centrally by
    save_state) -- without it the order of events is unknowable and nothing is
    adopted."""
    esc_at = s.get("escalated_at")
    if not esc_at:
        return None
    try:
        if by_label is None:
            _, by_label = all_job_statuses()
    except Exception:
        return None
    hit = (by_label or {}).get(f"{st['label']}-{sid}")
    if not hit:
        return None
    jid, qstatus = hit
    if not jid or jid == s.get("job_id") or qstatus in ("failed", "cancelled", "error"):
        return None
    try:
        t_job = (enqueued_at_of or _job_enqueued_at)(jid)
        if not t_job or datetime.fromisoformat(str(t_job)) <= datetime.fromisoformat(str(esc_at)):
            return None
    except Exception:
        return None
    s["status"] = ENQUEUED
    s["job_id"] = jid
    s["escalation_reason"] = None
    save_state(st)
    print(f"# {sid}: was ESCALATED, but coding job {jid} ({qstatus}) was enqueued for it "
          f"AFTER the escalation -- adopting it as {ENQUEUED} (queue truth over stale state).")
    return jid


def _job_enqueued_at(job_id):
    """enqueued_at of a queue job from the live state file, else its done sidecar."""
    try:
        qs = json.loads((Path.home() / "bin" / "ollama-queue-state.json").read_text())
        for j in qs.get("jobs", []):
            if j.get("id") == job_id:
                return j.get("enqueued_at")
    except Exception:
        pass
    try:
        d = json.loads((Path.home() / "bin" / "ollama-queue-logs" / f"{job_id}.done.json").read_text())
        # a reaped job's sidecar carries no enqueued_at; its launch baseline time is
        # later than its enqueue, so it can only make a job look NEWER when it was
        # launched after the escalation -- which is the case being detected.
        return d.get("enqueued_at") or d.get("baseline_at")
    except Exception:
        return None


def deps_done(st, sid):
    # SKIPPED counts as satisfied: the dependent waits on a PROPERTY, and an
    # already-satisfied slice means that property holds at the tip. Waiting for a
    # DONE that can never arrive would deadlock the rest of the plan.
    return all(st["slices"][d]["status"] in SATISFIED for d in st["slices"][sid]["depends_on"])


def any_dep_failed(st, sid):
    return any(st["slices"][d]["status"] in (FAILED, BLOCKED, ESCALATED)
              for d in st["slices"][sid]["depends_on"])


def provision_node_modules(repo, cwt):
    """Give a JS/TS chain worktree the node_modules its verify needs. Returns one
    of 'n/a' (not a node project), 'present', 'linked', or 'unavailable'.

    THE SILENT KILLER THIS FIXES (2026-09-19). `git worktree add` copies TRACKED
    files only, and node_modules is gitignored -- so every chain worktree of a
    JS/TS repo came up without it. The scaffold then links each SLICE worktree's
    node_modules at the CHAIN's, which did not exist, and printed one line about
    it mid-scaffold:

        node_modules: source <chain>/node_modules is not installed -- run `npm ci`

    ...and carried on. verify.sh (node-test) cannot run without it, so authoring
    could never reach a both-ways proof: the harness is red at baseline for the
    wrong reason and green never happens. Every TS slice of cc-waitlist-r2 failed
    this way, and the failures read as gate/spec defects, which is what sent three
    rounds of effort at the must_contain literals instead of at the environment.
    At the time of the fix EVERY node chain worktree on this machine was missing
    it: bfmrAutoLink, cc-waitlist-r2 (and its sub-plan), rt-costco-always-sites
    (and its sub-plan) -- i.e. every JS/TS plan in flight was dead on arrival.

    A SYMLINK to the source repo's node_modules, not `npm ci`: it is instant,
    needs no network, and is the same tree the repo itself builds against, which
    is what env-parity means here. Non-fatal by design -- if the source has none
    either, say so and let the scaffold's own message stand rather than blocking
    a plan that may not need it."""
    try:
        if not os.path.isfile(os.path.join(cwt, "package.json")):
            return "n/a"
        dst = os.path.join(cwt, "node_modules")
        if os.path.exists(dst):
            return "present"
        src = os.path.join(repo, "node_modules")
        if not os.path.isdir(src):
            # The repo the worktree came from may ITSELF be a worktree; fall back
            # to the main checkout that owns the git dir.
            top = git(repo, "rev-parse", "--path-format=absolute",
                      "--git-common-dir", capture=True)
            if top:
                alt = os.path.join(os.path.dirname(top.rstrip("/")), "node_modules")
                if os.path.isdir(alt):
                    src = alt
        if not os.path.isdir(src):
            print(f"# node_modules: neither {cwt} nor {repo} has one -- a JS/TS verify "
                  f"will NOT be able to run. Install it in {repo} (`npm ci`).")
            return "unavailable"
        os.symlink(src, dst)
        print(f"# node_modules: linked {dst} -> {src} (env parity for the verify)")
        return "linked"
    except OSError as e:
        print(f"# node_modules: could not provision ({e})")
        return "unavailable"


def ensure_chain_worktree(st):
    """One worktree of the repo checked out on branch slice/<label> at repo HEAD.
    Committing in it advances the branch tip that later slices are cut from."""
    repo, branch, cwt = st["repo"], st["chain_branch"], st["chain_worktree"]
    if os.path.isdir(os.path.join(cwt, ".git")) or os.path.exists(os.path.join(cwt, ".git")):
        provision_node_modules(repo, cwt)
        return cwt
    if not git(repo, "branch", "--list", branch, capture=True):
        git(repo, "branch", branch)
    os.makedirs(WT_ROOT, exist_ok=True)
    # subprocess (not the Bash tool) -> the worktree-guard hook does not apply,
    # and this is the orchestrator's own managed worktree, not a hand-roll.
    run(["git", "-C", repo, "worktree", "add", cwt, branch], check=True)
    provision_node_modules(repo, cwt)
    return cwt


def parse_enqueue_id(stdout):
    """enqueue prints:  'enqueued <id>  <label>  model=... host=...'"""
    for line in (stdout or "").splitlines():
        line = line.strip()
        if line.startswith("enqueued ") and not line.startswith("enqueued SPLIT"):
            parts = line.split()
            if len(parts) >= 2:
                return parts[1]
    return None


LOG_DIR = os.path.expanduser("~/bin/ollama-queue-logs")


def _sidecar_status(job_id):
    """Bug #5 (2026-09-18): recover a completed job's terminal status from its
    never-pruned sidecar when the LIVE `status` table no longer has a row.

    A done/failed coding job is removed from live state shortly after it finishes
    (ollama-queue prunes the row on the next tick). A slicer polling on its own
    cadence can miss the brief terminal window and then see the row simply GONE --
    which the old job_status() reported as None, so execute() printed "not found --
    check manually" and NEVER committed a PASSED slice onto the chain (arr-codec-floor
    s1-codec-rank: job 4e146d20f607 passed, slice recorded failed, job_id lost).

    The `<id>.done.json` sidecar (live LOG_DIR, then archive/) is written BEFORE the
    prune and carries the authoritative worker outcome in its 'status' field. Returns
    a queue-status string ('done'/'failed'/...) or None (no durable record)."""
    if not job_id:
        return None
    import glob
    cands = []
    for base in (LOG_DIR, os.path.join(LOG_DIR, "archive")):
        cands.append(os.path.join(base, f"{job_id}.done.json"))
        cands += sorted(glob.glob(os.path.join(base, f"*{job_id}*.done.json")))
    for path in cands:
        if not os.path.isfile(path):
            continue
        try:
            d = json.loads(Path(path).read_text())
        except Exception:
            continue
        st = d.get("status")
        if st:
            return str(st)
        # A sidecar exists (job completed) but carries no status token -> treat the
        # existence of a done.json as "done" rather than guessing failed.
        return "done"
    return None


# --- Gate-verdict-aware landing (2026-09-23) ------------------------------------
# THE HOLE. The ENQUEUED poll landed a coding job's target onto the chain the moment
# the QUEUE said `done` -- i.e. the worker's own verify went green -- and never read
# the gate's verdict. gate-on-complete.py documents the opposite contract at
# SLICE_ADVANCE_VERDICTS ("a concerns/fail verdict must NOT auto-commit its target
# onto the chain branch -- that is the needs-eyes lane's business"), and since
# Cause-2b (2026-09-21) fires --advance-detached on fail/concerns as well, the hook
# itself walked every RED coding job straight into this branch. Measured over every
# slice coding job with a gate record (124 on 2026-09-23): 107 pass, 8 concerns,
# 5 fail, 3 pass-pending-review -- and ALL 13 red ones are recorded DONE on their
# chains (bg-eraser-s1-invoke s4 [0eb122a99cb9] fail code_high=2; aw-sched-runner
# s11 [9414e0cf848e] fail code_high=1; bg-brokers-s1-load s1 [813d71882974] fail).
#
# fail/error = the gate found a HIGH code finding (or could not judge at all). That
# is exactly the reviewer-code-high-with-green-verify class GATE_AUTOFIX_TRUST_REVIEWER
# =off parks for a human: ESCALATE, do not land; --accept-slice is the designed
# escalated->done lever and re-runs verify.sh itself.
GATE_ESCALATE_VERDICTS = ("fail", "error", "nonconvergence")
# concerns = input/scope flags only (the dirty-launch demotion, "this edited file
# was not named by the task") or code findings BELOW high -- gate-on-complete calls
# these "not worth a 27B slot ... the coordinator reviews the diff". They land, with
# the verdict recorded on the row so integration can see it. skipped = the gate had
# nothing to review (empty diff / no task file): land, and let the empty-deliverable
# guard in _stage_deliverable decide.
GATE_LAND_VERDICTS = ("pass", "skipped", "concerns")
# How long the poll waits for a TERMINAL gate verdict on a queue-`done` job before
# landing on the live verify alone (the pre-2026-09-23 behaviour). Bounded so a
# gate that never writes its record cannot jam a chain; the completion hook only
# fires --advance-detached at a terminal verdict, so in practice only a MANUAL
# --execute racing the gate ever waits here.
GATE_VERDICT_WAIT_S = 2 * 3600
# GATE FINDING CHECK (gate-on-complete, 2026-10-04): while the verifier for a
# re-gate reviewer finding is in flight the record reads this verdict. It is
# INTERMEDIATE (wait), and -- unlike "no verdict" -- it must never time out into a
# land on the live verify alone: the reviewer DID raise a finding. If the verifier
# never reports within GATE_VERDICT_WAIT_S, escalate exactly as the re-gate's own
# fail/concerns would have parked it.
GATE_FINDING_CHECK_VERDICT = "pending-finding-check"


def verdict_stale_reasons(rec, worktree):
    """[] unless the gate record carries a judged-identity stamp (gate_identity.py,
    2026-10-06) AND a judged product file differs on disk now -> the reasons.
    Unstamped records and an unloadable gate_identity return [] (legacy behaviour;
    the live verify re-run remains the proof). Never raises."""
    j = (rec or {}).get("judged") or {}
    if not (isinstance(j, dict) and j.get("files")) or not worktree:
        return []
    try:
        import importlib.util as _ilu
        _p = Path(os.path.realpath(__file__)).with_name("gate_identity.py")
        _sp = _ilu.spec_from_file_location("gate_identity", _p)
        _gi = _ilu.module_from_spec(_sp)
        _sp.loader.exec_module(_gi)
        ok, why = _gi.identity_check(rec, worktree)
    except Exception:
        return []
    if ok:
        return []
    # A vanished worktree is not "changed code" -- the live verify will fail it.
    return [w for w in why if "STALE" in w]


def gate_record(job_id):
    """The gate's durable `<id>.gate.json` (live LOG_DIR, then archive/), or None.
    Never raises: a missing/torn record is simply 'no verdict yet'."""
    if not job_id:
        return None
    for base in (LOG_DIR, os.path.join(LOG_DIR, "archive")):
        p = os.path.join(base, f"{job_id}.gate.json")
        if not os.path.isfile(p):
            continue
        try:
            d = json.loads(Path(p).read_text())
        except Exception:
            return None
        return d if isinstance(d, dict) else None
    return None


def done_sidecar_age_s(job_id, now=None):
    """Seconds since the queue wrote `<id>.done.json` (the moment the job finished
    and the gate was fired), or None when no sidecar exists to time from."""
    if not job_id:
        return None
    for base in (LOG_DIR, os.path.join(LOG_DIR, "archive")):
        p = os.path.join(base, f"{job_id}.done.json")
        try:
            return max(0.0, (now if now is not None else time.time()) - os.path.getmtime(p))
        except OSError:
            continue
    return None


def gate_review_failed(rec):
    """True when a gate record is pass-pending-review but its review FAILED terminally
    (review="failed (...)"). Nothing re-runs a failed review, so no further verdict is
    coming: waiting on it only burned the full wait (20 min awaiting-gate grace for a
    failed authoring slice, 2 h GATE_VERDICT_WAIT_S for a coding job) before doing what
    the timeout does anyway (2026-10-02, Rivian s1 r2 fc6eec003057 waited 27 min)."""
    rec = rec or {}
    return (str(rec.get("verdict") or "") == "pass-pending-review"
            and str(rec.get("review") or "").startswith("failed"))


def coding_land_route(verdict, waited_s, review=None):
    """PURE. What the ENQUEUED poll does with a coding job the queue reports `done`:
      'escalate' -- the gate FAILED it (GATE_ESCALATE_VERDICTS): mark ESCALATED with
                    the gate's findings; --accept-slice lands it after a human/Opus read.
      'land'     -- gate pass/skipped/concerns; or no terminal verdict after
                    GATE_VERDICT_WAIT_S (or no sidecar to time the wait from), in
                    which case the LIVE verify.sh re-run is the only proof.
      'wait'     -- no verdict yet / pass-pending-review, still inside the wait."""
    v = str(verdict or "").strip().lower()
    if v in GATE_ESCALATE_VERDICTS:
        return "escalate"
    if v in GATE_LAND_VERDICTS:
        return "land"
    if v == GATE_FINDING_CHECK_VERDICT:
        if waited_s is None or waited_s >= GATE_VERDICT_WAIT_S:
            return "escalate"   # verifier lost: fail-safe park, never a silent land
        return "wait"
    if gate_review_failed({"verdict": v, "review": review}):
        return "land"   # the review died: no verdict is coming; the live verify decides
    if waited_s is None or waited_s >= GATE_VERDICT_WAIT_S:
        return "land"
    return "wait"


def gate_escalation_reason(rec, job_id, sid):
    """The needs-eyes text for a gate-failed coding job: verdict, counts, the high
    code findings by file:line, and the lever that applies."""
    rec = rec or {}
    counts = rec.get("counts") or {}
    highs = [i for i in (rec.get("issues") or [])
             if isinstance(i, dict) and i.get("severity") == "high"
             and i.get("category") == "code"]
    shown = "; ".join(f"{i.get('file') or '?'}:{i.get('line') or '?'} "
                      f"{str(i.get('what') or '').strip()[:140]}" for i in highs[:3])
    if len(highs) > 3:
        shown += f"; +{len(highs) - 3} more"
    authority = rec.get("gate_authority")
    return (f"coding job {job_id} converged (queue done, its verify green) but the "
            f"gate's verdict is {str(rec.get('verdict'))!r} (code_high="
            f"{counts.get('code_high', 0)}, review={rec.get('review_verdict') or rec.get('review') or '?'}"
            f"{', authority ' + str(authority) if authority else ''}). "
            f"Findings: {shown or '(none listed)'}. NOT landed on the chain -- a high "
            f"code finding on a green verify is the needs-eyes lane's call, not the "
            f"slicer's. Read the diff and {os.path.join(LOG_DIR, job_id + '.gate.json')}: "
            f"if the finding is a reviewer false positive, `--accept-slice {sid}` "
            f"re-runs verify.sh and lands it; if it is real, fix it in the worktree "
            f"and --accept-slice {sid}, or --retry-slice {sid} to re-author.")


_AUTOFIX_LIVE = ("pending", "queued", "running", "scheduled", "held", "paused", "done",
                 "needs_opus")


def autofix_successor(job_id, state_path=None):
    """(id, status, round) of the newest gate auto-fix round re-queued for `job_id`
    (same auto_fix_root chain, a HIGHER round, same cwd) that is not terminally
    failed, else None. Reads the queue's own state file -- the gate records the
    round there (auto_fix_root/auto_fix_round), not in the slice state."""
    try:
        qs = json.loads(Path(state_path or (Path.home() / "bin" / "ollama-queue-state.json")).read_text())
        jobs = qs.get("jobs") or []
        if isinstance(jobs, dict):
            jobs = list(jobs.values())
    except Exception:
        return None
    me = next((j for j in jobs if j.get("id") == job_id), None)
    if not me:
        return None
    root = me.get("auto_fix_root") or job_id
    rnd = int(me.get("auto_fix_round") or 0)
    best = None
    for j in jobs:
        try:
            r = int(j.get("auto_fix_round") or 0)
        except (TypeError, ValueError):
            continue
        if (j.get("id") != job_id and (j.get("auto_fix_root") or "") == root and r > rnd
                and j.get("cwd") == me.get("cwd") and j.get("status") in _AUTOFIX_LIVE
                and (best is None or r > best[2])):
            best = (j["id"], j.get("status"), r)
    return best


def job_status(job_id):
    """Status string for a job id from the plain `status` table, else its
    never-pruned sidecar (Bug #5), else None.

    Bug #7 (2026-09-18): match the job id to the row's OWN id COLUMN, never a
    naive `job_id in line` substring. A pruned coding job's id survives as a
    DEPENDENCY reference inside a downstream PLANNED row's note
    ("... held-on-dep -> <that id>"), so the substring form matched the planned
    row and returned "planned" -- execute() then read that as "coding job still
    running" and STALLED THE CHAIN FOREVER instead of falling through to the
    sidecar, which correctly reports the pruned job 'done' and advances. This was
    THE reason auto-authored slices never produced a coding run (the owner: "an auto
    author just finished ... but we never got the actual coding run going")."""
    if not job_id:
        return _sidecar_status(job_id)
    out = subprocess.run(["python3", QUEUE, "status"],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        s = line.lstrip()
        if not s.startswith("["):
            continue
        rest = s.split("]", 1)[1].split()
        if rest and rest[0] == job_id:      # exact match on the ID column only
            return s.split("]")[0].lstrip("[").strip()
    return _sidecar_status(job_id)


VANISHED_JOB_MAX = 2          # re-gate+re-enqueue attempts before a vanished job escalates
VANISHED_JOB_GRACE_S = 5 * 60  # sweep: how old an ENQUEUED stamp must be before "vanished"


def job_vanished(jid, by_id, sidecar=None):
    """PURE given by_id/sidecar. A coding job is VANISHED when the live queue table
    is readable and non-empty, the job is not in it, and no completion sidecar
    exists for it. An EMPTY table is 'unknown' (daemon down / unreadable), never
    vanished -- so a queue outage cannot trigger a wave of re-enqueues."""
    if not jid or not by_id:
        return False
    if jid in by_id:
        return False
    sidecar = _sidecar_status if sidecar is None else sidecar
    return sidecar(jid) is None


def heal_vanished_job(st, sid, s):
    """The ENQUEUED slice's job is gone from the queue with no sidecar. Returns
      'unknown'   -- queue table empty/unreadable: leave ENQUEUED, say so;
      'requeue'   -- slice reset to CONFIRMED (job_id cleared, the vanished id kept
                     on the record); caller re-runs confirm_and_enqueue;
      'escalated' -- vanished VANISHED_JOB_MAX times already, or no harness to
                     re-gate: parked with an escalation_reason naming the ids."""
    jid = s.get("job_id")
    try:
        by_id, _ = all_job_statuses()
    except Exception:
        by_id = {}
    if not job_vanished(jid, by_id):
        print(f"# {sid}: job {jid} is not in the queue table right now, but the table "
              f"is {'empty/unreadable' if not by_id else 'inconsistent'} -- leaving "
              f"ENQUEUED; will re-check on the next advance.")
        return "unknown"
    gone = list(s.get("vanished_job_ids") or []) + [jid]
    s["vanished_job_ids"] = gone
    wt = s.get("worktree") or slice_worktree(st, sid)
    if len(gone) <= VANISHED_JOB_MAX and os.path.isdir(wt) and harness_authored(wt):
        s["status"] = CONFIRMED
        s["job_id"] = None
        s["worktree"] = wt
        save_state(st)
        print(f"# {sid}: coding job {jid} VANISHED (not in the queue, no completion "
              f"sidecar) -- attempt {len(gone)}/{VANISHED_JOB_MAX}: re-gating the intact "
              f"harness and re-enqueueing.")
        return "requeue"
    s["status"] = ESCALATED
    s["escalation_reason"] = (
        f"coding job(s) {', '.join(gone)} VANISHED from the queue (no live row, no "
        f"completion sidecar) "
        + (f"{len(gone)} times -- the queue is losing this slice's jobs; check "
           f"ollama-queue.py logs, then --regate {sid}"
           if len(gone) > VANISHED_JOB_MAX else
           f"and its worktree {wt} has no authored harness to re-gate -- --retry-slice {sid}"))
    save_state(st)
    print(f"# {sid}: ESCALATED -- {s['escalation_reason']}")
    return "escalated"


def all_job_statuses():
    """Map every queue job id -> status, and label -> (id, status), from the
    plain `status` table. Used by --reconcile to match persisted slice state to
    the actual queue."""
    out = subprocess.run(["python3", QUEUE, "status"],
                         capture_output=True, text=True).stdout
    by_id, by_label = {}, {}
    for line in out.splitlines():
        s = line.lstrip()
        if not s.startswith("["):
            continue
        status = s.split("]")[0].lstrip("[").strip()
        rest = s.split("]", 1)[1].split()
        if len(rest) >= 2:
            jid, label = rest[0], rest[1]
            by_id[jid] = status
            by_label[label] = (jid, status)
    return by_id, by_label


# Queue status -> slice status. A live/queued/done job maps to ENQUEUED so
# execute()'s poll picks it up (and, for 'done', advances the chain); terminal
# failures map to FAILED. This is what lets a hand-enqueued job or a stale
# FAILED marker self-heal instead of needing the state JSON hand-edited.
_QUEUE_TO_SLICE = {
    "done": ENQUEUED, "running": ENQUEUED, "queued": ENQUEUED,
    "pending": ENQUEUED, "scheduled": ENQUEUED, "held": ENQUEUED,
    # BUG (2026-09-18): "paused" was missing here AND from _ACTIVE_QSTATES, so a
    # paused job was read as "no queue evidence" -- reconcile left a stale FAILED
    # marker in place and slice_job_inflight() reported no in-flight job, which
    # would have let --retry-slice launch a DUPLICATE alongside the paused one.
    "paused": ENQUEUED,
    "failed": FAILED, "error": FAILED, "done_unconverged": FAILED,
    "cancelled": FAILED,
    # BUG (2026-09-19): "needs_opus" was missing here, so a coding job the queue
    # parked in the Opus-escalation lane left the slice's own status field wherever
    # it was before (usually ENQUEUED) instead of ESCALATED -- reconcile() saw
    # `_QUEUE_TO_SLICE.get("needs_opus")` return None and skipped the slice
    # entirely (want is None -> continue). That desync is exactly what made
    # --regate refuse with "is 'enqueued', not 'escalated'" even though the queue
    # already agreed the slice needed the Opus gate (bg-eraser-s1-invoke s4,
    # 2026-09-19). Mapping it to ESCALATED lets reconcile self-heal the slice
    # status and --regate work directly, with no manual `resolve` + `--execute`
    # workaround needed.
    "needs_opus": ESCALATED,
}


def subplan_label(parent_label, sid):
    """The run-label of the sub-plan a re-sliced ESCALATED slice was exploded into.

    The slicer's own naming convention and the ONLY link between the two runs:
    parent `bg-crypto` slice `s1-crypto` -> sub-plan `bg-crypto-s1-crypto`."""
    return f"{parent_label}-{sid}"


def subplan_is_complete(sub):
    """PURE. True iff this sub-plan run-state has NOTHING left to land.

    Complete means EVERY member slice is in SATISFIED (done or skipped). A
    skipped member counts -- SKIPPED means the property already holds at the
    tip, which is exactly as final as DONE for the parent's purposes (see
    SATISFIED). Anything else -- pending, awaiting_review, confirmed, enqueued,
    failed, blocked, escalated -- means work is still owed, and the parent must
    stay ESCALATED so the chain keeps halting where it truthfully halts.

    Deliberately fails CLOSED on anything it cannot read as a plan (missing
    file, empty order, garbage): "I could not prove it is complete" must never
    be recorded as "it is complete"."""
    if not isinstance(sub, dict):
        return False
    order, slices = sub.get("order"), sub.get("slices")
    if not isinstance(order, list) or not order or not isinstance(slices, dict):
        return False
    for sid in order:
        s = slices.get(sid)
        if not isinstance(s, dict) or s.get("status") not in SATISFIED:
            return False
    return True


def load_subplan(parent_label, sid):
    """The sub-plan's persisted run-state, or None if it does not exist / is
    unreadable. Never raises: a missing sub-plan is the common case (most
    escalations were never re-sliced) and simply means "no evidence"."""
    return read_state(subplan_label(parent_label, sid))


def subplan_chain_branch(parent_label, sid, sub=None):
    """The branch a sub-plan's commits live on. The sub-plan is itself a run, so it
    records its own chain_branch; fall back to the naming convention when the row is
    missing so a hand-made sub-plan still resolves."""
    if isinstance(sub, dict) and sub.get("chain_branch"):
        return sub["chain_branch"]
    return f"slice/{subplan_label(parent_label, sid)}"


def merge_subplan_into_chain(st, sid, sub, cwt=None):
    """Land a finished sub-plan's commits ON the parent plan's chain branch.

    THE GAP THIS CLOSES (2026-09-19, flagged twice without a fix; live on
    bg-actions, bg-crypto, bg-eraser, bg-state and cc-waitlist-r2).

    When a slice is too big it is ESCALATED and re-sliced into a sub-plan. The
    sub-plan is a full run of its own: it cuts its OWN chain worktree on its OWN
    branch `slice/<parent>-<sid>`, and every converged sub-slice is committed there.
    Its parent's branch `slice/<parent>` never sees any of it. reconcile_escalated_
    subplan() then marked the parent slice SKIPPED on the strength of "the sub-plan
    landed the property" -- but the property was landed on a DIFFERENT BRANCH that
    nothing merges, so:
      * the next parent slice is cut from the parent tip and cannot see the work,
      * and integration copies the parent chain TREE onto main, so the sub-plan's
        commits are not merely out of order, they are silently DROPPED.
    The sub-plan's branch was reachable only by name, from a human who happened to
    know the convention. That is not a workflow, it is an orphan.

    So the merge is part of ordinary state advancement, not a manual step: a
    sub-plan's work reaches the parent chain at the same moment the parent slice is
    recorded satisfied, or the parent slice is NOT recorded satisfied.

    Returns (status, detail):
      'ok'        -- the sub-plan branch is now an ancestor of the chain branch
                     (either it already was, or this call merged it).
      'nothing'   -- the sub-plan branch has no commits of its own to contribute.
      'conflict'  -- the merge conflicted; it has been ABORTED and the chain
                     worktree is back exactly at its tip. detail names the paths.
      'error'     -- could not merge for some other reason (dirty tree, missing
                     branch); detail says which. Nothing was changed.
    Never leaves a half-merged chain worktree behind: every non-ok path aborts."""
    cwt = cwt or ensure_chain_worktree(st)
    branch = subplan_chain_branch(st["label"], sid, sub)
    if not git(cwt, "rev-parse", "--verify", "--quiet", f"{branch}^{{commit}}", capture=True):
        return "error", (f"sub-plan branch {branch!r} does not exist in the repo, so its "
                         f"commits cannot be located -- the parent slice must NOT be "
                         f"recorded satisfied on the strength of work nobody can find")
    dirty = git(cwt, "status", "--porcelain", capture=True)
    if dirty.strip():
        return "error", (f"the chain worktree {cwt} is DIRTY, so a merge would mix "
                         f"uncommitted work into the sub-plan's commit: {dirty.splitlines()[:5]}")
    # Already in the parent's history (a previous advance merged it) -> idempotent.
    anc = subprocess.run(["git", "-C", cwt, "merge-base", "--is-ancestor", branch, "HEAD"],
                         capture_output=True, text=True)
    if anc.returncode == 0:
        return "ok", f"{branch} is already an ancestor of the chain tip"
    # Does it actually carry anything the parent lacks?
    ahead = git(cwt, "rev-list", "--count", f"HEAD..{branch}", capture=True)
    if ahead in ("", "0"):
        return "nothing", f"{branch} has no commits the chain branch does not already have"
    before = git(cwt, "rev-parse", "HEAD", capture=True)
    cp = subprocess.run(
        ["git", "-C", cwt, "merge", "--no-ff", "--no-edit", "-m",
         f"merge sub-plan {subplan_label(st['label'], sid)} into {st['chain_branch']} "
         f"({ahead} commit(s) for slice {sid})", branch],
        capture_output=True, text=True)
    after = git(cwt, "rev-parse", "HEAD", capture=True)
    if cp.returncode == 0 and after and after != before:
        return "ok", (f"merged {ahead} commit(s) from {branch} into "
                      f"{st['chain_branch']} ({before[:8]} -> {after[:8]})")
    # CONFLICT (or any other failed merge): abort, report THIS conflict concretely.
    conflicted = git(cwt, "diff", "--name-only", "--diff-filter=U", capture=True)
    subprocess.run(["git", "-C", cwt, "merge", "--abort"], capture_output=True, text=True)
    subprocess.run(["git", "-C", cwt, "reset", "--hard", "-q", before],
                   capture_output=True, text=True)
    detail = ((cp.stderr or "") + (cp.stdout or "")).strip()[-400:]
    paths = [p for p in conflicted.splitlines() if p.strip()]
    if paths:
        return "conflict", (
            f"merging sub-plan branch {branch} into {st['chain_branch']} CONFLICTS on "
            f"{', '.join(paths)}. Both the parent chain and the sub-plan edited the same "
            f"region, so which text is correct is a code judgement, not a mechanical one. "
            f"The merge was aborted and the chain worktree is back at {before[:8]}; the "
            f"parent slice stays ESCALATED. Resolve in {cwt}: "
            f"`git merge {branch}`, fix the conflict, commit, then re-run --execute.")
    return "error", (f"merging {branch} into {st['chain_branch']} failed "
                     f"(rc={cp.returncode}): {detail or 'no git output'}")


def reconcile_escalated_subplan(st, sid):
    """Close the ESCALATED-parent / finished-sub-plan gap (2026-09-19).

    THE GAP. When a slice is too big the slicer ESCALATES it and it gets
    re-sliced into its own sub-plan `<parent>-<sid>`. The sub-plan then runs to
    completion -- but NOTHING ever tells the parent. The parent slice sits at
    ESCALATED forever, execute() halts the chain on it ("parked for review; the
    chain STOPS here"), and --reconcile said "nothing to reconcile" because it
    only ever looked at the QUEUE: a re-sliced slice has no queue job of its own
    (its work was done by the sub-plan's jobs, under the sub-plan's labels), so
    there was no evidence for reconcile to find. Seen live on three top-level
    plans at once: bg-crypto/s1-crypto, bg-eraser/s1-invoke, bg-state/s1-init-db.

    WHICH STATUS. Not DONE. DONE carries a specific, load-bearing claim -- "this
    slice's OWN coding job converged and its deliverable was committed to the
    chain" -- and for a re-sliced slice that is simply false: no coding job for
    this slice ever ran, and nothing was committed under its name. Recording
    DONE would make the row lie about its own provenance and would fold it into
    the `done` count in the summary line, hiding the re-slice.

    SKIPPED is the honest one. Its definition is "the slice's property is
    ALREADY SATISFIED at the chain tip, so there is nothing for IT to land" --
    which is exactly the situation: the sub-plan landed the property, so this
    slice has nothing left to do. SKIPPED is in SATISFIED, so dependents and the
    chain proceed (the whole point), it is never folded into DONE, show_status
    reports it on its own line, and skip_reason -- carried through
    merge_terminal_facts -- keeps the row self-explaining. A brand-new status
    would have to be threaded through SATISFIED / chain_may_pass / the summary
    anyway, i.e. it would BE skipped with a longer name; the extra provenance it
    would buy is recorded instead in `resolved_by_subplan`.

    CONSERVATIVE. Only when the sub-plan exists AND every one of its slices is
    SATISFIED. A partially-done sub-plan (anything pending/failed/escalated/
    blocked) leaves the parent ESCALATED: work is still owed to the chain, and
    silently closing the parent would step the chain over a fix that is not in
    it -- Bug #12 all over again. Returns True iff it changed the slice; the
    caller saves through save_state() so the write is merged, never blind."""
    s = st["slices"][sid]
    if s["status"] != ESCALATED:
        return False
    sub = load_subplan(st["label"], sid)
    if not subplan_is_complete(sub):
        return False
    lbl = subplan_label(st["label"], sid)
    n = len(sub["order"])
    n_skipped = sum(1 for i in sub["order"] if sub["slices"][i]["status"] == SKIPPED)
    # THE MERGE IS A PRECONDITION, NOT A FOLLOW-UP. The whole claim being recorded
    # here is "the sub-plan's commits satisfy this slice". That claim is only true
    # once those commits are ON this plan's chain branch -- otherwise the parent
    # slice is marked satisfied against work the chain cannot see and integration
    # will drop. So: merge first, and record satisfied ONLY if the merge landed.
    mstatus, mdetail = merge_subplan_into_chain(st, sid, sub)
    if mstatus not in ("ok", "nothing"):
        # Escalate THIS conflict, concretely, with the branch and paths named --
        # rather than silently leaving the work orphaned (the old behaviour) or
        # punting the mechanism. The slice is already ESCALATED; enrich the reason
        # so the needs-eyes panel says what to do.
        s["escalation_reason"] = (
            f"sub-plan {lbl} is COMPLETE but its commits could NOT be merged back "
            f"into {st['chain_branch']}: {mdetail}")
        s["subplan_merge_status"] = mstatus
        save_state(st)
        print(f"# reconcile {sid}: sub-plan {lbl} is complete but the merge-back "
              f"{mstatus.upper()} -- staying {ESCALATED}.\n#   {mdetail}")
        return False
    s["status"] = SKIPPED
    s["skip_reason"] = (
        f"re-sliced into sub-plan {lbl}, which is COMPLETE "
        f"({n} slice(s): {n - n_skipped} done, {n_skipped} skipped) and whose "
        f"commits are now ON {st['chain_branch']} ({mdetail}) -- this "
        f"slice's property is satisfied by the sub-plan's commits, so it has "
        f"nothing of its own left to land")
    s["resolved_by_subplan"] = lbl
    s["subplan_merge_status"] = mstatus
    s["subplan_merge_detail"] = mdetail
    s["skipped_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
    print(f"# reconcile {sid}: {ESCALATED} -> {SKIPPED} "
          f"(sub-plan {lbl} is complete: {n} slice(s), all satisfied)")
    return True


def reconcile(st):
    """Match persisted slice state to the actual queue (by job-id, then by the
    `<label>-<sid>` enqueue label). Conservative: only changes a slice when the
    queue contradicts it, never touches a DONE slice (its chain commit already
    landed), and leaves a genuinely-failed authoring slice (no queue job) alone.

    Also closes the non-queue desync an ESCALATED slice can have: one that was
    re-sliced into a now-finished sub-plan -- see reconcile_escalated_subplan()."""
    by_id, by_label = all_job_statuses()
    changed = 0
    for sid in st["order"]:
        s = st["slices"][sid]
        if s["status"] in SATISFIED:
            continue
        # Checked BEFORE the queue lookup: a re-sliced slice has no queue job of
        # its own, so the queue can only ever say "no evidence" about it.
        if reconcile_escalated_subplan(st, sid):
            changed += 1
            continue
        label = f"{st['label']}-{sid}"
        jid = s.get("job_id")
        qstatus = by_id.get(jid) if jid else None
        if qstatus is None and label in by_label:
            jid, qstatus = by_label[label]      # adopt the job for this label
        # BUG (2026-09-18): reconcile only ever looked at the CODING job (job_id /
        # `<label>-<sid>`). The AUTHORING job is enqueued by ollama-dispatch-auto
        # under `auto-author-<label>-<sid>` and its id is never persisted, so a
        # slice whose authoring attempt was re-enqueued/resumed after an earlier
        # failure had NO queue evidence here -- the run-state kept the OLD `failed`
        # status while the attempt was live (confirmed on cc-waitlist-r2 s5/s6).
        # An ACTIVE authoring job means the most recent attempt is in flight and
        # has not yet produced a coding job: the truthful status is PENDING, and
        # the auto-author id must NOT land in job_id (the ENQUEUED poll would then
        # stage an authoring job's "done" as if it were a coding deliverable).
        if qstatus is None or qstatus not in _ACTIVE_QSTATES:
            ahit = by_label.get(f"auto-author-{label}")
            if ahit and ahit[1] in _ACTIVE_QSTATES:
                if s["status"] != PENDING or s.get("author_job_id") != ahit[0]:
                    print(f"# reconcile {sid}: {s['status']} -> {PENDING} "
                          f"(authoring job {ahit[0]} is {ahit[1]})")
                    s["status"] = PENDING
                    s["author_job_id"] = ahit[0]
                    changed += 1
                continue
        if qstatus is None and jid:
            # Bug #5: the live row was pruned after completion -> recover the
            # terminal outcome from the never-pruned sidecar so a passed-but-pruned
            # slice still advances the chain instead of stalling as "not found".
            qstatus = _sidecar_status(jid)
        if qstatus is None:
            continue                            # no queue evidence -> leave as-is
        want = _QUEUE_TO_SLICE.get(qstatus)
        if want is None:
            continue
        # A slice the ENQUEUED poll ESCALATED on the GATE's verdict for this very job
        # (gate-verdict-aware landing, 2026-09-23) is consistent with the queue's
        # `done`: the queue and the gate answer different questions. Flipping it back
        # to ENQUEUED here would make every --reconcile/--execute pair re-escalate it.
        if (s["status"] == ESCALATED and s.get("gate_verdict")
                and s.get("job_id") == jid and want == ENQUEUED):
            continue
        if s.get("job_id") != jid or s["status"] != want:
            print(f"# reconcile {sid}: {s['status']}/job={s.get('job_id')} "
                  f"-> {want}/job={jid} (queue={qstatus})")
            s["job_id"] = jid
            s["status"] = want
            changed += 1
    if changed:
        save_state(st)
        print(f"# reconciled {changed} slice(s) against the queue. "
              f"Re-run --execute to continue the chain.")
    else:
        print("# nothing to reconcile -- slice state already matches the queue.")


_ACTIVE_QSTATES = {"running", "queued", "pending", "scheduled", "held", "paused"}


def heal_status_for_live_job(label):
    """PURE. Bug #11 (2026-09-19). Given the QUEUE LABEL of a live job found for a
    slice that is carrying a stale FAILED marker, what status truthfully describes
    the slice?

    An `auto-author-<...>` job is still AUTHORING the harness -- no coding job
    exists yet -- so the slice is PENDING. A job under the bare `<label>-<sid>`
    coding label is the CODING dispatch itself: the slice is ENQUEUED.

    execute()'s self-heal used to stamp PENDING for BOTH, while reconcile() maps the
    very same live coding job to ENQUEUED via _QUEUE_TO_SLICE. Two code paths, one
    fact, opposite answers -- and the wrong one is destructive rather than merely
    untidy. With status=PENDING and a live coding job, the next --execute after that
    job finishes takes the PENDING branch, finds the harness already authored,
    "resumes" it, and enqueues a SECOND coding dispatch into the same worktree; the
    first job's converged deliverable is never staged onto the chain, and the two
    dispatches race on one tree (exactly the dirty-launch failure slice_job_inflight
    exists to prevent). Make the self-heal agree with reconcile.

    2026-09-19: `auto-refine-<...>-r<N>` is a round of the SAME authoring loop (it is
    enqueued by ollama-dispatch-auto, not by the slicer's coding dispatch), so it maps
    to PENDING alongside auto-author-. Reading a live refine round as ENQUEUED would
    claim a coding dispatch that does not exist yet."""
    lbl = str(label or "")
    return (PENDING if lbl.startswith(("auto-author-", "auto-refine-"))
            else ENQUEUED)


def slice_job_inflight(st, sid):
    """Return (job_id, qstatus, label) of an ACTIVE queue job for this slice --
    either its auto-author job or its coding job -- else None. Guards against
    launching a duplicate dispatch: a second --execute that reclaims the worktree
    while the first job is mid-flight leaves a dirty, non-attributable launch tree
    that the gate flags HIGH and marks the slice failed.

    BUG (2026-09-19): the label list was EXACT-MATCH on two names only, so it was
    blind to the third label shape the auto flow enqueues -- the refine rounds,
    `auto-refine-{label}-{sid}-r{N}`. With a refine job live in the queue this
    returned None, execute()'s "a dispatch is already in flight" guard did not
    fire, and the PENDING/resume branch ran clean_and_seal() on a worktree that a
    live job was about to use -- which is how job 0f3f0e7af69a
    (auto-refine-esim-global-s1-parse-global-r1) lost its acceptance test and was
    recorded as DID-NOT-CONVERGE. Match refine rounds by PREFIX so a new round
    suffix can never reintroduce the blind spot; prefer the highest round."""
    try:
        _, by_label = all_job_statuses()
    except Exception:
        return None
    for label in (f"auto-author-{st['label']}-{sid}", f"{st['label']}-{sid}"):
        hit = by_label.get(label)
        if hit:
            jid, qstatus = hit
            if qstatus in _ACTIVE_QSTATES:
                return jid, qstatus, label
    refine_pfx = f"auto-refine-{st['label']}-{sid}-r"

    def _round_no(lbl):
        # NUMERIC, not lexical: "-r10" sorts below "-r9" as a string.
        m = re.search(r"-r(\d+)$", lbl)
        return int(m.group(1)) if m else -1
    for label in sorted((l for l in by_label if l.startswith(refine_pfx)),
                        key=_round_no, reverse=True):
        jid, qstatus = by_label[label]
        if qstatus in _ACTIVE_QSTATES:
            return jid, qstatus, label
    # BUG (2026-10-06, soak seed 19): blind to the AUTHOR CONTINUATION shapes
    # `auto-author-{label}-{sid}-c{N}` / `-esc` (the same shapes _author_job_label_re
    # counts). With c1 pending, execute()'s in-flight guard did not fire and the
    # PENDING "harness already authored -- resuming" path ran clean_and_seal +
    # preflight on the tree the c1 author job was about to use.
    cont_re = re.compile(r"^auto-author-%s-%s-(?:c(\d+)|esc)$"
                         % (re.escape(str(st["label"])), re.escape(str(sid))))
    conts = [(l, cont_re.match(l)) for l in by_label]
    for label, m in sorted(((l, m) for l, m in conts if m),
                           key=lambda lm: int(lm[1].group(1) or 10**6), reverse=True):
        jid, qstatus = by_label[label]
        if qstatus in _ACTIVE_QSTATES:
            return jid, qstatus, label
    return None


# The queue fires gate-on-complete for exactly these terminal statuses (its reap
# loop's `gated_jobs`), so a job in one of them may have a gate still RUNNING against
# its worktree even though the job itself is no longer live.
_GATED_QSTATES = ("done", "done_unconverged", "failed")


def slice_job_awaiting_gate(st, sid, statuses=None, gate=None, age=None,
                            grace_s=LOST_EVENT_GRACE_S):
    """(job_id, label, age_s) of a job of this slice that has FINISHED (queue done/
    done_unconverged/failed) but whose gate has NOT reported a terminal verdict yet,
    inside the lost-event grace -- else None.

    The gap slice_job_inflight() cannot see: it answers "is a job LIVE?", and a job
    the queue has reaped is not live -- but its GATE is. gate-on-complete.py reads
    the worktree AFTER the reap (get_diff, the decidable checks, then the relevance
    measurement MUTATES the tree in place and restores it, then reads AUTO-TASK.md
    for the review intent), and its verdict is the completion event that fires the
    next --advance-detached for this plan.

    LIVE (2026-09-24, arr-codec-floor s4): r2's gate landed and its advance saw s4
    FAILED "with no live job" -- r3 had finished 9s earlier -- so it cleared the
    worktree for an auto-retry. r3's gate hit FileNotFoundError on AUTO-TASK.md 4s
    later and died with NO verdict; its relevance pass had meanwhile written the
    target back into the just-cleared directory, so the re-author's scaffold
    refused ("exists (use --force)") and s4 ended FAILED with nothing in flight and
    no event coming. The queue then held focus on the dead bundle for 10 minutes.

    Terminal verdict = a gate record exists, its verdict is not pass-pending-review
    and its review is not "pending" (the same wait coding_land_route() applies). A
    finished job with NO done.json cannot be timed and had no gate fired
    (ungateable) -> not awaiting. Bounded by LOST_EVENT_GRACE_S, the --sweep's own
    "terminal job nobody noticed" window: a gate that never reports cannot pin the
    slice forever. Job ids on the slice RECORD (author_job_id / job_id) count too,
    so a queue row pruned since the job finished does not blind the guard.
    `statuses`/`gate`/`age` are injectable for --self-test. Never raises."""
    try:
        _, by_label = (statuses if statuses is not None else all_job_statuses())
    except Exception:
        return None
    gate = gate or gate_record
    age = age or done_sidecar_age_s
    base = st["label"]
    cands = []
    for label, (jid, qs) in by_label.items():
        if (label in (f"auto-author-{base}-{sid}", f"{base}-{sid}")
                or label.startswith(f"auto-refine-{base}-{sid}-r")
                or re.match(r"^auto-author-%s-%s-(?:c\d+|esc)$"      # seed 19 class
                            % (re.escape(str(base)), re.escape(str(sid))), label)):
            if qs in _GATED_QSTATES:
                cands.append((jid, label))
    s = (st.get("slices") or {}).get(sid) or {}
    for k in ("author_job_id", "job_id"):
        jid = s.get(k)
        if jid and all(jid != c[0] for c in cands):
            cands.append((jid, f"{k} on record"))
    best = None
    for jid, label in cands:
        try:
            rec = gate(jid)
        except Exception:
            rec = None
        if (rec is not None
                and str(rec.get("verdict") or "") not in ("", "pass-pending-review",
                                                          GATE_FINDING_CHECK_VERDICT)
                and rec.get("review") != "pending"):
            continue  # a terminal verdict is on record: the gate is done with this tree
        if gate_review_failed(rec):
            continue  # its review died: no verdict is coming, the gate is done here
        try:
            a = age(jid)
        except Exception:
            a = None
        if a is None or a >= grace_s:
            continue  # untimeable (no gate was fired) or past the lost-event grace
        if best is None or a < best[2]:
            best = (jid, label, a)
    return best


def failed_job_gate_hold(st, sid, js, awaiting=None, gate=None, age=None):
    """(job_id, label, age_s) when a slice's ENQUEUED job ended non-PASS but its gate
    is still deciding (so an auto-fix round may yet be requeued), else None.
    Only the statuses the queue actually gates count (_GATED_QSTATES): a cancelled
    or errored job fires no gate, so waiting for one would only stall the slice.
    `awaiting`/`gate`/`age` are injectable for --self-test. Never raises."""
    if js not in _GATED_QSTATES:
        return None
    try:
        hit = (awaiting or slice_job_awaiting_gate)(st, sid)
    except Exception:
        hit = None
    if hit:
        return hit
    # REVIEW MERGED, AUTO-FIX NOT DECIDED YET (2026-10-06, canary run apikeyfile):
    # the gate's review merge writes review=done + verdict=fail, and only AFTER that
    # runs its auto-fix decision (which records auto_fix_action and requeues the
    # round). A poll between the two writes saw a terminal red verdict with no
    # successor and failed the slice. No auto_fix_action yet = the gate is not done.
    # Bounded by the same lost-event grace (a gate that dies there cannot pin it).
    try:
        jid = ((st.get("slices") or {}).get(sid) or {}).get("job_id")
        rec = (gate or gate_record)(jid) if jid else None
        why = None
        if isinstance(rec, dict) and rec.get("verdict"):
            act = rec.get("auto_fix_action")
            if act is None and rec.get("review") == "done":
                why = "auto-fix decision pending"
            # DECIDED BUT NOT YET EFFECTED (2026-10-06, canary diag2-2): the gate writes
            # auto_fix_action=requeue/escalate, THEN runs the enqueue/park subprocess
            # (seconds), THEN records its status. A poll in between saw "requeue" with
            # no successor row yet and failed the slice.
            elif (str(rec.get("auto_fix_mode") or "") == "live" and (
                    (act == "requeue" and "auto_fix_enqueue_status" not in rec)
                    or (act == "escalate" and "auto_fix_escalate_status" not in rec))):
                why = f"auto-fix {act} decided, not yet enqueued"
        if why:
            a = (age or done_sidecar_age_s)(jid)
            if a is not None and a < LOST_EVENT_GRACE_S:
                return (jid, why, a)
    except Exception:
        pass
    return None


def retry_slice(st, sid, notes=None):
    """Reset a FAILED/BLOCKED slice to pending and clear its worktree so the next
    --execute re-authors from a clean, attributable baseline. Automated recovery
    for the dirty-launch / aborted-author failure mode.

    `notes` (--review-notes FILE): the escalation review's findings, kept on the
    slice (last REVIEW_NOTES_KEEP) and appended to the authoring intent, so a
    re-author after a "spec under-specified" / "capability" verdict starts from
    what the review found instead of repeating the same attempt blind."""
    if sid not in st["slices"]:
        die(f"unknown slice {sid} (have: {', '.join(st['order'])})")
    infl = slice_job_inflight(st, sid)
    if infl:
        jid, qs, lbl = infl
        die(f"{sid} still has a live job ({lbl} [{jid}] = {qs}); cancel it before retrying")
    s = st["slices"][sid]
    # SILENT-DESTRUCTIVE-NO-OP GUARD (2026-09-19, found by the bg-brokers re-land).
    # --retry-slice never checked status, so on a DONE slice it did the WORST of
    # both worlds: it deleted the worktree (irreversible), then save_state ->
    # merge_terminal_facts force-restored DONE over the in-memory PENDING, so the
    # status flip silently reverted and the operator was told "reset to pending"
    # about a slice that is still done and has now lost its worktree. Refuse
    # before touching anything, and name the transition that actually applies.
    if s["status"] in SATISFIED:
        die(f"{sid} is {s['status']!r} -- --retry-slice refuses to touch a satisfied "
            f"slice (it would delete the worktree and then be silently reverted to "
            f"{s['status']!r} by the terminal-facts merge). If its work is NOT at the "
            f"chain tip -- e.g. a later slice rewrote the same function -- use "
            f"--reland-slice {sid} --reason '...', which is the supported way to "
            f"re-open a slice whose landed work was subsequently lost.")
    wt = s.get("worktree") or slice_worktree(st, sid)
    if hand_locked(wt):
        if os.environ.get("DISPATCH_SELF_HEAL"):
            die(f"{sid}: worktree is HAND-LOCKED ({wt}/{HAND_LOCK}) -- an automated "
                f"--retry-slice (self-heal) never discards a hand harness")
        print(f"# {sid}: discarding a HAND-LOCKED worktree on an explicit --retry-slice "
              f"(the lock goes with it).")
    if os.environ.get("DISPATCH_SELF_HEAL"):
        _bw = author_budget_block(st, sid, s)
        if _bw:
            die(f"{sid}: an automated --retry-slice (self-heal) is refused -- {_bw}. "
                f"The worktree is kept as evidence; a human decides the next step.")
    cwt = ensure_chain_worktree(st)
    remove_worktree(cwt, wt)
    s.pop("hand_locked_at", None)
    s["status"] = PENDING
    s["job_id"] = None
    # A human retry is a deliberate fresh start: the author-job budget counts from
    # here, and the identical-failure streak is forgotten (attempts stays as history).
    # An AUTOMATED retry (dispatch-self-heal.py, DISPATCH_SELF_HEAL=1) is NOT: it keeps
    # the current window (2026-10-05, s3fix: two self-heal retries each handed s3 a
    # fresh 8-job window -> 25 author/refine jobs).
    refresh_author_job_ids(st, sid, s)
    if not os.environ.get("DISPATCH_SELF_HEAL"):
        s["author_jobs_at_retry"] = len(s.get("author_job_ids") or [])
    for _k in ("author_fail_streak", "author_fail_sig"):
        s.pop(_k, None)
    if notes and notes.strip():
        s["review_notes"] = ((s.get("review_notes") or []) + [notes.strip()[:REVIEW_NOTES_MAX]]
                             )[-REVIEW_NOTES_KEEP:]
    save_state(st)
    print(f"# {sid}: reset to pending + worktree cleared -- it re-authors clean on the next advance."
          + (" Review notes attached to the authoring intent." if notes and notes.strip() else ""))
    return True


REVIEW_NOTES_KEEP = 2
REVIEW_NOTES_MAX = 2500


def authoring_intent(s):
    """PURE. The slice intent plus any attached review notes (see retry_slice)."""
    notes = [n for n in (s.get("review_notes") or []) if n]
    if not notes:
        return s["intent"]
    return (s["intent"] + "\n\nNOTES FROM THE REVIEW OF A PREVIOUS FAILED ATTEMPT -- "
            "address these; the intent above still defines the property:\n"
            + "\n---\n".join(notes))


def reland_slice(st, sid, reason):
    """Re-open a slice that is DONE but whose work is NO LONGER AT THE CHAIN TIP.

    THE MISSING TRANSITION (2026-09-19, bg-brokers). s2 added dedupe to
    load_brokers and landed DONE. s1 then landed on top of it and replaced the
    whole function, so s2's property silently stopped holding -- while the row
    still read `done`. Nothing in the state machine covered this: --retry-slice
    was a destructive no-op (see the guard there), --regate and --accept-slice
    both assert ESCALATED, and --skip-slice asserts the property ALREADY HOLDS,
    which is the exact opposite of the truth here.

    The gap matters because it is structural, not a one-off: any two slices that
    touch the same function can order this way, and the later one wins by
    construction. The chain has no ancestry check that would notice.

    This is the ONLY caller allowed to narrow a terminal status, it requires an
    explicit operator reason, and it records the previous status so the row can
    still explain its own history. It does NOT delete the worktree (the landed
    work is evidence) and it does NOT re-author on its own -- the next --execute
    does that."""
    if sid not in st["slices"]:
        die(f"unknown slice {sid} (have: {', '.join(st['order'])})")
    s = st["slices"][sid]
    if s["status"] not in SATISFIED:
        die(f"slice {sid} is {s['status']!r}, not one of {SATISFIED} -- --reland-slice "
            f"only re-opens a slice recorded as finished. A slice that is not "
            f"finished is already eligible for --execute / --retry-slice.")
    if not (reason or "").strip():
        die("--reland-slice requires --reason: re-opening a finished slice is an "
            "operator judgement and the row has to say why.")
    infl = slice_job_inflight(st, sid)
    if infl:
        jid, qs, lbl = infl
        die(f"{sid} still has a live job ({lbl} [{jid}] = {qs}); cancel it before relanding")
    prev = s["status"]
    s["status"] = PENDING
    s["job_id"] = None
    s["relanded_from"] = prev
    s["reland_reason"] = reason.strip()
    clear_author_failures(s)
    # The ONE place `unsatisfy` is passed: without it the merge below would read
    # the DONE still on disk and stamp this straight back, exactly as
    # --retry-slice used to be silently reverted.
    save_state(st, unsatisfy={sid})
    print(f"# {sid}: {prev} -> {PENDING} (re-landed). Reason: {s['reland_reason']}\n"
          f"#   The worktree was NOT deleted -- the previously landed work is evidence.\n"
          f"#   It re-authors and re-gates on the next advance.")
    return True


def skip_slice(st, sid, reason):
    """Retire a slice whose property is ALREADY SATISFIED at the chain tip.

    The missing transition (2026-09-19). A slice can be specified correctly, be
    perfectly authorable, and still have nothing to do -- because an earlier slice
    already implemented its property. bg-actions-s1-item s4 is the canonical case:
    s1 created broker_guard/actions.py with email_confirm accepted and exactly the
    six-key return set, which IS the entirety of s4's intent.

    Such a slice is not merely redundant, it is UNSATISFIABLE BY CONSTRUCTION under
    the harness contract. The both-ways proof requires verify.sh RED at baseline and
    GREEN only after refimpl.py; an honest fixture for an already-true property is
    GREEN at baseline, so no refimpl can flip it and no amount of re-authoring will
    ever converge. Before this existed the only recoveries were --retry-slice (spins
    forever) or hand-editing the run-state JSON (a dishonest bypass of a real gate).

    `reason` is REQUIRED and stored. A skip is a claim that the property already
    holds, and a claim with no stated grounds is indistinguishable from giving up."""
    if sid not in st["slices"]:
        die(f"unknown slice {sid} (have: {', '.join(st['order'])})")
    if not (reason or "").strip():
        die("--skip-slice requires --reason: state HOW you established the property "
            "already holds (what you ran, what it returned)")
    infl = slice_job_inflight(st, sid)
    if infl:
        jid, qs, lbl = infl
        die(f"{sid} still has a live job ({lbl} [{jid}] = {qs}); stop it before skipping "
            f"(`ollama-queue.py stop {jid}`)")
    s = st["slices"][sid]
    if s["status"] in SATISFIED:
        print(f"# {sid}: already {s['status']!r} -- nothing to do.")
        return
    s["status"] = SKIPPED
    s["skip_reason"] = reason.strip()
    s["skipped_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
    # Plan-level consent for the auto-skip path (see check_baseline_green_skip).
    # A human has now confirmed ONE already-satisfied slice in this plan, which is
    # the evidence that this plan's harnesses are not simply leaky. Only after that
    # is the automatic version trusted for the plan's remaining slices.
    st["baseline_green_confirmed"] = True
    save_state(st)
    print(f"# {sid}: SKIPPED -- {s['skip_reason']}")
    print(f"# Nothing lands on the chain for this slice; dependents may proceed on the "
          f"next advance.")
    return True


REGATEABLE = frozenset({ESCALATED, FAILED})


def regate_slice(st, sid, model, host, max_iters, chat_timeout, author_mode, num_ctx):
    """Re-run the MECHANICAL relevance gate + enqueue on a slice that ESCALATED,
    after its harness was fixed IN PLACE (e.g. a Claude-gate agent strengthened the
    fixture in the existing worktree). This is the missing escalated->confirmed
    transition: --retry-slice DELETES the worktree and re-authors from scratch
    (wiping the fix), --confirm-slice needs AWAITING_REVIEW, and --execute has no
    ESCALATED branch. It does NOT re-author and it does NOT bypass the gate --
    confirm_and_enqueue still runs preflight both-ways + verify-relevance, so a
    worktree that is not actually GO simply re-ESCALATES. Safe on any ESCALATED
    slice."""
    if sid not in st["slices"]:
        die(f"unknown slice {sid} (have: {', '.join(st['order'])})")
    s = st["slices"][sid]
    # FAILED too (2026-10-04, unattended-readiness 2a): a FAILED slice whose
    # harness was fixed in place had NO non-destructive way back -- --regate
    # refused it, --retry-slice deletes the fix, and the next --execute's FAILED
    # auto-heal cleared the worktree. Re-gating it is exactly as safe as for an
    # ESCALATED one: preflight still decides GO/NO-GO and a non-GO tree
    # re-ESCALATES.
    # PENDING + HAND-LOCKED (2026-10-05, rt-egift-link-s1-s0): --execute skips a
    # hand-locked PENDING slice and tells the operator "Move past it with --regate",
    # but --regate refused PENDING -- the only exit it advertised was a dead end (a
    # hand-lock taken while the author job was still running leaves the slice
    # PENDING forever). The lock is the human's claim on the tree; that is exactly
    # the precondition --regate needs, so accept it. An unlocked PENDING slice is
    # still refused (it may be mid-authoring).
    _wt0 = s.get("worktree") or slice_worktree(st, sid)
    if s["status"] not in REGATEABLE and not (s["status"] == PENDING and hand_locked(_wt0)):
        die(f"slice {sid} is {s['status']!r}, not one of {sorted(REGATEABLE)} (or a "
            f"HAND-LOCKED {PENDING!r}) -- --regate only re-gates an ESCALATED or FAILED "
            f"slice, or a pending one whose worktree a human hand-locked")
    infl = slice_job_inflight(st, sid)
    if infl:
        jid, qs, lbl = infl
        die(f"{sid} still has a live job ({lbl} [{jid}] = {qs}); wait for it before re-gating")
    wt = s.get("worktree") or slice_worktree(st, sid)
    if not os.path.isdir(wt):
        die(f"{sid}: worktree {wt} is gone -- cannot re-gate; use --retry-slice to re-author")
    if hand_locked(wt):
        _ignore_hand_lock(wt)
        print(f"# {sid}: worktree is HAND-LOCKED -- --regate tests the hand harness as "
              f"it is; the lock stays, so a later failure is NOT auto-retried over it.")
    s["status"] = CONFIRMED
    save_state(st)
    print(f"# {sid}: re-gating the fixed harness in {wt} "
          f"(preflight decides GO/NO-GO; a non-GO tree re-ESCALATES) ...")
    confirm_and_enqueue(st, sid, s, wt, model, host, max_iters, chat_timeout,
                        author_mode, num_ctx)


def accept_slice(st, sid):
    """The missing escalated->done transition (2026-09-19). --regate assumes the
    slice escalated BEFORE its coding job ran (a preflight/harness NO-GO on a
    clean baseline) and re-runs preflight + enqueue accordingly -- it NO-GOs
    forever on a slice whose coding job already converged and whose escalation
    came from the reviewer (needs_opus), because the target is no longer a
    clean baseline (that modified target IS the verified fix). --retry-slice
    would delete the worktree and re-author from scratch, discarding a correct
    converged fix. Neither transition fits "the code is right, a human/Opus
    already confirmed the reviewer's flag was a false positive -- land it."

    This is that transition: verify.sh must still say VERIFY_OK in the
    worktree (never trust an escalation's age or verdict string over a live
    re-run), then it stages + commits the deliverable exactly like the
    ENQUEUED-poll success path and stamps DONE. Bug class discovered live on
    bg-eraser-s1-invoke s4-profile-full-name -- see Agent-Dispatch-Log.md
    cont.87/88."""
    if sid not in st["slices"]:
        die(f"unknown slice {sid} (have: {', '.join(st['order'])})")
    s = st["slices"][sid]
    if s["status"] != ESCALATED:
        die(f"slice {sid} is {s['status']!r}, not {ESCALATED!r} -- --accept-slice "
            f"only lands a converged ESCALATED slice")
    infl = slice_job_inflight(st, sid)
    if infl:
        jid, qs, lbl = infl
        die(f"{sid} still has a live job ({lbl} [{jid}] = {qs}); resolve or wait "
            f"for it before accepting")
    wt = s.get("worktree") or slice_worktree(st, sid)
    if not os.path.isdir(wt):
        die(f"{sid}: worktree {wt} is gone -- cannot accept; use --retry-slice to re-author")
    print(f"# {sid}: re-running verify.sh in {wt} before accepting ...")
    vp = subprocess.run(["bash", "verify.sh"], cwd=wt, capture_output=True, text=True,
                        env=_SANDBOX_ENV)  # VERIFY-SANDBOX
    vout = (vp.stdout or "") + (vp.stderr or "")
    if vp.returncode != 0 or "VERIFY_OK" not in vout:
        die(f"{sid}: verify.sh did NOT confirm (rc={vp.returncode}); not accepting.\n"
            f"{vout.strip()[-800:]}")
    cwt = ensure_chain_worktree(st)
    outcome, msg = _stage_slice(cwt, wt, st, sid, s)
    if outcome != "ok":
        die(f"{sid}: verify.sh passed but {msg} -- refusing to accept (nothing to land)")
    cout, cmsg = _commit_slice(cwt, sid, s, st)
    if cout != "ok":
        die(f"{sid}: verify.sh passed but {cmsg}")
    s["status"] = DONE
    save_state(st)
    print(f"# {sid}: DONE (accepted), chain advanced to {cmsg[:8]}.")
    _resolve_parked_rows(s)
    return True


def _resolve_parked_rows(s, statuses=None, run=None):
    """Accepting a slice lands its fix; the coding job's queue row was parked
    needs_opus by the gate and nothing else ever moves it, so it sat on the
    dashboard (and in the escalation sweep) until someone ran
    `ollama-queue.py resolve <id>` by hand (2026-10-02, Rivian s4 5983078bfe69).
    Resolve exactly this slice's own job rows that are needs_opus. Never raises:
    the slice is already DONE; a failed resolve is reported, not fatal."""
    run = run or subprocess.run
    try:
        by_id, _ = statuses if statuses is not None else all_job_statuses()
    except Exception:
        return []
    done = []
    for k in ("job_id", "author_job_id"):
        jid = s.get(k)
        if jid and by_id.get(jid) == "needs_opus":
            r = run(["python3", QUEUE, "resolve", jid], capture_output=True, text=True)
            ok = getattr(r, "returncode", 1) == 0
            print(f"# queue row {jid} (needs_opus) " + ("resolved" if ok else
                  f"NOT resolved -- run: python3 {QUEUE} resolve {jid}"))
            if ok:
                done.append(jid)
    return done


# Active unconfirmed-draft markers (see ollama-dispatch-draft DRAFT_MARK/_JS). Their
# presence means the relevance review has NOT happened; `--confirm` strips them.
_DRAFT_UNCONFIRMED_MARKERS = ("DRAFT_UNCONFIRMED = True", "const DRAFT_UNCONFIRMED = true")


def _draft_unconfirmed(wt):
    """True if the slice worktree still carries an ACTIVE unconfirmed-draft marker in
    its fixture or TASK.md -- i.e. the mechanical relevance review has NOT cleared it.
    Used to keep the DRAFT_UNCONFIRMED / relevance gate intact on an UNATTENDED land."""
    for rel in ("TASK.md", "test_fixture.py", "verify.test.ts", "verify.test.mts",
                "verify_impl.mjs", "verify_impl.mts", "verify_impl.js"):
        p = Path(wt) / rel
        if not p.is_file():
            continue
        try:
            txt = p.read_text(errors="ignore")
        except OSError:
            continue
        if any(m in txt for m in _DRAFT_UNCONFIRMED_MARKERS):
            return True
    return False


def _land_green_slice(st, sid, s, cwt, require_relevance=True):
    """Re-run verify.sh LIVE in the slice worktree; if VERIFY_OK, stage+commit the
    deliverable onto the chain and stamp DONE. Returns (ok, message). The shared core
    of --complete-slice and execute()'s FAILED auto-land (Cause-2a, 2026-09-21).

    It NEVER trusts a stale verdict string -- the green proof is a live re-run, exactly
    as in accept_slice(). When require_relevance (the UNATTENDED land) it ALSO refuses a
    worktree still carrying an unconfirmed-draft marker, so an auto-land can never bypass
    the relevance review. The MANUAL lever passes require_relevance=False (the operator
    IS the review) and only WARNS on the marker; verify.sh green is still mandatory."""
    wt = s.get("worktree") or slice_worktree(st, sid)
    if not os.path.isdir(wt):
        return (False, f"worktree {wt} is gone -- cannot land")
    # The live verify, the staging read and the commit see ONE consistent tree: hold
    # the worktree tree lock across all three (soak seed 3, 2026-10-06 -- a racing
    # self-check had the target reset to baseline / holding refimpl output mid-read).
    with _wt_tree_lock(wt):
        return _land_green_slice_locked(st, sid, s, cwt, wt, require_relevance)


def _land_green_slice_locked(st, sid, s, cwt, wt, require_relevance):
    vp = subprocess.run(["bash", "verify.sh"], cwd=wt, capture_output=True, text=True,
                        env=_SANDBOX_ENV)  # VERIFY-SANDBOX
    vout = (vp.stdout or "") + (vp.stderr or "")
    if vp.returncode != 0 or "VERIFY_OK" not in vout:
        return (False, f"verify.sh did NOT confirm (rc={vp.returncode})\n{vout.strip()[-800:]}")
    if _draft_unconfirmed(wt):
        msg = ("the worktree still carries an unconfirmed-draft marker (DRAFT_UNCONFIRMED) "
               "-- the relevance review has not happened")
        if require_relevance:
            return (False, msg + f"; refusing to auto-land. Read {wt}'s fixture then "
                    f"`ollama-dispatch-draft {wt} --confirm`, or land it deliberately "
                    f"with --complete-slice {sid}.")
        print(f"# WARNING {sid}: {msg} -- landing on operator authority (--complete-slice).")
    outcome, m = _stage_slice(cwt, wt, st, sid, s)
    if outcome != "ok":
        return (False, f"verify.sh passed but {m} -- nothing to land")
    cout, cmsg = _commit_slice(cwt, sid, s, st)
    if cout != "ok":
        return (False, f"verify.sh passed but {cmsg}")
    s["status"] = DONE
    save_state(st)
    return (True, cmsg)


def complete_slice(st, sid):
    """Land a GREEN-but-unconverged slice directly -- the owner's "manually insert a complete
    with results when you need to step in" lever (2026-09-21).

    Behaves like --accept-slice (re-run verify.sh, refuse unless VERIFY_OK, then
    stage+commit the deliverable and stamp DONE + advance the chain) but does NOT require
    ESCALATED: it accepts a FAILED / ESCALATED / BLOCKED slice whose verify is green at
    HEAD -- the confirmed dirty-launch-baseline false-fail that parks correct code as
    `failed`. Because the operator is the reviewer, an unconfirmed-draft marker is a
    WARNING here rather than a refusal; verify.sh green is still mandatory (that is the
    safety, exactly as in --accept-slice)."""
    if sid not in st["slices"]:
        die(f"unknown slice {sid} (have: {', '.join(st['order'])})")
    s = st["slices"][sid]
    if s["status"] in SATISFIED:
        print(f"# {sid}: already {s['status']!r} -- nothing to complete.")
        return
    if s["status"] not in (FAILED, ESCALATED, BLOCKED):
        die(f"slice {sid} is {s['status']!r}, not one of FAILED/ESCALATED/BLOCKED -- "
            f"--complete-slice lands a green-but-unconverged slice. A slice still in "
            f"motion is --execute's business; use --accept-slice for an ESCALATED slice "
            f"you reviewed, or stop the live job first.")
    infl = slice_job_inflight(st, sid)
    if infl:
        jid, qs, lbl = infl
        die(f"{sid} still has a live job ({lbl} [{jid}] = {qs}); stop or wait for it "
            f"before completing (`ollama-queue.py stop {jid}`)")
    cwt = ensure_chain_worktree(st)
    print(f"# {sid}: re-running verify.sh in {s.get('worktree') or slice_worktree(st, sid)} "
          f"before completing ...")
    ok, msg = _land_green_slice(st, sid, s, cwt, require_relevance=False)
    if not ok:
        die(f"{sid}: {msg} -- refusing to complete (nothing green to land)")
    print(f"# {sid}: DONE (completed), chain advanced to {msg[:8]}.")
    return True


def dry_run(st):
    print(f"# ---- SLICE PLAN: {st['label']}  ({len(st['order'])} slices) ----")
    print(f"# repo:   {st['repo']}")
    print(f"# target: {st['target']}   lang: {st['lang']}")
    print(f"# chain branch: {st['chain_branch']}  (worktree {st['chain_worktree']})")
    print(f"# topological order: {', '.join(st['order'])}\n")
    for i, sid in enumerate(st["order"]):
        s = st["slices"][sid]
        print(f"# {i+1}/{len(st['order'])} {sid} [{s['status']}] -- {s['title']}")
        if s["depends_on"]:
            print(f"#     depends_on: {', '.join(s['depends_on'])}")
        print(f"#     must_contain: {', '.join(s['must_contain'])}")
        print(f"#     verify: {s['verify_shape']}")
    print("\n# --execute advances to the next checkpoint (author / review / enqueue / poll).")
    print("# at an 'awaiting_review' pause: read the slice worktree's test_fixture.py, then")
    print("#   ollama-dispatch-slice <plan> --confirm-slice <id> ; then --execute again.")


def show_status(st):
    """One line per slice; an ESCALATED slice is LOUD (marked `!!`, its reason on the next
    line, and a closing banner), and any slice that has authored shows its real budget use
    (`author 2/5 attempts, 7/8 jobs`). Before 2026-10-06 an escalated slice looked like any
    other row, with no reason and no budget."""
    esc = []
    budget = author_job_budget(st)
    if _FL is not None:
        _FL.sweep()                                     # fail-open: keep the ledger current
    for sid in st["order"]:
        s = st["slices"][sid]
        extra = (f"  job={s['job_id']}" if s.get("job_id") else "")
        extra += (f"  wt={s['worktree']}" if s.get("worktree") else "")
        att = int(s.get("author_attempts") or 0)
        jobs = max(0, len(s.get("author_job_ids") or []) - int(s.get("author_jobs_at_retry") or 0))
        if _FL is not None:
            try:
                c = _FL.slice_counter(st.get("label"), sid, s, job_budget=budget,
                                      lifetime_factor=AUTHOR_JOB_LIFETIME_FACTOR, attempt_cap=MAX_AUTHOR_ATTEMPTS)
                if c["jobs_lifetime"] or att:
                    extra += f"  [{c['text']}{' -- AT CAP' if c['at_cap'] else ''}]"
                    att = jobs = 0
            except Exception:
                pass
        if att or jobs:
            extra += f"  [author {att}/{MAX_AUTHOR_ATTEMPTS} attempts, {jobs}/{budget} jobs]"
        flag = "!!" if s["status"] == ESCALATED else "  "
        print(f"{flag}{s['status']:16} {sid:24} {s['title']}{extra}")
        if s["status"] == ESCALATED:
            esc.append(sid)
            print(f"      ESCALATED -- {str(s.get('escalation_reason') or '(no reason recorded)')[:400]}")
    if esc:
        print(f"!! {len(esc)} slice(s) ESCALATED and NOT retrying: {', '.join(esc)} -- the chain is "
              f"stopped here and needs a human (--regate / --retry-slice / --skip-slice).")


def confirm_slice(st, sid):
    if sid not in st["slices"]:
        die(f"unknown slice id {sid!r}")
    s = st["slices"][sid]
    if s["status"] != AWAITING_REVIEW:
        die(f"slice {sid} is {s['status']!r}, not {AWAITING_REVIEW!r} -- nothing to confirm")
    s["status"] = CONFIRMED
    save_state(st)
    print(f"confirmed {sid}: relevance reviewed -- it preflights + enqueues on the next advance.")
    return True


def slice_worktree(st, sid):
    return os.path.join(WT_ROOT, f"wt-slice-{st['label']}-{sid}")


def _bundle_args(st):
    """`--bundle <tag>` for every queue/AUTO command this plan issues, or nothing
    when the plan carries no bundle tag (see load_state's "bundle")."""
    tag = default_bundle(st)
    return ["--bundle", str(tag)] if tag else []


def default_bundle(st):
    """The queue bundle every row of this plan is stamped with: the plan's explicit
    `bundle`, else its ROOT plan label (a sub-plan, whose repo is its parent's chain
    worktree, inherits the parent's bundle). Before 2026-09-27 an untagged plan's
    rows carried bundle=None and the queue had to re-derive membership from label
    parsing on every tick -- the BFMR s2 refine cb21d014c3cd and the ev-service-
    screen jobs were bundle=None, so a gate row whose parent was pruned fell back
    to a bundle of one. Stamped at the source, membership cannot drift."""
    st = st or {}
    if st.get("bundle"):
        return st["bundle"]
    label = st.get("label")
    cur, seen = st, set()
    while cur and label and label not in seen and is_subplan(cur):
        seen.add(label)
        m = re.match(r"^wt-slice-(.+)-chain$",
                     os.path.basename(str(cur.get("repo") or "").rstrip("/")))
        if not m:
            break
        parent = read_state(m.group(1))
        if parent and parent.get("bundle"):
            return parent["bundle"]
        label, cur = m.group(1), parent
    return label


def auto_launch_argv(st, sid, s, cwt, wt, resume_author=False):
    """The full ollama-dispatch-auto argv for authoring slice `sid` off the chain tip `cwt`.
    One function so the launch contract (deterministic --baseline-ref = the chain tip's sha,
    --lane, bundle, shape, requires) is testable instead of living inline in execute()."""
    return [AUTO, "--repo", cwt, "--dest", wt,
            "--intent", authoring_intent(s), "--target", slice_target(st, s),
            *[f"--edit-file={_f}" for _f in slice_edit_files(st, s)],
            "--lang", st["lang"], "--label", f"{st['label']}-{sid}",
            "--slice-plan", st["label"], "--slice-id", sid,
            "--max-rounds", "4", *_baseline_args(cwt), *_lane_args_auto(st),
            *_bundle_args(st), *_shape_args(st),
            *_verify_shape_args(s), *_reqs(s),
            *(["--resume-author"] if resume_author else [])]


def _lane_of(st):
    """The plan's lane (--lane, persisted in the run state; env DISPATCH_LANE as a fallback)."""
    lane = (st or {}).get("lane") or os.environ.get("DISPATCH_LANE") or "open"
    return lane if lane in ("open", "fixed", "auto") else "open"


def _lane_args_auto(st):
    """`--lane X` for AUTO (omitted for the default open lane: argv stays byte-identical)."""
    lane = _lane_of(st)
    return [] if lane == "open" else ["--lane", lane]


def _lane_enqueue_args(st, cwt=None, targets=()):
    """`--mode X` for the slice's coding enqueue, via the shared task_class helper; [] for the
    open lane or when the queue's enqueue has no --mode (fail-closed: never breaks an enqueue)."""
    lane = _lane_of(st)
    if lane == "open":
        return []
    try:
        import importlib.util as _ilu
        _sp = _ilu.spec_from_file_location("task_class", os.path.join(os.path.dirname(
            os.path.realpath(__file__)), "task_class.py"))
        m = _ilu.module_from_spec(_sp)
        _sp.loader.exec_module(m)
        cls = None
        if cwt:
            tc = m.read_task_class(cwt)
            cls = (tc or {}).get("class")
        args = m.lane_args(lane, cls, QUEUE, targets=targets)
    except Exception:
        args = []
    if not args:
        print(f"# lane {lane} requested but the queue enqueue has no --mode: open lane", file=sys.stderr)
    return args


SPEC_DEFECT_MARK = "SPEC_DEFECT: "


def is_spec_defect(sig):
    """PURE. True when a failure signature is a pre-dispatch SPEC_DEFECT (the spec
    contradicts the base tree). Those route to RE-SPEC on first sight, not a retry."""
    return SPEC_DEFECT_MARK in str(sig or "")


def _baseline_args(cwt):
    """`--baseline-ref <sha>` for AUTO: the chain worktree's CURRENT tip, resolved
    here once so the scaffold cuts the slice from exactly the tree the chain is on
    (no origin fetch, no re-resolution; AUTO records it as base_sha in
    .dispatch-harness.json). Nothing when the tip cannot be resolved."""
    try:
        r = subprocess.run(["git", "-C", str(cwt), "rev-parse", "--verify", "-q", "HEAD^{commit}"],
                           capture_output=True, text=True, timeout=30)
        sha = (r.stdout or "").strip()
        if r.returncode == 0 and re.fullmatch(r"[0-9a-f]{40,64}", sha):
            return ["--baseline-ref", sha]
    except Exception:
        pass
    return []


def _shape_args(st):
    """AUTO's --kind/--anchor/--symbol for this plan's TS/JS harness shape, or
    nothing (older run states and non-TS plans carry none of these keys)."""
    out = []
    for k in ("kind", "anchor", "symbol"):
        v = (st or {}).get(k)
        if v:
            out.append(f"--{k}={v}")
    return out


def _verify_shape_args(s):
    """AUTO's --verify-shape for this slice (the plan's verify design), or nothing.
    `=` form: the text may start with '-'. (2026-10-05, rt-egift-link-s1-s0: the
    author never saw the plan's verify_shape and built an unrunnable mock fixture.)"""
    vs = str((s or {}).get("verify_shape") or "").strip()
    return [f"--verify-shape={vs}"] if vs else []


def _reqs(s):
    out = []
    for lit in s["must_contain"]:
        # `--require <lit>` breaks argparse when lit starts with '-' (e.g. a
        # sort-key literal like "-codec_rank(") -- it gets misread as a new
        # option instead of this flag's value. The `=` form is immune to that.
        out.append(f"--require={lit}")
    return out


def vacuous_gate_reason(st, s, status, baseline_root):
    """The whole guard decision for one slice, as ONE testable call.

    execute() used to make this decision with an inline `if status in (...)`
    wrapper around vacuous_literals(). A revert-test showed that wrapper could be
    neutered (`if False:`) without any test noticing -- source-greps cannot see a
    dead branch. Folding the status filter in here means the decision itself is
    unit-tested per status, and execute() keeps only an unconditional call."""
    if status not in (PENDING, CONFIRMED, FAILED, BLOCKED):
        return None
    return vacuous_literals(st, s, baseline_root)


def vacuous_literals(st, s, baseline_root):
    """Return a REASON string if this slice's must_contain literals cannot
    possibly discriminate its change, else None.

    WHY (2026-09-19, found on cc-waitlist-r2). must_contain literals are asserted
    against the TARGET FILE, and they are the only mechanical statement of "the
    dispatch actually wrote the thing we asked for". cc-waitlist-r2 carried the
    literal "on" on all six slices, and it was the ONLY literal on s5/s6 -- "on"
    is a substring of `function`, so it matches essentially any TypeScript file,
    including the untouched baseline. That gate passes before the model has done
    anything. s4 already LANDED under it.

    The check is deliberately not a heuristic about literal length or wordiness:
    the decidable question is whether the literal set already holds at baseline.
    If EVERY literal is already present in the target file before the slice runs,
    the requirement set is satisfied by doing nothing, and it can never tell a
    real implementation from an empty diff. If even one literal is absent, that
    one discriminates and the set is fine.

    Target missing at baseline (a creation slice) => nothing is present => not
    vacuous. Unreadable for any other reason => we do NOT block: the guard only
    fires on a fact it positively established."""
    lits = [l for l in (s.get("must_contain") or []) if str(l).strip()]
    if not lits:
        # An EMPTY literal set (2026-09-23). omnibus_slice._tokens() returns [] on
        # purpose when a clause has no discriminating token ("better no literal
        # check than a vacuous one that reads as coverage"), and this guard then
        # parked every such slice as a plan defect -- 2 of the 7 live escalations
        # today (rt-bfmr-tracking-endorsement s2, rt-bfmr-pending-sync-scope s1).
        # The two tools disagreed; the literal guard is the SECONDARY check. The
        # primary discriminator is the fixture, proven both-ways by preflight
        # (verify RED at baseline, GREEN under refimpl) and mutation-scored. So an
        # ordinary slice with no literals proceeds on the fixture alone, recorded
        # and said out loud. An INVARIANT slice is the exception: its whole
        # skip-vs-run decision rests on the literals, so it still needs them.
        if s.get("kind") == "invariant":
            return ("the slice declares NO must_contain literals at all, so the gate "
                    "asserts nothing about the target file -- an empty diff would pass")
        if not s.get("must_contain_empty_accepted"):
            s["must_contain_empty_accepted"] = True
            s["_refined_dirty"] = True
            print("# must_contain is EMPTY for this slice -- proceeding on the fixture "
                  "alone (preflight's both-ways + relevance proof is the discriminator; "
                  "the literal guard adds nothing here).")
        return None
    rel = st.get("target")
    if not rel:
        return None
    path = os.path.join(baseline_root, rel)
    if not os.path.exists(path):
        return None
    try:
        body = Path(path).read_text(errors="replace")
    except OSError:
        return None
    absent = [l for l in lits if l not in body]
    if absent:
        return None
    if s.get("kind") == "invariant":
        # ALREADY-SATISFIED INVARIANT (Phase 2, 2026-10-08). Every literal an invariant slice
        # names is present at the tip: the property holds, so there is nothing to land.
        # Never refine/re-derive literals here -- that turned the structures it is ABOUT into
        # a fresh dispatchable gate (and the invariant slices then burned author jobs on a
        # property that already held). execute() turns this reason into SKIPPED.
        shown = ", ".join(repr(l) for l in lits[:6]) + (" ..." if len(lits) > 6 else "")
        return (f"every must_contain literal ({shown}) of this invariant slice is already "
                f"present in {rel} at the chain tip (already satisfied)")
    # CALL-SITE REFINEMENT (2026-09-23, Fable pass 2; live on aw-sched-runner
    # s23-always-calls-upsert-sche). The literal was `upsert_schedule`; the symbol
    # was IMPORTED at baseline (line 8) and never called -- exactly the work the
    # slice asks for -- so the bare name was present and the slice was parked as
    # vacuous, and every --retry-slice re-parked it on the spot. The plan tool's
    # own rule for this is "use the call-site form": `upsert_schedule(` is absent
    # at baseline and discriminates perfectly. That restatement is mechanical, so
    # do it here instead of handing a human a sentence: for each bare identifier
    # already present, if `NAME(` is NOT at baseline, the slice's literal becomes
    # `NAME(`. The run state records the refinement; the plan file is untouched.
    # DECLARED-ONLY IS NOT VACUOUS (2026-09-23, arr-codec-floor s4-pack-vs-pack).
    # The consumer slice of a definer carries the helper's name (`codec_rank`) so
    # the gate can assert it CALLS the helper. Once the definer lands, that name
    # is at baseline on its `def codec_rank(` line -- and only there. The old
    # rule ("every literal present => vacuous") parked EVERY consumer slice of
    # every definer as a plan defect; 3 of the 7 live escalations were this. A
    # symbol that is only declared/imported and never used is precisely what the
    # slice exists to change, so the set still discriminates the work asked for.
    # Only a literal already USED at baseline (a call, an assignment, prose) is
    # satisfied by doing nothing. Refine to `NAME(` where that form is absent
    # (the import case); keep the bare name where it is not (the def case, where
    # `def NAME(` already contains it) and record why.
    classes = classify_baseline_literals(lits, body)
    declared = [l for l in lits if classes[l] == "declared"]
    if declared:
        refined, changed = refine_call_site_literals(lits, body)
        kept = [l for l in declared if l in refined]
        if changed:
            s["must_contain"] = refined
            s["must_contain_refined"] = {"from": lits, "to": refined,
                                         "at": datetime.now(timezone.utc).isoformat(timespec="seconds")}
            print(f"# must_contain refined to call-site form "
                  f"{[l for l in refined if l not in lits]} -- the bare name(s) appear at "
                  f"baseline only on import/declaration lines and could not discriminate.")
        if kept:
            s["must_contain_declared_only"] = kept
            print(f"# must_contain literal(s) {kept} appear at baseline ONLY on their own "
                  f"declaration line (def/class); the slice's job is to USE them, so the "
                  f"set is not vacuous. The fixture is the discriminator.")
        s["_refined_dirty"] = True      # execute() persists; this fn stays side-effect free on disk
        return None
    # EVERY literal is USED at baseline -- the set is vacuous as it stands. Before
    # parking this on a human, try to re-derive a discriminator from the slice's own
    # intent/title, which is exactly what a human does by hand (see
    # discriminating_candidates). Found ones are APPENDED, never substituted: the
    # original literals keep their identification value, and because the gate is
    # conjunctive a single absent literal makes the whole set discriminate again.
    # Capped at 2 -- each added literal is another thing the finished code MUST
    # contain, and an over-constrained gate is its own failure mode. If a candidate
    # is wrong, preflight's both-ways proof catches it against refimpl BEFORE a
    # coding dispatch is launched, and `must_contain_rederived` says where it came
    # from.
    extra = discriminating_candidates(
        f"{s.get('intent') or ''} {s.get('title') or ''}", body, exclude=rel)[:2]
    if extra:
        s["must_contain"] = lits + extra
        s["must_contain_rederived"] = {
            "from": lits, "added": extra,
            "why": f"every original literal is already used in {rel} at the chain tip",
            "at": datetime.now(timezone.utc).isoformat(timespec="seconds")}
        s["_refined_dirty"] = True
        print(f"# must_contain was VACUOUS at the chain tip (every literal already "
              f"used in {rel}); re-derived {extra} from the slice's own intent -- "
              f"absent at baseline, so the set discriminates again. Not escalating.")
        return None
    shown = ", ".join(repr(l) for l in lits[:6]) + (" ..." if len(lits) > 6 else "")
    return (f"every must_contain literal ({shown}) is ALREADY present in {rel} at "
            f"baseline, so the gate is satisfied by an empty diff and cannot tell "
            f"a real implementation from no work at all, and no more specific literal "
            f"could be derived from the slice's own intent/title either")


_IDENT_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
# A line that merely NAMES a symbol without using it: imports/exports and
# declarations. Python, JS/TS and Swift/Go spellings.
_DECL_LINE_RE = re.compile(
    r"^\s*(?:from\s|import\s|export\s|def\s|async\s+def\s|class\s|interface\s|type\s"
    r"|(?:const|let|var)\s+[^=]*=\s*(?:await\s+)?require\(|@)")


def classify_baseline_literals(lits, baseline_body):
    """PURE. literal -> 'absent' | 'declared' | 'used' against the baseline text.
    'declared': a bare identifier whose every whole-word occurrence is on an
    import/export/def/class/decorator line (_DECL_LINE_RE). 'used': present in
    any other way -- a call, an assignment, prose, or a non-identifier literal
    (e.g. `on` inside `function`) -- i.e. satisfied by doing nothing."""
    lines = baseline_body.splitlines()
    out = {}
    for l in lits:
        if l not in baseline_body:
            out[l] = "absent"
            continue
        if not _IDENT_RE.match(l):
            out[l] = "used"
            continue
        word = re.compile(r"(?<![A-Za-z0-9_])" + re.escape(l) + r"(?![A-Za-z0-9_])")
        hits = [ln for ln in lines if word.search(ln)]
        out[l] = "declared" if hits and all(_DECL_LINE_RE.match(ln) for ln in hits) else "used"
    return out


def refine_call_site_literals(lits, baseline_body):
    """PURE. For a bare identifier literal that appears at baseline ONLY on
    import/declaration lines (as a whole word), substitute its call-site form
    `NAME(` when THAT is absent at baseline. Returns (new_list, changed).

    Deliberately narrow: an identifier used anywhere else at baseline (a call, an
    assignment, prose) is left alone, and so is anything that is not an identifier
    -- the cc-waitlist-r2 literal `on` matches inside `function` but is never a
    whole word on an import line, so it stays vacuous and still parks the slice.
    A name whose `NAME(` form IS at baseline (its own `def NAME(` line) is left
    bare: see vacuous_literals(), which records it as declared-only instead."""
    out, changed = [], False
    classes = classify_baseline_literals(lits, baseline_body)
    for l in lits:
        if classes[l] == "declared" and (l + "(") not in baseline_body:
            out.append(l + "(")
            changed = True
        else:
            out.append(l)
    return out, changed


# ---------------------------------------------------------------------------
# RE-DERIVING A DISCRIMINATOR FROM THE SLICE'S OWN INTENT (2026-09-25)
#
# WHY. The vacuous-gate guard below is chain-tip-aware and fires BEFORE authoring,
# so it never burns a coding dispatch -- but it then STOPS and hands a human the
# job of picking a better literal. That manual loop is the actual recurring cost:
# `arr-codec-floor` s2/s3/s4, four `aw-sched-runner` slices, `rt-costco-always-sites`
# s3, `arr-webhook...` s6/s7, `aw-sched-routes` s14 -- every one was resolved by a
# person re-reading the slice's own intent and copying a more specific string out of
# it. That restatement is mechanical, exactly like refine_call_site_literals(), so
# do it here instead of escalating.
#
# The plan-time validator (ollama-dispatch-plan's VACUOUS_MUST_CONTAIN) cannot fix
# this class: it reads the target as it is when the PLAN is drafted, while the gate
# compares against the CHAIN TIP, which advances as sibling slices land. A literal
# that was absent at plan time (`sched_id` before s1..s13 of aw-sched-routes landed
# their routes) is present by the time s14 dispatches. Chain-tip vacuity is only
# decidable here, per slice, at dispatch time.
_PATH_TOKEN_RE = re.compile(r"/[A-Za-z0-9_\-{}./]+")
_QUOTED_RE = re.compile(r"'([^'\n]{2,60})'|\"([^\"\n]{2,60})\"")
_CALLSITE_RE = re.compile(r"([A-Za-z_]\w*)\s*\(")
_STRUCT_TOKEN_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*_[A-Za-z0-9_]+|"
                              r"\b[A-Za-z][a-z0-9]+[A-Z][A-Za-z0-9]*\b")
_BARE_PARAM_RE = re.compile(r"^\{[A-Za-z_]\w*\}$")
# A source FILENAME. Never a gate literal: a file does not contain its own name, so
# it looks absent-at-baseline (i.e. discriminating) while asserting nothing at all.
_SOURCE_FILENAME_RE = re.compile(
    r"\.(?:py|pyi|ts|tsx|js|jsx|mjs|cjs|go|rs|rb|java|kt|swift|c|h|cc|cpp|hpp|"
    r"sh|bash|json|ya?ml|toml|sql|md)\b")
# identifier STRUCTURE: snake_case, dotted, kebab/flag, a phrase, or a camelCase
# hump. Same rule as omnibus_slice._is_discriminating, which authored these
# literals in the first place -- a re-derived literal is held to the same bar.
_STRUCTURED_LIT = re.compile(r"[_.\-@/\s{}]|[a-z0-9][A-Z]")
_COMMON_WORD = frozenset("""
a an the and or but if when then else on in at by to of for from with within without
is are was were be been being has have had does do did not no nor so such as
this that these those it its there here which who whom whose while until since
new old all any each every one two both same other another next last first
set get put add use call run make take keep pass fail skip show hide
true false none null nil void self this that value key name type data item
list dict str int bool float char text line file path code test spec
helper function method class field param flag option check guard route
""".split())


def literal_is_specific(lit):
    """PURE. True iff `lit` is specific enough to freeze as a gate literal.
    A bare path parameter (`{sched_id}`) names no work and is refused: it is the
    part of a route every sibling route already carries."""
    s = (lit or "").strip()
    if len(s) < 3 or not re.search(r"[A-Za-z0-9]", s):
        return False
    if _BARE_PARAM_RE.match(s):
        return False
    if _STRUCTURED_LIT.search(s):
        return True
    if not s.isalpha():
        return True
    if s.lower() in _COMMON_WORD:
        return False
    if s.islower() and len(s) < 4:
        return False
    return True


def discriminating_candidates(text, baseline_body, exclude=""):
    """PURE. Literals derived from the slice's OWN intent/title that are ABSENT from
    `baseline_body`, most specific first. Never invents: every candidate is a
    substring of `text` (or a `NAME(` call-site form of a name in it), which is also
    what ollama-dispatch-plan's LITERAL_NOT_IN_INTENT rule requires.

    Families, in priority order:
      1. route/path TAILS. A path in an intent is rarely verbatim in the code --
         `aw-sched-routes` s14's intent says `/scheduled/{sched_id}/toggle` while the
         router carries the `/scheduled` prefix and the decorator reads
         `@router.post("/{sched_id}/toggle")`. The tail segments (`{sched_id}/toggle`,
         `toggle`) survive the prefix; the full path does not.
      2. call-site forms `NAME(` for names the intent says the slice calls.
      3. the INNER text of quoted strings, without the quotes -- quote-style
         agnostic, so a refimpl that writes "enabled" satisfies an intent that
         said 'enabled'.
      4. structured identifiers (snake_case / camelCase) named in the intent.

    `exclude` is text whose substrings can never be candidates -- pass the slice's
    TARGET path. Almost every generated intent opens with "In <target>: ...", and
    a file's own path is the worst possible gate literal: it is absent from the
    baseline only because source files do not name themselves, so it would read as
    a discriminator while asserting nothing the change introduces.
    """
    text = text or ""
    cands = []

    def add(c):
        c = (c or "").strip().strip(",.;:")
        if c and c not in cands:
            cands.append(c)

    for p in _PATH_TOKEN_RE.findall(text):
        segs = [x for x in p.strip("/").split("/") if x]
        if len(segs) >= 2:
            add("/".join(segs[-2:]))
        if segs:
            add(segs[-1])
    for name in _CALLSITE_RE.findall(text):
        add(name + "(")
    for a, b in _QUOTED_RE.findall(text):
        add(a or b)
    for t in _STRUCT_TOKEN_RE.findall(text):
        add(t)

    return [c for c in cands
            if c not in baseline_body
            and (not exclude or c not in exclude)
            and not _SOURCE_FILENAME_RE.search(c)
            and literal_is_specific(c)]


BASELINE_GREEN_MARKER = "verify PASSES on the untouched baseline"

# The SAME fact, stated by the authoring self-check instead of by preflight
# (ollama-dispatch-auto's auto-harness-check.py). This is the marker that makes
# already-satisfied detectable BEFORE a coding dispatch is ever scaffolded --
# see park_if_already_satisfied().
AUTHOR_BASELINE_GREEN_MARKER = "verify.sh PASSES at baseline"


_PF_FAIL_LINE = re.compile(r"^\s*\[FAIL\s*\]\s+(\S+)\s+(.*?)\s*$")
_PF_NOGO_LINE = re.compile(r"^NO-GO:\s+(\S+)\s+--\s+(.*?)\s*$")
# How many times a CONFIRMED slice may bounce off a cwd-exclusive collision before
# that is treated as a real problem rather than "the other job has not finished".
CWD_COLLISION_MAX = 6


def preflight_blockers(pf):
    """PURE. The [FAIL] rows of a captured preflight run as [(check_id, msg), ...],
    in report order, falling back to the `NO-GO: id -- msg` verdict line. Empty
    when nothing parseable failed (a crash before the report, an empty run).

    This is what turns a NO-GO into an `escalation_reason` (#10, 2026-09-23): the
    preflight branch of confirm_and_enqueue set ESCALATED with no reason at all,
    so the needs-eyes row, the watcher's context file and the ESCALATED stanza all
    said only "relevance gate NO-GO" -- for a verify-relevance miss, a dirty
    baseline, a cwd collision and a harness crash alike."""
    blob = (getattr(pf, "stdout", "") or "") + "\n" + (getattr(pf, "stderr", "") or "")
    out, seen = [], set()
    for ln in blob.splitlines():
        m = _PF_FAIL_LINE.match(ln)
        if m and m.group(1) not in seen:
            seen.add(m.group(1))
            out.append((m.group(1), m.group(2)))
    if not out:
        for ln in blob.splitlines():
            m = _PF_NOGO_LINE.match(ln.strip())
            if m:
                out.append((m.group(1), m.group(2)))
                break
    return out


def preflight_nogo_kind(blockers):
    """PURE. Classify a NO-GO by its blocker set: `collision` when the ONLY thing
    that failed is cwd-exclusive (another active queue job owns this worktree --
    a scheduling fact about the queue, not a verdict on the harness; #5), else
    `verdict`. An empty blocker list is a `verdict` (unknown failure: escalate)."""
    ids = {b[0] for b in blockers}
    return "collision" if ids and ids == {"cwd-exclusive"} else "verdict"


def _preflight_says_baseline_green(pf):
    """True when preflight's NO-GO is specifically 'the verify was already green'.

    Matched on preflight's own `baseline-fails` wording (BASELINE_GREEN_MARKER),
    which is the single decidable statement of "nothing to do here". Kept as a pure
    helper on (stdout, stderr) so --self-test can pin both directions: this must NOT
    match an ordinary NO-GO, or a real harness defect would be silently skipped."""
    blob = (getattr(pf, "stdout", "") or "") + (getattr(pf, "stderr", "") or "")
    return BASELINE_GREEN_MARKER in blob


def audit_baseline_green_claim(wt):
    """Independently re-verify a claimed 'verify.sh is green at baseline' fact by
    actually running verify.sh in `wt` right now, instead of trusting whatever
    preflight or the authoring self-check reported earlier. True if the claim
    holds (verify really does pass with VERIFY_OK); False if it does not.

    DEFENSE IN DEPTH (2026-09-21, the owner: "do we/should we build some kind of
    automated review for failed jobs to ensure we didn't do anything to cause the
    failure?"). This exact claim was wrongly reported once THIS session by a
    different bug (confirm_and_enqueue routing every preflight NO-GO through here,
    not just a genuine baseline-green one -- see _preflight_says_baseline_green
    above, now fixed). Both times a bad reason string here was only caught because
    a human got suspicious of the wording and re-ran verify.sh by hand. Routing a
    decision this consequential (SKIP the slice, or park it for a human) through a
    single upstream self-report is exactly that failure mode -- cheap to close
    mechanically (verify.sh already runs in well under a second in this pipeline)
    rather than relying on someone noticing again next time."""
    # "Baseline" means the TARGET AT HEAD (2026-10-02, Rivian s1): a failed/aborted
    # authoring round can leave refimpl output or a model edit in the target, and
    # measuring that dirty tree "confirmed" a green-at-baseline claim that the chain
    # tip does not satisfy (the tip had no mapServiceRequestStatus at all). Put the
    # declared target back to HEAD for the measurement only, then restore its bytes.
    target, saved = _harness_target(wt), None
    if target:
        p = Path(wt) / target
        dirty = run(["git", "-C", str(wt), "diff", "--quiet", "HEAD", "--", target],
                    capture_output=True, text=True).returncode != 0
        if dirty and p.is_file():
            saved = p.read_bytes()
            run(["git", "-C", str(wt), "checkout", "HEAD", "--", target],
                capture_output=True, text=True)
    try:
        rc, so = _audit_verify(wt)
    finally:
        if saved is not None:
            (Path(wt) / target).write_bytes(saved)
    return rc == 0 and "VERIFY_OK" in (so or "")


def _audit_verify(wt):
    """(rc, stdout) of verify.sh in `wt`, own process group, whole-group timeout kill.
    A missing worktree cannot confirm anything -> (127, '')."""
    if not Path(wt).is_dir():
        return 127, ""
    rc, so, _se, _to = _pgrun().run_group(["bash", "verify.sh"], cwd=wt,
                                           timeout=AUDIT_VERIFY_TIMEOUT_S, shell=False)
    return rc, so


AUDIT_VERIFY_TIMEOUT_S = 900
_PGRUN_MOD = []


def _pgrun():
    """~/bin/pgrun.py, loaded once (own process group + whole-group timeout kill)."""
    if not _PGRUN_MOD:
        import importlib.util as _ilu
        _s = _ilu.spec_from_file_location("pgrun", Path(__file__).resolve().parent / "pgrun.py")
        _m = _ilu.module_from_spec(_s)
        _s.loader.exec_module(_m)
        _PGRUN_MOD.append(_m)
    return _PGRUN_MOD[0]


def _harness_target(wt):
    """The declared target from <wt>/.dispatch-harness.json, else None."""
    try:
        return (json.loads((Path(wt) / ".dispatch-harness.json").read_text()) or {}).get("target")
    except (OSError, ValueError, AttributeError):
        return None


def baseline_green_discriminates(st, wt):
    """MECHANICAL 'already satisfied by an earlier slice' proof (2026-10-03, item 4).

    park_if_already_satisfied used to send the FIRST green-at-baseline slice of every
    plan to a human because "satisfied" and "leaky fixture" looked identical from the
    tip alone. They are NOT identical one commit-range back: put the declared target
    back to its content at the CHAIN BASE (merge-base of the slice worktree's HEAD and
    the repo's local default branch -- i.e. before ANY slice of this chain touched it)
    and run the same verify.sh:
        RED at base + GREEN at tip  -> the fixture discriminates, and what flipped it
                                       is this chain's own earlier work: auto-skip.
        GREEN at base               -> leaky fixture OR property already on main:
                                       still ambiguous, still a human.
        target unchanged base..tip  -> no discrimination possible: human.
    Only the target is swapped (a target ABSENT at base is removed for the run = its
    faithful base state); its exact bytes (or absence) are restored afterwards and the
    restore is checked. Any error -> (False, ...) -> the existing escalation.

    Returns (discriminates: bool, evidence: dict)."""
    ev = {"method": "verify.sh with target at chain base vs tip"}
    target = _harness_target(wt)
    if not target or not Path(wt).is_dir():
        ev["why"] = "no declared harness target / worktree -- cannot discriminate"
        return False, ev
    repo = (st or {}).get("repo") or ""
    dref = local_default_branch(repo) if repo and os.path.isdir(repo) else None
    if not dref:
        ev["why"] = "no local default branch for %r -- no chain base" % repo
        return False, ev
    # TIP = THE CHAIN BRANCH, not the slice worktree's HEAD (2026-10-06,
    # rt-egift-link-s1 s1-parse-link + s4-api-route). The slice worktree's HEAD
    # carries its OWN "seal dispatch harness" / "seal round baseline" commits, and
    # those sealed the model's draft of the target. "RED at base, GREEN at HEAD" then
    # proved only that the slice's own unlanded draft passes: both slices were
    # SKIPPED as "already satisfied by an earlier slice" while the chain never got
    # parseCostcoDeliveryLink or the route, and s5 (which needs both) burned 9 jobs.
    # Prove it against what the chain actually holds, and require the target the
    # verify just went green on to BE the chain's copy.
    chain = (st or {}).get("chain_branch") or ""
    tip = git(wt, "rev-parse", "--verify", "-q", chain + "^{commit}", capture=True) if chain else ""
    if not tip:
        ev.update({"target": target, "chain_branch": chain or None,
                   "why": "no chain branch tip to prove against -- cannot discriminate"})
        return False, ev
    base = git(wt, "merge-base", dref, tip, capture=True)
    ev.update({"target": target, "onto": dref, "base_rev": base or None, "tip_rev": tip or None,
               "chain_branch": chain})
    if not base or not tip:
        ev["why"] = "could not resolve chain base/tip"
        return False, ev

    def _blob(rev):
        cp = run(["git", "-C", str(wt), "show", "%s:%s" % (rev, target)], capture_output=True)
        return cp.stdout if cp.returncode == 0 else None
    base_blob, tip_blob = _blob(base), _blob(tip)
    p = Path(wt) / target
    existed = p.is_file()
    saved = p.read_bytes() if existed else None
    if saved != tip_blob:
        ev["why"] = ("the target in the slice worktree is NOT the chain tip's copy (%s) -- the "
                     "green verify ran on this slice's OWN sealed/unlanded edit, which proves "
                     "nothing about an earlier slice" % (tip[:12],))
        return False, ev
    if base_blob == tip_blob:
        ev["why"] = ("target is identical at chain base and tip -- no earlier slice of "
                     "this chain changed it, so green-at-tip means green-at-base")
        return False, ev
    try:
        if base_blob is None:
            if existed:
                p.unlink()
        else:
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_bytes(base_blob)
        rc, so = _audit_verify(wt)
    finally:
        if existed:
            p.write_bytes(saved)
        elif p.exists():
            p.unlink()
    restored = (p.read_bytes() == saved) if existed else (not p.exists())
    base_green = rc == 0 and "VERIFY_OK" in (so or "")
    ev.update({"base_verify_rc": rc, "base_verify_ok": base_green,
               "target_absent_at_base": base_blob is None, "restored_exactly": restored})
    if not restored:
        ev["why"] = "target bytes NOT restored exactly -- refusing to trust the run"
        return False, ev
    if base_green:
        ev["why"] = ("verify is ALSO green with the target at the chain base -- leaky "
                     "fixture or property already on %s" % dref)
        return False, ev
    ev["why"] = ("verify RED with target at chain base %s, GREEN at tip %s -- an earlier "
                 "slice of this chain satisfied it and the fixture discriminates"
                 % (base[:12], tip[:12]))
    return True, ev


def park_if_already_satisfied(st, sid, s, wt, origin):
    """Route an 'the verify is green before anything changed' slice. True if handled.

    A green-at-baseline verify means the property ALREADY HOLDS at the chain tip,
    so no refimpl can ever flip it and re-authoring can never help. There are only
    two causes -- a genuinely satisfied spec, or a LEAKY fixture that asserts
    nothing -- and they are indistinguishable from here, so the FIRST case in a
    plan always goes to a human; only after one is confirmed with --skip-slice
    (which sets baseline_green_confirmed) is the automatic path trusted for that
    plan's remaining slices.

    WHY THIS IS A FUNCTION (2026-09-19): this used to live inline in
    confirm_and_enqueue, i.e. it could only ever fire at PREFLIGHT -- after a
    full authoring dispatch had already been spent. Measured over 52 pre-gate
    failures since 09-15, the authoring self-check is the thing that actually
    rejects these first, and it says so in its own words 9 times
    ("verify.sh PASSES at baseline -- the fixture cannot fail"). Those 9 never
    reached preflight, so the already-satisfied path they needed was unreachable
    and each one instead became a FAILED slice that got re-authored on the next
    pass, forever. bg-actions s4 is the worst case on record: 11 authoring
    dispatches for a property s1 had already satisfied, never once reaching
    preflight. Called from BOTH places now, so the detection happens at whichever
    stage notices first."""
    if not audit_baseline_green_claim(wt):
        s["status"] = ESCALATED
        s["escalation_reason"] = (
            "PIPELINE BUG SUSPECTED: %s claimed verify.sh PASSES at the untouched "
            "baseline, but re-running `bash verify.sh` in %s just now disagrees "
            "(non-zero exit or no VERIFY_OK printed) -- the baseline-green claim "
            "itself is false. Do NOT skip this slice on that claim; the pipeline "
            "stage that reported it (%s) is the thing to investigate, not this "
            "slice's relevance." % (origin, wt, origin))
        save_state(st)
        print(f"# {sid}: ESCALATED -- SUSPECT baseline-green claim from {origin}. "
              f"A direct re-run of verify.sh in {wt} just now disagrees with the "
              f"claim. This looks like a bug in {origin}, not a property of this "
              f"slice -- investigate the pipeline before trusting anything else "
              f"{origin} reported for this run.")
        return True
    if st.get("baseline_green_confirmed"):
        s["status"] = SKIPPED
        s["skip_reason"] = ("verify.sh is GREEN at the untouched baseline (%s) -- "
                            "the property is already satisfied at the chain tip; "
                            "auto-skipped after this plan's first case was "
                            "human-confirmed" % origin)
        s["skipped_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
        save_state(st)
        print(f"# {sid}: SKIPPED automatically -- its verify passes at baseline ({origin}), "
              f"so the property already holds and there is nothing to dispatch. "
              f"(A human already confirmed the first such slice in this plan.)")
        return True
    # MECHANICAL DISCRIMINATION (2026-10-03): red at the chain base + green at the tip
    # is evidence, not a guess -- auto-skip on it, with the evidence on the slice.
    # Anything short of that falls through to the human escalation unchanged.
    try:
        _disc, _ev = baseline_green_discriminates(st, wt)
    except Exception as _e:
        _disc, _ev = False, {"why": "discriminator raised %r" % (_e,)}
    if _disc:
        s["status"] = SKIPPED
        s["skip_reason"] = ("verify.sh is GREEN at the untouched baseline (%s) and RED "
                            "with the target at the chain base -- already satisfied by "
                            "an earlier slice of this chain (mechanically proven)" % origin)
        s["skip_evidence"] = _ev
        s["skipped_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
        save_state(st)
        print(f"# {sid}: SKIPPED automatically -- {_ev.get('why')}")
        return True
    s["baseline_discrimination"] = _ev
    s["status"] = ESCALATED
    s["escalation_reason"] = (
        "verify.sh is GREEN at the untouched baseline (%s) -- EITHER the property "
        "is already satisfied by an earlier slice (skip it) OR the fixture is "
        "leaky and asserts nothing (fix it). This is the plan's first such "
        "case, so it is routed to a human rather than auto-skipped. Mechanical "
        "base-vs-tip check could not tell them apart: %s" % (origin, _ev.get("why")))
    save_state(st)
    print(f"# {sid}: ESCALATED -- verify.sh PASSES at the untouched baseline ({origin}).\n"
          f"# That means one of two things, and only a human can tell them apart:\n"
          f"#   (a) the property is ALREADY SATISFIED by an earlier slice -- then\n"
          f"#       `--skip-slice {sid} --reason '...'` (which also unlocks\n"
          f"#       auto-skip for the rest of THIS plan), or\n"
          f"#   (b) the fixture is LEAKY and would pass against anything -- then\n"
          f"#       fix {wt}/test_fixture.py and `--regate {sid}`.\n"
          f"# This is the plan's FIRST green-at-baseline slice, so it is NOT "
          f"auto-skipped. It is NOT re-authored either: re-authoring an "
          f"already-true property is the 11-dispatch storm this check exists to stop.")
    return True


_CONFIRM_ENTRY_STATUSES = (CONFIRMED, AWAITING_REVIEW, PENDING)


def confirm_abort_reason(st, sid, expect):
    """Why confirm_and_enqueue must not touch `sid`'s worktree now, or None. Reads
    DISK (another process may own the slice) and the live queue."""
    try:
        infl = slice_job_inflight(st, sid)
    except Exception:
        infl = None
    if infl:
        return f"it has a live job ({infl[2]} [{infl[0]}] = {infl[1]})"
    # A FINISHED job whose gate has not reported (soak seed 36: the enqueuing driver
    # died before recording the job): the gate is still reading/mutating this tree
    # and its verdict fires the advance that harvests / auto-lands it.
    try:
        awg = slice_job_awaiting_gate(st, sid)
    except Exception:
        awg = None
    if awg:
        return f"its job {awg[0]} ({awg[1]}) finished and its gate has not reported yet"
    try:
        disk = read_state(st.get("label")) if st.get("label") else None
    except Exception:
        disk = None
    ds = ((disk or {}).get("slices") or {}).get(sid)
    if isinstance(ds, dict) and ds.get("status") not in expect:
        return (f"the slice is {ds.get('status')!r} on disk"
                + (f" (job {ds.get('job_id')})" if ds.get("job_id") else "")
                + " -- another driver moved it on since this one read it")
    return None


def confirm_and_enqueue(st, sid, s, wt, model, host, max_iters, chat_timeout,
                        author_mode, num_ctx, expect=None):
    """Run the MECHANICAL relevance gate (draft --confirm + preflight both-ways +
    verify-relevance) on an authored slice and, on GO, enqueue the coding dispatch.
    This is the gate that replaced the human relevance review: the pipeline trusts
    whatever it clears. On a preflight NO-GO it does NOT park for a human -- it marks
    the slice ESCALATED so it surfaces to the Claude gate (the run-status needs-eyes
    panel), which is where the rare relevance judgement now lives."""
    # ONE tree-lock span from the confirm edit to the end of preflight (soak seed 6,
    # 2026-10-06): a self-check that snapshotted the fixture BEFORE `draft --confirm`
    # restored the marker version AFTER clean_and_seal committed the confirmed one
    # -> preflight NO-GO "harness file edited since the last seal" -> ESCALATED.
    # preflight is told (OLLAMA_DISPATCH_TREE_LOCK_HELD) that its parent holds the
    # lock, so it does not wait on us.
    with _wt_tree_lock(wt):
        # STALE DRIVER (2026-10-06, soak seed 10): a second driver that read this slice
        # before another one enqueued its coding job went on to confirm+preflight the
        # tree -- first colliding with the pending job, then (job done) NO-GO'ing on
        # the job's own uncommitted deliverable and ESCALATING a slice that was fine.
        # Re-ask DISK, under the lock, before mutating anything.
        _why = confirm_abort_reason(st, sid, expect or _CONFIRM_ENTRY_STATUSES)
        if _why:
            print(f"# {sid}: NOT re-gating -- {_why}. Leaving the slice to its owner.")
            return
        run([DRAFT, wt, "--confirm"], check=False)
        if author_mode != "auto":
            run([SCAFFOLD, "--freeze-literals", wt], check=False)
        # Seal for BOTH modes: auto authoring leaves the harness untracked, which the
        # gate would flag as a dirty launch tree.
        clean_and_seal(wt)
        pf = run([PREFLIGHT, wt, "--refimpl-cmd", f"python3 refimpl.py {wt}", *_reqs(s)],
                 capture_output=True, text=True)
    # Captured (not streamed) so the NO-GO REASON can be classified below; echo it
    # so --execute output is unchanged for a human reading the log.
    sys.stdout.write(pf.stdout or "")
    sys.stderr.write(pf.stderr or "")
    if pf.returncode != 0:
        # ALREADY-SATISFIED AUTO-SKIP (the owner 2026-09-19: "this is the preventive fix
        # for the whole class of bug, not just this one instance"). Preflight's
        # both-ways proof already detects this exactly -- `baseline-fails` FAILs with
        # "verify PASSES on the untouched baseline" -- but every NO-GO was funnelled
        # into one generic ESCALATED, so the one NO-GO that is not a harness defect
        # looked like every other. A verify that is green before anything changed
        # means the property already holds; re-authoring can never help, because no
        # refimpl can flip an already-green verify.
        #
        # THE CAVEAT IS THE IMPORTANT PART. A green-at-baseline verify has two
        # possible causes -- a genuinely satisfied spec, or a LEAKY fixture that
        # asserts nothing and would pass against anything. Those are
        # indistinguishable from this side, and auto-skipping a leaky harness would
        # silently drop real work. So the FIRST one in a plan always goes to
        # needs-eyes; only after a human has confirmed one with --skip-slice (which
        # sets baseline_green_confirmed) is the automatic path trusted for that
        # plan's remaining slices.
        #
        # GUARD (2026-09-21, caught live on scheduler-s3-next-run-time): this call
        # was UNCONDITIONAL -- park_if_already_satisfied() always returns True, so
        # EVERY preflight NO-GO (a genuine verify-relevance failure here: 3/11
        # mutants survived on refimpl.py's tzinfo handling, nothing to do with
        # baseline) was mislabeled with the baseline-green escalation text. Verified
        # directly: `bash verify.sh` at the untouched baseline FAILED as designed
        # (2/6 cases, AttributeError on the missing symbol) -- the ESCALATED reason
        # was simply false. Only route through here when preflight ITSELF said the
        # baseline was green.
        if (_preflight_says_baseline_green(pf)
                and park_if_already_satisfied(st, sid, s, wt, "preflight baseline-fails")):
            return
        blockers = preflight_blockers(pf)
        # A LONE cwd-exclusive FAIL is NOT a relevance verdict (#5, 2026-09-23): it
        # says another active queue job's cwd is (or nests) this worktree -- usually
        # this slice's own still-listed auto-author/refine job, or a stale queue
        # row. Escalating it as a "relevance NO-GO" sent a scheduling collision to
        # needs-eyes with a false diagnosis and stopped the chain for a human. Leave
        # the slice CONFIRMED so the next advance (the sweep re-kicks a collided
        # plan after a grace window) re-runs the gate once the other job is gone;
        # only a slice that keeps colliding is escalated, and then it says so.
        if preflight_nogo_kind(blockers) == "collision":
            n = int(s.get("cwd_collisions") or 0) + 1
            s["cwd_collisions"] = n
            detail = blockers[0][1]
            s["last_collision"] = {"at": time.time(), "detail": detail}
            if n <= CWD_COLLISION_MAX:
                s["status"] = CONFIRMED
                save_state(st)
                print(f"# {sid}: preflight cwd-exclusive collision ({n}/{CWD_COLLISION_MAX}): "
                      f"{detail}. NOT a relevance verdict -- left CONFIRMED; the gate "
                      f"re-runs on the next advance once that job is out of the queue.")
                return
            s["status"] = ESCALATED
            s["escalation_reason"] = (
                f"preflight cwd-exclusive collision persisted through {n} advances: "
                f"{detail} -- another queue job keeps owning this worktree; cancel/resolve "
                f"that job (ollama-queue.py status), then --regate {sid}")
            save_state(st)
            print(f"# {sid}: ESCALATED -- {s['escalation_reason']}")
            return
        reason = "; ".join(f"{cid}: {msg}" for cid, msg in blockers) or (
            f"preflight exited {pf.returncode} with no parseable [FAIL] row -- "
            f"see its output above")
        s["status"] = ESCALATED
        s["escalation_reason"] = f"mechanical relevance gate (preflight) NO-GO -- {reason}"
        save_state(st)
        print(f"# {sid}: ESCALATED -- mechanical relevance gate (preflight) NO-GO: {reason}\n"
              f"#   No human park: this surfaces to the Claude gate (run-status needs-eyes). "
              f"To resolve: fix the harness in {wt}, then --regate {sid} "
              f"(or --retry-slice {sid} to re-author from scratch).")
        return
    cp = subprocess.run(
        ["python3", QUEUE, "enqueue", "--model", model, "--host", host,
         "--cwd", wt, "--task-file", os.path.join(wt, "TASK.md"),
         "--task-kind", "coding", "--verify", "bash verify.sh",
         "--num-ctx", str(num_ctx),
         "--max-iters", str(max_iters), "--chat-timeout", str(chat_timeout),
         "--label", f"{st['label']}-{sid}", *_bundle_args(st),
         *_lane_enqueue_args(st, wt, [slice_target(st, s), *slice_edit_files(st, s)])],
        capture_output=True, text=True)
    print(cp.stdout.strip())
    job_id = parse_enqueue_id(cp.stdout)
    # Bug #5 (2026-09-18): CAPTURE the job id the instant enqueue prints it, BEFORE
    # the returncode test. The enqueue can print `enqueued <id>` and still exit
    # non-zero (a post-enqueue warning, a noisy child); the old code threw the id
    # away and marked the slice FAILED with job_id=None, so reconcile/execute could
    # never find the job that WAS created -- a passing slice recorded as failed and
    # never committed onto the chain (arr-codec-floor). If we have an id, the job
    # exists: record it as ENQUEUED and let the poll/reconcile follow it to its real
    # verdict. Only a genuine no-id enqueue is a FAILED enqueue.
    if job_id:
        s["job_id"] = job_id
        s["status"] = ENQUEUED
        s["enqueued_at"] = time.time()
        # The gate went through: any earlier cwd-exclusive bounce is history, and
        # must not keep the sweep re-kicking this slice (#5).
        s.pop("last_collision", None)
        save_state(st)
        if cp.returncode != 0:
            print(f"# {sid}: enqueue exited {cp.returncode} but a job id was created "
                  f"({job_id}); recorded ENQUEUED (not FAILED). stderr: {cp.stderr.strip()}")
        else:
            print(f"# {sid}: enqueued as {job_id}. Re-run --execute to poll for convergence.")
        return
    # Bug #5 (2026-09-18): distinguish a CONTEXT-BUDGET gate refusal from a generic
    # enqueue failure. The queue's ctx-gate exits 2 with "nothing enqueued" when the
    # slice's estimated context exceeds the host ceiling -- the coding slice never
    # runs. This MUST surface as a real, actionable problem (ESCALATED -> needs-eyes),
    # never a silent FAILED and NEVER a PASS-looking row: the fix is to --auto-split,
    # move to a bigger-window host, or re-scope the slice.
    _err = (cp.stderr or "") + (cp.stdout or "")
    if cp.returncode == 2 and ("ctx-gate REFUSED" in _err or "nothing enqueued" in _err):
        s["status"] = ESCALATED
        s["escalation_reason"] = (
            "context-budget gate blocked the coding-slice enqueue (nothing enqueued; "
            "no code written) -- re-scope/--auto-split the slice or move it to a "
            "bigger-window host, then --retry-slice: "
            + " ".join((cp.stderr or "").strip().split())[-300:])
        save_state(st)
        print(f"# {sid}: ESCALATED -- context-budget gate blocked the coding-slice enqueue "
              f"(the slice is too big for the host ceiling; nothing was enqueued). "
              f"Resolve by re-scoping/splitting this slice or moving it to a bigger-window "
              f"host, then --retry-slice {sid}. This is NOT a pass -- no code was written.\n"
              f"    ctx-gate: {cp.stderr.strip()[-400:]}")
        return
    s["status"] = FAILED
    save_state(st)
    print(f"# {sid}: FAILED to enqueue (no job id): {cp.stderr.strip()}")


def _park_or_advance(st, sid, s, wt, model, host, max_iters, chat_timeout,
                     author_mode, num_ctx, auto_confirm):
    """After a slice's harness is authored+sealed: either PARK for a manual human
    relevance review (--manual-review, or manual author mode where the scaffold's
    case list is deliberately empty), or -- the default -- AUTO-CONFIRM straight into
    the mechanical relevance gate + enqueue. No human stop in the default path."""
    if auto_confirm and author_mode == "auto":
        s["status"] = CONFIRMED
        save_state(st)
        print(f"# {sid}: auto-confirmed (Claude-gate default; no human relevance park) "
              f"-- handing to the mechanical preflight relevance gate.")
        confirm_and_enqueue(st, sid, s, wt, model, host, max_iters, chat_timeout,
                            author_mode, num_ctx)
        return
    s["status"] = AWAITING_REVIEW
    save_state(st)
    print(f"\n# PAUSE (--manual-review): slice {sid} harness authored in:\n#   {wt}")
    print(f"# READ {wt}/test_fixture.py for RELEVANCE, then:")
    print(f"#   ollama-dispatch-slice <plan> --confirm-slice {sid}")
    print(f"#   ollama-dispatch-slice <plan> --execute")


def chain_may_pass(status):
    """May execute() advance PAST a slice in this status to the next one in `order`?

    ESCALATED joined DONE/SKIPPED/FAILED on 2026-09-27: its dependents are held by
    any_dep_failed() exactly like a FAILED slice's, so only independent slices pass.

    Only two statuses mean "this slice will never land anything else into the chain
    worktree on this pass": DONE (its change IS in the chain) and FAILED (it is dead;
    its dependents are held by any_dep_failed(), and the existing contract is that
    independent later slices still get a shot). EVERY other status -- PENDING,
    AWAITING_REVIEW, CONFIRMED, ENQUEUED, BLOCKED, ESCALATED -- is still in motion,
    so stepping over it would author the next slice against a chain tip that is
    missing this slice's fix. Pure predicate so --self-test can pin it."""
    return status in (DONE, SKIPPED, FAILED, ESCALATED)


# --- UNATTENDED-READINESS (2026-10-04): retry guard + hand-edit protection -------
#
# (1) RETRY GUARD. A coding-stage slice (its harness already cleared preflight once,
# so it has a coding job_id) that FAILED is auto-retried by bound_stale_worktree_retry.
# A retry only makes sense if the harness it would retry against is SELF-CONSISTENT:
# the reference impl must turn the SEALED fixture green. If it does not -- the
# refimpl no longer applies (chat-fixes s6c 2026-10-04: "refimpl anchor 2 not found
# -- did the target change?"), or the fixture rejects the reference answer -- no
# coding model can ever pass it, and every retry is a wasted dispatch. So before the
# retry clears anything, apply refimpl.py to a throwaway copy of the sealed baseline
# and run verify there. Disagreement -> ESCALATE, keep the worktree, do not retry.
# A fixture that is GREEN on the unfixed baseline and RED with the refimpl encodes
# the BUGGY shape as the expected one; it is rejected (escalated) by name.
# Separately, a retry whose worktree carries an edit to the sealed fixture is
# FLAGGED (printed + recorded in s["retry_flags"]) -- a coding attempt that edits
# its own fixture is gaming the check, whatever the verdict was.
#
# (2d) HAND-EDIT PROTECTION. The FAILED auto-heal clears the worktree. When a human
# (or Claude) has started fixing the harness IN PLACE after the failure, that clear
# silently destroyed the fix. At the moment a slice ENTERS FAILED, save_state stamps
# a fingerprint of the worktree's dirty files (content hash per file) and the time.
# Before auto-healing, a dirty file whose content differs from that fingerprint AND
# whose mtime is newer than the failure (and than the failing job's own gate/done
# sidecars, which may legitimately touch the tree after the transition) is a hand
# edit: the auto-heal SKIPS the slice and says how to proceed (--regate SID, which
# now accepts FAILED, or --retry-slice SID to discard).

RETRY_GUARD_TIMEOUT_S = 600
# Not product, not a hand edit: caches and files the pipeline itself rewrites.
_TREE_NOISE_PARTS = {"__pycache__", ".pytest_cache", "node_modules", ".venv",
                     ".mypy_cache", ".ruff_cache"}
_TREE_NOISE_SUFFIX = (".pyc", ".tsbuildinfo")
_TREE_NOISE_NAMES = {".preflight-state.json", ".hand-harness"}
_TREE_FP_MAX_FILES = 400
HAND_EDIT_MTIME_SLACK_S = 1.0


def _tree_noise(rel):
    parts = Path(rel).parts
    return (any(p in _TREE_NOISE_PARTS for p in parts)
            or rel.endswith(_TREE_NOISE_SUFFIX)
            or Path(rel).name in _TREE_NOISE_NAMES)


def worktree_dirty_files(wt):
    """Paths (relative) that differ from the worktree's HEAD: tracked changes plus
    untracked-not-ignored files, minus cache noise. None if wt is not a git tree."""
    if not os.path.isdir(wt):
        return None
    d = subprocess.run(["git", "-C", wt, "diff", "HEAD", "--name-only", "-z"],
                       capture_output=True, text=True)
    if d.returncode != 0:
        return None
    u = subprocess.run(["git", "-C", wt, "ls-files", "--others", "--exclude-standard", "-z"],
                       capture_output=True, text=True)
    rels = {r for r in (d.stdout + "\0" + (u.stdout if u.returncode == 0 else "")).split("\0")
            if r}
    return sorted(r for r in rels if not _tree_noise(r))


def _file_digest(path):
    import hashlib
    try:
        return hashlib.sha1(Path(path).read_bytes()).hexdigest()
    except FileNotFoundError:
        return "<deleted>"
    except OSError:
        return "<unreadable>"


def worktree_fingerprint(wt):
    """{rel: sha1} of the worktree's dirty files (capped), or None."""
    rels = worktree_dirty_files(wt)
    if rels is None:
        return None
    return {r: _file_digest(os.path.join(wt, r)) for r in rels[:_TREE_FP_MAX_FILES]}


def _stamp_failed_tree(st, base):
    """Central, like _stamp_escalations: fingerprint a slice's worktree at the moment
    it ENTERS FAILED; drop the fingerprint once it leaves FAILED."""
    b_sl = (base or {}).get("slices") or {}
    for sid, s in (st.get("slices") or {}).items():
        if not isinstance(s, dict):
            continue
        bs = b_sl.get(sid)
        was = bs.get("status") if isinstance(bs, dict) else None
        if s.get("status") == FAILED:
            # On the TRANSITION only: a slice already FAILED before this guard
            # existed keeps no fingerprint (it falls back to the sidecar-mtime
            # test) rather than one taken now, after any hand edit was made.
            if was != FAILED and "failed_tree" not in s:
                wt = s.get("worktree") or (slice_worktree(st, sid) if st.get("label") else None)
                try:
                    fp = worktree_fingerprint(wt) if wt else None
                except Exception:
                    fp = None
                s["failed_tree"] = fp if fp is not None else {}
                s["failed_at_epoch"] = time.time()
        else:
            s.pop("failed_tree", None)
            s.pop("failed_at_epoch", None)


def _job_sidecar_mtime(job_id):
    """Newest mtime of a job's done/gate sidecars (live LOG_DIR or archive), or 0."""
    if not job_id:
        return 0.0
    best = 0.0
    for base in (LOG_DIR, os.path.join(LOG_DIR, "archive")):
        for ext in (".done.json", ".gate.json"):
            try:
                best = max(best, os.path.getmtime(os.path.join(base, f"{job_id}{ext}")))
            except OSError:
                pass
    return best


def hand_edits_since_failure(s, wt):
    """Files hand-edited in `wt` since the slice FAILED (list, possibly empty).

    A file counts only if BOTH: its content differs from the fingerprint stamped
    when the slice entered FAILED (or it was not dirty then), AND its mtime is newer
    than the later of the failure time and the failing job's gate/done sidecars (a
    gate that finishes after the transition may still have touched the tree).
    A slice with no fingerprint (it failed before this guard existed) falls back to
    the mtime test alone against the sidecars; with no reference time at all it
    cannot tell, and reports nothing (the pre-guard behaviour)."""
    rels = worktree_dirty_files(wt)
    if not rels:
        return []
    fp = s.get("failed_tree")
    t_ref = max(float(s.get("failed_at_epoch") or 0.0), _job_sidecar_mtime(s.get("job_id")))
    if t_ref <= 0:
        return []
    out = []
    for r in rels:
        p = os.path.join(wt, r)
        try:
            mt = os.path.getmtime(p)
        except OSError:
            mt = time.time() if isinstance(fp, dict) and r in fp and fp[r] != "<deleted>" else 0.0
        if mt <= t_ref + HAND_EDIT_MTIME_SLACK_S:
            continue
        if isinstance(fp, dict) and fp.get(r) == _file_digest(p):
            continue                       # touched, not changed
        out.append(r)
    return out


# No bytecode in the throwaway copy: the baseline verify would otherwise cache a
# .pyc of the UNFIXED target, and a same-size refimpl edit landing in the same
# second (mtime+size are the staleness key) is then silently not seen -- the guard
# would report a disagreement that does not exist. Found by this guard's own test.
_GUARD_ENV = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1",
              "DISPATCH_VERIFY_SANDBOX": "1"}  # VERIFY-SANDBOX


def _purge_pycache(d):
    for root, dirs, _files in os.walk(d):
        if "__pycache__" in dirs:
            shutil.rmtree(os.path.join(root, "__pycache__"), ignore_errors=True)
            dirs.remove("__pycache__")
        for skip in (".venv", "node_modules", ".git"):
            if skip in dirs:
                dirs.remove(skip)


def _verify_green(d, timeout):
    _purge_pycache(d)
    try:
        vp = subprocess.run(["bash", "verify.sh"], cwd=d, capture_output=True, text=True,
                            timeout=timeout, env=_GUARD_ENV)
    except subprocess.TimeoutExpired:
        return False, "verify.sh timed out"
    out = (vp.stdout or "") + (vp.stderr or "")
    return (vp.returncode == 0 and "VERIFY_OK" in out), out


def _head_has(wt, rel):
    return subprocess.run(["git", "-C", wt, "cat-file", "-e", f"HEAD:{rel}"],
                          capture_output=True).returncode == 0


def retry_guard(st, sid, s, wt, timeout=RETRY_GUARD_TIMEOUT_S):
    """(ok, reason, flags). ok=False means: do NOT retry, escalate with `reason`.
    Only judges a CODING-stage slice (job_id set) whose worktree holds a SEALED
    harness (refimpl.py + verify.sh committed at HEAD); anything else is an
    authoring-stage failure, where re-authoring the harness IS the cure."""
    import tempfile
    flags = []
    if not s.get("job_id") or not wt or not os.path.isdir(wt):
        return True, None, flags
    if not (_head_has(wt, "refimpl.py") and _head_has(wt, "verify.sh")):
        return True, None, flags
    fx = _fixture_path(wt)
    if fx is not None:
        rel = os.path.relpath(str(fx), wt)
        if (_head_has(wt, rel) and subprocess.run(
                ["git", "-C", wt, "diff", "--quiet", "HEAD", "--", rel],
                capture_output=True).returncode == 1):
            flags.append(f"FIXTURE_EDITED: {rel} differs from the sealed harness "
                         f"(job {s.get('job_id')}) -- a retry must not edit its own fixture")
    td = tempfile.mkdtemp(prefix=f"retry-guard-{sid}-")
    try:
        arch = subprocess.run(["git", "-C", wt, "archive", "--format=tar", "HEAD"],
                              capture_output=True)
        if arch.returncode != 0:
            return True, None, flags        # cannot measure -> do not block on it
        tx = subprocess.run(["tar", "-x", "-C", td], input=arch.stdout, capture_output=True)
        if tx.returncode != 0:
            return True, None, flags
        for heavy in (".venv", "node_modules"):
            src = os.path.join(wt, heavy)
            if os.path.isdir(src) and not os.path.exists(os.path.join(td, heavy)):
                os.symlink(src, os.path.join(td, heavy))
        base_green, _ = _verify_green(td, timeout)
        try:
            ap = subprocess.run([sys.executable, "refimpl.py", td], cwd=td,
                                capture_output=True, text=True, timeout=timeout,
                                env=_GUARD_ENV)
        except subprocess.TimeoutExpired:
            return False, "retry guard: refimpl.py timed out against the sealed baseline", flags
        if ap.returncode != 0:
            tail = " ".join(((ap.stderr or "") + (ap.stdout or "")).split())[-300:]
            return False, ("retry guard: refimpl and fixture DISAGREE -- refimpl.py no "
                           f"longer applies to the sealed baseline ({tail}); no coding "
                           "attempt can pass this harness, so it is not retried"), flags
        ref_green, rout = _verify_green(td, timeout)
    finally:
        shutil.rmtree(td, ignore_errors=True)
    if ref_green:
        return True, None, flags
    tail = " ".join(str(rout).split())[-300:]
    if base_green:
        return False, ("retry guard: REJECTED fixture -- it encodes the BUGGY shape "
                       "(verify GREEN on the unfixed baseline, RED with the reference "
                       f"impl): {tail}"), flags
    return False, ("retry guard: refimpl and fixture DISAGREE -- verify stays RED with "
                   f"the reference impl applied to the sealed baseline: {tail}"), flags


# --- HAND-LOCK + IN-FLIGHT RETRY ABORT (2026-10-04, unattended-readiness 2e) -----
# chat-fixes3 s2, twice AFTER 2d shipped: the slice FAILED, a detached advance began
# the auto-retry, Main hand-wrote the harness and --regate'd it (slice -> ENQUEUED,
# job 0a79390ccb8a) -- and the in-flight driver, still holding status FAILED in a
# local variable, went on to clear the worktree and re-author over the hand harness
# (advance.log: "another writer moved this slice to job 0a79390ccb8a ... NOT writing
# this process's stale edits" immediately followed by "auto-retrying (clearing").
# 2d only looked at the moment of the clear, and only at content, never at who owns
# the slice NOW. So every destructive step of a retry re-asks, against DISK:
#   - is the slice still in the status this retry started from?
#   - is there no live job for it?
#   - is the worktree not hand-locked, and (FAILED) not hand-edited since?
# and aborts WITHOUT clearing if any answer changed. The explicit lock: a file
# HAND_LOCK in the worktree. While it exists no automatic retry, clear, resume or
# re-author touches the tree (ollama-dispatch-auto and dispatch-self-heal check it
# too); only --regate (tests the hand harness, lock kept) and --retry-slice
# (discards the tree, lock with it) move past it.
HAND_LOCK = ".hand-harness"


def hand_locked(wt):
    try:
        return bool(wt) and os.path.exists(os.path.join(wt, HAND_LOCK))
    except Exception:
        return False


def _ignore_hand_lock(wt):
    """Keep the lock file out of git's view (preflight's baseline-clean, the seal's
    stray-file check, the 2d fingerprint) via the repo's info/exclude."""
    try:
        r = subprocess.run(["git", "-C", wt, "rev-parse", "--git-path", "info/exclude"],
                           capture_output=True, text=True)
        if r.returncode != 0 or not r.stdout.strip():
            return
        ex = Path(r.stdout.strip())
        if not ex.is_absolute():
            ex = Path(wt) / ex
        ex.parent.mkdir(parents=True, exist_ok=True)
        cur = ex.read_text() if ex.exists() else ""
        if HAND_LOCK not in cur.split():
            ex.write_text(cur + ("" if cur.endswith("\n") or not cur else "\n") + HAND_LOCK + "\n")
    except Exception:
        pass


def retry_abort_reason(st, sid, wt, expect):
    """Why an AUTOMATIC retry of `sid` (started from status `expect`) must stop
    before its next destructive step, or None. Reads DISK, not this process's copy."""
    disk = read_state(st.get("label")) if st.get("label") else None
    ds = ((disk or {}).get("slices") or {}).get(sid)
    if isinstance(ds, dict) and ds.get("status") != expect:
        return (f"the slice is {ds.get('status')!r} on disk (another writer -- e.g. a "
                f"--regate -- took it while this retry was in flight; this retry "
                f"started from {expect!r})")
    try:
        infl = slice_job_inflight(st, sid)
    except Exception:
        infl = None
    if infl:
        return f"it has a live job ({infl[2]} [{infl[0]}] = {infl[1]})"
    if hand_locked(wt):
        return f"its worktree is HAND-LOCKED ({os.path.join(wt, HAND_LOCK)})"
    if expect == FAILED and wt and os.path.isdir(wt):
        s = (st.get("slices") or {}).get(sid) or {}
        he = hand_edits_since_failure(s, wt)
        if he:
            return f"its worktree has hand edits since the failure ({', '.join(he[:6])})"
    return None


def bound_stale_worktree_retry(st, sid, s, wt, cwt, origin):
    """RETRY-STORM GUARD (2026-09-19 -- see MAX_IDENTICAL_AUTHOR_FAILURES).

    `wt` is a worktree left behind by a PREVIOUS attempt that did not land. Before
    wiping that evidence and spending another dispatch, record WHY it did not
    finish, and refuse to launch again once the same reason has repeated. This is
    the whole fix for the 9x s4 storm.

    Returns True if another attempt is warranted -- in which case the stale
    worktree HAS BEEN CLEARED and the caller may (re-)author from a clean baseline.
    Returns False if the slice has instead been routed to a terminal decision
    (ESCALATED, or SKIPPED via park_if_already_satisfied) and the caller must stop --
    OR (2026-09-24) if a job of this slice has finished but its gate has not reported
    yet: nothing is recorded or cleared, the caller stops, and the gate's own
    --advance-detached re-enters here once its verdict is on disk.

    EXTRACTED (2026-09-20) from the PENDING branch of execute() so the FAILED
    auto-heal can share the identical budget rather than grow a second, parallel
    one. It is the same code, in one place, with two callers."""
    # REAP-vs-GATE RACE (2026-09-24, arr-codec-floor s4 r3 -- see
    # slice_job_awaiting_gate). The worktree is NOT stale while a just-finished job's
    # gate is still reading/mutating it; wiping it crashes that gate and loses the
    # verdict that would have fired this very retry. Checked BEFORE recording a
    # failure: the pending verdict is the newest fact about this slice, and counting
    # an attempt against it now would inflate the retry-storm streak.
    _entry_status = s.get("status")
    ag = slice_job_awaiting_gate(st, sid)
    if ag:
        jid, lbl, a = ag
        print(f"# {sid}: NOT clearing {wt} ({origin}) -- {lbl} [{jid}] finished {a:.0f}s "
              f"ago and its gate has not reported a terminal verdict yet. The gate still "
              f"reads and mutates this tree in place, and its verdict is the event that "
              f"re-enters this slice; wiping the tree now would crash that gate and leave "
              f"NO verdict at all. Leaving it intact; the gate's own --advance-detached "
              f"resumes here (bounded by the {int(LOST_EVENT_GRACE_S // 60)}-min lost-event "
              f"grace).")
        return False
    # RETRY GUARD (2026-10-04, unattended-readiness 1) -- see retry_guard.
    _ok, _why, _flags = retry_guard(st, sid, s, wt)
    if _flags:
        s["retry_flags"] = ((s.get("retry_flags") or []) + _flags)[-5:]
        for _f in _flags:
            print(f"# {sid}: FLAG -- {_f}")
    if not _ok:
        s["status"] = ESCALATED
        s["escalation_reason"] = _why + (f" [{'; '.join(_flags)}]" if _flags else "")
        save_state(st)
        print(f"# {sid}: ESCALATED, NOT retried ({origin}) -- {s['escalation_reason']}\n"
              f"# The worktree is left INTACT as evidence: {wt}. Fix the harness there "
              f"then --regate {sid}, or --retry-slice {sid} to re-author it.")
        return False
    streak, sig = note_author_failure(s, wt)
    save_state(st)
    # Not every repeat deserves the same patience. "The verify is green
    # at baseline" is not a flaky failure that another attempt might get
    # past -- it is a decidable statement that there is nothing here to
    # prove. Route it on the FIRST sighting rather than spending
    # MAX_IDENTICAL_AUTHOR_FAILURES attempts re-establishing it.
    if AUTHOR_BASELINE_GREEN_MARKER in sig:
        park_if_already_satisfied(st, sid, s, wt, origin)
        return False
    # SPEC_DEFECT (auto's pre-dispatch contradiction gate): the SPEC is wrong, so the
    # only useful move is a (bounded) RE-SPEC on FIRST sight; "already satisfied" is the
    # baseline-green case and parks like it. Cap spent -> falls to the ESCALATED park.
    if is_spec_defect(sig) and "already satisfied at base" in str(sig):
        park_if_already_satisfied(st, sid, s, wt, origin)
        return False
    if is_spec_defect(sig) and respec_on_cap(s, sig, streak, int(s.get("author_attempts") or 0)):
        save_state(st)
        print(f"# {sid}: SPEC_DEFECT -- RE-SPEC'd on first sight (one bounded respec); "
              f"re-authoring from a clean baseline with the defect folded into the intent. "
              f"Latest: {sig}")
        remove_worktree(cwt, wt)
        return True
    if is_spec_defect(sig):
        # the one re-spec is spent and the SAME contradiction came back: another launch
        # cannot change it -- park it where a human/Claude re-specs the plan.
        s["status"] = ESCALATED
        s["escalation_reason"] = (f"{sig} -- re-spec already tried once ({s.get('respec_count')}x) "
                                  f"and the spec still contradicts the base tree; fix the plan "
                                  f"intent, then --retry-slice {sid}.")
        save_state(st)
        print(f"# {sid}: ESCALATED -- {s['escalation_reason']}")
        return False
    attempts = int(s.get("author_attempts") or 0)
    _budget_why = author_budget_block(st, sid, s)
    if (not _budget_why and (streak >= MAX_IDENTICAL_AUTHOR_FAILURES
                             or attempts >= MAX_AUTHOR_ATTEMPTS)
            and respec_on_cap(s, sig, streak, attempts)):
        save_state(st)
        print(f"# {sid}: authoring cap reached (streak {streak}, {attempts} attempts) -- "
              f"RE-SPEC'd instead of parking (one bounded respec); re-authoring from a clean "
              f"baseline with the failure folded into the slice intent. Latest: {sig}")
        remove_worktree(cwt, wt)
        return True
    if (streak >= MAX_IDENTICAL_AUTHOR_FAILURES
            or attempts >= MAX_AUTHOR_ATTEMPTS or _budget_why):
        s["status"] = ESCALATED
        s["escalation_reason"] = (
            f"authoring made no progress across {streak} consecutive "
            f"attempts ({attempts} total), each ending on "
            f"the identical failure: {sig}"
            if streak >= MAX_IDENTICAL_AUTHOR_FAILURES else
            f"{_budget_why} "
            f"across {attempts} attempt(s) without a landable harness. Latest: {sig}"
            if _budget_why else
            f"authoring has now been launched {attempts} times for this "
            f"slice without ever producing a complete harness. The failure "
            f"reason kept CHANGING, so the identical-failure streak never "
            f"tripped -- but a slice that has burned {attempts} dispatches "
            f"is not converging, whatever the reasons. Latest: {sig}")
        save_state(st)
        # print the reason that actually tripped (2026-10-02: Rivian s5 hit the
        # attempt cap with streak=1 and this line claimed "failed 1 times in a
        # row for the IDENTICAL reason", misdirecting the reader).
        print(f"# {sid}: ESCALATED -- {s['escalation_reason']}\n"
              f"# Re-running it would burn another dispatch for the same "
              f"result, so the chain STOPS here and this surfaces to the "
              f"Claude gate (run-status needs-eyes). The worktree is left "
              f"INTACT as evidence: {wt}\n"
              f"# Resolve by fixing the harness there then --regate {sid}; "
              f"or --retry-slice {sid} to start clean if the cause is "
              f"genuinely transient; or --skip-slice {sid} --reason ... if "
              f"the property is already satisfied and the slice is a no-op.")
        return False
    # LAST CHECK BEFORE THE IRREVERSIBLE STEP (2e) -- see retry_abort_reason.
    _abort = retry_abort_reason(st, sid, wt, _entry_status)
    if _abort:
        print(f"# {sid}: retry ABORTED before clearing {wt} ({origin}) -- {_abort}. "
              f"Nothing cleared. Move past it with --regate {sid} (test the tree as it "
              f"is) or --retry-slice {sid} (discard it).")
        return False
    print(f"# {sid}: clearing stale worktree before authoring "
          f"(attempt {s.get('author_attempts')}; last failure: {sig}).")
    remove_worktree(cwt, wt)
    return True


def harvest_ready_slices(st, cwt, job_status_fn=None, gate_record_fn=None,
                         age_fn=None, land_fn=None, save_fn=None):
    """HARVEST-BEFORE-AUTHOR (2026-09-23, Fable pass 3). Land EVERY ENQUEUED slice
    whose coding job is queue-`done` with a landable gate verdict, in `order`, BEFORE
    execute()'s serial walk authors anything. Returns the list of slice ids landed.

    Why: execute() walks `order` and RETURNS at the first slice still in motion --
    which is right for "never author past an unlanded slice", but it also meant a
    green, gate-PASSED coding job on a LATER independent slice sat ENQUEUED behind an
    EARLIER slice that was still being authored. Seen live twice on 2026-09-23:
    rt-bfmr-pending-sync-scope s2 (job 4de479149b18, gate pass) parked behind s1
    (auto-author pending), and aw-sched-runner s26 (b08f56f19fa6, gate pass) behind
    s23. The cost is not just latency: the earlier slice is then AUTHORED against a
    chain tip that is missing the later slice's landed change, and when both create
    the same file (a creation task) the later 3-way rebase has an EMPTY base and
    conflicts by construction -- a wasted PASS re-authored from scratch.

    Landing here is exactly the ENQUEUED branch's landing (gate route via
    coding_land_route, the LIVE verify.sh re-run + relevance guard inside
    _land_green_slice, stale-seed rebase inside _stage_deliverable). Anything that
    is not a plain 'land' -- still running, waiting on the gate, gate-FAILED -- is
    left for the serial walk, which owns the escalate/wait/fail messaging. A landing
    that fails is stamped FAILED with its reason, as the ENQUEUED branch does.

    The queue/gate/git reads are injectable so --self-test can drive this offline."""
    job_status_fn = job_status_fn or job_status
    gate_record_fn = gate_record_fn or gate_record
    age_fn = age_fn or done_sidecar_age_s
    land_fn = land_fn or _land_green_slice
    save_fn = save_fn or save_state
    landed = []
    for sid in st["order"]:
        s = st["slices"][sid]
        if s.get("status") != ENQUEUED or not s.get("job_id"):
            continue
        if job_status_fn(s["job_id"]) != "done":
            continue
        rec = gate_record_fn(s["job_id"]) or {}
        if coding_land_route(rec.get("verdict"), age_fn(s["job_id"]),
                             rec.get("review")) != "land":
            continue
        if rec.get("verdict"):
            s["gate_verdict"] = rec["verdict"]
        ok, msg = land_fn(st, sid, s, cwt, require_relevance=True)
        if ok:
            landed.append(sid)
            print(f"# {sid}: HARVESTED -- its coding job {s['job_id']} was done"
                  + (f" (gate {s['gate_verdict']})" if s.get("gate_verdict") else "")
                  + f"; landed ahead of the serial walk, chain advanced to {msg[:8]}.")
        else:
            s["status"] = FAILED
            s["failure_reason"] = msg
            save_fn(st)
            print(f"# {sid}: job {s['job_id']} reported done but {msg} -- FAILED "
                  f"(not committed); dependents will be blocked.")
    if landed:
        # A PENDING slice whose worktree already exists was SEEDED from the pre-harvest
        # tip. An existing-file edit 3-way rebases fine at landing; a CREATION task
        # (target absent at its seed) cannot -- both sides add from an empty base.
        # Say so now, while a --retry-slice (re-seed off the new tip) is still cheap.
        for sid in st["order"]:
            s = st["slices"][sid]
            wt = s.get("worktree")
            if s.get("status") == PENDING and wt and os.path.isdir(wt):
                print(f"# NOTE {sid}: PENDING with a worktree seeded BEFORE this harvest "
                      f"({wt}). If {st.get('target')!r} did not exist at its seed, its "
                      f"landing will conflict (empty merge base) -- consider "
                      f"--retry-slice {sid} before its authoring job runs.")
    return landed


# ---------------------------------------------------------------------------
# AUTO-LAND A GATE-PASSED SLICE WITH NO DRIVER (2026-09-27, the owner: "why isn't that
# automated if the slice is good?"). BFMR s2 sat ESCALATED with job_id None while its
# coding job 0a7ff4902d90 had PASSED its gate: the lost update erased the job id,
# adopt_post_escalation_job needs escalated_at (s2 predates the stamp), and the
# driver finished s3-s5 and exited, so nothing ever looked at s2 again.
#
# The fix keys off QUEUE TRUTH only, never escalated_at: the slice's NEWEST finished
# coding job (label exactly `<plan>-<sid>`, from the never-pruned sidecars) passed its
# gate with a non-empty diff, and the slice worktree still holds EXACTLY that diff
# (so what lands is what the gate passed). It then lands through the normal
# _land_green_slice path -- live verify.sh re-run, the unconfirmed-draft relevance
# guard, the stale-seed rebase + shared-tail resolver + landed-slice re-verify inside
# _stage_deliverable -- and stamps DONE. A refused land stays ESCALATED with the real
# reason and is not retried until the chain tip moves. Driven by the 5-min --sweep
# (plan_needs_kick -> one detached advance) and by every execute() pass.
# ---------------------------------------------------------------------------
def slice_coding_jobs(st, sid, log_dir=None):
    """[(persisted_at, job_id, done_record)] for every FINISHED coding job of this
    slice, newest first, from the never-pruned `<id>.done.json` sidecars (LOG_DIR,
    then archive/). Only the coding label `<plan>-<sid>` counts -- author/refine/gate
    rows are other jobs. Never raises."""
    log_dir = log_dir or LOG_DIR
    label = planned_label(st["label"], sid)
    rx = re.compile(r"^([0-9a-f]{12})-" + re.escape(label) + r"\.log$")
    out = {}
    for base in (log_dir, os.path.join(log_dir, "archive")):
        try:
            names = os.listdir(base)
        except OSError:
            continue
        for n in names:
            m = rx.match(n)
            if not m or m.group(1) in out:
                continue
            try:
                d = json.loads(Path(base, f"{m.group(1)}.done.json").read_text())
            except Exception:
                continue
            if isinstance(d, dict) and d.get("label") == label:
                out[m.group(1)] = (str(d.get("persisted_at") or ""), m.group(1), d)
    return sorted(out.values(), key=lambda t: (t[0], t[1]), reverse=True)


def _satisfied_count(st):
    return sum(1 for v in (st.get("slices") or {}).values()
               if (v or {}).get("status") in SATISFIED)


def passed_job_to_land(st, sid, jobs, gate_fn=None):
    """PURE given `jobs` (slice_coding_jobs) and `gate_fn`. (job_id, None) when this
    slice should be auto-landed from its newest finished coding job, else (None, why).
    Eligible: ESCALATED, or ENQUEUED on a job that is not that newest finished one
    (the ENQUEUED poll / harvest own their own job), or CONFIRMED (ORPHANED ENQUEUE,
    2026-10-06 soak seed 36: the driver that enqueued the coding job was SIGKILLed
    before it recorded ENQUEUED/job_id, so the slice still read CONFIRMED and the
    next driver re-ran preflight over the job's own deliverable -> baseline-clean
    NO-GO -> ESCALATED a slice whose job had PASSED; the caller's worktree-holds-
    the-job's-diff + launch-baseline-HEAD check is what keeps an older attempt's job
    from being adopted); deps satisfied; the newest job finished clean and its gate
    verdict is exactly 'pass'; not already refused at this chain tip."""
    gate_fn = gate_fn or gate_record
    s = (st.get("slices") or {}).get(sid) or {}
    status = s.get("status")
    if status not in (ESCALATED, ENQUEUED, CONFIRMED):
        return None, f"status {status}"
    if not deps_done(st, sid):
        return None, "dependencies not satisfied"
    if not jobs:
        return None, "no finished coding job"
    _, jid, d = jobs[0]
    if status == ENQUEUED:
        if s.get("job_id") == jid:
            return None, "its own ENQUEUED job -- the poll/harvest lands it"
        if s.get("job_id") and s["job_id"] not in {j for _, j, _ in jobs}:
            return None, f"its job {s['job_id']} has not finished"
    if d.get("status") != "done" or d.get("exit_code") not in (0, None):
        return None, f"newest coding job {jid} is {d.get('status')}/exit={d.get('exit_code')}"
    verdict = str((gate_fn(jid) or {}).get("verdict") or "").strip().lower()
    if verdict != "pass":
        return None, f"newest coding job {jid} gate verdict {verdict or 'none'}"
    ref = s.get("auto_land_refused") or {}
    if ref.get("job") == jid and ref.get("satisfied") == _satisfied_count(st):
        return None, "auto-land already refused at this chain tip"
    return jid, None


def _job_diff_text(job_id, log_dir=None):
    log_dir = log_dir or LOG_DIR
    for base in (log_dir, os.path.join(log_dir, "archive")):
        try:
            return Path(base, f"{job_id}.diff").read_text()
        except OSError:
            continue
    return None


def _diff_section(diff_text, path):
    parts = re.split(r"(?m)^(?=diff --git )", diff_text or "")
    return "".join(p for p in parts if p.startswith(f"diff --git a/{path} "))


def worktree_holds_job_diff(wt, target, job_id, done_rec=None, log_dir=None):
    """(True, '') when slice worktree `wt` still carries EXACTLY the diff the gate
    passed for `job_id` on `target` (non-empty), on the same launch HEAD when the
    job recorded one. Anything else is (False, why): the tree moved on (a re-author,
    a hand edit), so landing it would land code the gate never saw."""
    sec = _diff_section(_job_diff_text(job_id, log_dir), target)
    if not sec.strip():
        return False, f"job {job_id}'s recorded diff has no change to {target}"
    try:
        head = subprocess.run(["git", "-C", wt, "rev-parse", "HEAD"], capture_output=True,
                              text=True, timeout=30).stdout.strip()
        now = subprocess.run(["git", "-C", wt, "diff", "HEAD", "--", target],
                             capture_output=True, text=True, timeout=60).stdout
    except Exception as e:
        return False, f"cannot read worktree {wt}: {e}"
    want_head = ((done_rec or {}).get("launch_baseline") or {}).get("head")
    if want_head and head != want_head:
        return False, (f"worktree HEAD {head[:8]} is not the job's launch baseline "
                       f"{want_head[:8]}")
    if now != sec:
        return False, f"worktree {target} no longer matches job {job_id}'s passed diff"
    return True, ""


def auto_land_passed(st, cwt, finder=None, gate_fn=None, inflight_fn=None,
                     match_fn=None, land_fn=None, save_fn=None):
    """Land every slice passed_job_to_land() says is due, in plan order. Returns the
    slice ids landed. Every I/O step is injectable for the tests."""
    finder = finder or slice_coding_jobs
    gate_fn = gate_fn or gate_record
    inflight_fn = inflight_fn or slice_job_inflight
    match_fn = match_fn or worktree_holds_job_diff
    land_fn = land_fn or _land_green_slice
    save_fn = save_fn or save_state
    landed = []
    for sid in st["order"]:
        s = st["slices"][sid]
        if s.get("status") not in (ESCALATED, ENQUEUED, CONFIRMED):
            continue
        jobs = finder(st, sid)
        jid, _why = passed_job_to_land(st, sid, jobs, gate_fn)
        if not jid:
            continue
        if inflight_fn(st, sid):
            continue                    # a live job for this slice owns it right now
        done_rec = next((d for _, j, d in jobs if j == jid), None)
        wt = s.get("worktree") or slice_worktree(st, sid)
        ok, msg = match_fn(wt, slice_target(st, s), jid, done_rec)
        if ok:
            prev_reason = s.get("escalation_reason")
            s["job_id"] = jid
            s["gate_verdict"] = "pass"
            s["escalation_reason"] = None
            ok, msg = land_fn(st, sid, s, cwt, require_relevance=True)
            if ok:
                s.pop("auto_land_refused", None)
                save_fn(st)
                landed.append(sid)
                print(f"# {sid}: AUTO-LANDED -- its newest coding job {jid} passed its gate "
                      f"(was escalated: {str(prev_reason or '')[:120]!r}); chain advanced "
                      f"to {str(msg)[:8]}.")
                continue
        if s.get("status") == CONFIRMED:
            # Adoption is opportunistic: a CONFIRMED slice whose tree does not hold
            # that job's diff (an older attempt's job) is simply not orphaned -- leave
            # it to its normal confirm -> preflight -> enqueue path, never escalate.
            print(f"# {sid}: CONFIRMED; newest coding job {jid} passed but is not this "
                  f"tree's ({str(msg)[:200]}) -- not adopted.")
            continue
        s["status"] = ESCALATED
        s["escalation_reason"] = f"auto-land of gate-PASSED job {jid} refused: {str(msg)[:600]}"
        s["auto_land_refused"] = {"job": jid, "satisfied": _satisfied_count(st),
                                  "at": datetime.now(timezone.utc).isoformat()}
        save_fn(st)
        print(f"# {sid}: gate-PASSED job {jid} NOT auto-landed -- {str(msg)[:300]}")
    return landed


def execute(st, model, host, max_iters, chat_timeout, author_mode, num_ctx,
            auto_confirm=True, publish_dag_first=True):
    """Advance the chain one checkpoint at a time; stop at the first slice still
    running on the queue (or, with --manual-review, at a relevance review). Resumable.
    By default there is NO human relevance gate: an authored slice auto-confirms into
    the mechanical preflight relevance gate, which either enqueues it or ESCALATES it
    to the Claude gate. `auto_confirm=False` (--manual-review) restores the human park."""
    repo = st["repo"]
    # LANGUAGE SUPPORT before the chain worktree / DAG rows exist: a plan in a
    # language the pipeline cannot carry (C#), a lang/target mismatch (`python`
    # on update.sh), or a missing toolchain is refused with the reason instead
    # of authoring slice after slice into the same wall. Only while nothing has
    # started -- an in-flight chain is never stopped by this check.
    if all(v.get("status") == PENDING and not v.get("worktree")
           for v in st["slices"].values()):
        try:
            import dispatch_langs
            _why = dispatch_langs.support_error(st.get("lang"), st.get("target"),
                                                repo=st.get("repo"))
        except ImportError:
            _why = None
        if _why:
            die(f"REFUSING plan {st['label']}: {_why}")
    cwt = ensure_chain_worktree(st)
    # The owner: "i want everything showing in the queue so i see what we're working on."
    # The whole worklist goes in as dependency-gated PLANNED rows the first time the
    # plan is executed -- not one job at a time as each slice happens to start.
    if publish_dag_first and not st.get("dag_published"):
        publish_dag(st)

    # Land what is already green FIRST, so every slice authored below is cut from
    # the most advanced tip the chain can honestly have. See harvest_ready_slices.
    harvest_ready_slices(st, cwt)
    # ...and any slice whose NEWEST coding job passed its gate but whose state never
    # caught up (escalated / lost job id) -- see auto_land_passed.
    auto_land_passed(st, cwt)

    for sid in st["order"]:
        # Re-read before acting: another process (--regate, self-heal, an operator
        # lever) may have moved this slice while this driver was busy -- act on
        # the truth on disk, never this process's stale copy (BFMR s2, 2026-09-27).
        refresh_state(st)
        s = st["slices"][sid]
        status = s["status"]
        if status == ESCALATED and adopt_post_escalation_job(st, sid, s):
            status = s["status"]

        if status in SATISFIED:
            continue
        if status in (PENDING, FAILED) and hand_locked(
                s.get("worktree") or slice_worktree(st, sid)):
            print(f"# {sid}: {status} and HAND-LOCKED "
                  f"({s.get('worktree') or slice_worktree(st, sid)}/{HAND_LOCK}) -- no "
                  f"automatic retry, clear, resume or re-author. Move past it with "
                  f"--regate {sid} or --retry-slice {sid}.")
            continue
        if _plan_cancelled(st["label"]):
            print(f"# {st['label']}: CANCELLED by a human while this run was advancing -- "
                  f"stopping before {sid} (--uncancel to resume).")
            return

        # VACUOUS-GATE GUARD (2026-09-19). Runs BEFORE authoring, before the
        # preflight relevance gate, before any dispatch -- because a slice whose
        # must_contain set is already true at baseline cannot be saved by any
        # amount of re-authoring or re-gating. It is not a failure to retry, it
        # is a plan defect a human has to restate. See vacuous_literals().
        why = vacuous_gate_reason(st, s, status, cwt)
        if s.pop("_refined_dirty", False):
            save_state(st)
        if why and s.get("kind") == "invariant":
            # An INVARIANT slice states a NEGATIVE or a TOTALITY property ("performs
            # no network I/O", "exactly one of the three outcomes, always"). There is
            # no token a correct implementation contains that a wrong one does not, so
            # must_contain provably cannot discriminate it -- and the harness contract
            # (verify RED at baseline) is unsatisfiable for a property that already
            # holds. ESCALATING it is pure noise: it reappears in needs-eyes forever
            # and no re-author or re-gate can ever move it. The honest terminal state
            # is SKIPPED, whose definition is exactly "the property holds at the chain
            # tip, so there is nothing for THIS slice to land".
            #
            # NOT a laundering path. Three things must all be true: the plan itself
            # declares kind=="invariant" (a human/Claude wrote that, the auto-slicer
            # never emits it), every must_contain literal is present at the tip (that
            # IS the `why` -- the structures the invariant is about exist), and the
            # slice's verify_shape still carries the assertion for a reviewer to run.
            # A slice with no literals at all is refused below, so "declare kind and
            # empty must_contain" cannot buy a free pass.
            if not [l for l in (s.get("must_contain") or []) if str(l).strip()]:
                s["status"] = ESCALATED
                s["escalation_reason"] = (
                    "invariant slice declares NO must_contain literals -- an invariant "
                    "must still name the structures it is about, or 'the property holds "
                    "at the tip' asserts nothing")
                save_state(st)
                print(f"# {sid}: ESCALATED -- invariant slice with no literals.")
                continue
            s["status"] = SKIPPED
            s["skip_reason"] = (
                f"INVARIANT slice (plan declares kind=invariant): its property is a "
                f"negative/totality statement that must_contain cannot express, and every "
                f"structure it names is present at the chain tip -- {why}. Nothing for it "
                f"to land; the property is asserted by its verify_shape, which is the gate "
                f"a reviewer runs.")
            s["skipped_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
            save_state(st)
            print(f"# {sid}: SKIPPED -- invariant slice, its structures are all at the "
                  f"chain tip. Dependents proceed.")
            continue
        if why:
            s["status"] = ESCALATED
            s["escalation_reason"] = f"vacuous must_contain gate: {why}"
            save_state(st)
            print(f"# {sid}: ESCALATED before dispatch -- {why}.\n"
                  f"#   Nothing is retried: re-author cannot fix a gate that is "
                  f"already true. Restate this slice's must_contain in the plan "
                  f"(literals that only appear AFTER the change), then --retry-slice {sid}.")
            # STOP, do not `continue` (2026-09-23, Fable pass 2). This branch used to
            # step over the freshly-ESCALATED slice and author the NEXT one against a
            # chain tip missing it -- the one thing chain_may_pass() exists to forbid,
            # and the opposite of what the `status == ESCALATED` branch below does for
            # the very same state on the next pass ("the chain STOPS here"). Live:
            # aw-sched-runner --retry-slice s23 re-parked s23 here and the same run
            # went on to author s24/s26 (2026-09-23).
            # 2026-09-27 (the owner: "stay on the started bundle as long as ANYTHING in
            # it can still run -- including slices that don't depend on the failed
            # one"). The Fable-pass-2 STOP above protected slices authored against a
            # tip missing this one -- but only a slice that DEPENDS on it can be
            # wrong for that reason, and those are held by any_dep_failed() (BLOCKED,
            # cascading through the order). An independent slice proceeds.
            print(f"# {sid}: dependents of {sid} are BLOCKED until it is resolved; "
                  f"slices that do not depend on it continue.")
            continue

        # Bug #10 (2026-09-19): BLOCKED was a ONE-WAY door. A slice is BLOCKED when a
        # dependency is FAILED/BLOCKED/ESCALATED, but every documented recovery for
        # those states (--retry-slice on a FAILED dep, --regate on an ESCALATED one)
        # eventually drives the dep to DONE -- and nothing ever revived the dependent.
        # There is no `if status == BLOCKED` branch below, so once the dep recovered
        # the slice matched NO branch at all: execute() silently fell through it on
        # every pass, the final summary still reported it "blocked (dep failed)", and
        # the unattended auto-feed chain quietly dropped the rest of the plan. The
        # ordering assumption ("a dep never un-fails") is not enforced anywhere, so
        # enforce the inverse transition explicitly: deps satisfied => back to PENDING.
        if status == BLOCKED and not any_dep_failed(st, sid):
            print(f"# {sid}: was BLOCKED but every dependency has since recovered "
                  f"-> back to {PENDING} (re-authoring it).")
            s["status"] = status = PENDING
            s["job_id"] = None
            save_state(st)

        if any_dep_failed(st, sid) and status in (PENDING, BLOCKED):
            s["status"] = BLOCKED
            save_state(st)
            print(f"# {sid}: BLOCKED (a dependency failed) -- skipping.")
            continue

        # BUG (2026-09-18): this guard skipped FAILED slices, so a slice carrying a
        # stale FAILED marker while its authoring attempt was actually live in the
        # queue never had that marker corrected -- the persisted status described a
        # SUPERSEDED attempt. A live job is ground truth for the MOST RECENT attempt
        # whatever the persisted status says: self-heal FAILED -> PENDING here.
        if status in (PENDING, CONFIRMED, FAILED):
            infl = slice_job_inflight(st, sid)
            if infl:
                jid, qs, lbl = infl
                if status == FAILED:
                    heal = heal_status_for_live_job(lbl)
                    print(f"# {sid}: stale FAILED marker -- a fresh dispatch is live "
                          f"({lbl} [{jid}] = {qs}); resetting to {heal}.")
                    s["status"] = heal
                    # A refine ROUND belongs to the authoring loop, not the coding
                    # dispatch -- record it as the author job (2026-09-19).
                    if lbl.startswith(("auto-author-", "auto-refine-")):
                        s["author_job_id"] = jid
                    else:
                        s["job_id"] = jid
                    save_state(st)
                print(f"# {sid}: a dispatch is already in flight ({lbl} [{jid}] = {qs}); "
                      f"NOT launching a duplicate. Re-run --execute later to poll, or --reconcile.")
                return

        # BUG (2026-09-20): a BARE FAILED slice -- FAILED with NO live job -- matched
        # NO branch in this loop. The self-heal directly above only covers the case
        # where the FAILED marker is STALE because a fresh dispatch is already live;
        # with nothing in the queue there was nothing to heal against, every branch
        # below tests a different status, and chain_may_pass(FAILED) is True, so the
        # loop fell out of the bottom and stepped over it. Every subsequent --execute
        # did the same thing forever: the slice sat FAILED with a dirty worktree
        # (target file half-edited by the losing run, plus the scaffold files) and the
        # ONLY recovery was a human typing --retry-slice by hand. Seen live on the
        # broker_guard/playwright_checks.py chain: s1-build-site-checks and
        # s3-run-playwright-checks both sat in exactly this state across many passes.
        #
        # Do automatically what the human does: record the attempt, then clear the
        # worktree and reset to PENDING so this SAME pass re-authors from a clean,
        # attributable baseline. The bound is not a new one -- it is literally the
        # existing retry-storm budget (identical-signature streak + total attempts),
        # so a slice that keeps failing the same way ESCALATES to the Claude gate
        # exactly as an unauthorable one does, instead of looping forever.
        #
        # Deliberately NOT applied to: SATISFIED (retry_slice refuses those, and so do
        # we -- the loop `continue`s on them before reaching here) or ESCALATED, which
        # exists precisely to hold a slice for human/Claude judgement.
        if status == FAILED:
            if not deps_done(st, sid):
                print(f"# {sid}: FAILED and its dependencies {s['depends_on']} are not "
                      f"satisfied -- NOT auto-retrying (a re-author would be cut from a "
                      f"chain tip that is missing them).")
                continue
            wt = s.get("worktree") or slice_worktree(st, sid)
            s["worktree"] = wt
            # REAP-vs-GATE RACE (2026-09-24): "no live job" is not "no job still being
            # judged". A round of this slice that the queue has just reaped may have
            # its gate running against this very worktree; that verdict is the event
            # that will re-enter this branch. Neither auto-land nor clear ahead of it
            # -- see slice_job_awaiting_gate (bounded by LOST_EVENT_GRACE_S).
            _ag = slice_job_awaiting_gate(st, sid)
            if _ag:
                print(f"# {sid}: FAILED, but {_ag[1]} [{_ag[0]}] finished {_ag[2]:.0f}s ago "
                      f"and its gate has not reported a terminal verdict yet -- NOT "
                      f"auto-landing or clearing a tree the gate is still reading. Its "
                      f"verdict fires the next advance; stop here.")
                return
            # HAND-EDIT PROTECTION (2026-10-04, unattended-readiness 2d) -- see
            # hand_edits_since_failure. Neither auto-land nor clear a tree someone
            # is fixing in place.
            _he = hand_edits_since_failure(s, wt) if os.path.isdir(wt) else []
            if _he:
                print(f"# {sid}: FAILED, but its worktree {wt} has UNCOMMITTED HAND "
                      f"EDITS made after the failure ({', '.join(_he[:6])}"
                      f"{' ...' if len(_he) > 6 else ''}) -- NOT auto-retrying (that "
                      f"would clear them). To test the fix in place: --regate {sid}. "
                      f"To discard it and re-author: --retry-slice {sid}.")
                continue
            # CAUSE-2a AUTO-LAND (2026-09-21): a slice that already reached the CODING
            # stage (has a coding job_id -> its harness cleared the mechanical relevance
            # gate at confirm_and_enqueue) and is FAILED only because its converged
            # deliverable never got committed -- the confirmed dirty-launch-baseline
            # `concerns` demotion (rt-costco class) -- must be LANDED, not re-authored
            # (which would discard correct code and burn GPU). A LIVE verify.sh re-run is
            # the proof, and _land_green_slice also refuses on an unconfirmed-draft marker,
            # so the relevance gate stays intact. This fires ONLY when the slice already
            # passed relevance (coding job_id set); a slice that FAILED during AUTHORING
            # (no coding job_id, relevance never proven) is deliberately NOT auto-landed --
            # it falls through to the bounded re-author / needs_opus escalation below
            # (Cause-2b), which is where an unproven harness belongs.
            if s.get("job_id") and os.path.isdir(wt):
                landed, lmsg = _land_green_slice(st, sid, s, cwt, require_relevance=True)
                if landed:
                    print(f"# {sid}: FAILED but its converged deliverable is GREEN at HEAD "
                          f"-- AUTO-LANDED (chain advanced to {lmsg[:8]}) instead of "
                          f"re-authoring correct code. Continuing...")
                    continue
            _abort = retry_abort_reason(st, sid, wt, FAILED)
            if _abort:
                print(f"# {sid}: FAILED auto-retry NOT started -- {_abort}. The worktree "
                      f"is left as it is.")
                continue
            print(f"# {sid}: FAILED with no live job -- auto-retrying (clearing the "
                  f"losing attempt's worktree {wt} and resetting to {PENDING}).")
            # Unconditional, even when the worktree is already gone: the budget is
            # what makes this safe, and a FAILED slice that leaves NO worktree behind
            # would otherwise be the one shape that could loop uncounted forever.
            if not bound_stale_worktree_retry(
                    st, sid, s, wt, cwt, "failed slice, before auto-retry"):
                return
            s["status"] = status = PENDING
            s["job_id"] = None
            save_state(st)

        if status == PENDING:
            if not deps_done(st, sid):
                print(f"# {sid}: waiting on dependencies {s['depends_on']} -- stop here.")
                return
            wt = slice_worktree(st, sid)
            s["worktree"] = wt
            # RESUME: a prior run may have already authored this slice's harness
            # (AUTO is a long blocking call; an interrupted --execute leaves the
            # harness in place but the state still PENDING). Pick it up instead
            # of re-running AUTO into an existing worktree (which collides).
            resume_author = False
            _sc_fail = harness_self_check_fail(wt) if harness_authored(wt) else None
            if harness_authored(wt) and _sc_fail is None:
                print(f"# {sid}: harness already authored -- resuming (no re-author).")
                clear_author_failures(s)
                clean_and_seal(wt)
                _park_or_advance(st, sid, s, wt, model, host, max_iters,
                                 chat_timeout, author_mode, num_ctx, auto_confirm)
                return
            if harness_authored(wt):
                # authored but NOT converged: its authoring round was interrupted.
                # Continue authoring on the same tree (AUTO --resume-author: bounded
                # continuation ladder) -- never preflight it, never wipe it.
                print(f"# {sid}: harness authored but it does NOT self-check ({_sc_fail}) "
                      f"-- its authoring was interrupted; resuming AUTHORING on the same "
                      f"tree (--resume-author), not preflight.")
                resume_author = True
            elif Path(wt).exists():
                if not bound_stale_worktree_retry(
                        st, sid, s, wt, cwt, "authoring self-check, before re-author"):
                    return
            _abort = retry_abort_reason(st, sid, wt, PENDING)
            if _abort:
                print(f"# {sid}: NOT authoring -- {_abort}. Nothing enqueued.")
                return
            _unc = uncovered_edit_files(st, s)
            if _unc:
                s["last_auto_error"] = (f"plan defect: intent edits {', '.join(_unc)} outside "
                                        f"the slice scope")
                save_state(st)
                print(f"# {sid}: NOT authoring -- PLAN DEFECT: the intent creates/edits "
                      f"{', '.join(_unc)} but the slice's scope is only "
                      f"{', '.join([slice_target(st, s)] + slice_edit_files(st, s))}. The "
                      f"harness would say 'Only edit' the target while needing the others, "
                      f"and landing would drop them. Give the slice its own `target` and/or "
                      f"`edit_files` in the plan (or `reads` for a file it only references), "
                      f"then --retry-slice {sid}. Nothing enqueued.")
                return
            _lint = pre_author_lint_reason(st, dict(s, id=sid))
            if _lint:
                s["status"] = ESCALATED
                s["escalation_reason"] = (f"PLAN LINT: {_lint}. Fix the plan entry for {sid} "
                                          f"(or set `lint_ack: true` on it to override), then "
                                          f"--retry-slice {sid}. Refused BEFORE any author job.")
                save_state(st)
                print(f"# {sid}: ESCALATED -- {s['escalation_reason']} Nothing enqueued.")
                return
            _unsat = spec_satisfiability_reason(st, dict(s, id=sid), cwt)
            if _unsat:
                s["status"] = ESCALATED
                s["escalation_reason"] = (f"UNSATISFIABLE SPEC: {_unsat}. Fix the literal(s) in the "
                                          f"plan entry for {sid} (or set `lint_ack: true`), then "
                                          f"--retry-slice {sid}. Refused BEFORE any author job.")
                save_state(st)
                print(f"# {sid}: ESCALATED -- {s['escalation_reason']} Nothing enqueued.")
                return
            # PRE-LAUNCH BUDGET GATE (2026-10-05, s3fix): the job budget used to be
            # consulted only on the failed->retry path, so a slice reset to PENDING
            # (a self-heal --retry-slice) re-authored without it ever being checked.
            _budget_why = author_budget_block(st, sid, s)
            if _budget_why:
                s["status"] = ESCALATED
                s["escalation_reason"] = (f"{_budget_why} -- refused BEFORE launching "
                                          f"another authoring round.")
                save_state(st)
                print(f"# {sid}: ESCALATED -- {s['escalation_reason']} Nothing enqueued.")
                return
            _foreign = foreign_tracked_harness(cwt, st["label"])
            if _foreign:
                s["status"] = ESCALATED
                s["escalation_reason"] = (
                    f"REPO DEFECT: the chain base TRACKS another task's dispatch harness "
                    f"({', '.join(_foreign)}) -- every authoring launch would modify "
                    f"tracked files and start DIRTY (untrusted). Untrack them in the "
                    f"plan repo and the chain: git -C {shlex.quote(str(cwt))} rm -q "
                    f"--cached {' '.join(_foreign)} && git -C {shlex.quote(str(cwt))} "
                    f"commit -qm 'strip foreign dispatch scaffold' (same in "
                    f"{shlex.quote(str(st.get('repo') or '<repo>'))}), then --retry-slice {sid}.")
                save_state(st)
                print(f"# {sid}: ESCALATED -- {s['escalation_reason']} Nothing enqueued.")
                return
            print(f"# === authoring slice {sid} ({s['title']}) off chain tip ===")
            if author_mode == "auto":
                # a reason recorded by a PREVIOUS launch must not outlive it
                s.pop("last_auto_error", None)
                cp = run_tee(auto_launch_argv(st, sid, s, cwt, wt, resume_author))
                # ROOT-CAUSE FIX (2026-09-21): AUTO's refine loop now aborts early
                # (rc=0) if the slice already converged via a different path while
                # it was running (see slice_already_satisfied() in
                # ollama-dispatch-auto). Re-read the slice's OWN on-disk status here,
                # fresh, before touching it -- if another path already landed DONE/
                # SKIPPED, leave it alone instead of routing an already-terminal
                # slice through _park_or_advance() (which would wrongly stamp it
                # CONFIRMED and re-enqueue a mechanical gate pass for work that's
                # already finished).
                # read_state(), NOT load_state(): load_state() takes the PLAN dict
                # (it indexes plan["slices"]) and can write the state back via
                # refresh_spec_from_plan(). All this check needs is a pure re-read
                # of the state file. Passing st["label"] to load_state() crashed
                # here with AttributeError: 'str' object has no attribute 'get'.
                fresh = read_state(st["label"]) or {}
                fresh_status = (fresh.get("slices", {}).get(sid, {}) or {}).get("status")
                # ANY status other than the PENDING we set before launching AUTO means
                # another driver acted on this slice while AUTO ran (#3): landed it,
                # confirmed/enqueued it off the same worktree, or escalated it. Routing
                # it through _park_or_advance here would be a second driver -- a
                # duplicate CONFIRMED + coding enqueue on a tree the other one owns.
                if hand_locked(wt):
                    s["status"] = PENDING
                    s["hand_locked_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
                    save_state(st)
                    print(f"# {sid}: the worktree was HAND-LOCKED while authoring was in "
                          f"flight -- AUTO stopped without enqueuing over it; left "
                          f"{PENDING} (not FAILED). --regate {sid} to test the hand "
                          f"harness, --retry-slice {sid} to discard it.")
                    return
                if fresh_status and fresh_status != PENDING:
                    # STALL (2026-09-23, aw-sched-runner: s19 landed by
                    # --complete-slice while this detached run was inside AUTO;
                    # this branch returned, and s20..s27 sat PENDING for hours with
                    # nothing left to fire a hook). Our in-memory `st` is stale, so
                    # do NOT continue this loop -- ask for ONE fresh advance, which
                    # main() fires on exit after releasing the lock, re-reads the
                    # state and authors the next slice.
                    request_advance(st["label"])
                    print(f"# {sid}: already {fresh_status} on disk (landed via a "
                          f"different path while this authoring run was in flight) "
                          f"-- leaving as-is; a fresh advance will continue the chain.")
                    return
                if cp.returncode != 0:
                    # BUG (2026-09-18): a non-zero AUTO rc was stamped as FAILED
                    # unconditionally. But AUTO returns non-zero when its authoring
                    # job is merely PAUSED/re-queued -- the job stays ALIVE in the
                    # queue and later runs to completion. Stamping FAILED there
                    # persists a status describing an attempt that is still in
                    # flight (and blocks the chain on a slice that may yet pass).
                    # Only a slice with NO live authoring job has actually failed.
                    infl = slice_job_inflight(st, sid)
                    if infl:
                        jid, qs, lbl = infl
                        s["status"] = PENDING
                        s["author_job_id"] = jid
                        save_state(st)
                        print(f"# {sid}: AUTO exited {cp.returncode} but its job is "
                              f"still live ({lbl} [{jid}] = {qs}) -- left {PENDING}, "
                              f"not FAILED. Re-run --execute later to poll.")
                        return
                    # ALREADY-SATISFIED, DETECTED AT AUTHORING TIME (2026-09-19).
                    # The authoring self-check runs the both-ways proof too, and
                    # when it reports "verify.sh PASSES at baseline" it has just
                    # established the same fact preflight would have: the property
                    # already holds, so NOTHING the model writes can make an honest
                    # fixture go red. Stamping FAILED here made that slice eligible
                    # for re-authoring on the next pass, which is how one such slice
                    # burned 11 identical dispatches without ever reaching preflight.
                    # Route it to the real decision instead of the retry loop.
                    if AUTHOR_BASELINE_GREEN_MARKER in author_failure_signature(wt):
                        park_if_already_satisfied(st, sid, s, wt,
                                                  "authoring self-check")
                        return
                    reason, deterministic = auto_failure_reason(
                        getattr(cp, "stdout", "") or "")
                    if reason:
                        s["last_auto_error"] = reason
                    if deterministic:
                        # Same inputs, same refusal: a relaunch cannot get past it,
                        # so escalate NOW, with AUTO's own words as the reason,
                        # instead of spending a second launch to prove it identical.
                        note_author_failure(s, wt)
                        s["status"] = ESCALATED
                        s["escalation_reason"] = (
                            f"authoring failed DETERMINISTICALLY (AUTO rc="
                            f"{cp.returncode}) -- a relaunch with the same inputs "
                            f"cannot pass: {reason or 'no reason line in AUTO output'}")
                        save_state(st)
                        print(f"# {sid}: ESCALATED on the first attempt -- AUTO failed "
                              f"deterministically (rc={cp.returncode}):\n#     "
                              f"{reason}\n# Fix the cause, then --retry-slice {sid}.")
                        return
                    _kept = converged_harness_preflight_nogo(
                        getattr(cp, "stdout", "") or "", wt)
                    if _kept:
                        note_author_failure(s, wt)
                        refresh_author_job_ids(st, sid, s)
                        s["status"] = ESCALATED
                        s["escalation_reason"] = (
                            "HARNESS CONVERGED, PREFLIGHT NO-GO -- worktree KEPT "
                            "(not re-authored): %s. Fix the named blocker in %s, then "
                            "resume with: ollama-dispatch-slice %s --regate %s (re-runs "
                            "preflight on the kept harness; a still-NO-GO tree simply "
                            "re-escalates). To discard it and re-author instead: "
                            "--retry-slice %s." % (_kept, wt, st.get("plan_path") or "<plan.json>",
                                                   sid, sid))
                        save_state(st)
                        print(f"# {sid}: ESCALATED -- {s['escalation_reason']}")
                        return
                    s["status"] = FAILED
                    save_state(st)
                    print(f"# {sid}: FAILED during auto-authoring (rc={cp.returncode})"
                          + (f": {reason}" if reason else "."))
                    return
                clean_and_seal(wt)
            else:
                run([SCAFFOLD, "--label", f"{st['label']}-{sid}", "--repo", cwt,
                     "--dest", wt, "--lang", st["lang"], "--target", slice_target(st, s),
                     *[f"--edit-file={_f}" for _f in slice_edit_files(st, s)],
                     "--defect", f"omnibus slice {sid}", "--property", s["intent"]])
            _park_or_advance(st, sid, s, wt, model, host, max_iters,
                             chat_timeout, author_mode, num_ctx, auto_confirm)
            return

        if status == AWAITING_REVIEW:
            # A slice parked by an older run or by --manual-review. With the Claude-gate
            # default (auto_confirm), advance it now instead of waiting on a human.
            if auto_confirm:
                wt = s["worktree"]
                print(f"# {sid}: was parked at relevance review -- auto-advancing "
                      f"(Claude-gate default).")
                confirm_and_enqueue(st, sid, s, wt, model, host, max_iters,
                                    chat_timeout, author_mode, num_ctx)
                return
            print(f"# {sid}: awaiting your relevance review -- --confirm-slice {sid} then --execute.")
            return

        if status == CONFIRMED:
            wt = s["worktree"]
            confirm_and_enqueue(st, sid, s, wt, model, host, max_iters,
                                chat_timeout, author_mode, num_ctx)
            return

        # Bug #12 (2026-09-18): there was NO `if status == ESCALATED` branch here.
        # An ESCALATED slice (preflight relevance NO-GO, context-budget block, or a
        # reviewer "needs_opus") is PARKED, not finished -- its fix is NOT in the
        # chain worktree. With no branch, it matched nothing and fell through to the
        # next iteration: an unattended --execute sweep silently stepped OVER the
        # parked slice and authored/dispatched the NEXT one against a chain tip that
        # is missing this slice's change (seen live: bg-eraser-s1-invoke s4 ESCALATED,
        # s5 auto-authored off the pre-s4 tip, job 5d76522723be, cancelled by hand).
        # That contradicts this function's contract -- "stop at the first slice still
        # running" -- and silently clobbers whenever the two slices' lines overlap.
        # An ESCALATED slice halts the chain like every other in-motion status.
        # 2026-09-27 (the owner: work the started bundle while anything in it can run):
        # an ESCALATED slice no longer stops the whole chain. Its DEPENDENTS are
        # held (any_dep_failed -> BLOCKED, cascading), and a slice that declares
        # no dependency on it is authored/landed as usual; the queue's bundle
        # commitment parks the bundle only once nothing runnable is left.
        if status == ESCALATED:
            print(f"# {sid}: ESCALATED -- parked for review; its dependents are held "
                  f"(its fix is not in the chain worktree yet), independent slices "
                  f"continue.")
            if s.get("escalation_reason"):
                print(f"#   reason: {s['escalation_reason']}")
            print(f"#   --accept-slice {sid}  : its coding job already converged and "
                  f"you reviewed the diff -- land it.")
            print(f"#   --regate {sid}        : it was a preflight/relevance NO-GO and "
                  f"you fixed the harness IN PLACE -- re-gate and enqueue.")
            print(f"#   --retry-slice {sid}   : re-author it from scratch.")
            continue

        if status == ENQUEUED:
            js = job_status(s["job_id"])
            # GATE AUTO-FIX SUCCESSOR (2026-10-05, rt-egift-link-s1-s0 0ea47b5f09f8 ->
            # 01fdda651fba): the gate re-queued an auto-fix round IN THIS WORKTREE.
            # Marking the slice FAILED orphaned that round (nothing would land its
            # result) and, on an unlocked slice, let the FAILED auto-heal clear the
            # worktree under it. Follow the round, then poll IT through the normal
            # branches below (so a finished round lands in this same pass).
            if js in ("failed", "done_unconverged", "error", "cancelled"):
                succ = autofix_successor(s["job_id"])
                if succ:
                    print(f"# {sid}: job {s['job_id']} {js}, but the gate re-queued "
                          f"auto-fix round {succ[2]} as {succ[0]} ({succ[1]}) in the same "
                          f"worktree -- following it (still {ENQUEUED}).")
                    s["job_id"] = succ[0]
                    save_state(st)
                    js = job_status(s["job_id"])
            if js is None:
                # VANISHED JOB (2026-09-23, cc-waitlist-r2 s1 e1b1a6ceea18): the job is
                # in neither the live queue table nor any completion sidecar. "check
                # manually" parked the whole chain forever. Heal it: the harness is
                # intact, so re-gate + re-enqueue (bounded), else escalate WITH a reason.
                healed = heal_vanished_job(st, sid, s)
                if healed == "requeue":
                    confirm_and_enqueue(st, sid, s, s["worktree"], model, host, max_iters,
                                        chat_timeout, author_mode, num_ctx,
                                        expect=_CONFIRM_ENTRY_STATUSES + (ENQUEUED,))
                return
            if js == "done":
                # GATE-VERDICT-AWARE LANDING (2026-09-23). Queue `done` means the
                # worker's own verify went green; it says NOTHING about the gate.
                # Route on the gate's durable record -- see coding_land_route and
                # the GATE_*_VERDICTS comment for the 13 red jobs this landed.
                rec = gate_record(s["job_id"]) or {}
                route = coding_land_route(rec.get("verdict"),
                                          done_sidecar_age_s(s["job_id"]),
                                          rec.get("review"))
                if route == "wait":
                    print(f"# {sid}: job {s['job_id']} is done but its gate verdict is "
                          f"{rec.get('verdict') or 'not recorded yet'} -- waiting for the "
                          f"gate (the completion hook advances the chain when the verdict "
                          f"lands; after {GATE_VERDICT_WAIT_S // 60} min the live verify "
                          f"alone decides).")
                    return
                if route == "escalate":
                    s["status"] = ESCALATED
                    s["gate_verdict"] = rec.get("verdict")
                    s["escalation_reason"] = gate_escalation_reason(rec, s["job_id"], sid)
                    save_state(st)
                    print(f"# {sid}: ESCALATED -- {s['escalation_reason']}")
                    return
                # STALE VERDICT (2026-10-06 gate audit): a verdict stamped with the
                # product-file hashes it judged must still describe the slice
                # worktree. If a judged file changed after the gate (a hand edit, a
                # continuation round), the live verify below would prove the NEW code
                # green while the review/relevance verdict is about the OLD code --
                # escalate for a --regate instead of landing on a stale verdict.
                # Unstamped (pre-2026-10-06) records keep the old behaviour.
                _stale = verdict_stale_reasons(rec, s.get("worktree"))
                if _stale:
                    s["status"] = ESCALATED
                    s["gate_verdict"] = rec.get("verdict")
                    s["escalation_reason"] = (
                        f"gate verdict for job {s['job_id']} is STALE: "
                        + "; ".join(_stale)[:300]
                        + f" -- the code on disk is not what was reviewed: --regate {sid} "
                          f"(fresh preflight + coding job + gate), or read the changed "
                          f"files and --accept-slice {sid}")
                    save_state(st)
                    print(f"# {sid}: ESCALATED -- {s['escalation_reason']}")
                    return
                if rec.get("verdict"):
                    s["gate_verdict"] = rec["verdict"]
                else:
                    print(f"# WARNING {sid}: landing job {s['job_id']} with NO gate verdict "
                          f"recorded {GATE_VERDICT_WAIT_S // 60}+ min after it finished -- "
                          f"the live verify.sh re-run is the only proof.")
                # The green proof is a LIVE verify.sh re-run in the worktree (never the
                # queue's status token) plus the relevance/DRAFT_UNCONFIRMED guard --
                # the same core --accept-slice / --complete-slice / the FAILED auto-land
                # use, so every path onto the chain proves the same thing.
                ok, msg = _land_green_slice(st, sid, s, cwt, require_relevance=True)
                if not ok:
                    s["status"] = FAILED
                    s["failure_reason"] = msg
                    save_state(st)
                    print(f"# {sid}: job {s['job_id']} reported done but {msg} -- FAILED "
                          f"(not committed); dependents will be blocked.")
                    continue
                print(f"# {sid}: DONE, chain advanced to {msg[:8]}"
                      + (f" (gate {s['gate_verdict']})" if s.get("gate_verdict") else "")
                      + ". Continuing...")
                continue
            if js == "needs_opus":
                # BUG (2026-10-02, Rivian s4 5983078bfe69): the gate sends a coding job
                # with a reviewer code-high straight to the queue's needs_opus lane, so
                # the queue never reports `done` and the escalate route above never
                # ran. This poll printed "still running" every 5 min for 2 h while the
                # slice sat ENQUEUED -- and --accept-slice refused it ("is 'enqueued',
                # not 'escalated'"). needs_opus IS the escalation: record it.
                rec = gate_record(s["job_id"]) or {}
                s["status"] = ESCALATED
                if rec.get("verdict"):
                    s["gate_verdict"] = rec.get("verdict")
                s["escalation_reason"] = gate_escalation_reason(rec, s["job_id"], sid)
                save_state(st)
                print(f"# {sid}: ESCALATED (queue needs_opus) -- {s['escalation_reason']}")
                return
            if js in ("failed", "done_unconverged", "error", "cancelled"):
                # GATE STILL DECIDING (2026-10-06, found by pipeline-canary.py): the
                # queue reaps a red coding job and fires its gate, which writes
                # verdict=fail with review=pending, waits for the review, and only
                # THEN requeues the auto-fix round. A poll in that window saw "failed,
                # no successor" and marked the slice FAILED ("dependents will be
                # blocked") while the gate was about to own the worktree. The next
                # poll un-failed it ("stale FAILED marker"), but meanwhile the FAILED
                # was visible to everything else: dependents, the FAILED auto-heal,
                # the dashboard. Wait for the gate; its verdict fires the next advance.
                hold = failed_job_gate_hold(st, sid, js)
                if hold:
                    print(f"# {sid}: job {hold[0]} {js}, but its gate has not reported a "
                          f"terminal verdict yet ({int(hold[2])}s since it finished; the "
                          f"gate may still requeue an auto-fix round) -- waiting, NOT "
                          f"failing it. The gate's verdict advances the chain.")
                    return
                s["status"] = FAILED
                _grec = gate_record(s["job_id"]) or {}
                s["failure_reason"] = (
                    f"job {s['job_id']} {js}; gate verdict={_grec.get('verdict')} "
                    f"review={_grec.get('review')} auto_fix={_grec.get('auto_fix_action')}"
                    f"/{_grec.get('auto_fix_enqueue_status')}; age="
                    f"{done_sidecar_age_s(s['job_id'])}")
                save_state(st)
                print(f"# {sid}: dispatch {js} -- FAILED; dependents will be blocked. "
                      f"({s['failure_reason']})")
                continue
            print(f"# {sid}: job {s['job_id']} is {js} -- still running. Re-run --execute later.")
            return

        # Bug #12, structural half: the ESCALATED gap above was only possible because
        # the bottom of this loop body is a SILENT `continue`. Any status with no
        # branch -- today's, or one added later -- steps past an unlanded slice
        # instead of halting. Fail loud instead: only a status chain_may_pass()
        # accepts may be stepped over.
        if not chain_may_pass(status):
            print(f"# {sid}: status {status!r} is not a finished state and no branch "
                  f"above handled it -- STOPPING rather than authoring the next slice "
                  f"against a chain tip that is missing this one. (This is a bug in "
                  f"execute(): {status!r} needs its own branch.)")
            return

    done = [i for i in st["order"] if st["slices"][i]["status"] == DONE]
    skipped = [i for i in st["order"] if st["slices"][i]["status"] == SKIPPED]
    failed = [i for i in st["order"] if st["slices"][i]["status"] == FAILED]
    blocked = [i for i in st["order"] if st["slices"][i]["status"] == BLOCKED]
    escalated = [i for i in st["order"] if st["slices"][i]["status"] == ESCALATED]
    # SKIPPED is reported on its own line, never folded into `done`: a reader
    # counting progress must be able to see that those slices landed NOTHING.
    print(f"\n# SLICE RUN COMPLETE: {len(done)} done, {len(skipped)} skipped "
          f"(already satisfied), {len(failed)} failed, {len(blocked)} blocked, "
          f"{len(escalated)} escalated.")
    for i in skipped:
        print(f"#   skipped {i}: {st['slices'][i].get('skip_reason', '(no reason recorded)')}")
    # Every slice is terminal -> no PLANNED row for this plan can still come true.
    # Leaving them would leave phantom worklist rows in the queue forever (the whole
    # point of the placeholders is that they mean "still coming").
    subprocess.run(["python3", QUEUE, "plan-clear", "--group", f"slice-{st['label']}"],
                   capture_output=True, text=True)
    if done:
        print(f"# converged slices are commits on {st['chain_branch']} in {st['chain_worktree']}")
    # WHOLE-CHAIN INTEGRATION, STAGE half (2026-09-23, Fable pass 2). Until now this
    # is where the pipeline said "integrate by copying that tree onto main" and
    # stopped -- twenty converged plans never landed. A fully SATISFIED plan with
    # something on its chain now stages its code-only integration commit and
    # records `integration`; the escalation watcher announces a staged chain that
    # is waiting for --land-integration, and any failure. See integrate_chain().
    if plan_converged(st):
        cwt_ = st.get("chain_worktree")
        tip_ = git(cwt_, "rev-parse", "HEAD", capture=True) if cwt_ and os.path.isdir(cwt_) else None
        # onto_tip_ is what makes a cached verdict expire: a `staged` or conflict record
        # whose default branch has moved is re-classified instead of re-announced.
        onto_tip_ = current_onto_tip(st)
        if integration_needed(st, tip_, onto_tip_):
            integrate_chain(st, cwt_ if tip_ else None)
        else:
            rec_ = st.get("integration") or {}
            print(f"# integration [{st['label']}]: {rec_.get('status', '?')} (recorded "
                  f"{rec_.get('at', '?')} vs {rec_.get('onto')} @ "
                  f"{str(onto_tip_ or '?')[:8]}) -- {str(rec_.get('summary', ''))[:200]}")
    if failed:
        print(f"# FAILED: {', '.join(failed)}")
    if blocked:
        print(f"# BLOCKED (dep failed): {', '.join(blocked)}")
    if escalated:
        # Per-slice TRUE reason (2026-10-03): this line used to label every escalated
        # slice "relevance NO-GO" -- replay-endorse s4b was a vacuous must_contain
        # (plan defect) and s3 an exhausted authoring budget.
        print(f"# ESCALATED to the Claude gate: {', '.join(escalated)}")
        for _sid in escalated:
            _s = st["slices"].get(_sid) or {}
            print(f"#   {_sid}: {escalation_kind(_s.get('escalation_reason'))}")
        print(f"#   -- these surface in the run-status needs-eyes panel; each slice's "
              f"reason above names its resolution lever.")


def _self_test():
    """PURE unit tests for the auto-feed decision core -- no queue, no git, no
    model. Same convention as ollama-queue.py --self-test."""
    ok = True

    def check(name, got, want):
        nonlocal ok
        if got == want:
            print(f"PASS {name}")
        else:
            ok = False
            print(f"FAIL {name}: got {got!r} want {want!r}")

    st = {
        "label": "alpha",
        "order": ["s1", "s2", "s3"],
        "slices": {
            "s1": {"status": DONE, "title": "one", "depends_on": []},
            "s2": {"status": PENDING, "title": "two", "depends_on": ["s1"]},
            "s3": {"status": PENDING, "title": "three", "depends_on": ["s2"]},
        },
    }
    check("a planned row uses the CODING job's label (so enqueue releases it)",
          planned_label("alpha", "s2"), "alpha-s2")
    rows = dag_rows(st)
    check("the WHOLE remaining DAG is published, not just the next slice",
          [r["label"] for r in rows], ["alpha-s2", "alpha-s3"])
    check("an already-DONE slice publishes no phantom row",
          any(r["label"] == "alpha-s1" for r in rows), False)
    check("the first remaining slice has no dependency (it is ready now)",
          rows[0]["after"], None)
    check("each later slice is dep-gated on the one before it",
          rows[1]["after"], "alpha-s2")
    check("the row carries the slice title so the queue row is legible",
          rows[0]["note"], "two")
    st["slices"]["s2"]["status"] = DONE
    check("re-publishing after a slice lands drops it and re-roots the chain",
          [(r["label"], r["after"]) for r in dag_rows(st)], [("alpha-s3", None)])
    # A row's edge names its REAL unsatisfied dependency, not merely the previous
    # slice (2026-09-23, Fable pass 3: pending-sync-scope s3 re-wired s2 -> s1).
    _dst = {"label": "beta", "order": ["s1", "s2", "s3"], "slices": {
        "s1": {"status": PENDING, "title": "one", "depends_on": []},
        "s2": {"status": DONE, "title": "two", "depends_on": []},
        "s3": {"status": PENDING, "title": "three", "depends_on": ["s1"]}}}
    check("a row depends on its declared unsatisfied dependency, skipping a landed "
          "intermediate slice", [(r["label"], r["after"]) for r in dag_rows(_dst)],
          [("beta-s1", None), ("beta-s3", "beta-s1")])
    _dst["slices"]["s3"]["depends_on"] = ["s2"]
    check("...and a row whose only dependency already landed chains on the previous "
          "unsatisfied slice (the serial walk order)",
          [(r["label"], r["after"]) for r in dag_rows(_dst)], [("beta-s1", None), ("beta-s3", "beta-s1")])
    _rst = {"label": "gamma", "order": ["s1", "s2"], "dag_published": True, "slices": {
        "s1": {"status": PENDING, "title": "one", "depends_on": [], "intent": "i1",
               "must_contain": [], "verify_shape": ""},
        "s2": {"status": PENDING, "title": "two", "depends_on": [], "intent": "i2",
               "must_contain": [], "verify_shape": ""}}}
    _rplan = {"label": "gamma", "slices": [
        {"id": "s1", "title": "one", "intent": "i1", "depends_on": []},
        {"id": "s2", "title": "two", "intent": "i2", "depends_on": ["s1"]}]}
    _saved_save = globals()["save_state"]
    try:
        globals()["save_state"] = lambda st_, unsatisfy=None: None
        refresh_spec_from_plan(_rst, _rplan)
    finally:
        globals()["save_state"] = _saved_save
    check("a re-wired depends_on in the plan un-latches dag_published so the DAG rows "
          "are re-published (and re-pointed)", _rst.get("dag_published"), False)

    # --- vacuous must_contain gate ---------------------------------------------
    import re
    import tempfile as _tf
    with _tf.TemporaryDirectory() as _root:
        _vst = {"target": "lib/ccWaitlist.ts"}
        os.makedirs(os.path.join(_root, "lib"), exist_ok=True)
        _tgt = os.path.join(_root, "lib", "ccWaitlist.ts")
        Path(_tgt).write_text("export function load() { return 1; }\n")
        check("the cc-waitlist-r2 defect: ['on'] already matches `function` at baseline",
              vacuous_literals(_vst, {"must_contain": ["on"]}, _root) is not None, True)
        check("a literal that does NOT yet exist discriminates -- allowed",
              vacuous_literals(_vst, {"must_contain": ["dedupeWaitlist"]}, _root), None)
        check("one absent literal is enough even if the others are already true",
              vacuous_literals(_vst, {"must_contain": ["on", "dedupeWaitlist"]}, _root), None)
        # 2026-09-23: an EMPTY set is no longer a park for an ordinary slice -- the
        # fixture (both-ways + relevance proven) is the discriminator; omnibus emits
        # [] on purpose. It is recorded and said out loud. An INVARIANT still needs
        # its literals (its skip decision rests on them).
        _es = {"must_contain": []}
        check("an EMPTY must_contain on an ORDINARY slice proceeds on the fixture alone",
              vacuous_literals(_vst, _es, _root), None)
        check("...recording that it was accepted (persisted by execute())",
              (_es.get("must_contain_empty_accepted"), _es.get("_refined_dirty")), (True, True))
        check("whitespace-only literals count as EMPTY (same outcome)",
              vacuous_literals(_vst, {"must_contain": ["  "]}, _root), None)
        check("an EMPTY must_contain on an INVARIANT slice is still refused",
              vacuous_literals(_vst, {"must_contain": [], "kind": "invariant"}, _root)
              is not None, True)
        # DECLARED-ONLY (the def case: arr-codec-floor s4 after s1 landed codec_rank)
        _def_root = _tf.mkdtemp()
        _dst = {"target": "arr-webhook.py"}
        Path(_def_root, "arr-webhook.py").write_text(
            "import os\n\ndef codec_rank(name):\n    return 1\n\ndef pack(x):\n    return x\n")
        _ds = {"must_contain": ["codec_rank"]}
        check("a literal present ONLY on its own `def` line is NOT vacuous (the slice's job is to use it)",
              vacuous_literals(_dst, _ds, _def_root), None)
        check("...kept bare (its `NAME(` form is already on the def line) and recorded as declared-only",
              (_ds["must_contain"], _ds.get("must_contain_declared_only")),
              (["codec_rank"], ["codec_rank"]))
        Path(_def_root, "arr-webhook.py").write_text(
            "def codec_rank(name):\n    return 1\n\ndef pack(x):\n    return codec_rank(x)\n")
        check("...but a literal already USED at baseline (called) IS vacuous",
              vacuous_literals(_dst, {"must_contain": ["codec_rank"]}, _def_root) is not None, True)
        check("classify_baseline_literals: absent / declared / used",
              classify_baseline_literals(["zzz", "codec_rank", "pack", "return"],
                                         "def codec_rank(n):\n    return 1\nx = pack(2)\n"),
              {"zzz": "absent", "codec_rank": "declared", "pack": "used", "return": "used"})
        shutil.rmtree(_def_root, ignore_errors=True)
        check("a creation slice (target absent at baseline) is NOT vacuous",
              vacuous_literals({"target": "lib/nope.ts"}, {"must_contain": ["on"]}, _root), None)
        check("a plan with no target declared is left alone, not blocked",
              vacuous_literals({}, {"must_contain": ["on"]}, _root), None)
        # The guard must fire from execute()'s own source, before authoring.
        # STRUCTURAL, not a substring match: the first version of this test
        # searched the whole source for "vacuous_literals(" and was satisfied by
        # the GUARD'S OWN COMMENT, so deleting the call site went undetected in
        # the revert-test. Strip comment text first and require a real call with
        # the live state/slice/worktree arguments.
        check("the guard applies to a PENDING slice (before authoring)",
              vacuous_gate_reason(_vst, {"must_contain": ["on"]}, PENDING, _root) is not None, True)
        for _st8 in (CONFIRMED, FAILED, BLOCKED):
            check(f"...and to a {_st8} slice (every pre-dispatch state)",
                  vacuous_gate_reason(_vst, {"must_contain": ["on"]}, _st8, _root) is not None, True)
        for _st8 in (DONE, SKIPPED, ENQUEUED, ESCALATED):
            check(f"...but NOT to a {_st8} slice (nothing to re-decide)",
                  vacuous_gate_reason(_vst, {"must_contain": ["on"]}, _st8, _root), None)
        _esrc = inspect.getsource(execute)
        _code = "\n".join(re.sub(r"#.*$", "", l) for l in _esrc.splitlines())
        check("execute() actually CALLS the guard (not merely mentions it)",
              bool(re.search(r"vacuous_gate_reason\(\s*st\s*,\s*s\s*,\s*status\s*,", _code)), True)
        _vpos = _code.find("vacuous_gate_reason(")
        _esrc = _code
        _apos = _esrc.find("if status == PENDING:")
        check("...and it is positioned ahead of the PENDING/author branch",
              _vpos >= 0 and _apos >= 0 and _vpos < _apos, True)

    # --- advance lock: one advance per plan, never a permanent jam --------------
    live = {"pid": 1, "started_at": datetime.now(timezone.utc).isoformat()}
    check("a lock held by a LIVE advance is not stale",
          lock_is_stale(live, alive=lambda p: True), False)
    check("a lock whose owner died is stale (the chain must not jam)",
          lock_is_stale(live, alive=lambda p: False), True)
    old = {"pid": 1, "started_at": "2020-01-01T00:00:00+00:00"}
    check("a lock older than the max age is stale even if the pid is alive",
          lock_is_stale(old, alive=lambda p: True), True)
    check("an unreadable/garbage lock is stale (fail toward advancing)",
          lock_is_stale("not-a-dict"), True)
    check("a lock with no timestamp but a live owner is NOT stale",
          lock_is_stale({"pid": 1}, alive=lambda p: True), False)

    # Real file lock, in a scratch STATE_ROOT -- never the live one.
    import tempfile
    global STATE_ROOT
    _saved = STATE_ROOT
    try:
        STATE_ROOT = tempfile.mkdtemp(prefix="slice-selftest-")
        first = acquire_advance_lock("alpha")
        check("the first advance takes the lock", bool(first), True)
        check("a SECOND completion hook firing does not start a rival advance",
              acquire_advance_lock("alpha"), None)
        release_advance_lock("alpha")
        second = acquire_advance_lock("alpha")
        check("the lock is reusable once the advance finishes", bool(second), True)
        release_advance_lock("alpha")
        # A lock left behind by a dead process must not jam the chain forever.
        Path(lock_path("alpha")).write_text(json.dumps({"pid": 999999999}))
        check("a stale lock from a dead advance is reclaimed",
              bool(acquire_advance_lock("alpha")), True)
        release_advance_lock("alpha")

        # --- one driver per plan (2026-09-23 two-drivers-one-worktree race) -----
        _lk = acquire_advance_lock("beta")
        check("the lock can be re-pointed at the detached CHILD's pid",
              _write_lock_owner(_lk, os.getpid()) and
              json.loads(Path(_lk).read_text())["pid"] == os.getpid(), True)
        check("read_lock_owner sees the live holder",
              (read_lock_owner("beta") or {}).get("pid"), os.getpid())
        check("...and a second acquire is refused while it lives",
              acquire_advance_lock("beta"), None)
        release_advance_lock("beta")
        check("read_lock_owner is None once released", read_lock_owner("beta"), None)
        check("advance_detached names the child, not the spawner, in the lock",
              "_write_lock_owner(lk, proc.pid)" in inspect.getsource(advance_detached),
              True)
        check("a manual --execute takes the same per-plan lock as --advance-detached",
              "acquire_advance_lock(label)" in inspect.getsource(main), True)
        check("...and exits with the machine-readable abstain code when refused",
              "sys.exit(EXIT_DRIVER_LIVE)" in inspect.getsource(main), True)
        check("...and releases it however execute() ends",
              "release_advance_lock(label)" in inspect.getsource(main)
              and "finally:" in inspect.getsource(main), True)
        # coalesced re-trigger: N blocked events -> one marker -> one advance
        check("no request marker at rest", consume_requested_advance("beta"), False)
        request_advance("beta")
        request_advance("beta")
        check("a blocked hook leaves ONE request marker that is consumed once",
              (consume_requested_advance("beta"), consume_requested_advance("beta")),
              (True, False))
        check("a blocked --advance-detached REQUESTS instead of dropping the event",
              "request_advance(label)" in inspect.getsource(advance_detached), True)
        check("the lock holder fires the requested advance on exit",
              "consume_requested_advance(label)" in inspect.getsource(main)
              and "advance_detached(st, a.plan)" in inspect.getsource(main), True)
        check("'already done on disk -- leaving as-is' no longer stalls the chain",
              "request_advance(st[\"label\"])" in inspect.getsource(execute), True)
        check("operator levers warn when a live driver holds the plan",
              all(f"warn_if_driver_live(st, \"{lever}" in inspect.getsource(main)
                  for lever in ("--retry-slice", "--regate", "--accept-slice",
                                "--complete-slice", "--skip-slice", "--reland-slice")),
              True)

        # --- stranded-event sweep + lever re-arm (2026-09-23, Fable pass 2) -------
        # A plan whose lock holder died with a request marker on disk, and no live
        # driver: the sweep must fire exactly one advance and eat the marker.
        _fired = []
        _rec = lambda st_, plan_: _fired.append(st_["label"])
        _plan_f = os.path.join(STATE_ROOT, "gamma.plan.json")
        Path(_plan_f).write_text("{}")
        _gst = {"label": "gamma", "plan_path": _plan_f, "order": ["s1", "s2"],
                "slices": {"s1": {"status": DONE}, "s2": {"status": PENDING}}}
        Path(state_path("gamma")).write_text(json.dumps(_gst))
        # a lock naming a DEAD pid = the holder died without its finally
        Path(lock_path("gamma")).write_text(json.dumps({"pid": 999999999}))
        request_advance("gamma")
        check("a stranded marker with a dead lock holder is swept into ONE advance",
              (sweep_stranded_advances(fire=_rec, statuses={}, verbose=False), _fired),
              (["gamma"], ["gamma"]))
        check("...and the marker is consumed by the sweep (no second advance later)",
              os.path.exists(requested_path("gamma")), False)
        _fired.clear()
        check("a plan with nothing stranded is left alone",
              sweep_stranded_advances(fire=_rec, statuses={}, verbose=False), [])
        # a LIVE holder with a marker: not ours -- it consumes on exit
        request_advance("gamma")
        Path(lock_path("gamma")).write_text(json.dumps(
            {"pid": os.getpid(),
             "started_at": datetime.now(timezone.utc).isoformat()}))
        check("a marker under a LIVE driver is NOT swept (the holder owns it)",
              sweep_stranded_advances(fire=_rec, statuses={}, verbose=False), [])
        check("...and the marker is left for that holder",
              os.path.exists(requested_path("gamma")), True)
        release_advance_lock("gamma")
        consume_requested_advance("gamma")
        # a lost completion event: ENQUEUED slice, job long done, no marker, no driver
        _gst["slices"]["s2"] = {"status": ENQUEUED, "job_id": "j2"}
        Path(state_path("gamma")).write_text(json.dumps(_gst))
        _old = lambda j: LOST_EVENT_GRACE_S + 60
        _young = lambda j: 30.0
        check("an ENQUEUED slice whose job finished past the grace window is kicked",
              bool(plan_needs_kick(_gst, {"j2": "done"}, _old, None, False)), True)
        check("...but not while the job is still running",
              plan_needs_kick(_gst, {"j2": "running"}, _old, None, False), None)
        check("...and not inside the grace window (the hook is still on its way)",
              plan_needs_kick(_gst, {"j2": "done"}, _young, None, False), None)
        check("...and never under a live driver",
              plan_needs_kick(_gst, {"j2": "done"}, _old, {"pid": 1}, False), None)
        check("a plan parked only in ESCALATED is a human decision, not a kick",
              plan_needs_kick({"label": "g", "order": ["s1"],
                               "slices": {"s1": {"status": ESCALATED}}},
                              {}, _old, None, False), None)
        # #5: a CONFIRMED slice left behind by a cwd-exclusive collision is
        # re-kicked after the grace window, and not before.
        _col = {"label": "g", "order": ["s1"],
                "slices": {"s1": {"status": CONFIRMED,
                                  "last_collision": {"at": 1000.0, "detail": "x"}}}}
        check("a collided CONFIRMED slice is re-gated once the grace window passed",
              "cwd-exclusive collision" in (plan_needs_kick(
                  _col, {}, _old, None, False, now=1000.0 + COLLISION_RETRY_GRACE_S + 1) or ""),
              True)
        check("...but not inside the window (the other job is probably still running)",
              plan_needs_kick(_col, {}, _old, None, False, now=1000.0 + 60), None)
        check("a CONFIRMED slice with no collision record is not the sweep's business",
              plan_needs_kick({"label": "g", "order": ["s1"],
                               "slices": {"s1": {"status": CONFIRMED}}},
                              {}, _old, None, False, now=1e12), None)
        # VANISHED coding job (cc-waitlist-r2 s1): readable table, job absent, no sidecar
        _van = {"label": "g", "order": ["s1"],
                "slices": {"s1": {"status": ENQUEUED, "job_id": "gone1"}}}
        check("an ENQUEUED slice whose job is in neither the queue table nor a sidecar is kicked",
              "vanished" in (plan_needs_kick(_van, {"other": "running"}, _old, None, False,
