        check("job_vanished: empty table is unknown, never vanished",
              job_vanished("gone1", {}, sidecar=lambda j: None), False)
        _hsrc = inspect.getsource(execute)
        check("execute() heals a vanished job instead of 'check manually'",
              "heal_vanished_job(st, sid, s)" in _hsrc and "check manually" not in _hsrc, True)
        # #10 / #5: preflight NO-GO classification
        class _PFOut:
            def __init__(self, out, err=""):
                self.stdout, self.stderr, self.returncode = out, err, 1
        _pfo = ("  [PASS] baseline-clean     tree is clean\n"
                "  [FAIL] cwd-exclusive      1 active job(s) already own this worktree\n"
                "         abc123 [running] auto-refine-x-s1-r2 -> /wt\n"
                "-----\nNO-GO: cwd-exclusive -- 1 active job(s) already own this worktree\n")
        _bl = preflight_blockers(_PFOut(_pfo))
        check("preflight_blockers parses the [FAIL] rows",
              _bl, [("cwd-exclusive", "1 active job(s) already own this worktree")])
        check("a LONE cwd-exclusive FAIL is a collision, not a verdict",
              preflight_nogo_kind(_bl), "collision")
        _bl2 = preflight_blockers(_PFOut(
            "  [FAIL] cwd-exclusive      1 active job(s) already own this worktree\n"
            "  [FAIL] verify-relevance   score 0.4 < 0.8; 3 survivors\n"))
        check("cwd-exclusive alongside a real blocker is a verdict (escalate)",
