              plan_needs_kick(_van, {}, _old, None, False, now=5000.0), None)
        _van["slices"]["s1"]["enqueued_at"] = 5000.0 - 30
        check("...and a just-enqueued stamp gets the grace window",
              plan_needs_kick(_van, {"other": "running"}, _old, None, False, now=5000.0), None)
        check("job_vanished: absent from a non-empty table with no sidecar",
              job_vanished("gone1", {"other": "running"}, sidecar=lambda j: None), True)
        check("job_vanished: a sidecar means it finished, not vanished",
