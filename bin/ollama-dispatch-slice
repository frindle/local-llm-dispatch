    _rr, _rd = auto_failure_reason(_refusal_tail)
    check("auto_failure_reason carries the scaffold's own refusal text",
          ("REFUSING code-fix scaffold" in (_rr or "")
           and "scaffold failed (rc=2)" in (_rr or "")), True)
    check("a scaffold failure is DETERMINISTIC", _rd, True)
    check("an argparse usage error is DETERMINISTIC",
          auto_failure_reason("usage: x [-h]\nollama-dispatch-scaffold: error: "
                              "unrecognized arguments: --allow-browser-context\n"
                              "ERROR: scaffold failed (rc=2)\n")[1], True)
    _nr, _nd = auto_failure_reason(
        "    verdict=NO-GO  blockers=['verify-relevance']\n"
        "[auto] hit the round cap without a GO. The harness is in /x.\n")
    check("a round-cap NO-GO is reported but NOT deterministic (a retry may pass)",
          (bool(_nr) and "round cap" in _nr, _nd), (True, False))
    check("silent output -> no reason, not deterministic",
          auto_failure_reason("polling...\n"), (None, False))
    _sa = {"last_auto_error": "REFUSING x | ERROR: scaffold failed (rc=2)"}
    check("note_author_failure prefers AUTO's own reason over the stub listing",
          note_author_failure(_sa, "/nonexistent-wt-c")[1],
          "REFUSING x | ERROR: scaffold failed (rc=2)")
    clear_author_failures(_sa)
    check("clear_author_failures also forgets the stale AUTO reason",
          "last_auto_error" in _sa, False)
    _ex_src = inspect.getsource(execute)
    check("execute() tees AUTO's output so the reason is capturable",
          "cp = run_tee(auto_launch_argv(" in _ex_src, True)
    check("a deterministic AUTO failure escalates on the FIRST attempt",
          (_ex_src.find("if deterministic:")
           < _ex_src.find("s[\"status\"] = ESCALATED", _ex_src.find("if deterministic:"))
           < _ex_src.find("FAILED during auto-authoring")), True)
    check("the authoring path refuses to re-author once the streak is reached",
          "streak >= MAX_IDENTICAL_AUTHOR_FAILURES" in _ex, True)
    check("the retry-storm escalation leaves the worktree INTACT as evidence "
          "(no remove_worktree between the escalation reason and its return)",
          (lambda _b, _i: _i >= 0 and "remove_worktree" not in _b[_i:_b.index("return False", _i)])(
              inspect.getsource(bound_stale_worktree_retry),
              inspect.getsource(bound_stale_worktree_retry).find("authoring made no progress across")),
          True)

    # --- harness_authored is language-aware (2026-09-27, bfmr s2) ------------------
    # It used to require test_fixture.py, so every complete JS/TS harness read as
    # "unauthored -> test_fixture.py:missing", re-authored forever, and escalated.
    def _harness(d, fixture, manifest=None):
        Path(d, "TASK.md").write_text("## Must contain\n- `x`\n")
        Path(d, "refimpl.py").write_text("pass\n")
        fp = Path(d, fixture); fp.parent.mkdir(parents=True, exist_ok=True)
        fp.write_text("cases\n")
        if manifest is not None:
            Path(d, ".dispatch-harness.json").write_text(json.dumps({"authored": manifest}))
    for _fx, _man in (("test_fixture.py", None), ("verify.test.ts", None),
                      ("Tests/verifyTests.swift", None),
                      ("tests/login.test.ts", ["TASK.md", "refimpl.py", "verify.sh",
                                               "check_literals.py", "tests/login.test.ts"])):
        with tempfile.TemporaryDirectory() as _hd:
            _harness(_hd, _fx, _man)
            check(f"harness_authored: complete harness with fixture {_fx} -> True",
                  harness_authored(_hd), True)
            check(f"...and its failure signature is not 'unauthored' ({_fx})",
                  author_failure_signature(_hd).startswith("unauthored"), False)
    with tempfile.TemporaryDirectory() as _hd:
        Path(_hd, "TASK.md").write_text("## Must contain\n- `x`\n")
        Path(_hd, "refimpl.py").write_text("pass\n")
        check("harness_authored: no fixture at all -> False", harness_authored(_hd), False)

    # --- Cause-2a/2b self-recovery: auto-land + --complete-slice (2026-09-21) -------
    # _draft_unconfirmed keeps the relevance gate intact for an unattended land.
    with tempfile.TemporaryDirectory() as _dwt:
        Path(_dwt, "TASK.md").write_text("do the thing\n")
        Path(_dwt, "test_fixture.py").write_text("assert load() == 1\n")
        check("no marker -> relevance considered confirmed (draft was --confirm'd)",
              _draft_unconfirmed(_dwt), False)
        Path(_dwt, "test_fixture.py").write_text("DRAFT_UNCONFIRMED = True\nassert 1\n")
        check("an ACTIVE python DRAFT_UNCONFIRMED marker is detected (relevance unconfirmed)",
              _draft_unconfirmed(_dwt), True)
        Path(_dwt, "test_fixture.py").write_text("assert 1\n")
        Path(_dwt, "verify.test.ts").write_text("const DRAFT_UNCONFIRMED = true;\n")
        check("...and the JS marker form is detected too",
              _draft_unconfirmed(_dwt), True)

    # _land_green_slice against REAL git: verify-green + no marker LANDS; a marker
    # refuses under require_relevance; a red verify never lands. (Cause-2a core.)
    _saved_root = STATE_ROOT
    with tempfile.TemporaryDirectory() as _lroot:
        STATE_ROOT = _lroot
        _cwt = os.path.join(_lroot, "chain")
        os.makedirs(_cwt)
        for _a in (["init", "-q"], ["config", "user.email", "t@t"],
                   ["config", "user.name", "t"]):
            subprocess.run(["git", "-C", _cwt, *_a], capture_output=True, text=True)
        Path(_cwt, "seed").write_text("seed\n")
        subprocess.run(["git", "-C", _cwt, "add", "-A"], capture_output=True, text=True)
        subprocess.run(["git", "-C", _cwt, "commit", "-qm", "base"], capture_output=True, text=True)

        _wt_seq = [0]

        def _mk_wt(green=True, marker=False):
            w = tempfile.mkdtemp(prefix="land-wt-", dir=_lroot)
            _wt_seq[0] += 1
            # Distinct body per worktree so each land is a real, HEAD-moving commit
            # (identical content would make _commit_deliverable a correct no-op).
            Path(w, "app.py").write_text("def f(): return %d\n" % (42 + _wt_seq[0]))
            Path(w, "verify.sh").write_text(
                'echo VERIFY_OK\n' if green else 'echo NOPE; exit 1\n')
            Path(w, "test_fixture.py").write_text(
                "DRAFT_UNCONFIRMED = True\n" if marker else "assert f()\n")
            return w

        _st = {"label": "land", "target": "app.py",
               "slices": {"s1": {"status": FAILED, "title": "land it",
                                 "worktree": _mk_wt(green=True, marker=False)}}}
        _ok, _msg = _land_green_slice(_st, "s1", _st["slices"]["s1"], _cwt,
                                      require_relevance=True)
        check("_land_green_slice: verify GREEN + relevance confirmed -> lands (ok)",
              _ok, True)
        check("...and it stamps the slice DONE", _st["slices"]["s1"]["status"], DONE)
        check("...and the deliverable is really committed onto the chain (HEAD moved)",
              subprocess.run(["git", "-C", _cwt, "log", "--oneline"],
                             capture_output=True, text=True).stdout.count("\n") >= 2, True)

        _st2 = {"label": "land2", "target": "app.py",
                "slices": {"s1": {"status": FAILED, "title": "unconfirmed",
                                  "worktree": _mk_wt(green=True, marker=True)}}}
        _ok2, _m2 = _land_green_slice(_st2, "s1", _st2["slices"]["s1"], _cwt,
                                      require_relevance=True)
        check("_land_green_slice: verify GREEN but UNCONFIRMED draft -> REFUSES (relevance gate)",
              _ok2, False)
        check("...and the slice is left FAILED, not landed",
              _st2["slices"]["s1"]["status"], FAILED)
        _ok2b, _ = _land_green_slice(_st2, "s1", _st2["slices"]["s1"], _cwt,
                                     require_relevance=False)
        check("...but the MANUAL lever (require_relevance=False) lands it on operator authority",
              _ok2b, True)

        _st3 = {"label": "land3", "target": "app.py",
                "slices": {"s1": {"status": FAILED, "title": "red",
                                  "worktree": _mk_wt(green=False, marker=False)}}}
        _ok3, _ = _land_green_slice(_st3, "s1", _st3["slices"]["s1"], _cwt,
                                    require_relevance=True)
        check("_land_green_slice: a RED verify NEVER lands (bounded-retry owns it)",
              _ok3, False)
    STATE_ROOT = _saved_root

    # complete_slice status guards + the execute() FAILED auto-land, structurally.
    _cs = inspect.getsource(complete_slice)
    check("--complete-slice accepts a FAILED/ESCALATED/BLOCKED slice (not just ESCALATED)",
          all(s in _cs for s in ("FAILED", "ESCALATED", "BLOCKED")), True)
    check("--complete-slice refuses a slice with a live job (never races a dispatch)",
          "slice_job_inflight(" in _cs, True)
    check("--complete-slice lands via the shared verify-green core",
          "_land_green_slice(" in _cs, True)
    _exsrc = inspect.getsource(execute)
    check("execute()'s FAILED branch AUTO-LANDS a green converged slice before re-authoring",
          "_land_green_slice(" in _exsrc, True)
    check("...guarded on a coding job_id, so an unproven-authoring FAILED is NOT auto-landed",
          _exsrc.index("_land_green_slice(") > _exsrc.index("if status == FAILED:")
          and "s.get(\"job_id\")" in _exsrc, True)
    check("...and the auto-land is positioned BEFORE the bounded re-author fallthrough",
          _exsrc.index("_land_green_slice(") < _exsrc.index("bound_stale_worktree_retry("), True)

    # --- SKIPPED: the already-satisfied slice (s4 was one) -------------------------
    check("SKIPPED is satisfied, so dependents may proceed", SKIPPED in SATISFIED, True)
    check("SKIPPED is NOT folded into DONE (it landed nothing)", SKIPPED == DONE, False)
    check("a SKIPPED slice is stepped over (nothing more will land for it)",
          chain_may_pass(SKIPPED), True)
    check("FAILED is NOT treated as satisfied", FAILED in SATISFIED, False)
    check("ESCALATED is NOT treated as satisfied", ESCALATED in SATISFIED, False)
    _dep_st = {"slices": {"a": {"status": SKIPPED, "depends_on": []},
                          "b": {"status": PENDING, "depends_on": ["a"]}}}
    check("deps_done: a SKIPPED dependency satisfies its dependent "
          "(waiting for a DONE that can never arrive would deadlock the plan)",
          deps_done(_dep_st, "b"), True)
    check("any_dep_failed: a SKIPPED dependency is not a failure",
          any_dep_failed(_dep_st, "b"), False)

    # --- Already-satisfied auto-skip, and its first-time-per-plan caveat ----------
    class _PF:
        def __init__(self, out): self.stdout, self.stderr = out, ""
    check("a green-at-baseline NO-GO is recognised",
          _preflight_says_baseline_green(
              _PF("baseline-fails FAIL verify PASSES on the untouched baseline (exit 0)")), True)
    check("an ORDINARY NO-GO is NOT mistaken for already-satisfied "
          "(else a real harness defect would be silently skipped)",
          _preflight_says_baseline_green(
              _PF("verify-relevance FAIL score 0.4 < 0.8; 3 survivors")), False)
    check("an empty/failed preflight is not read as already-satisfied",
          _preflight_says_baseline_green(_PF("")), False)
    # Behavioural, not source-grep: drive the real router both ways.
    class _FakeCompleted:
        def __init__(self, returncode, stdout=""):
            self.returncode = returncode
            self.stdout = stdout

    def _park(confirmed, verify_passes=True):
        _st = {"label": "pt-%d" % confirmed, "slices": {}}
        if confirmed:
            _st["baseline_green_confirmed"] = True
        _s = {"status": PENDING}
        import io, contextlib
        global run, save_state, _audit_verify
        _orig_run, _orig_save, _orig_av = run, save_state, _audit_verify
        _audit_verify = lambda wt: ((0, "VERIFY_OK\n") if verify_passes else (1, "FAIL\n"))

        def _fake_run(cmd, **kwargs):
            if cmd[:2] == ["bash", "verify.sh"]:
                return (_FakeCompleted(0, "VERIFY_OK\n") if verify_passes
                        else _FakeCompleted(1, "FAIL\n"))
            return _orig_run(cmd, **kwargs)
        run = _fake_run
        save_state = lambda st: None
        buf = io.StringIO()
        try:
            with contextlib.redirect_stdout(buf):
                _r = park_if_already_satisfied(_st, "s1", _s, "/tmp/wt", "unit-test")
        finally:
            run, save_state, _audit_verify = _orig_run, _orig_save, _orig_av
        return _r, _s
    _r0, _s0 = _park(False)
    _r1, _s1 = _park(True)
    _r2, _s2 = _park(True, verify_passes=False)
    check("audit: a CONTRADICTED baseline-green claim is SUSPECTED, never auto-skipped",
          (_r2, _s2["status"]), (True, ESCALATED))
    check("audit: a contradicted-claim escalation says PIPELINE BUG SUSPECTED",
          "PIPELINE BUG SUSPECTED" in _s2["escalation_reason"], True)
    check("the FIRST green-at-baseline slice in a plan ESCALATES, never auto-skips",
          (_r0, _s0["status"]), (True, ESCALATED))
    check("auto-skip only after a human confirmed one in this plan",
          (_r1, _s1["status"]), (True, SKIPPED))
    check("an auto-skip records WHY it was skipped", "already satisfied" in _s1["skip_reason"], True)
    check("neither outcome leaves the slice re-authorable "
          "(FAILED is what re-armed the 11-dispatch storm)",
          _s0["status"] != FAILED and _s1["status"] != FAILED, True)

    # THE BUG: already-satisfied must be detectable at AUTHORING time, not only at
    # preflight. Revert-test = delete the AUTHOR_BASELINE_GREEN_MARKER branches from
    # the authoring path and this pair fails, because the slice falls through to
    # FAILED and is re-authored on the next pass -- the 11-dispatch storm.
    _auth = _ex
    check("the authoring-failure path routes a green-at-baseline slice to the "
          "already-satisfied decision instead of FAILED",
          _auth.count("AUTHOR_BASELINE_GREEN_MARKER in") >= 2, True)
    _route = _auth.find("AUTHOR_BASELINE_GREEN_MARKER in author_failure_signature")
    _stamp = _auth.find('print(f"# {sid}: FAILED during auto-authoring')
    check("...and it does so BEFORE stamping FAILED",
          _route != -1 and _stamp != -1 and _route < _stamp, True)
    check("the authoring self-check's own wording is what is matched",
          AUTHOR_BASELINE_GREEN_MARKER in
          "FAIL: verify.sh PASSES at baseline -- the fixture cannot fail, so it "
          "certifies nothing", True)
    check("an ordinary authoring failure is NOT mistaken for already-satisfied",
          AUTHOR_BASELINE_GREEN_MARKER in
          "FAIL: TASK.md still has TODO placeholders -- fill them in", False)
    _sk = inspect.getsource(skip_slice)
    check("--skip-slice requires a stated reason", "--skip-slice requires --reason" in _sk, True)
    check("a human skip is what unlocks auto-skip for the rest of the plan",
          'st["baseline_green_confirmed"] = True' in _sk, True)
    check("--skip-slice refuses while a job is still live",
          "still has a live job" in _sk, True)

    # --- the done-but-not-at-the-chain-tip transition (bg-brokers) --------------
    _rt = inspect.getsource(retry_slice)
    check("--retry-slice refuses a SATISFIED slice (it was a destructive no-op)",
          "if s[\"status\"] in SATISFIED:" in _rt, True)
    _guard = _rt.find('if s["status"] in SATISFIED:')
    _destroy = _rt.find("remove_worktree(")
    check("...and refuses BEFORE deleting the worktree, not after",
          _guard != -1 and _destroy != -1 and _guard < _destroy, True)
    check("...and the refusal names the transition that does apply",
          "--reland-slice" in _rt, True)
    _rl = inspect.getsource(reland_slice)
    check("--reland-slice requires a stated reason", "requires --reason" in _rl, True)
    check("--reland-slice refuses while a job is still live",
          "still has a live job" in _rl, True)
    check("--reland-slice KEEPS the worktree (the landed work is evidence)",
          "remove_worktree(" in _rl, False)
    check("--reland-slice is the only caller that narrows a terminal status",
          "unsatisfy={sid}" in _rl, True)
    # Whole-file, not execute()'s source: the point is that NOTHING else in the
    # tool can undo a terminal fact, so the count has to be over everything.
    # Whole file MINUS this test function (which necessarily passes unsatisfy=
    # itself): the point is that no PRODUCTION path can undo a terminal fact.
    _whole = Path(__file__).read_text().replace(inspect.getsource(_self_test), "")
    check("...and it is the ONLY production caller that passes unsatisfy=",
          _whole.count("unsatisfy={"), 1)

    # --- the save_state clobber race (caught live: a skip erased by --execute)
    def _mk(status, **kw):
        s = {"status": status}
        s.update(kw)
        return {"slices": {"s4": s}}
    check("a SKIPPED slice on disk survives a stale in-memory FAILED",
          merge_terminal_facts(_mk(SKIPPED, skip_reason="already satisfied"),
                               _mk(FAILED))["slices"]["s4"]["status"], SKIPPED)
    check("...and its reason comes with it, so the row still explains itself",
          merge_terminal_facts(_mk(SKIPPED, skip_reason="already satisfied"),
                               _mk(FAILED))["slices"]["s4"]["skip_reason"],
          "already satisfied")
    check("a DONE slice on disk survives a stale in-memory PENDING",
          merge_terminal_facts(_mk(DONE), _mk(PENDING))["slices"]["s4"]["status"], DONE)
    check("normal forward progress still writes through (disk PENDING -> mem DONE)",
          merge_terminal_facts(_mk(PENDING), _mk(DONE))["slices"]["s4"]["status"], DONE)
    check("a DONE on disk is STILL restored when unsatisfy names a DIFFERENT slice",
          merge_terminal_facts(_mk(DONE), _mk(PENDING),
                               unsatisfy={"s7"})["slices"]["s4"]["status"], DONE)
    check("an explicit --reland-slice narrowing IS honoured for the named slice",
          merge_terminal_facts(_mk(DONE), _mk(PENDING),
                               unsatisfy={"s4"})["slices"]["s4"]["status"], PENDING)
    check("...and a SKIPPED is re-openable the same way (both terminal states)",
          merge_terminal_facts(_mk(SKIPPED), _mk(PENDING),
                               unsatisfy={"s4"})["slices"]["s4"]["status"], PENDING)
    check("the default (no unsatisfy) keeps the full clobber protection",
          merge_terminal_facts(_mk(DONE), _mk(PENDING))["slices"]["s4"]["status"], DONE)
    check("a skip is NOT undone by a concurrent write that also says skipped",
          merge_terminal_facts(_mk(SKIPPED), _mk(SKIPPED))["slices"]["s4"]["status"],
          SKIPPED)
    check("a slice present on disk but absent from memory is never dropped",
          "s9" in merge_terminal_facts(
              {"slices": {"s9": {"status": DONE}}}, _mk(PENDING))["slices"], True)
    check("baseline_green_confirmed is sticky once true",
          merge_terminal_facts({"baseline_green_confirmed": True},
                               {"slices": {}}).get("baseline_green_confirmed"), True)
    check("merge tolerates garbage on either side",
          (merge_terminal_facts(None, _mk(FAILED)) is not None
           and merge_terminal_facts({"slices": "x"}, _mk(FAILED)) is not None), True)
    check("save_state actually calls the merge (not just defined)",
          "merge_terminal_facts(" in inspect.getsource(save_state), True)

    # --- ESCALATED parent whose sub-plan already finished (2026-09-19) --------
    # Live: bg-crypto/s1-crypto, bg-eraser/s1-invoke, bg-state/s1-init-db all
    # reported a stale halt while --reconcile said "nothing to reconcile".
    def _sub(*statuses):
        order = [f"x{i}" for i in range(len(statuses))]
        return {"label": "sub", "order": order,
                "slices": {i: {"status": s} for i, s in zip(order, statuses)}}
    check("sub-plan naming convention is <parent>-<sid>",
          subplan_label("bg-crypto", "s1-crypto"), "bg-crypto-s1-crypto")
    check("an all-DONE sub-plan is complete",
          subplan_is_complete(_sub(DONE, DONE, DONE)), True)
    check("a sub-plan containing a SKIPPED slice still counts as complete "
          "(SKIPPED is satisfied -- nothing left to land)",
          subplan_is_complete(_sub(DONE, SKIPPED, DONE)), True)
    check("an all-SKIPPED sub-plan is complete",
          subplan_is_complete(_sub(SKIPPED, SKIPPED)), True)
    for _bad in (PENDING, AWAITING_REVIEW, CONFIRMED, ENQUEUED, FAILED,
                 BLOCKED, ESCALATED):
        check(f"a sub-plan with one {_bad} member is NOT complete",
              subplan_is_complete(_sub(DONE, _bad, DONE)), False)
    check("a missing sub-plan (None) is NOT complete -- fail closed",
          subplan_is_complete(None), False)
    check("an empty sub-plan is NOT complete (no evidence is not proof)",
          subplan_is_complete({"order": [], "slices": {}}), False)
    check("a garbage sub-plan is NOT complete",
          subplan_is_complete({"order": ["x0"], "slices": {"x0": "nope"}}), False)
    check("a sub-plan whose order names a missing slice is NOT complete",
          subplan_is_complete({"order": ["x0"], "slices": {}}), False)

    _saved = STATE_ROOT
    try:
        STATE_ROOT = tempfile.mkdtemp(prefix="slice-selftest-sub-")

        # A REAL git repo, because the merge-back is a git fact and a mocked one
        # would prove nothing. Layout mirrors production exactly: a parent chain
        # branch `slice/par` with its own worktree, and a sub-plan branch
        # `slice/par-s1` carrying commits the parent branch does not have.
        _grepo = tempfile.mkdtemp(prefix="slice-selftest-repo-")
        _gcwt = os.path.join(_grepo, "..", os.path.basename(_grepo) + "-chain")
        _gcwt = os.path.abspath(_gcwt)

        def _g(*a, repo=None):
            return subprocess.run(["git", "-C", repo or _grepo, *a],
                                  capture_output=True, text=True)

        def _mkrepo(conflict=False):
            """Fresh repo + parent chain worktree + a sub-plan branch with work.
            conflict=True also advances the PARENT branch over the same line, so
            the merge must conflict."""
            shutil.rmtree(_grepo, ignore_errors=True)
            shutil.rmtree(_gcwt, ignore_errors=True)
            os.makedirs(_grepo, exist_ok=True)
            _g("init", "-q", "-b", "main")
            _g("config", "user.email", "t@t"), _g("config", "user.name", "t")
            Path(_grepo, "t.txt").write_text("base\n")
            _g("add", "-A"), _g("commit", "-q", "-m", "base")
            _g("branch", "slice/par")
            _g("worktree", "add", "-q", _gcwt, "slice/par")
            _g("config", "user.email", "t@t", repo=_gcwt)
            _g("config", "user.name", "t", repo=_gcwt)
            # sub-plan branch: its own worktree, its own commit -- exactly how a
            # sub-plan run lands work today.
            _swt = _gcwt + "-sub"
            shutil.rmtree(_swt, ignore_errors=True)
            _g("branch", "slice/par-s1", "slice/par")
            _g("worktree", "add", "-q", _swt, "slice/par-s1")
            _g("config", "user.email", "t@t", repo=_swt)
            _g("config", "user.name", "t", repo=_swt)
            Path(_swt, "t.txt").write_text("base\nSUBPLAN WORK\n")
            _g("add", "-A", repo=_swt)
            _g("commit", "-q", "-m", "sub-plan slice work", repo=_swt)
            _g("worktree", "remove", "--force", _swt)
            if conflict:
                Path(_gcwt, "t.txt").write_text("base\nPARENT WORK\n")
                _g("add", "-A", repo=_gcwt)
                _g("commit", "-q", "-m", "parent chain work", repo=_gcwt)

        def _sub_work_on_chain():
            """The ONLY question that matters: is the sub-plan's commit reachable
            from the parent chain branch, and is its content in the chain tree?"""
            anc = subprocess.run(
                ["git", "-C", _gcwt, "merge-base", "--is-ancestor",
                 "slice/par-s1", "HEAD"], capture_output=True, text=True).returncode == 0
            try:
                body = Path(_gcwt, "t.txt").read_text()
            except OSError:
                body = ""
            return anc and "SUBPLAN WORK" in body

        def _parent(conflict=False):
            _mkrepo(conflict=conflict)
            return {"label": "par", "order": ["s1"], "repo": _grepo,
                    "chain_branch": "slice/par", "chain_worktree": _gcwt,
                    "slices": {"s1": {"status": ESCALATED, "title": "t",
                                      "depends_on": []}}}

        def _write_sub(*statuses):
            d = _sub(*statuses)
            d["chain_branch"] = "slice/par-s1"
            Path(state_path("par-s1")).write_text(json.dumps(d))

        # 1. fully-satisfied sub-plan -> the parent slice reconciles
        p = _parent()
        _write_sub(DONE, DONE)
        check("a COMPLETE sub-plan reconciles its ESCALATED parent slice",
              reconcile_escalated_subplan(p, "s1"), True)
        check("...to SKIPPED, not DONE (no coding job of its own ever ran)",
              p["slices"]["s1"]["status"], SKIPPED)
        check("...which is satisfied, so the chain stops halting there",
              chain_may_pass(p["slices"]["s1"]["status"]), True)
        check("...and the row explains itself by naming the sub-plan",
              p["slices"]["s1"]["resolved_by_subplan"], "par-s1")
        check("...with a stated reason (never a bare status flip)",
              bool(p["slices"]["s1"].get("skip_reason")), True)
        # THE GAP (2026-09-19): the sub-plan's commits must be ON the parent chain
        # branch, not merely recorded as satisfying it. Revert-test for this: delete
        # the merge_subplan_into_chain() call in reconcile_escalated_subplan and this
        # single assertion goes red while every other check above still passes --
        # which is exactly the bug that shipped.
        check("...AND the sub-plan's commits are now ON the parent chain branch",
              _sub_work_on_chain(), True)
        check("...recorded as a merge fact, not an assumption",
              p["slices"]["s1"].get("subplan_merge_status"), "ok")

        # 1b. IDEMPOTENT: a second reconcile over an already-merged sub-plan is a
        # no-op, not a duplicate merge commit.
        _tip = subprocess.run(["git", "-C", _gcwt, "rev-parse", "HEAD"],
                              capture_output=True, text=True).stdout.strip()
        check("re-merging an already-merged sub-plan is a no-op",
              merge_subplan_into_chain(p, "s1", json.loads(Path(state_path("par-s1")).read_text()))[0],
              "ok")
        check("...and the chain tip did not move again",
              subprocess.run(["git", "-C", _gcwt, "rev-parse", "HEAD"],
                             capture_output=True, text=True).stdout.strip(), _tip)

        # 1c. CONFLICT: the parent chain and the sub-plan both edited the same line.
        # The mechanism escalates THIS conflict; it does not silently skip the
        # parent slice over work that is not in the chain.
        p = _parent(conflict=True)
        _write_sub(DONE, DONE)
        _ctip = subprocess.run(["git", "-C", _gcwt, "rev-parse", "HEAD"],
                               capture_output=True, text=True).stdout.strip()
        check("a CONFLICTING sub-plan merge does NOT reconcile the parent",
              reconcile_escalated_subplan(p, "s1"), False)
        check("...the parent slice stays ESCALATED (nothing is laundered)",
              p["slices"]["s1"]["status"], ESCALATED)
        check("...the escalation names the conflict specifically",
              "CONFLICT" in (p["slices"]["s1"].get("escalation_reason") or ""), True)
        check("...and the conflicting paths are named so a human can act",
              "t.txt" in (p["slices"]["s1"].get("escalation_reason") or ""), True)
        check("...the chain worktree is left back at its tip, never half-merged",
              subprocess.run(["git", "-C", _gcwt, "rev-parse", "HEAD"],
                             capture_output=True, text=True).stdout.strip(), _ctip)
        check("...and the chain worktree is CLEAN (no conflict markers left behind)",
              subprocess.run(["git", "-C", _gcwt, "status", "--porcelain"],
                             capture_output=True, text=True).stdout.strip(), "")

        # 1d. a sub-plan branch that does not exist at all must NOT satisfy the parent
        p = _parent()
        _write_sub(DONE, DONE)
        subprocess.run(["git", "-C", _grepo, "branch", "-D", "slice/par-s1"],
                       capture_output=True, text=True)
        check("a MISSING sub-plan branch does NOT reconcile the parent "
              "(no commits anyone can point at)",
              reconcile_escalated_subplan(p, "s1"), False)
        check("...and it stays ESCALATED", p["slices"]["s1"]["status"], ESCALATED)

        # 2. partially-done sub-plan -> the parent STAYS escalated
        p = _parent()
        _write_sub(DONE, PENDING)
        check("a PARTIALLY-done sub-plan does NOT reconcile the parent",
              reconcile_escalated_subplan(p, "s1"), False)
        check("...and the parent slice is left ESCALATED (work is still owed)",
              p["slices"]["s1"]["status"], ESCALATED)

        # 3. sub-plan containing a skipped slice is still complete, end to end
        p = _parent()
        _write_sub(DONE, SKIPPED)
        check("a sub-plan with a SKIPPED member still reconciles the parent",
              reconcile_escalated_subplan(p, "s1"), True)

        # 4. no sub-plan at all -> nothing happens (the ordinary escalation)
        p = _parent()
        os.remove(state_path("par-s1"))
        check("a MISSING sub-plan does NOT reconcile the parent",
              reconcile_escalated_subplan(p, "s1"), False)
        check("...and the parent slice is left ESCALATED",
              p["slices"]["s1"]["status"], ESCALATED)

        # 5. only ESCALATED slices are eligible
        p = _parent()
        _write_sub(DONE, DONE)
        p["slices"]["s1"]["status"] = FAILED
        check("a FAILED slice is NOT closed by a complete sub-plan "
              "(only an ESCALATED slice was re-sliced)",
              reconcile_escalated_subplan(p, "s1"), False)
    finally:
        shutil.rmtree(STATE_ROOT, ignore_errors=True)
        STATE_ROOT = _saved
        for _p in (_grepo, _gcwt, _gcwt + "-sub"):
            shutil.rmtree(_p, ignore_errors=True)

    check("reconcile() actually consults the sub-plan (not just defined)",
          "reconcile_escalated_subplan(" in inspect.getsource(reconcile), True)
    check("the sub-plan reconcile writes through save_state, never a blind write",
          "save_state(" in inspect.getsource(reconcile), True)
    # Source-level guard on the merge-back, alongside the behavioural ones above:
    # the flip to SKIPPED must come AFTER the merge attempt, never before.
    _rsrc = inspect.getsource(reconcile_escalated_subplan)
    check("reconcile_escalated_subplan actually CALLS the merge-back",
          "merge_subplan_into_chain(" in _rsrc, True)
    check("...and the merge is attempted BEFORE the slice is recorded satisfied",
          _rsrc.find("merge_subplan_into_chain(") < _rsrc.find('s["status"] = SKIPPED'), True)
    check("...and a non-ok merge returns False instead of flipping the status",
          'if mstatus not in ("ok", "nothing")' in _rsrc, True)

    # --- invariant slices: a negative/totality property is SKIPPED, not escalated ---
    _isrc = inspect.getsource(execute)
    check("execute() special-cases kind=='invariant' at the vacuous gate",
          's.get("kind") == "invariant"' in _isrc, True)
    check("...and an invariant with NO literals is still refused",
          _isrc.find('invariant slice declares NO must_contain literals') > 0, True)
    _vst = {"target": "t.txt"}
    _iroot = tempfile.mkdtemp(prefix="slice-selftest-inv-")
    try:
        Path(_iroot, "t.txt").write_text("alpha beta\n")
        check("an invariant slice's literals being all-present IS the vacuous signal",
              vacuous_gate_reason(_vst, {"must_contain": ["alpha", "beta"]},
                                  PENDING, _iroot) is not None, True)
        check("...and a literal it does NOT yet have is not vacuous, so it still runs",
              vacuous_gate_reason(_vst, {"must_contain": ["alpha", "gamma"]},
                                  PENDING, _iroot), None)
    finally:
        shutil.rmtree(_iroot, ignore_errors=True)

    # --- node_modules env parity (the silent killer of every JS/TS slice) --------
    _nroot = tempfile.mkdtemp(prefix="slice-selftest-nm-")
    try:
        _src, _wt = os.path.join(_nroot, "repo"), os.path.join(_nroot, "wt")
        os.makedirs(os.path.join(_src, "node_modules", "left-pad"))
        os.makedirs(_wt)
        check("a worktree with no package.json is not a node project",
              provision_node_modules(_src, _wt), "n/a")
        Path(_wt, "package.json").write_text("{}")
        check("REPRO: a JS/TS worktree missing node_modules gets it LINKED",
              provision_node_modules(_src, _wt), "linked")
        check("...and the linked tree really resolves to the source's packages",
              os.path.isdir(os.path.join(_wt, "node_modules", "left-pad")), True)
        check("...and a second call is a no-op, not a re-link",
              provision_node_modules(_src, _wt), "present")
        _src2, _wt2 = os.path.join(_nroot, "r2"), os.path.join(_nroot, "w2")
        os.makedirs(_src2); os.makedirs(_wt2)
        Path(_wt2, "package.json").write_text("{}")
        check("a source repo with no node_modules is reported, never faked",
              provision_node_modules(_src2, _wt2), "unavailable")
        check("...and nothing was created in its place",
              os.path.exists(os.path.join(_wt2, "node_modules")), False)
        check("ensure_chain_worktree provisions on BOTH paths (new and existing)",
              inspect.getsource(ensure_chain_worktree).count("provision_node_modules("), 2)
    finally:
        shutil.rmtree(_nroot, ignore_errors=True)

    # --- spec refresh: editing the PLAN must reach a run already in progress ------
    _saved = STATE_ROOT
    try:
        STATE_ROOT = tempfile.mkdtemp(prefix="slice-selftest-spec-")
        _plan = {"repo": "/r", "target": "t.ts", "label": "sp", "slices": [
            {"id": "a", "intent": "i-a", "depends_on": [], "must_contain": ["on"],
             "verify_shape": "v-a"},
            {"id": "b", "intent": "i-b", "depends_on": ["a"], "must_contain": ["on"],
             "verify_shape": "v-b"}]}
        _st = load_state(_plan, plan_path=None)
        save_state(_st)
        _st["slices"]["a"]["status"] = DONE
        save_state(_st)
        _plan["slices"][0]["must_contain"] = ["reallyNewSymbol"]
        _plan["slices"][1]["must_contain"] = ["otherNewSymbol"]
        _plan["slices"][1]["kind"] = "invariant"
        n = refresh_spec_from_plan(_st, _plan)
        check("a plan edit reaches a PENDING slice of a run already in progress",
              _st["slices"]["b"]["must_contain"], ["otherNewSymbol"])
        check("...including a newly-declared kind",
              _st["slices"]["b"].get("kind"), "invariant")
        check("...but NEVER rewrites a slice whose work already landed",
              _st["slices"]["a"]["must_contain"], ["on"])
        check("...and it reports that it changed something", n > 0, True)
        check("refreshing twice is a no-op (idempotent)",
              refresh_spec_from_plan(_st, _plan), 0)
        check("load_state() actually calls the refresh on an existing run",
              "refresh_spec_from_plan(" in inspect.getsource(load_state), True)

        # --- 2026-09-24 REAP-vs-GATE RACE (arr-codec-floor s4 r3): a FINISHED job whose
        # gate has not reported is still "in flight" for anything destructive to its
        # worktree. Pure, via the injectable statuses/gate/age readers.
        _ast = {"label": "rho", "order": ["s4"],
                "slices": {"s4": {"status": FAILED, "depends_on": []}}}
        _by = {"auto-refine-rho-s4-r3": ("j3", "done"),
               "auto-refine-rho-s4-r2": ("j2", "done"),
               "rho-s9": ("j9", "done")}
        _recs = {"j2": {"verdict": "concerns", "review": "merged"}}   # j3: crashed gate, no record
        _ages = {"j2": 900.0, "j3": 13.0, "j9": 5.0}
        check("awaiting-gate: the live shape -- a done refine round with NO gate record, 13s old",
              slice_job_awaiting_gate(_ast, "s4", statuses=({}, _by), gate=_recs.get, age=_ages.get),
              ("j3", "auto-refine-rho-s4-r3", 13.0))
        check("awaiting-gate: a job of a DIFFERENT slice never counts",
              slice_job_awaiting_gate(_ast, "s4", statuses=({}, {"rho-s9": ("j9", "done")}),
                                      gate=lambda j: None, age=_ages.get), None)
        check("awaiting-gate: a terminal gate record (review merged) -> not awaiting",
              slice_job_awaiting_gate(_ast, "s4", statuses=({}, {"auto-refine-rho-s4-r2": ("j2", "done")}),
                                      gate=_recs.get, age=lambda j: 30.0), None)
        check("awaiting-gate: pass-pending-review is NOT terminal -> awaiting",
              slice_job_awaiting_gate(_ast, "s4", statuses=({}, {"rho-s4": ("j5", "done")}),
                                      gate=lambda j: {"verdict": "pass-pending-review", "review": "pending"},
                                      age=lambda j: 30.0), ("j5", "rho-s4", 30.0))
        check("awaiting-gate: a verdict on record but review still pending -> awaiting",
              slice_job_awaiting_gate(_ast, "s4", statuses=({}, {"rho-s4": ("j5", "done")}),
                                      gate=lambda j: {"verdict": "concerns", "review": "pending"},
                                      age=lambda j: 30.0), ("j5", "rho-s4", 30.0))
        check("awaiting-gate: a FAILED job is gated too (the queue fires its gate) -> awaiting",
              slice_job_awaiting_gate(_ast, "s4", statuses=({}, {"auto-author-rho-s4": ("j6", "failed")}),
                                      gate=lambda j: None, age=lambda j: 30.0), ("j6", "auto-author-rho-s4", 30.0))
        _hit = ("j7", "rho-s4", 4.0)
        check("failed-hold: a FAILED coding job whose gate is still deciding -> hold (no FAILED yet)",
              failed_job_gate_hold(_ast, "s4", "failed", awaiting=lambda st, sid: _hit), _hit)
        check("failed-hold: done_unconverged is gated too -> hold",
              failed_job_gate_hold(_ast, "s4", "done_unconverged", awaiting=lambda st, sid: _hit), _hit)
        check("failed-hold: a cancelled job fires no gate -> never hold",
              failed_job_gate_hold(_ast, "s4", "cancelled", awaiting=lambda st, sid: _hit), None)
        _fst = {"label": "rho", "order": ["s4"],
                "slices": {"s4": {"status": ENQUEUED, "job_id": "j8", "depends_on": []}}}
        _none = lambda st, sid: None
        check("failed-hold: gate fully decided (auto_fix_action recorded) -> no hold",
              failed_job_gate_hold(_fst, "s4", "failed", awaiting=_none,
                                   gate=lambda j: {"verdict": "fail", "review": "done",
                                                   "auto_fix_action": "none"},
                                   age=lambda j: 5.0), None)
        check("failed-hold: review merged (verdict=fail) but NO auto-fix decision yet -> hold",
              failed_job_gate_hold(_fst, "s4", "failed", awaiting=_none,
                                   gate=lambda j: {"verdict": "fail", "review": "done"},
                                   age=lambda j: 5.0), ("j8", "auto-fix decision pending", 5.0))
        check("failed-hold: requeue DECIDED (live) but its enqueue not recorded yet -> hold",
              failed_job_gate_hold(_fst, "s4", "failed", awaiting=_none,
                                   gate=lambda j: {"verdict": "fail", "review": "done",
                                                   "auto_fix_action": "requeue",
                                                   "auto_fix_mode": "live"},
                                   age=lambda j: 5.0),
              ("j8", "auto-fix requeue decided, not yet enqueued", 5.0))
        check("failed-hold: requeue enqueued (status recorded) -> no hold (the successor speaks)",
              failed_job_gate_hold(_fst, "s4", "failed", awaiting=_none,
                                   gate=lambda j: {"verdict": "fail", "review": "done",
                                                   "auto_fix_action": "requeue", "auto_fix_mode": "live",
                                                   "auto_fix_enqueue_status": "requeued"},
                                   age=lambda j: 5.0), None)
        check("failed-hold: SHADOW mode requeue (nothing will be enqueued) -> no hold",
              failed_job_gate_hold(_fst, "s4", "failed", awaiting=_none,
                                   gate=lambda j: {"verdict": "fail", "review": "done",
                                                   "auto_fix_action": "requeue",
                                                   "auto_fix_mode": "shadow"},
                                   age=lambda j: 5.0), None)
        check("failed-hold: escalate decided (live), park not recorded yet -> hold",
              bool(failed_job_gate_hold(_fst, "s4", "failed", awaiting=_none,
                                        gate=lambda j: {"verdict": "fail", "review": "done",
                                                        "auto_fix_action": "escalate",
                                                        "auto_fix_mode": "live"},
                                        age=lambda j: 5.0)), True)
        check("failed-hold: ...but past the lost-event grace -> no hold (a dead gate cannot pin it)",
              failed_job_gate_hold(_fst, "s4", "failed", awaiting=_none,
                                   gate=lambda j: {"verdict": "fail", "review": "done"},
                                   age=lambda j: LOST_EVENT_GRACE_S + 1.0), None)
        check("awaiting-gate: past LOST_EVENT_GRACE_S -> not awaiting (a gate that never reports cannot pin the slice)",
              slice_job_awaiting_gate(_ast, "s4", statuses=({}, {"rho-s4": ("j5", "done")}),
                                      gate=lambda j: None, age=lambda j: LOST_EVENT_GRACE_S + 1.0), None)
        check("awaiting-gate: no done.json to time from (no gate was fired) -> not awaiting",
              slice_job_awaiting_gate(_ast, "s4", statuses=({}, {"rho-s4": ("j5", "done")}),
                                      gate=lambda j: None, age=lambda j: None), None)
        check("awaiting-gate: a RUNNING job is slice_job_inflight's business, not this guard's",
              slice_job_awaiting_gate(_ast, "s4", statuses=({}, {"rho-s4": ("j5", "running")}),
                                      gate=lambda j: None, age=lambda j: 1.0), None)
        check("awaiting-gate: a job id on the slice RECORD counts even after the queue pruned its row",
              slice_job_awaiting_gate({"label": "rho", "order": ["s4"],
                                       "slices": {"s4": {"status": FAILED, "author_job_id": "j7"}}},
                                      "s4", statuses=({}, {}), gate=lambda j: None, age=lambda j: 40.0),
              ("j7", "author_job_id on record", 40.0))
        check("awaiting-gate: the reader raising -> None, never raises",
              slice_job_awaiting_gate(_ast, "s4", statuses=({}, {"rho-s4": ("j5", "done")}),
                                      gate=lambda j: 1 / 0, age=lambda j: 1 / 0), None)
        # The guard is wired where the destruction happens, and BEFORE the failure is
        # recorded (a pending verdict must not inflate the retry-storm streak).
        _bs = inspect.getsource(bound_stale_worktree_retry)
        check("bound_stale_worktree_retry consults the awaiting-gate guard BEFORE note_author_failure/remove_worktree",
              0 < _bs.find("slice_job_awaiting_gate(") < _bs.find("note_author_failure(") < _bs.find("remove_worktree("),
              True)
        _ex = inspect.getsource(execute)
        check("execute()'s FAILED branch consults the awaiting-gate guard before auto-land/auto-retry",
              0 < _ex.find("slice_job_awaiting_gate(") < _ex.find("FAILED with no live job -- auto-retrying"),
              True)
        # REVERT TEST on the choke point: with a job awaiting its gate, the retry guard
        # refuses, records nothing, and removes nothing.
        _saved_ag = globals()["slice_job_awaiting_gate"]
        _saved_rm = globals()["remove_worktree"]
        _saved_naf = globals()["note_author_failure"]
        _calls = []
        globals()["slice_job_awaiting_gate"] = lambda st_, sid_: ("j3", "auto-refine-rho-s4-r3", 13.0)
        globals()["remove_worktree"] = lambda cwt_, wt_: _calls.append("rm")
        globals()["note_author_failure"] = lambda s_, wt_: (_calls.append("naf"), (1, "x"))[1]
        try:
            _r = bound_stale_worktree_retry(_ast, "s4", _ast["slices"]["s4"],
                                            "/nonexistent/wt", "/nonexistent/cwt", "self-test")
        finally:
            globals()["slice_job_awaiting_gate"] = _saved_ag
            globals()["remove_worktree"] = _saved_rm
            globals()["note_author_failure"] = _saved_naf
        check("awaiting-gate guard: bound_stale_worktree_retry refuses (False) while a verdict is pending",
              _r, False)
        check("awaiting-gate guard: ...and neither records a failure nor touches the worktree",
              _calls, [])
    finally:
        shutil.rmtree(STATE_ROOT, ignore_errors=True)
        STATE_ROOT = _saved

    print("SELF_TEST_OK" if ok else "SELF_TEST_FAILED")
    return ok


def main():
    if "--self-test" in sys.argv[1:]:
        # HERMETIC (2026-10-06): the self-test's fixtures (bound_stale_worktree_retry ->
        # author_budget_block -> queue_rows) shelled out to the REAL
        # `ollama-queue.py status`, so results depended on live queue state and any
        # write path reached would hit the live daemon. An empty script answers "no rows".
        global QUEUE
        QUEUE = os.devnull
        sys.exit(0 if _self_test() else 1)
    ap = argparse.ArgumentParser(
        description="Slice a single-file omnibus into per-property gated, chained sub-dispatches.")
    ap.add_argument("plan", nargs="?", default=None,
                    help="JSON slice plan (required for everything except --sweep)")
    ap.add_argument("--execute", action="store_true",
                    help="advance the chain to the next checkpoint (resumable)")
    ap.add_argument("--sweep", action="store_true",
                    help="no plan needed: fire ONE detached advance for every plan with a "
                         "stranded completion event (an .advance.requested marker whose "
                         "lock holder died, or an ENQUEUED slice whose job finished "
                         f">{LOST_EVENT_GRACE_S // 60} min ago) or with due work and "
                         "nothing in flight (a PENDING/CONFIRMED next slice, no job, idle "
                         f">{LOST_EVENT_GRACE_S // 60} min) and no live driver. A plan "
                         "stopped on ESCALATED is never kicked. dispatch-ack-reconcile "
                         "runs this from launchd every 5 min.")
    ap.add_argument("--no-advance", action="store_true",
                    help="with an operator lever (--skip/--retry/--reland/--accept/"
                         "--complete/--confirm-slice): change the run state but do NOT "
                         "fire the detached advance that normally follows")
    ap.add_argument("--integrate", action="store_true",
                    help="STAGE the whole-chain integration for a CONVERGED plan (every "
                         "slice done/skipped): classify the chain against the repo's local "
                         "default branch, stage its code-only diff on a scratch integrate/* "
                         "branch and record `integration` on the run state. Writes NO "
                         "default branch, pushes nothing. Runs automatically at "
                         "convergence; use this to re-run after fixing a failed record.")
    ap.add_argument("--land-integration", action="store_true",
                    help="LAND a STAGED integration: fast-forward the repo's default branch "
                         "to the staged commit and push. Refuses unless the record is "
                         "'staged' and the chain tip has not moved since. This is the one "
                         "step that writes main, so it is an explicit operator act.")
    ap.add_argument("--confirm-slice", metavar="ID",
                    help="mark a slice's cases relevance-reviewed (after you read them)")
    ap.add_argument("--status", action="store_true", help="show slice states and exit")
    ap.add_argument("--accept-behavior-gap", action="store_true",
                    help="start a FRESH --execute even though behavioral clauses of the "
                         "plan's top-level intent reach no slice (human override)")
    ap.add_argument("--cancel", action="store_true",
                    help="HUMAN cancel of the whole plan: writes <plan>.cancelled, which "
                         "every automated actor (this slicer's levers/advance/sweep, "
                         "dispatch-self-heal, the escalation watcher, the queue) treats as "
                         "terminal. Pair with --reason. Undo with --uncancel")
    ap.add_argument("--uncancel", action="store_true",
                    help="lift a --cancel (or a queue cancel of one of this plan's jobs) "
                         "and advance the plan again")
    ap.add_argument("--harvest", action="store_true",
                    help="land every ENQUEUED slice whose coding job is done with a "
                         "landable gate verdict, right now, without waiting for the "
                         "serial --execute walk to reach it (the operator form of the "
                         "harvest pre-pass every --execute runs first). Live verify.sh + "
                         "relevance guard + stale-seed rebase apply exactly as in "
                         "--execute; nothing is authored or enqueued.")
    ap.add_argument("--reconcile", action="store_true",
                    help="match persisted slice state to the actual queue "
                         "(by job-id, then by the <label>-<sid> enqueue label) so a "
                         "desync self-heals -- no hand-editing the run-state JSON")
    ap.add_argument("--reset", action="store_true", help="delete the run state and start over")
    ap.add_argument("--author-job-budget", type=int, metavar="N", default=None,
                    help="per-RUN override of the author/refine queue-job budget per "
                         "slice (default %d): a slice that has burned N auto-author/"
                         "auto-refine jobs since its last --retry-slice ESCALATES "
                         "instead of re-authoring again" % MAX_AUTHOR_JOBS)
    ap.add_argument("--retry-slice", metavar="ID",
                    help="reset a FAILED/BLOCKED slice to pending and clear its "
                         "worktree so --execute re-authors it from a clean baseline")
    ap.add_argument("--hand-lock", metavar="ID",
                    help="create the hand-lock (%s) in slice ID's worktree: no automatic "
                         "retry/clear/re-author touches it until --regate or --retry-slice "
                         "(or the file is removed)" % ".hand-harness")
    ap.add_argument("--regate", metavar="ID",
                    help="re-run the mechanical relevance gate + enqueue on an "
                         "ESCALATED or FAILED slice whose harness was fixed IN PLACE. Unlike "
                         "--retry-slice it does NOT delete the worktree or re-author, "
                         "and it does NOT bypass the gate -- preflight still decides "
                         "GO/NO-GO, so a non-GO tree re-ESCALATES. The missing "
                         "escalated->confirmed transition.")
    ap.add_argument("--accept-slice", metavar="ID",
                    help="land a converged ESCALATED slice whose coding job already "
                         "ran and whose escalation was a reviewer false positive "
                         "(confirmed by a human/Opus read against TASK.md), NOT a "
                         "preflight NO-GO. Re-runs verify.sh (must say VERIFY_OK) then "
                         "stages+commits the deliverable and stamps DONE. Unlike "
                         "--regate (assumes a clean baseline, NO-GOs forever on a "
                         "converged tree) or --retry-slice (deletes the worktree, "
                         "discarding the correct fix), this is the missing "
                         "escalated->done transition for a needs_opus escalation.")
    ap.add_argument("--complete-slice", metavar="ID",
                    help="LAND a green-but-unconverged slice directly (the manual "
                         "step-in lever). Like --accept-slice it re-runs verify.sh "
                         "(must say VERIFY_OK) then stages+commits the deliverable and "
                         "stamps DONE -- but does NOT require ESCALATED: it accepts a "
                         "FAILED/ESCALATED/BLOCKED slice whose verify is green at HEAD "
                         "(the dirty-launch-baseline false-fail that parks correct code "
                         "as failed). verify.sh green is mandatory; an unconfirmed-draft "
                         "marker is warned, not refused (the operator is the reviewer).")
    ap.add_argument("--skip-slice", metavar="ID",
                    help="retire a slice whose property is ALREADY SATISFIED at the "
                         "chain tip, so there is nothing for it to land. Requires "
                         "--reason. Such a slice is unsatisfiable by construction "
                         "(the both-ways proof needs verify.sh RED at baseline, and an "
                         "honest fixture for an already-true property is GREEN), so "
                         "--retry-slice would spin on it forever. Dependents may "
                         "proceed: the property they wait on does hold. Also unlocks "
                         "auto-skip for the REST of this plan's green-at-baseline "
                         "slices.")
    ap.add_argument("--reland-slice", metavar="ID",
                    help="re-open a DONE/SKIPPED slice whose work is NO LONGER at the "
                         "chain tip -- e.g. a later slice rewrote the same function and "
                         "silently dropped this slice's property while the row still "
                         "read done. Requires --reason. The inverse of --skip-slice: "
                         "that one asserts the property already holds, this one records "
                         "that it stopped holding. Keeps the worktree (the landed work "
                         "is evidence) and re-authors on the next --execute.")
    ap.add_argument("--review-notes", default=None, metavar="FILE",
                    help="with --retry-slice: attach this review's findings to the "
                         "slice; they are appended to the authoring intent")
    ap.add_argument("--reason", default=None,
                    help="required with --skip-slice: how you established the property "
                         "already holds (what you ran, what it returned). Also required "
                         "with --reland-slice: what showed the landed work is gone from "
                         "the chain tip")
    ap.add_argument("--author", choices=["auto", "manual"], default="auto",
                    help="auto: ollama-dispatch-auto authors each harness; "
                         "manual: scaffold only, you+draft author it")
    ap.add_argument("--manual-review", action="store_true",
                    help="restore the human relevance-review PARK after each slice is "
                         "authored (default: no human gate -- auto-confirm into the "
                         "mechanical preflight gate, which enqueues or ESCALATES to the "
                         "Claude gate). Manual author mode always parks regardless.")
    ap.add_argument("--model", default="qwen3.6-35b-a3b-vl-mtp-mxfp8")
    ap.add_argument("--host", default="studio")
    ap.add_argument("--max-iters", type=int, default=20)
    ap.add_argument("--num-ctx", type=int, default=32768,
                    help="explicit start context window for each code dispatch "
                         "(default 32768; avoids the 16384-bucket pause-resume choke "
                         "against big single-file targets)")
    ap.add_argument("--chat-timeout", type=int, default=1200)
    ap.add_argument("--advance-detached", action="store_true",
                    help="AUTO-FEED entry point (called by the job-completion hook): "
                         "re-enter --execute in a detached process under the per-plan "
                         "lock, so the chain advances itself with no live session")
    ap.add_argument("--release-lock-for", metavar="LABEL",
                    help="[internal] release this plan's advance lock when this "
                         "--execute finishes (set by --advance-detached)")
    ap.add_argument("--publish-dag", action="store_true",
                    help="publish every remaining slice into the queue as a "
                         "dependency-gated PLANNED row and exit")
    ap.add_argument("--lane", choices=("open", "fixed", "auto"), default=None,
                    help="coding-job lane (default open; persisted in the run state): passed to "
                         "ollama-dispatch-auto as --lane and to the slice coding enqueue as the "
                         "worker's --mode, ONLY when `ollama-queue.py enqueue` accepts --mode.")
    ap.add_argument("--no-dag", action="store_true",
                    help="do NOT publish planned rows on --execute (the old "
                         "one-job-at-a-time view)")
    a = ap.parse_args()

    if a.sweep:
        sweep_stranded_advances()
        return
    if not a.plan:
        ap.error("plan is required (only --sweep runs without one)")

    try:
        a.plan = resolve_plan_arg(a.plan)
    except FileNotFoundError as e:
        die(str(e))
    plan = load_plan(a.plan)
    if a.reset:
        p = state_path(plan.get("label", "sliced"))
        if os.path.exists(p):
            os.remove(p)
            print(f"removed state {p}")
        else:
            print("no state to remove")
        return
    if a.execute and not a.accept_behavior_gap and \
            not os.path.exists(state_path(plan.get("label", "sliced"))):
        gap = plan_behavior_gap(plan)
        if gap:
            die(f"refusing to START {plan.get('label')}: {gap} Regenerate the plan "
                f"(omnibus_slice / ollama-dispatch-plan now carry the behavior), or "
                f"pass --accept-behavior-gap to override.", code=3)
    st = load_state(plan, plan_path=a.plan)
    if getattr(a, "lane", None):
        st["lane"] = a.lane
        try:
            save_state(st)
        except Exception:
            pass

    # HUMAN CANCEL IS TERMINAL (2026-09-27, see plan_cancel.py). Checked before
    # EVERY lever and before --advance-detached (the completion hook's entry and
    # dispatch-self-heal's --retry-slice/--regate): a cancelled plan is never
    # re-armed by automation, only by a human --uncancel.
    if a.cancel:
        import plan_cancel
        p_ = plan_cancel.mark_cancelled(st["label"], a.reason or "", by="ollama-dispatch-slice --cancel")
        print(f"# {st['label']}: CANCELLED ({p_}). No automated actor will advance, retry "
              f"or re-gate it. Undo: --uncancel.")
        retire_cancelled_handoff_rows(st)
        return
    if a.uncancel:
        import plan_cancel
        rec = plan_cancel.cancelled(st["label"])
        if rec and rec.get("label") not in (None, st["label"]):
            die(f"{st['label']} is covered by its PARENT plan's cancel "
                f"({rec.get('label')}) -- uncancel that plan instead")
        plan_cancel.clear_cancelled(st["label"])
        print(f"# {st['label']}: cancel lifted -- advancing the plan.")
        if not a.no_advance:
            advance_detached(st, a.plan)
        return
    _canc = _plan_cancelled(st["label"])
    if _canc and not (a.status or a.reset):
        print(f"# {st['label']}: CANCELLED by a human ({_canc.get('at')}, "
              f"{_canc.get('by')}: {_canc.get('reason')}) -- refusing to act. "
              f"Undo with --uncancel.")
        return

    if a.advance_detached:
        sys.exit(advance_detached(st, a.plan))
    if a.publish_dag:
        publish_dag(st)
        return
    # OPERATOR LEVERS RE-ARM THE CHAIN (2026-09-23, Fable pass 2). Each lever below
    # returns True when it actually changed the run state. Until now every one of
    # them ended with "Re-run --execute ..." -- an instruction to a human, not an
    # event -- and the only automatic trigger (the job-completion hook) never fires
    # again for a plan whose last driver exited on ESCALATED. 15 plans on this
    # machine were resolved by a lever after their last advance and never moved
    # again (see the STRANDED-EVENT SWEEP comment). A lever now fires the same
    # detached advance the hook would: it re-reads the state and does whatever is
    # due -- lands, authors the next slice, or prints SLICE RUN COMPLETE and clears
    # the planned rows. If a live driver holds the lock it becomes ONE request
    # marker, exactly like a blocked hook. --no-advance keeps the old behaviour.
    # --regate is not here: it enqueues by itself and the hook drives from there.
    def _rearm(changed, lever):
        if not changed:
            return
        if a.no_advance:
            print(f"# {st['label']}: {lever} changed the run state; --no-advance given, "
                  f"so run --execute (or wait for the sweep) to advance the plan.")
            return
        print(f"# {st['label']}: {lever} changed the run state -- advancing the plan now.")
        advance_detached(st, a.plan)

    if a.integrate:
        warn_if_driver_live(st, "--integrate (stages from the chain worktree)")
        if not plan_converged(st):
            open_ = [i for i in st["order"] if st["slices"][i]["status"] not in SATISFIED]
            die(f"{st['label']} has not converged -- still open: {', '.join(open_) or '(none, '
                f'but nothing is done either)'}. Integration stages only a fully satisfied plan.")
        integrate_chain(st)
        return
    if a.land_integration:
        warn_if_driver_live(st, "--land-integration (writes the repo's default branch)")
        land_integration(st)
        return
    if a.author_job_budget is not None:
        if a.author_job_budget < 1:
            die("--author-job-budget must be >= 1")
        st["author_job_budget"] = int(a.author_job_budget)
        save_state(st)
        print(f"# {st['label']}: author-job budget set to {a.author_job_budget} per slice "
              f"(default {MAX_AUTHOR_JOBS}). Counted from each slice's last --retry-slice.")
        return
    if a.confirm_slice:
        _rearm(confirm_slice(st, a.confirm_slice), "--confirm-slice")
        return
    if a.retry_slice:
        warn_if_driver_live(st, "--retry-slice (deletes the worktree)")
        _notes = None
        if getattr(a, "review_notes", None):
            try:
                _notes = Path(a.review_notes).read_text()
            except OSError as _e:
                die(f"--review-notes: cannot read {a.review_notes}: {_e}")
        _rearm(retry_slice(st, a.retry_slice, _notes), "--retry-slice")
        return
    if a.skip_slice:
        warn_if_driver_live(st, "--skip-slice")
        _rearm(skip_slice(st, a.skip_slice, a.reason), "--skip-slice")
        return
    if a.reland_slice:
        warn_if_driver_live(st, "--reland-slice")
        _rearm(reland_slice(st, a.reland_slice, a.reason), "--reland-slice")
        return
    if a.hand_lock:
        _hs = st["slices"].get(a.hand_lock)
        if _hs is None:
            die(f"unknown slice {a.hand_lock}")
        _hwt = _hs.get("worktree") or slice_worktree(st, a.hand_lock)
        if not os.path.isdir(_hwt):
            die(f"{a.hand_lock}: worktree {_hwt} does not exist")
        Path(_hwt, HAND_LOCK).write_text(
            f"hand-locked {datetime.now(timezone.utc).isoformat(timespec='seconds')}\n")
        _ignore_hand_lock(_hwt)
        print(f"# {a.hand_lock}: HAND-LOCKED ({_hwt}/{HAND_LOCK}).")
        return
    if a.regate:
        warn_if_driver_live(st, "--regate (re-seals + enqueues from the worktree)")
        regate_slice(st, a.regate, a.model, a.host, a.max_iters, a.chat_timeout,
                     a.author, a.num_ctx)
        return
    if a.accept_slice:
        warn_if_driver_live(st, "--accept-slice (commits from the worktree)")
        _rearm(accept_slice(st, a.accept_slice), "--accept-slice")
        return
    if a.complete_slice:
        warn_if_driver_live(st, "--complete-slice (commits from the worktree)")
        _rearm(complete_slice(st, a.complete_slice), "--complete-slice")
        return
    if a.harvest:
        warn_if_driver_live(st, "--harvest (commits from slice worktrees)")
        _landed = harvest_ready_slices(st, ensure_chain_worktree(st))
        if not _landed:
            print(f"# {st['label']}: nothing to harvest (no ENQUEUED slice with a "
                  f"queue-done, gate-landable coding job).")
        _rearm(bool(_landed), "--harvest")
        return
    if a.reconcile:
        reconcile(st)
        return
    if a.status:
        show_status(st)
        return
    if not a.execute:
        dry_run(st)
        return

    # ONE DRIVER PER PLAN (2026-09-23). Before this, only --advance-detached took
    # the per-plan lock; a manual/foreground --execute never did. So while an
    # operator's --execute sat blocked inside AUTO's author+refine ladder, every
    # completion hook for that plan started a detached --execute alongside it.
    # Both drivers then acted on the SAME slice worktree: the detached one took the
    # "harness already authored -- resuming" path (clean_and_seal + preflight +
    # enqueue the CODING job) while the resident AUTO, after its refine job came
    # back, ran its own preflight against a tree the other driver had just changed
    # and enqueued the NEXT refine round. Confirmed five times on 2026-09-23
    # (arr-webhook-yearly-upgrade-batches s1 [46a677172fd4], s6, s7, s8;
    # aw-sched-runner s19). Every --execute now holds the lock for its whole run; a
    # second driver leaves a request marker and exits, and the holder fires one
    # fresh advance on exit so no completion event is lost.
    label = st["label"]
    own_lock = bool(a.release_lock_for)     # the detached child already owns it
    if not own_lock:
        if acquire_advance_lock(label) is None:
            owner = read_lock_owner(label) or {}
            request_advance(label)
            print(f"# {label}: another --execute is already driving this plan "
                  f"(pid {owner.get('pid')}, since {owner.get('started_at')}) -- NOT "
                  f"starting a second driver on the same worktrees. Queued ONE "
                  f"follow-up advance for when it exits. To take over instead: "
                  f"`kill {owner.get('pid')}` then re-run --execute.")
            sys.exit(EXIT_DRIVER_LIVE)
        own_lock = True
    # DIE GRACEFULLY (2026-09-23, Fable pass 2). The `finally` below is the whole
    # re-arm contract -- release the lock, consume the request marker, fire the
    # coalesced advance -- and Python does NOT run it on SIGTERM/SIGHUP: the default
    # action kills the interpreter outright. That is exactly how a foreground
    # --execute blocked inside AUTO dies when a Bash tool call times out or its
    # terminal closes, and it is how arr-webhook-yearly-upgrade-batches lost two
    # completion events on 2026-09-23 (lock named a dead pid, marker stranded,
    # chain idle until a human ran --execute). Turn both signals into SystemExit so
    # the contract holds however the driver is stopped. SIGKILL cannot be caught;
    # the --sweep covers that case from launchd.
    def _die_gracefully(signum, _frame):
        raise SystemExit(128 + signum)
    for _sig in (signal.SIGTERM, signal.SIGHUP):
        try:
            signal.signal(_sig, _die_gracefully)
        except (ValueError, OSError):
            pass
    try:
        execute(st, a.model, a.host, a.max_iters, a.chat_timeout, a.author, a.num_ctx,
                auto_confirm=not a.manual_review, publish_dag_first=not a.no_dag)
    finally:
        # Whoever holds the lock MUST drop it however it ends, or the chain jams
        # until the staleness reclaim.
        if own_lock:
            release_advance_lock(label)
        # Coalesced re-trigger: events that arrived while we held the lock become
        # exactly one fresh detached advance (which re-reads the state).
        if consume_requested_advance(label):
            print(f"# {label}: an advance was requested while this run held the "
                  f"lock -- firing one fresh detached advance.")
            advance_detached(st, a.plan)


if __name__ == "__main__":
    main()
