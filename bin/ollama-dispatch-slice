        check("the NO-GO verdict line is the fallback when no [FAIL] row parsed",
              preflight_blockers(_PFOut("NO-GO: baseline-fails -- verify PASSES at baseline\n")),
              [("baseline-fails", "verify PASSES at baseline")])
        check("an empty preflight is an (unknown) verdict, never a collision",
              (preflight_blockers(_PFOut("")), preflight_nogo_kind([])), ([], "verdict"))
        _cae = inspect.getsource(confirm_and_enqueue)
        check("every ESCALATED set in confirm_and_enqueue records an escalation_reason",
              _cae.count("= ESCALATED") == _cae.count('s["escalation_reason"] ='), True)
        check("a lone collision leaves the slice CONFIRMED (bounded by CWD_COLLISION_MAX)",
              'preflight_nogo_kind(blockers) == "collision"' in _cae
              and "n <= CWD_COLLISION_MAX" in _cae, True)
        _fired.clear()
        # The real sidecar dir has no j2.done.json, so the age is None: the sweep
        # must ABSTAIN rather than kick on a wait it cannot time.
        check("the sweep abstains when no sidecar can time the lost event",
              sweep_stranded_advances(fire=_rec, statuses={"j2": "done"},
                                      now=time.time() + LOST_EVENT_GRACE_S + 60,
                                      verbose=False), [])

        # --- case 4: DUE work, nothing in flight, no driver, idle past the window
        # (2026-09-24, Fable pass 4 -- "shouldn't the jobs relaunch without us?")
        _fired.clear()
        _T0 = time.time()
        _stale = _T0 - LOST_EVENT_GRACE_S - 60
        _idle = {"label": "gamma", "plan_path": _plan_f, "order": ["s1", "s2"],
