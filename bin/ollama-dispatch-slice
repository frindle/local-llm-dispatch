        Path(_gpath).write_text(json.dumps(_idle))
        os.utime(_gpath, (_stale, _stale))
        _sweep = lambda now=_T0: sweep_stranded_advances(fire=_rec, statuses={}, now=now,
                                                          verbose=False)
        check("first_due_slice: a PENDING slice whose deps are satisfied is due",
