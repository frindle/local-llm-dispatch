#!/usr/bin/env python3
"""ollama-dispatch-draft -- have a local model DRAFT the adversarial cases.

WHERE THIS SITS
---------------
  ollama-dispatch-scaffold   emits everything except the judgment
  ollama-dispatch-draft      drafts the judgment part, and PROVES it mechanically
  ollama-dispatch-preflight  gates it
  <you>                      decide whether it is RELEVANT           <- irreducible

WHAT THE GATE CAN AND CANNOT DO -- read this before trusting the pipeline
------------------------------------------------------------------------
The gate mechanically catches a verify that does not discriminate
(`baseline-fails`, `verify-quality`), a task that is unsatisfiable
(`refimpl-passes`), and a verify that goes green while a "Must contain" literal
is absent (`refimpl-satisfies`).

It does NOT catch a verify that discriminates, asserts every literal, and tests
the WRONG PROPERTY. `refimpl-satisfies` is the decidable slice of relevance, not
relevance. Concretely, a drafted case like

    is_safe({"count": 99}, True) == True

fails at baseline, contains the required literal once the refimpl lands, and
passes the ENTIRE gate -- while testing nothing about the boundary the task is
actually about. Irrelevance is what a weak drafter produces most often.

So this tool does not remove the human. It changes the job from AUTHORING cases
to REVIEWING drafted ones -- much cheaper, same judgment -- and it enforces that
the review happened: drafts carry DRAFT_UNCONFIRMED, the gate FAILs on it, and
only `--confirm` removes it. A pipeline that is green because nobody looked is
the failure this whole toolchain exists to prevent.

THE LOOP IS SEPARABLE FROM THE MODEL, DELIBERATELY
--------------------------------------------------
`--drafter-cmd` injects any command in place of the model, so the retry logic is
provable without a GPU -- the same reason the gate takes `--refimpl-cmd`. A loop
whose only test needs a live model is a loop that gets tested once.

  ollama-dispatch-draft <worktree>                    # dispatch to the default model
  ollama-dispatch-draft <worktree> --rounds 3
  ollama-dispatch-draft <worktree> --drafter-cmd './fake-drafter.sh'   # testing
  ollama-dispatch-draft <worktree> --confirm          # after you have READ them
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

DRAFT_MARK = "DRAFT_UNCONFIRMED = True"
DRAFT_MARK_JS = "const DRAFT_UNCONFIRMED = true"
# Comment line stamped beside either marker; cmd_confirm strips it by exact text.
DRAFT_COMMENT_PY = "# Model-drafted; NOT yet read by a human."
DRAFT_COMMENT_JS = "// Model-drafted; NOT yet read by a human."
GATE = Path.home() / "bin" / "ollama-dispatch-preflight"
QUEUE = Path.home() / "bin" / "ollama-queue.py"
DEFAULT_MODEL = "qwen3.6-35b-a3b-vl-mtp-mxfp8"
DEFAULT_HOST = "studio"
# Blockers the drafter itself is expected to see and must NOT treat as a bad
# draft: the draft is unconfirmed by construction until a human confirms it.
IGNORED_BLOCKERS = {"draft-confirmed"}

# Delimiters wrapping the cases injected into a chk()-style .mts fixture, so a
# re-draft (round 2+) REPLACES the prior injection instead of stacking a second
# copy of the cases (the .py/.mjs path is idempotent because it regex-replaces
# the whole `CASES = [...]` block; the .mts path has no such block to replace).
MTS_BEGIN = "// >>> DRAFTED-CASES (auto-injected) >>>"
MTS_END = "// <<< DRAFTED-CASES <<<"


def _extract_chk_block(text: str):
    """Pull the chk()-case body out of a drafter's stdout for a .mts fixture.

    The .py/.mjs drafter emits a `CASES = [...]` array; the TS-symbol fixture
    has no array -- it is a run of `chk('name', cond)` statements (optionally in
    their own `{ ... }` scopes). Strip an optional code fence and require at
    least one chk() call; return None if the output has no cases to splice.
    """
    t = text.strip()
    t = re.sub(r"^```[A-Za-z0-9_-]*\n", "", t)
    t = re.sub(r"\n```\s*$", "", t).strip()
    if "chk(" not in t:
        return None
    return t


def _extract_test_block(text: str):
    """Pull the test()-block body out of a drafter's stdout for a node-test file.

    The node-test shape (ollama-dispatch-scaffold --ts-runner node-test) is a run
    of `test('name', () => { assert... })` blocks -- NOT a `CASES = [...]` array
    (.py/.mjs) nor a chk() list (.mts). Strip an optional code fence and require
    at least one test() call; return None if there is nothing to splice.
    """
    t = text.strip()
    t = re.sub(r"^```[A-Za-z0-9_-]*\n", "", t)
    t = re.sub(r"\n```\s*$", "", t).strip()
    if "test(" not in t:
        return None
    return t


def is_node_test(fx) -> bool:
    """True for a `node --test` / `tsx --test` fixture: `test('name', () => {...})`
    blocks that import from 'node:test'. This is the node-test shape emitted by
    `ollama-dispatch-scaffold --ts-runner node-test` for multi-file TS fixes.

    Keyed on the `node:test` import, NOT the .ts suffix -- a chk() .mts/.ts symbol
    fixture is also TypeScript but imports no such module, so this cleanly
    separates the two TS shapes wherever the code branches on fixture kind.
    """
    if fx is None:
        return False
    try:
        return "node:test" in fx.read_text(errors="replace")
    except Exception:
        return False


# ---------------------------------------------------------------------------
# NATIVE (non-Python, non-JS/TS) FIXTURE FLAVOURS -- swift / bash / go / rust /
# java / kotlin.
#
# The .py / .mjs / .mts / node-test paths above can all RUN the fixture file
# directly (`python3 fx.py`, `node fx.mjs`, `tsx fx.mts`). A swift/go/rust/java/
# kotlin fixture cannot be: it must be COMPILED, or run through a toolchain
# driver (`swift run CoreTests`, `go test ./pkg/x/`, `cargo test --test
# verify_impl`). Running such a file under python3 is a guaranteed SyntaxError ->
# nonzero exit -> `fixture_discriminates` reads a VACUOUS "fails at baseline"
# and a benign draft sails through -- the exact failure the JS path was fixed for.
#
# So the scaffold records the fixture's own run command in verify.sh as
#     # DISPATCH_FIXTURE_CMD: swift run CoreTests
# and this tool uses THAT, rather than re-deriving each toolchain's invocation
# (which would drift from the verify the gate actually runs). One marker line,
# one source of truth, and a new language needs no change here beyond a row in
# NATIVE_SPEC.
# ---------------------------------------------------------------------------
FIXTURE_CMD_MARK = "# DISPATCH_FIXTURE_CMD:"

# lang -> (case-counting regex, minimum cases, comment prefix). The case regex
# matches the scaffold's per-language case idiom: `chk(...)` / `chk!(...)` /
# `chk "desc"` everywhere except swift, whose fixture predates this and uses a
# `Case(desc:run:)` array.
NATIVE_SPEC = {
    "swift":  (r"\bCase\s*\(", 3, "//"),
    "bash":   (r"^\s*chk\s+\S", 3, "#"),
    "go":     (r"\bchk\s*\(", 3, "//"),
    "rust":   (r"\bchk!\s*\(", 3, "//"),
    "java":   (r"\bchk\s*\(", 3, "//"),
    "kotlin": (r"\bchk\s*\(", 3, "//"),
    # C#: one `chk(...)` / `chkThrows<T>(...)` STATEMENT per line; anchored at
    # line start so the helper's own `static void chk(` and the commented
    # example do not count as cases.
    "csharp": (r"^\s*chk(?:Throws<[^>]*>)?\s*\(", 3, "//"),
}
NATIVE_SUFFIX = {".swift": "swift", ".sh": "bash", ".bash": "bash",
                 ".go": "go", ".rs": "rust", ".java": "java", ".kt": "kotlin",
                 ".cs": "csharp"}
# The scaffold's canonical fixture paths, most specific first.
NATIVE_FIXTURE_GLOBS = (
    "Sources/*Tests/main.swift",   # swift (CLT-only: an executable test target)
    "verify_cases.sh",             # bash
    "verify_impl_test.go",         # go (root package)
    "*/verify_impl_test.go",       # go (target's package dir)
    "*/*/verify_impl_test.go",
    "tests/verify_impl.rs",        # rust
    "VerifyImpl.java",             # java
    "VerifyImpl.kt",               # kotlin
    "DispatchTests/VerifyImpl.cs", # csharp (net8.0 console harness project)
)


def native_lang(fx) -> str | None:
    """The NATIVE_SPEC language of this fixture, or None for the py/js/ts kinds."""
    if fx is None:
        return None
    return NATIVE_SUFFIX.get(fx.suffix)


def native_fixture(wt: Path):
    """The swift/bash/go/rust/java/kotlin fixture in this worktree, or None."""
    for g in NATIVE_FIXTURE_GLOBS:
        for p in sorted(wt.glob(g)):
            if p.is_file() and native_lang(p):
                return p
    return None


def fixture_cmd_from_verify(wt: Path):
    """The `# DISPATCH_FIXTURE_CMD:` line the scaffold wrote into verify.sh.

    This is the command that runs the BEHAVIOURAL fixture alone (not the whole
    verify), in the worktree, and it is what the gate's verify.sh runs too. None
    when absent -- callers then say UNPROVEN rather than guessing a toolchain.
    """
    vs = wt / "verify.sh"
    if not vs.is_file():
        return None
    for line in vs.read_text(errors="replace").splitlines():
        if line.strip().startswith(FIXTURE_CMD_MARK):
            cmd = line.strip()[len(FIXTURE_CMD_MARK):].strip()
            if cmd:
                return cmd
    return None


DRAFT_CHECK_NATIVE = r'''#!/usr/bin/env python3
"""Verify for the DRAFTING job -- %(lang)s fixture (compiled / toolchain-driven).

Inverted on purpose, exactly like draft-check.py for the Python flavour: this
passes when the fixture FAILS on the buggy baseline, because that is what proves
the drafted cases DISCRIMINATE. The RUN COMMAND is baked in from verify.sh's
`# DISPATCH_FIXTURE_CMD:` line, so a case that runs here runs the same way at
the gate -- and a %(lang)s fixture is never run under the wrong interpreter
(which would exit nonzero for a SYNTAX reason and read as a vacuous pass).
"""
import pathlib
import re
import subprocess
import sys

FX = pathlib.Path(%(fx_name)r)
CMD = %(cmd)r
MIN_CASES = %(min_cases)d
CASE_RE = %(case_re)r
fails = 0

if not FX.is_file():
    print(f"  FAIL: {FX} not found -- nothing to draft")
    print("--- 1 failed ---")
    sys.exit(1)

src = FX.read_text(errors="replace")

n = len(re.findall(CASE_RE, src, re.M))
if n < MIN_CASES:
    print(f"  FAIL: {n} case(s), need at least {MIN_CASES}")
    fails += 1
else:
    print(f"  ok: {n} cases authored")

# The scaffold guards the empty case list behind CASES_AUTHORED (false/0), which
# prints SCAFFOLD_INCOMPLETE and exits 1. Left as-is the fixture "fails" for the
# WRONG reason -- it never ran the cases -- so require it flipped, mirroring the
# .mts guard flip and the node-test guard-test deletion.
if re.search(r"CASES_AUTHORED\s*=\s*(false|0)\b", src):
    print("  FAIL: CASES_AUTHORED is still false/0 -- flip it so the cases RUN")
    fails += 1
if "SCAFFOLD_INCOMPLETE" in src and not re.search(r"CASES_AUTHORED", src):
    print("  FAIL: the SCAFFOLD_INCOMPLETE guard is still present -- author real "
          "cases and remove it")
    fails += 1

p = subprocess.run(CMD, shell=True, capture_output=True, text=True)
out = (p.stdout + p.stderr).strip()
# A build/compile error dies BEFORE any case runs: nonzero, but not
# discrimination. The fixture prints `ok - ` / `FAIL - ` (or the swift fixture's
# `case(s) passed` epilogue) once it actually ran, so require that evidence.
ran = re.search(r"^(ok - |FAIL - )|case\(s\) passed|--- \d+ failed ---",
                out, re.M) is not None
if p.returncode == 0:
    print("  FAIL: every case PASSES on the current buggy code, so the cases")
    print("        cannot tell a correct fix from no fix at all. Each case must")
    print("        FAIL now and PASS after the fix. Target the exact boundary.")
    fails += 1
elif not ran:
    print("  FAIL: the fixture did not BUILD/RUN (it never reported a case) --")
    print("        that is a broken fixture, not discrimination:")
    tail = [l for l in out.splitlines() if l.strip()]
    print("    " + (tail[-1] if tail else "")[:300])
    fails += 1
else:
    print(f"  ok: fixture fails on the buggy code (exit {p.returncode}) -- the")
    print("      cases discriminate")

print(f"--- {fails} failed ---")
if fails == 0:
    print("VERIFY_OK")
    sys.exit(0)
sys.exit(1)
'''


DRAFT_CHECK = r'''#!/usr/bin/env python3
"""Verify for the DRAFTING job -- run by the worker after every edit.

Inverted on purpose and it is worth reading twice: this passes when the fixture
FAILS. The tree is at the buggy baseline while drafting, so "the fixture fails"
IS "the cases discriminate". Putting that in the worker's own verify loop means
a benign draft gets corrected by the model itself, before anything reaches a
human -- which is far cheaper than bouncing it at the gate and re-drafting the
whole thing.
"""
import ast
import pathlib
import subprocess
import sys

FX = pathlib.Path("test_fixture.py")
MIN_CASES = 6
fails = 0

src = FX.read_text()
try:
    tree = ast.parse(src)
except SyntaxError as e:
    print(f"  FAIL: {FX} does not parse: {e}")
    print("--- 1 failed ---")
    sys.exit(1)

cases = None
for node in tree.body:
    if isinstance(node, ast.Assign) and any(
            isinstance(t, ast.Name) and t.id == "CASES" for t in node.targets):
        cases = node.value
n = len(cases.elts) if isinstance(cases, ast.List) else 0
if n < MIN_CASES:
    print(f"  FAIL: {n} case(s), need at least {MIN_CASES}")
    fails += 1
else:
    print(f"  ok: {n} cases authored")

p = subprocess.run([sys.executable, str(FX)], capture_output=True, text=True)
out = (p.stdout + p.stderr).strip()
if "Traceback" in out:
    print("  FAIL: the fixture CRASHED rather than reporting failures:")
    print("    " + out.splitlines()[-1][:200])
    fails += 1
elif p.returncode == 0:
    print("  FAIL: every case PASSES on the current buggy code, so the cases")
    print("        cannot tell a correct fix from no fix at all. Each case must")
    print("        FAIL now and PASS after the fix. Target the exact boundary.")
    fails += 1
else:
    print(f"  ok: fixture fails on the buggy code (exit {p.returncode}) -- the")
    print("      cases discriminate")

print(f"--- {fails} failed ---")
if fails == 0:
    print("VERIFY_OK")
    sys.exit(0)
sys.exit(1)
'''

DRAFT_CHECK_JS = r'''#!/usr/bin/env node
// Verify for the DRAFTING job -- run by the worker after every edit (node).
// Inverted on purpose, exactly like draft-check.py: this passes when the
// fixture FAILS. The tree is at the buggy baseline while drafting, so "the
// fixture fails" IS "the cases discriminate".

import { readFileSync } from 'node:fs';
import { spawnSync } from 'node:child_process';

const FX = 'verify_impl.mjs';
const MIN_CASES = 6;
let fails = 0;

let src;
try {
    src = readFileSync(FX, 'utf8');
} catch (e) {
    console.log(`  FAIL: cannot read ${FX}: ${e.message}`);
    console.log('--- 1 failed ---');
    process.exit(1);
}

// Count the top-level elements of CASES = [ ... ] -- commas at bracket depth 0.
function topLevelCount(body) {
    let depth = 0, count = 0;
    for (const ch of body) {
        if (ch === '[' || ch === '{' || ch === '(') depth++;
        else if (ch === ']' || ch === '}' || ch === ')') depth--;
        else if (ch === ',' && depth === 0) count++;
    }
    return body.trim() ? count + 1 : 0;
}

const m = src.match(/^\s*(?:(?:export\s+)?(?:const|let|var)\s+)?CASES\s*=\s*\[([\s\S]*?)\n\]/m);
const n = m ? topLevelCount(m[1]) : 0;
if (n < MIN_CASES) {
    console.log(`  FAIL: ${n} case(s), need at least ${MIN_CASES}`);
    fails++;
} else {
    console.log(`  ok: ${n} cases authored`);
}

const p = spawnSync(process.execPath, [FX], { encoding: 'utf8' });
const out = ((p.stdout || '') + (p.stderr || '')).trim();
if (/SyntaxError|ReferenceError/.test(out)) {
    console.log('  FAIL: the fixture CRASHED rather than reporting failures:');
    const lines = out.split('\n').filter((l) => l.trim());
    console.log('    ' + (lines[lines.length - 1] || '').slice(0, 200));
    fails++;
} else if (p.status === 0) {
    console.log('  FAIL: every case PASSES on the current buggy code, so the cases');
    console.log('        cannot tell a correct fix from no fix at all. Each case must');
    console.log('        FAIL now and PASS after the fix. Target the exact boundary.');
    fails++;
} else {
    console.log(`  ok: fixture fails on the buggy code (exit ${p.status}) -- the`);
    console.log('      cases discriminate');
}

console.log(`--- ${fails} failed ---`);
if (fails === 0) {
    console.log('VERIFY_OK');
    process.exit(0);
}
process.exit(1);
'''

DRAFT_CHECK_TS = r'''#!/usr/bin/env python3
"""Verify for the DRAFTING job -- TypeScript .mts (chk()) symbol fixture.

Inverted on purpose, exactly like draft-check.py / draft-check.mjs: this passes
when the fixture FAILS on the buggy baseline, because that is what proves the
chk() cases DISCRIMINATE. The .mts fixture must run under `tsx` (it type-strips
and resolves the typed `.ts`/extensionless import that bare python3/node cannot),
resolved LOCALLY -- never a networked `npx --yes tsx`, which hangs/fails on the
offline queue host and would read a vacuous "fails at baseline".
"""
import glob
import os
import pathlib
import re
import shutil
import subprocess
import sys

FX = pathlib.Path("verify_impl.mts")
MIN_CASES = 6
fails = 0

if not FX.is_file():
    print(f"  FAIL: {FX} not found -- nothing to draft")
    print("--- 1 failed ---")
    sys.exit(1)

src = FX.read_text(errors="replace")

# Count chk('name', cond) calls -- the .mts analogue of the CASES list length.
n = len(re.findall(r"\bchk\s*\(", src))
if n < MIN_CASES:
    print(f"  FAIL: {n} chk() case(s), need at least {MIN_CASES}")
    fails += 1
else:
    print(f"  ok: {n} chk() cases authored")

# The scaffold guards the cases behind `const CASES_AUTHORED = false;` (prints
# SCAFFOLD_INCOMPLETE and exits 1). If it is still false the fixture "fails" for
# the WRONG reason -- it never ran the cases -- so require it flipped to true.
if re.search(r"const\s+CASES_AUTHORED\s*=\s*false", src):
    print("  FAIL: CASES_AUTHORED is still false -- flip it true so the cases RUN")
    fails += 1


def resolve_tsx():
    for c in ("./node_modules/.bin/tsx",
              str(pathlib.Path.home() / "bin" / "ts-mutator"
                  / "node_modules" / ".bin" / "tsx")):
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return [c]
    onpath = shutil.which("tsx")
    if onpath:
        return [onpath]
    if shutil.which("npx"):
        cache = pathlib.Path.home() / ".npm" / "_npx"
        if glob.glob(str(cache / "*" / "node_modules" / ".bin" / "tsx")):
            return ["npx", "--offline", "tsx"]
    return None


tsx = resolve_tsx()
if tsx is None:
    print("  FAIL: tsx not resolvable locally -- cannot run the .mts fixture "
          "(npm install -D tsx in the repo, or `cd ~/bin/ts-mutator && "
          "npm install` for the gate's vendored copy)")
    print("--- 1 failed ---")
    sys.exit(1)

p = subprocess.run(tsx + [str(FX)], capture_output=True, text=True)
out = (p.stdout + p.stderr).strip()
# A discriminating run REACHES the fixture's own `--- N failed ---` epilogue with
# a nonzero exit. A crash / import error / early guard exit dies BEFORE that line
# -- that is not discrimination, it is a broken fixture, and must FAIL the draft.
ran_cases = re.search(r"---\s*\d+\s*failed\s*---", out) is not None
if p.returncode == 0:
    print("  FAIL: every case PASSES on the current buggy code, so the cases")
    print("        cannot tell a correct fix from no fix at all. Each case must")
    print("        FAIL now and PASS after the fix. Target the exact boundary.")
    fails += 1
elif not ran_cases:
    print("  FAIL: the fixture CRASHED (or exited early) rather than reporting")
    print("        case failures -- it never ran the cases under tsx:")
    tail = [l for l in out.splitlines() if l.strip()]
    print("    " + (tail[-1] if tail else "")[:200])
    fails += 1
else:
    print(f"  ok: fixture fails on the buggy code (exit {p.returncode}) -- the")
    print("      cases discriminate")

print(f"--- {fails} failed ---")
if fails == 0:
    print("VERIFY_OK")
    sys.exit(0)
sys.exit(1)
'''


DRAFT_CHECK_NODETEST = r'''#!/usr/bin/env python3
"""Verify for the DRAFTING job -- node --test / tsx --test fixture.

Inverted on purpose, exactly like draft-check.py / .mjs / the .mts chk() check:
this passes when the fixture FAILS on the buggy baseline, because that is what
proves the drafted test(...) cases DISCRIMINATE. The RUNNER (tsx --test when the
repo's tsconfig declares compilerOptions.paths so `@/` aliases resolve, else
node --experimental-strip-types --test) is baked in by ollama-dispatch-draft to
match the scaffold's verify.sh RUNNER selection exactly -- so a case that runs
here runs the same way at the gate.
"""
import json
import pathlib
import re
import subprocess
import sys

FX = pathlib.Path(%(fx_name)r)
RUNNER = json.loads(%(runner_json)r)
MIN_CASES = 3   # matches the scaffold's node-test `>= 3 tests` discipline
fails = 0

if not FX.is_file():
    print(f"  FAIL: {FX} not found -- nothing to draft")
    print("--- 1 failed ---")
    sys.exit(1)

src = FX.read_text(errors="replace")

# Count test('name', ...) blocks -- the node-test analogue of the CASES length.
n = len(re.findall(r"\btest\s*\(", src))
if n < MIN_CASES:
    print(f"  FAIL: {n} test() case(s), need at least {MIN_CASES}")
    fails += 1
else:
    print(f"  ok: {n} test() cases authored")

# The scaffold ships a single guard test that assert.fail()s with the marker
# SCAFFOLD_INCOMPLETE. If it is still there the suite "fails" for the WRONG
# reason (that guard, not the drafted cases) AND it can never go green under the
# fix -- so require it deleted, mirroring the .mts CASES_AUTHORED guard flip.
if "SCAFFOLD_INCOMPLETE" in src:
    print("  FAIL: the SCAFFOLD guard test is still present -- delete it and "
          "author real cases")
    fails += 1

p = subprocess.run(RUNNER + [FX.name], capture_output=True, text=True)
out = (p.stdout + p.stderr).strip()
# A discriminating run REACHES the runner's `# tests N` (TAP) / `ℹ tests N`
# summary with a nonzero exit. A crash / import error that dies BEFORE running
# the cases is a broken fixture, not discrimination, and must FAIL the draft.
ran = re.search(r"^(# |ℹ )tests \d+", out, re.M) is not None
if p.returncode == 0:
    print("  FAIL: every case PASSES on the current buggy code, so the cases")
    print("        cannot tell a correct fix from no fix at all. Each case must")
    print("        FAIL now and PASS after the fix. Target the exact boundary.")
    fails += 1
elif not ran:
    print("  FAIL: the fixture CRASHED (or ran no tests) rather than reporting")
    print("        case failures -- it never ran the cases under the test runner:")
    tail = [l for l in out.splitlines() if l.strip()]
    print("    " + (tail[-1] if tail else "")[:200])
    fails += 1
else:
    print(f"  ok: fixture fails on the buggy code (exit {p.returncode}) -- the")
    print("      cases discriminate")

print(f"--- {fails} failed ---")
if fails == 0:
    print("VERIFY_OK")
    sys.exit(0)
sys.exit(1)
'''


def sh(cmd, cwd=None, timeout=None, sandbox=False):
    # sandbox=True for a run of CODE UNDER TEST (a fixture): VERIFY-SANDBOX, so
    # ollama-queue.py refuses to enqueue real jobs from it. sh() itself also
    # enqueues the draft job, so the marker is opt-in per call, never global.
    env = {**os.environ, "DISPATCH_VERIFY_SANDBOX": "1"} if sandbox else None
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                       shell=isinstance(cmd, str), timeout=timeout, env=env)
    return p.returncode, p.stdout, p.stderr


# The gate's OWN vendored tsx (bin/ts-mutator, `npm install -D tsx`). The gate
# already trusts and installs bin/ts-mutator for the TS AST mutator; tsx rides
# the same install so a fresh checkout re-obtains it with `npm ci`.
TSX_VENDOR = Path.home() / "bin" / "ts-mutator" / "node_modules" / ".bin" / "tsx"


def resolve_tsx(wt: Path):
    """Resolve a runnable `tsx` command WITHOUT a silent network fetch.

    Returns (cmd_prefix_list, source) when tsx is resolvable, else (None, why).
    The old code fell straight to `npx --yes tsx`, which needs the network and
    HANGS/FAILS on the offline queue host -- a check that cannot succeed there,
    dressed up as a fallback. Resolution order, all local:
      1. worktree node_modules/.bin/tsx  (the repo's own dev dep)
      2. the gate's vendored bin/ts-mutator/node_modules/.bin/tsx
      3. a `tsx` already on PATH
      4. `npx --offline tsx` ONLY when a cached tsx makes an offline run
         plausible (`--offline` forbids any fetch, so it fails fast instead of
         hanging); never a bare networked `npx --yes tsx`.
    When none resolve, return None + an honest cause so the caller says UNPROVEN
    rather than vacuously passing or reaching for a network that isn't there.
    """
    if wt is not None:
        local = wt / "node_modules" / ".bin" / "tsx"
        if local.exists():
            return [str(local)], "worktree node_modules/.bin/tsx"
    if TSX_VENDOR.exists():
        return [str(TSX_VENDOR)], "gate vendored bin/ts-mutator/node_modules/.bin/tsx"
    onpath = shutil.which("tsx")
    if onpath:
        return [onpath], "tsx on PATH"
    if shutil.which("npx"):
        import glob as _glob
        cache = Path.home() / ".npm" / "_npx"
        if _glob.glob(str(cache / "*" / "node_modules" / ".bin" / "tsx")):
            return ["npx", "--offline", "tsx"], "npx --offline tsx (cached)"
    return None, ("tsx not resolvable locally and no network -- install tsx "
                  "(npm install -D tsx in the repo, or `cd ~/bin/ts-mutator && "
                  "npm install` for the gate's vendored copy)")


def _test_files_from_verify(wt: Path):
    """The node-test fixture(s) the scaffold named in verify.sh's `TEST_FILES=`.

    ollama-dispatch-scaffold --ts-runner node-test writes the in-scope test
    file(s) into verify.sh as `TEST_FILES="verify.test.ts ..."` (also recorded in
    .dispatch-harness.json's authored list). verify.sh is the authoritative
    declaration of what the fix must make pass, so it wins over a bare glob.
    """
    vs = wt / "verify.sh"
    if not vs.is_file():
        return []
    m = re.search(r'^\s*TEST_FILES="([^"]*)"', vs.read_text(errors="replace"),
                  re.M)
    if not m:
        return []
    return [wt / f for f in m.group(1).split() if f]


def _tsconfig_has_paths(wt: Path) -> bool:
    """Does the repo's tsconfig declare compilerOptions.paths? Mirrors verify.sh's
    RUNNER selection so the pre-gate checks pick the SAME runner the gate will.

    Tolerant of JSONC (the `// comments` + trailing commas `tsc --init` emits)
    and follows one level of a relative/absolute `extends`. On any doubt returns
    False, which selects the plain `node --test` runner -- the safe default.
    """
    def _load(path: Path):
        try:
            raw = path.read_text(errors="replace")
        except Exception:
            return None
        # strip // and /* */ comments (outside strings) + trailing commas
        out, i, N, q = [], 0, len(raw), ""
        while i < N:
            c, d = raw[i], raw[i + 1] if i + 1 < N else ""
            if q:
                out.append(c)
                if c == "\\":
                    out.append(d)
                    i += 2
                    continue
                if c == q:
                    q = ""
                i += 1
                continue
            if c in "\"'":
                q = c
                out.append(c)
                i += 1
                continue
            if c == "/" and d == "/":
                i += 2
                while i < N and raw[i] != "\n":
                    i += 1
                continue
            if c == "/" and d == "*":
                i += 2
                while i < N and not (raw[i] == "*" and i + 1 < N
                                     and raw[i + 1] == "/"):
                    i += 1
                i += 2
                continue
            out.append(c)
            i += 1
        cleaned = re.sub(r",\s*([}\]])", r"\1", "".join(out))
        try:
            return json.loads(cleaned)
        except Exception:
            return None

    def _hp(path: Path, depth: int) -> bool:
        if path is None or depth > 5 or not path.is_file():
            return False
        cfg = _load(path)
        if not isinstance(cfg, dict):
            return False
        co = cfg.get("compilerOptions") or {}
        if isinstance(co.get("paths"), dict) and co["paths"]:
            return True
        ext = cfg.get("extends")
        if isinstance(ext, str) and (ext.startswith(".") or os.path.isabs(ext)):
            base = (path.parent / ext).resolve()
            if not str(base).endswith(".json"):
                base = base.with_name(base.name + ".json")
            return _hp(base, depth + 1)
        return False

    return _hp(wt / "tsconfig.json", 0)


def node_test_runner(wt: Path, fx: Path):
    """The runner command for a node-test fixture, matching the scaffold's
    verify.sh: `tsx --test` when tsconfig declares compilerOptions.paths (so `@/`
    aliases resolve), else `node --experimental-strip-types --test`. Both force
    `--test-reporter=tap` so the `# tests N` summary line is deterministic.

    Returns (cmd_list_without_the_file, why). cmd is None only when tsx is needed
    but genuinely unresolvable (no network fallback -- resolve_tsx is honest).
    """
    if _tsconfig_has_paths(wt):
        tsx_cmd, src = resolve_tsx(wt)
        if tsx_cmd is None:
            return None, src
        # --experimental-test-module-mocks: same as the scaffold's RUNNER (2026-09-22).
        # The author prompt tells the model to use mock.module(), which node --test
        # rejects without the flag, so a drafted fixture "CRASHED ... never ran the
        # cases" here while the very same file passed under verify.sh.
        return (tsx_cmd + ["--test", "--test-reporter=tap", "--experimental-test-module-mocks"],
                f"tsx --test ({src}; tsconfig paths -> @/ resolves)")
    node = shutil.which("node")
    if not node:
        return None, "node is not on PATH -- cannot run the node-test fixture"
    return ([node, "--experimental-strip-types", "--test",
             "--test-reporter=tap", "--experimental-test-module-mocks"],
            "node --experimental-strip-types --test (no path aliases)")


def ensure_node_env(wt: Path):
    """Best-effort: generate the Prisma client a node-test fixture's target may
    import (`@/app/generated/prisma/...`). Returns (ok_or_None, why).

    The fixture imports the real target, which for a Next.js/Prisma repo pulls in
    the generated client at module load. Without it EVERY run dies with a module-
    not-found BEFORE the cases run, so the discrimination pre-check reads a
    vacuous "fails at baseline" for a benign draft. verify.sh regenerates anyway;
    doing it once up front makes the pre-gate checks meaningful. Never fatal, and
    a no-op when there is no prisma generator. The generated output is gitignored,
    so it never dirties the launch baseline.
    """
    schema = wt / "prisma" / "schema.prisma"
    if not schema.is_file():
        sdir = wt / "prisma" / "schema"
        cands = sorted(sdir.glob("*.prisma")) if sdir.is_dir() else []
        schema = cands[0] if cands else None
    if schema is None or "generator" not in schema.read_text(errors="replace"):
        return None, "no prisma generator -- nothing to bootstrap"
    if shutil.which("npx") is None:
        return None, "npx not on PATH -- cannot prisma generate"
    rc, out, err = sh(["npx", "--yes", "prisma", "generate"], cwd=wt,
                      timeout=300)
    if rc == 0:
        return True, "prisma client generated (node-test env bootstrap)"
    return None, ("prisma generate failed (continuing; verify.sh retries): "
                  + (err or out).strip()[-150:])


def fixture_of(wt: Path):
    # node --test / tsx --test fixture (multi-file TS fix). Most specific, so it
    # is resolved FIRST: named authoritatively by verify.sh's TEST_FILES, then a
    # `*.test.*` glob. Keyed on the node:test import (is_node_test), so it never
    # collides with the chk() .mts symbol shape or the CASES array shapes below.
    for p in _test_files_from_verify(wt):
        if p.is_file() and is_node_test(p):
            return p
    for p in (sorted(wt.glob("*.test.ts")) + sorted(wt.glob("*.test.mts"))
              + sorted(wt.glob("*.test.js"))):
        if is_node_test(p):
            return p
    # Native (compiled / toolchain-driven) fixtures: swift, bash, go, rust,
    # java, kotlin. Resolved BEFORE the *.py / *.mjs globs so a bash or swift
    # worktree can never have check_literals.py (or any other harness .py)
    # mistaken for its fixture -- these names are the scaffold's own and unique.
    nat = native_fixture(wt)
    if nat is not None:
        return nat
    for name in ("test_fixture.py",):
        if (wt / name).is_file():
            return wt / name
    for p in sorted(wt.glob("*.py")):
        if p.name in ("draft-check.py", "auto-harness-check.py", "check_literals.py",
                      "refimpl.py"):
            # the tools' own harness scripts, never a dispatch fixture -- the
            # auto self-check's prose says "behavioural CASES", which made it
            # the "fixture" of every non-Python auto worktree.
            continue
        if "CASES" in p.read_text(errors="replace"):
            return p
    # JS / .mjs fixtures (TypeScript/JS dispatches): named lookup first, then a
    # glob fallback keyed on CASES -- same shape as the Python lookups above.
    for name in ("verify_impl.mjs",):
        if (wt / name).is_file():
            return wt / name
    for p in sorted(wt.glob("*.mjs")) + sorted(wt.glob("*.js")):
        if p.name == "draft-check.mjs":
            continue  # the tool's own drafting verify, not a dispatch fixture
        if "CASES" in p.read_text(errors="replace"):
            return p
    # TS symbol fixture (.mts): a chk('name', cond) block list guarded by
    # CASES_AUTHORED, NOT a `CASES = [...]` array -- so it is keyed on the guard,
    # not on "CASES" alone (which the surrounding prose also contains).
    for name in ("verify_impl.mts",):
        if (wt / name).is_file():
            return wt / name
    for p in sorted(wt.glob("*.mts")):
        if "CASES_AUTHORED" in p.read_text(errors="replace"):
            return p
    return None


def gate(wt: Path, refimpl_cmd=None):
    """Run the real gate, --json. Returns (verdict, blocker_ids, raw).

    --auto-seal: the harness-sealed gate check (preflight, 2026-09-11) postdates
    this tool. On a --repo linked worktree the authored harness is untracked at
    draft time (scaffold seals LATE, by design), so without --auto-seal the gate
    NO-GOs on `harness-sealed` every round -- and `refimpl-passes` fails as a
    knock-on (no clean baseline to run the both-ways proof against), so the
    drafter can never converge and burns rounds on a harness issue it cannot fix.
    --auto-seal commits the drafted harness (target stays buggy -> baseline still
    RED for the right reason), which is the seal the operator does next anyway;
    on an already-sealed tree it is a no-op, so direct callers are not regressed."""
    cmd = [sys.executable, str(GATE), str(wt), "--json", "--auto-seal"]
    cmd += (["--refimpl-cmd", refimpl_cmd] if refimpl_cmd else ["--no-refimpl"])
    rc, out, err = sh(cmd)
    try:
        data = json.loads(out)
    except Exception:
        return "PARSE-ERROR", [], out + err
    ids = [b["check"] for b in data.get("blockers", [])]
    return data.get("verdict"), ids, data


def seal_harness(wt: Path):
    """Commit the drafted fixture into the baseline BEFORE gating. (ok, why).

    The gate runs check_baseline_clean BEFORE its own --auto-seal step, and a
    FAIL there SHORT-CIRCUITS the whole run (the both-ways proof never executes).
    On a fresh scaffold the fixture is UNTRACKED, so baseline-clean lets round 1
    through -- but once --auto-seal (or this seal) commits it, every LATER round's
    freshly-drafted cases are a TRACKED modification, so the gate bounces
    baseline-clean and never even looks at the new cases. With a live model each
    round drafts DIFFERENT cases, so the loop bounces on baseline-clean every
    retry and NEVER converges -- the reason automated drafting was unusable past
    round 1. Sealing the fixture here, before gate(), makes the tree clean when
    baseline-clean runs, and the committed fixture is exactly what the both-ways
    proof reverts to with `git checkout -- .` (an unsealed, uncommitted fixture
    would be reverted AWAY by that checkout, breaking the proof).

    Only the fixture is committed -- never draft-check.* / DRAFT-TASK.md, which
    must stay untracked so they do not dirty the launch baseline or scope. No-op
    outside a git repo, or when the fixture is already clean.
    """
    fx = fixture_of(wt)
    if not fx:
        return False, "no fixture to seal"
    rc, _, _ = sh(["git", "-C", str(wt), "rev-parse", "--git-dir"])
    if rc != 0:
        return False, "not a git repo -- nothing to seal (isolation is on you)"
    # PATH, not basename: a native fixture lives in a subdirectory (swift's is
    # Sources/<Core>Tests/main.swift). `git status -- main.swift` from the
    # worktree root matches NOTHING, so the old code read "already sealed" on a
    # dirty fixture and every round after the first bounced on baseline-clean.
    try:
        rel = [str(fx.relative_to(wt))]
    except ValueError:
        rel = [fx.name]
    # A native fixture's unconfirmed-draft marker is stamped into TASK.md (the
    # gate cannot see a .swift/.go/... file), so TASK.md is part of the drafted
    # harness for those flavours and must be sealed with it or the tree is dirty.
    if native_lang(fx) and (wt / "TASK.md").is_file() \
            and DRAFT_MARK in (wt / "TASK.md").read_text(errors="replace"):
        rel.append("TASK.md")
    rc, out, _ = sh(["git", "-C", str(wt), "status", "--porcelain", "--"] + rel)
    if not out.strip():
        return True, f"{', '.join(rel)} already sealed (clean baseline)"
    sh(["git", "-C", str(wt), "add", "--"] + rel)
    # hooks OFF: post-commit auto-push would publish this dispatch branch.
    rc, out, err = sh(["git", "-c", "core.hooksPath=/dev/null", "-C", str(wt), "commit", "-qm",
                       "seal drafted cases (clean launch baseline)"])
    if rc != 0:
        return False, (f"could not seal {', '.join(rel)}: "
                       f"{(err or out).strip()[-200:]} "
                       "-- the gate's --auto-seal is the fallback, but baseline-"
                       "clean may still bounce this round")
    return True, f"sealed {', '.join(rel)} into the baseline"


def fixture_discriminates(wt: Path):
    """Does the FIXTURE ALONE fail on the buggy tree?

    `baseline-fails` asks whether the whole verify fails at baseline, and in a
    generated scaffold it always does -- `check_literals.py` fails until the fix
    lands, and the counting idiom ORs the sections together. So a completely
    BENIGN set of cases (every one passing on the buggy code) still leaves the
    verify red at baseline, `baseline-fails` passes for the wrong reason, and
    the gate green-lights a draft that tests nothing.

    Found the first time this loop ran: it accepted `is_safe({"count": 99},
    True) == True` and friends. So the drafter asks the narrower question the
    gate cannot: run the fixture BY ITSELF against the untouched tree, and
    require it to fail. That is the behavioural half of the both-ways proof,
    isolated.
    """
    fx = fixture_of(wt)
    if not fx:
        return None, "no fixture to run"
    # Each fixture must run under ITS OWN runtime, or the check is inert:
    #   .py            -> python3 (sys.executable)
    #   .mts/.ts       -> tsx (type-strips and resolves the typed import that
    #                    bare python3/node cannot), resolved LOCALLY by
    #                    resolve_tsx(). If tsx is genuinely unavailable we return
    #                    None (UNPROVEN) -- an honest "could not run" -- rather
    #                    than the old silent `npx --yes tsx`, which needs the
    #                    network and hangs/fails on the offline queue host.
    #   .mjs/.js/...   -> node. Running a JS file under sys.executable (python3)
    #                    is a guaranteed SyntaxError -> nonzero exit -> the check
    #                    read a VACUOUS "fails at baseline = True" and NEVER
    #                    executed the cases, so a benign JS draft sailed through.
    #   .swift/.sh/.go/.rs/.java/.kt -> the toolchain command verify.sh recorded
    #                    as `# DISPATCH_FIXTURE_CMD:` (swift run XTests, go test,
    #                    cargo test, javac+java, ...). These CANNOT be run as a
    #                    file, and running one under python3/node exits nonzero
    #                    for a syntax reason -- a vacuous "discriminates".
    suffix = fx.suffix
    if native_lang(fx):
        cmd = fixture_cmd_from_verify(wt)
        if not cmd:
            return None, (f"{fx.name} is a {native_lang(fx)} fixture but verify.sh "
                          f"has no `{FIXTURE_CMD_MARK} ...` line -- cannot run the "
                          "fixture alone to test discrimination (re-scaffold with a "
                          "current ollama-dispatch-scaffold)")
        rc, out, err = sh(cmd, cwd=wt, timeout=900, sandbox=True)
        if rc == 0:
            return False, ("every drafted case PASSES on the buggy code, so the "
                           "cases prove nothing. " + (out.strip()[-200:] or ""))
        blob = (out + err)
        if not re.search(r"^(ok - |FAIL - )|case\(s\) passed|--- \d+ failed ---",
                         blob, re.M):
            return None, (f"`{cmd}` exited {rc} WITHOUT running a case (build or "
                          "toolchain failure) -- that is a broken fixture, not "
                          "discrimination: " + (err or out).strip()[-200:])
        return True, f"fixture alone fails at baseline (exit {rc}), as it must"
    if is_node_test(fx):
        # node --test / tsx --test: run the fixture ALONE under the SAME runner
        # the gate's verify.sh will use (tsx --test when tsconfig has paths, else
        # node --experimental-strip-types --test). cwd=wt so the target's `@/` and
        # relative imports resolve exactly as they do in verify.sh.
        runner, why = node_test_runner(wt, fx)
        if runner is None:
            return None, why  # honest UNPROVEN, never a vacuous pass/network
        run_cmd = runner + [fx.name]
    elif suffix in (".mts", ".ts"):
        tsx_cmd, tsx_src = resolve_tsx(wt)
        if tsx_cmd is None:
            return None, tsx_src  # honest UNPROVEN, never a vacuous pass/network
        run_cmd = tsx_cmd + [str(fx)]
    elif suffix in (".mjs", ".js", ".jsx", ".cjs"):
        node = shutil.which("node")
        if not node:
            return None, ("node is not on PATH -- cannot run the JS fixture to "
                          "test discrimination")
        run_cmd = [node, str(fx)]
    else:
        run_cmd = [sys.executable, str(fx)]
    rc, out, err = sh(run_cmd, cwd=wt, timeout=300, sandbox=True)
    if rc == 0:
        return False, ("every drafted case PASSES on the buggy code, so the "
                       "cases prove nothing. " + (out.strip()[-200:] or ""))
    return True, f"fixture alone fails at baseline (exit {rc}), as it must"


def draft_prompt(wt: Path, feedback=None):
    """The instruction handed to the drafter.

    Deliberately NOT 'write a test that passes'. A drafter optimising for a
    green verify writes the benign case every time -- that is the whole failure
    mode. It is asked for cases a WRONG fix would fail.
    """
    task = (wt / "TASK.md").read_text(errors="replace")
    fx = fixture_of(wt)
    body = fx.read_text(errors="replace") if fx else ""
    nodetest = is_node_test(fx)
    nlang = native_lang(fx)
    if nlang:
        what = "the adversarial case list"
        fill = f"author the cases in this {nlang} fixture"
    elif nodetest:
        what = "the test(...) cases"
        fill = "replace the SCAFFOLD guard test with real test() cases"
    else:
        what = "the CASES list"
        fill = "fill in CASES"
    p = f"""Author the adversarial test cases for this dispatch.

You are NOT fixing the code. You are writing {what} that decides whether
someone else's fix is correct.

--- TASK.md ---
{task}
--- end TASK.md ---

--- {fx.name if fx else 'fixture'} ({fill}) ---
{body}
--- end fixture ---

Write the cases in this shape. It is taken from three fixtures that caught real
bugs in this codebase, NOT from a style guide:

  1. THE POSITIVE CASE -- the thing the fix is supposed to start doing.
  2. THE BOUNDARY, AND ONE CASE ON EACH SIDE OF IT. For a threshold: just under,
     exactly at, just over. This is what a plausible WRONG fix (an off-by-one)
     fails.
  3. THE SAFETY / NO-EVIDENCE CASE -- the load-bearing one. When the input gives
     no grounds to act, the code must DO NOTHING rather than guess. A real
     example from this codebase: a season pack in a season with no
     single-keeper evidence must NEVER be selected, because it could be the
     only copy. Ask "what is the destructive thing this could do on thin
     evidence?" and pin it.
  4. THE AMBIGUITY CASE -- more than one candidate must return None/[], not an
     arbitrary pick. Zero candidates likewise.
  5. THE OVER-BROADENING CONTROL -- a near-miss input that must NOT be affected.
     A fix that strips a year from "(2023)" must not touch "1923" (a title that
     IS a year) or "(us)" (a non-year parenthetical). Without this, an
     over-eager fix passes.
  6. DEGENERATE INPUTS -- missing key, None, empty, wrong type, a value with no
     recognisable token at all. These must NOT raise. A raising case counts as
     a failure, which makes a broken fixture look discriminating.
  7. IDEMPOTENCE / PRESERVATION -- if the change is additive, the original must
     survive it.
  8. CASE-INSENSITIVITY where identifiers are compared, if the task involves
     matching.
  9. THE REGRESSION HALF -- behaviour that already works and must keep working.

Hard rules:
  * Every case must FAIL on the current buggy code and PASS on a correct fix,
    EXCEPT the regression half (7-9), which passes both ways on purpose.
    A case that passes on the buggy code and is not a regression case proves
    nothing.
  * At least {"3 cases" if (nodetest or nlang) else "6 cases"}. Keep the existing {"test() block" if nodetest else ("case" if nlang else "tuple")} shape exactly.
  * Do not invent behaviour the task does not ask for.
"""
    if nlang:
        # Native (compiled / toolchain-driven) fixture: the worker EDITS the
        # fixture file and re-runs draft-check.py, exactly like the node-test
        # path. Per-language shape notes so it edits the right idiom -- a model
        # handed a swift fixture and told about `CASES = [...]` writes Python.
        shape = {
            "swift": ("Append `Case` values to `let cases: [Case] = [ ... ]`, "
                      "each `Case(desc: \"...\") { <Bool expression> }`. The "
                      "closure returns true when the case PASSES. Call the real "
                      "symbol from the imported module."),
            "bash": ("Each case is one `chk \"<description>\" \"<actual>\" "
                     "\"<expected>\"` line, where <actual> is a command "
                     "substitution that drives the script under test, e.g. "
                     "`chk \"empty input -> 0\" \"$(run_target '')\" \"0\"`. "
                     "Then set `CASES_AUTHORED=1`."),
            "go": ("Each case is one `chk(t, \"<description>\", <got>, <want>)` "
                   "call inside the existing Test function. Then set "
                   "`CASES_AUTHORED = true`."),
            "rust": ("Each case is one `chk!(\"<description>\", <got>, <want>)` "
                     "inside the existing #[test] fn. Then set "
                     "`CASES_AUTHORED = true`."),
            "java": ("Each case is one `chk(\"<description>\", <got>, <want>)` "
                     "call inside main(). Then set `CASES_AUTHORED = true`."),
            "kotlin": ("Each case is one `chk(\"<description>\", <got>, <want>)` "
                       "call inside main(). Then set `CASES_AUTHORED = true`."),
        }[nlang]
        p += f"""
THIS IS A {nlang.upper()} FIXTURE. It is COMPILED/RUN by a toolchain, not
interpreted as a case array. {shape}
  * Edit {fx.name} IN PLACE. Do not emit the cases as chat output -- the file is
    the deliverable.
  * Do NOT edit the target under test: you are writing the judgment, not the fix.
    The cases must FAIL right now (the bug is still there) and PASS once someone
    fixes it.
  * Run `python3 draft-check.py` after every edit until it prints VERIFY_OK. It
    compiles and runs the fixture the same way the gate will, and it FAILS if the
    fixture does not compile, or if the cases pass on the buggy code.
"""
    elif nodetest:
        p += f"""
THIS IS A NODE-TEST FIXTURE (`node --test` / `tsx --test`). The cases are
`test('name', () => {{ ... }})` blocks using `import {{ test }} from 'node:test'`
and `import assert from 'node:assert/strict'` (already at the top of {fx.name}),
NOT a `CASES = [...]` array and NOT chk() calls.
  * Wire the import to the real symbol, e.g.
    `import {{ relinkStaleBfmrLinks }} from './lib/whatever.ts';` -- import the
    target the way TASK.md's entry point names it (relative, or a `@/` alias --
    the runner resolves both).
  * DELETE the `test('SCAFFOLD: cases not yet authored', ...)` guard entirely; it
    always fails and must not remain.
  * Each `test()` uses `assert` (assert.equal / assert.deepEqual / assert.throws
    / assert.doesNotThrow). A case FAILS now (buggy code) and PASSES after the
    fix, except the regression cases.
  * Edit {fx.name} in place and keep both existing `node:test` / `node:assert`
    imports (exactly once each). Run `python3 draft-check.py` after every edit
    until it prints VERIFY_OK (the fixture must FAIL on the buggy tree).
"""
    else:
        p += """
Output ONLY the replacement CASES list, starting with `CASES = [` and ending
with `]`. No prose, no code fences, no other edits.
"""
    # INTEGRATION fixtures: when the task (or the fixture skeleton) drives a web
    # app rather than a pure function, the cases still fit the (desc, thunk,
    # want) tuple shape -- the thunk just makes a request and returns the part
    # being asserted -- so this is guidance only, no change to how CASES are
    # spliced. Keeps a FastAPI/HTTP dispatch from getting a pure-function case
    # list that never touches a route.
    hay = (task + "\n" + body).lower()
    if not nodetest and not nlang and re.search(
            r"fastapi|starlette|httpx|testclient|\bwsgi\b|\basgi\b|flask|"
            r"endpoint|\broute\b|http\s|status[_ ]?code|/[a-z0-9_]+\s", hay):
        p += """
THIS IS AN INTEGRATION FIXTURE (it drives an app through a client, not a pure
function). Keep the (desc, thunk, want) tuple shape, but each thunk makes a real
request and returns the slice you assert:
  * status codes: ("GET /health -> 200", lambda: client.get("/health").status_code, 200)
  * response bodies: ("health body", lambda: client.get("/health").json()["status"], "ok")
  * the UNHAPPY paths -- a missing/invalid/oversized input must return the RIGHT
    4xx (422/400/404/409), NOT a 500 and NOT a silent 200. A wrong build that
    500s or accepts junk is exactly what a happy-path-only fixture misses.
  * auth/permission if the contract implies it (401/403 without a valid token).
  * assert the SHAPE of an error body where the contract names one, not only the
    code. Reuse the client/app the fixture skeleton already sets up; do not spin
    up a second one.
"""
    if feedback:
        p += f"""
YOUR PREVIOUS DRAFT WAS REJECTED BY THE GATE:
{feedback}
Fix that specifically. A rejected draft usually means the cases pass on the
buggy code, or they do not exercise what the task asked for.
"""
    return p


def _apply_cases_mts(fx: Path, text: str):
    """Splice drafted chk() cases into a TS-symbol .mts fixture. Returns (ok, why).

    The .mts fixture is a run of `chk('name', cond)` statements guarded by
    `const CASES_AUTHORED = false;` (which prints SCAFFOLD_INCOMPLETE and exits
    until real cases exist). Inject the cases into the authored region, flip the
    guard true so they RUN, and stamp the JS unconfirmed-draft marker. The
    fixture's own `if (checks < 3)` floor still enforces the >= 3 case count.
    """
    block = _extract_chk_block(text)
    if not block:
        return False, ("drafter output contained no chk(...) case statements "
                       "(a .mts symbol fixture expects chk() cases, not a "
                       "`CASES = [...]` array)")
    body = fx.read_text(errors="replace")
    if "CASES_AUTHORED" not in body:
        return False, f"{fx.name} has no CASES_AUTHORED guard to author against"
    comment = "// Model-drafted; NOT yet read by a human."
    region = f"{MTS_BEGIN}\n{comment}\n{DRAFT_MARK_JS};\n{block}\n{MTS_END}"
    if MTS_BEGIN in body and MTS_END in body:
        # round 2+: replace the prior injection rather than stack a second copy.
        body = re.sub(re.escape(MTS_BEGIN) + r".*?" + re.escape(MTS_END),
                      lambda _: region, body, count=1, flags=re.S)
    else:
        # Insert just before the guard so the cases are in scope before the
        # CASES_AUTHORED check. Anchor on the DELETE-THIS-BLOCK banner, falling
        # back to the guard declaration itself.
        anchor = "// >>> DELETE THIS BLOCK once"
        idx = body.find(anchor)
        if idx == -1:
            idx = body.find("const CASES_AUTHORED")
        if idx == -1:
            return False, f"{fx.name}: no guard to anchor the cases before"
        body = body[:idx] + region + "\n\n" + body[idx:]
    if "const CASES_AUTHORED = false;" in body:
        body = body.replace("const CASES_AUTHORED = false;",
                            "const CASES_AUTHORED = true;", 1)
    fx.write_text(body)
    n = block.count("chk(")
    return True, f"spliced {n} chk() case(s) into {fx.name}"


def _strip_scaffold_guard(body: str) -> str:
    """Remove the node-test scaffold's single guard `test('SCAFFOLD...', () => {
    assert.fail('SCAFFOLD_INCOMPLETE...') })`. It always fails, so it would keep
    the suite red even under a correct fix (breaking the both-ways proof); the
    drafter is told to delete it, and this makes the stdout path do so too. No-op
    if it is already gone."""
    return re.sub(
        r"\btest\s*\(\s*['\"][^'\"]*SCAFFOLD[^'\"]*['\"][\s\S]*?"
        r"SCAFFOLD_INCOMPLETE[\s\S]*?\}\s*\)\s*;?",
        "", body, count=1)


def _apply_cases_nodetest(fx: Path, text: str):
    """Splice drafted test() blocks into a node-test fixture. Returns (ok, why).

    The node-test shape is a run of `test('name', () => { assert... })` blocks --
    NOT a `CASES = [...]` array (.py/.mjs) nor chk() calls (.mts). Drop the
    scaffold guard test, splice the drafted blocks into a marked region (so a
    re-draft replaces rather than stacks), and stamp the JS unconfirmed-draft
    marker. draft-check.py's `>= 3 test()` floor enforces the case count.
    """
    block = _extract_test_block(text)
    if not block:
        return False, ("drafter output contained no test(...) blocks (a node-test "
                       "fixture expects `test('name', () => {...})` blocks, not a "
                       "`CASES = [...]` array)")
    # Drop any node:test / node:assert imports from the drafted block: the fixture
    # header already has them, and a duplicate ESM import is a SyntaxError.
    block = "\n".join(
        l for l in block.splitlines()
        if not re.match(r"\s*import\b.*\bnode:(test|assert)", l))
    body = fx.read_text(errors="replace")
    body = _strip_scaffold_guard(body)
    comment = "// Model-drafted; NOT yet read by a human."
    region = f"{MTS_BEGIN}\n{comment}\n{DRAFT_MARK_JS};\n{block}\n{MTS_END}"
    if MTS_BEGIN in body and MTS_END in body:
        # round 2+: replace the prior injection rather than stack a second copy.
        body = re.sub(re.escape(MTS_BEGIN) + r".*?" + re.escape(MTS_END),
                      lambda _: region, body, count=1, flags=re.S)
    else:
        body = body.rstrip() + "\n\n" + region + "\n"
    fx.write_text(body)
    n = len(re.findall(r"\btest\s*\(", block))
    return True, f"spliced {n} test(...) case(s) into {fx.name}"


def _mark_native(wt: Path, fx: Path):
    """Stamp a native (swift/bash/go/rust/java/kotlin) draft as unconfirmed.

    Two stamps, for two readers, and the second is the load-bearing one:
      1. a comment marker in the FIXTURE, so whoever reads the diff sees at a
         glance that a model wrote these cases; and
      2. the PYTHON marker in TASK.md, because the gate's draft-confirmed check
         scans TASK.md plus the .py / .mjs / .mts / .js / .ts fixtures the verify
         runs -- it cannot see a .swift/.sh/.go/.rs/.java/.kt file AT ALL.
         Without (2) a model-drafted native fixture reaches GO with nobody having
         read it, which is the one invariant this tool exists to keep. (Observed:
         the first swift dry-run gated GO on an unreviewed draft.)
    `--confirm` strips both; TASK.md is already in its file list.
    """
    lang = native_lang(fx)
    comment = NATIVE_SPEC[lang][2]
    body = fx.read_text(errors="replace")
    stamp = f"{comment} Model-drafted; NOT yet read by a human.\n"
    if "Model-drafted; NOT yet read by a human." not in body:
        if lang == "bash" and body.startswith("#!"):
            head, _, rest = body.partition("\n")
            body = head + "\n" + stamp + rest
        else:
            body = stamp + body
        fx.write_text(body)
    task = wt / "TASK.md"
    ttext = task.read_text(errors="replace") if task.is_file() else ""
    if DRAFT_MARK not in ttext:
        task.write_text(f"{DRAFT_COMMENT_PY}\n{DRAFT_MARK}\n\n" + ttext)
        ttext = task.read_text(errors="replace")
    if DRAFT_MARK not in ttext:
        return False, (f"could not stamp {DRAFT_MARK} into TASK.md -- without it "
                       "the gate cannot see that this native fixture is an "
                       "unconfirmed draft. Add the line by hand before gating.")
    return True, (f"marked {fx.name} + TASK.md as an unconfirmed draft "
                  "(the gate reads the TASK.md marker for native fixtures)")


def _apply_cases_native(wt: Path, fx: Path, text: str):
    """Splice drafted cases into a swift/bash/go/rust/java/kotlin fixture.

    Only the --drafter-cmd (stdout) path reaches this: the queue path is an
    in-place file edit (mode "inplace"), like node-test. Kept honest anyway --
    the retry loop has to be provable without a GPU, which is why --drafter-cmd
    exists at all.
    """
    lang = native_lang(fx)
    case_re, _min, comment = NATIVE_SPEC[lang]
    t = text.strip()
    t = re.sub(r"^```[A-Za-z0-9_-]*\n", "", t)
    t = re.sub(r"\n```\s*$", "", t).strip()
    if not re.search(case_re, t, re.M):
        return False, (f"drafter output contained no {lang} case matching "
                       f"/{case_re}/ -- nothing to splice")
    body = fx.read_text(errors="replace")
    begin, end = f"{comment} >>> DRAFTED-CASES >>>", f"{comment} <<< DRAFTED-CASES <<<"
    region = f"{begin}\n{comment} Model-drafted; NOT yet read by a human.\n{t}\n{end}"
    if begin in body and end in body:
        body = re.sub(re.escape(begin) + r".*?" + re.escape(end),
                      lambda _: region, body, count=1, flags=re.S)
    elif lang == "swift":
        # swift has no CASES_AUTHORED guard -- the cases ARE the array, so the
        # drafted block replaces the array body.
        m = re.search(r"let cases: \[Case\] = \[.*?\n\]", body, re.S)
        if not m:
            return False, f"{fx.name}: no `let cases: [Case] = [...]` to replace"
        body = body[:m.start()] + "let cases: [Case] = [\n" + t + "\n]" \
            + body[m.end():]
    else:
        anchor = "CASES_AUTHORED"
        idx = body.find(anchor)
        if idx == -1:
            return False, f"{fx.name}: no CASES_AUTHORED guard to anchor before"
        idx = body.rfind("\n", 0, idx) + 1
        body = body[:idx] + region + "\n\n" + body[idx:]
    body = re.sub(r"(CASES_AUTHORED\s*=\s*)(false|0)\b",
                  lambda m: m.group(1) + ("true" if m.group(2) == "false" else "1"),
                  body, count=1)
    fx.write_text(body)
    # The .py/.mjs splice stamps DRAFT_UNCONFIRMED as part of the same edit; a
    # native fixture's machine-readable marker lives in TASK.md, so stamp it here
    # too. Skipping it let a --drafter-cmd swift draft reach GO unreviewed.
    ok, why = _mark_native(wt, fx)
    if not ok:
        return False, why
    return True, (f"spliced {len(re.findall(case_re, t, re.M))} case(s) into "
                  f"{fx.name}; {why}")


def apply_cases(wt: Path, text: str):
    """Splice a drafted CASES list into the fixture. Returns (ok, why)."""
    fx = fixture_of(wt)
    if not fx:
        return False, "no fixture file found"
    if native_lang(fx):
        return _apply_cases_native(wt, fx, text)
    if is_node_test(fx):
        return _apply_cases_nodetest(fx, text)
    if fx.suffix == ".mts":
        return _apply_cases_mts(fx, text)
    m = re.search(r"CASES\s*=\s*\[.*?^\]", text, re.S | re.M)
    if not m:
        return False, "drafter output contained no `CASES = [ ... ]` block"
    new_cases = m.group(0)
    body = fx.read_text(errors="replace")
    if not re.search(r"^CASES\s*=\s*\[.*?^\]", body, re.S | re.M):
        return False, f"{fx.name} has no CASES block to replace"
    body = re.sub(r"^CASES\s*=\s*\[.*?^\]", lambda _: new_cases, body,
                  count=1, flags=re.S | re.M)
    # JS / .mjs fixtures get the `//` comment and the JS marker -- never the
    # Python `#` comment or the Python marker.
    is_js = fx.suffix in (".mjs", ".js")
    mark = DRAFT_MARK_JS if is_js else DRAFT_MARK
    comment = ("// Model-drafted; NOT yet read by a human." if is_js
               else "# Model-drafted; NOT yet read by a human.")
    if mark not in body:
        body = body.replace(
            "CASES = [",
            f"{comment}\n{mark}\n\nCASES = [",
            1)
    fx.write_text(body)
    n = len([l for l in new_cases.splitlines()
             if l.strip().startswith("(")])
    return True, f"spliced {n} case(s) into {fx.name}"


def run_drafter(wt: Path, prompt: str, a):
    """Produce a draft. Returns (mode, payload, why).

    mode "stdout"  -- --drafter-cmd: its stdout is the CASES block to splice.
    mode "inplace" -- the queue: the worker EDITED the fixture itself.

    The queue worker is an AGENTIC FILE-EDITING LOOP, not a text generator, and
    the first live run cost a job proving it. Given --max-iters 1 the model
    spent its one iteration on list_files + read_file and never answered:
    "DID NOT CONVERGE after 1 iterations". Asking it for stdout was the wrong
    shape entirely. So it is now given the job it is actually built for -- edit
    the file, run a verify, iterate -- and the draft is read from the FILE.
    """
    if a.drafter_cmd:
        rc, out, err = sh(a.drafter_cmd, cwd=wt, timeout=a.timeout)
        if rc != 0:
            return None, None, f"--drafter-cmd exited {rc}: {err.strip()[-300:]}"
        return "stdout", out, "drafter-cmd"

    # Language-aware draft-check: each fixture kind gets a verify that reads ITS
    # OWN file and runs it under ITS OWN runtime. A .mts fixture routed to the
    # Python draft-check (whose FX is hardcoded to test_fixture.py) dies with
    # FileNotFoundError before the model does anything -- the exact TS-worktree
    # failure this dispatch fixes.
    #   .mts/.ts     -> draft-check.py that runs verify_impl.mts under tsx
    #   .mjs/.js     -> node draft-check.mjs (reads verify_impl.mjs)
    #   .py (else)   -> python3 draft-check.py (reads test_fixture.py)
    fx = fixture_of(wt)
    suffix = fx.suffix if fx else ""
    nlang = native_lang(fx)
    if nlang:
        # swift/bash/go/rust/java/kotlin: the draft-check drives the fixture with
        # the SAME toolchain command verify.sh uses (its DISPATCH_FIXTURE_CMD
        # line) and requires it to FAIL on the buggy tree.
        cmd = fixture_cmd_from_verify(wt)
        if not cmd:
            return None, None, (
                f"{fx.name} is a {nlang} fixture but verify.sh has no "
                f"`{FIXTURE_CMD_MARK} ...` line -- the drafter has no way to run "
                "it (re-scaffold with a current ollama-dispatch-scaffold)")
        case_re, min_cases, _c = NATIVE_SPEC[nlang]
        (wt / "draft-check.py").write_text(
            DRAFT_CHECK_NATIVE % {"lang": nlang,
                                  "fx_name": str(fx.relative_to(wt)),
                                  "cmd": cmd, "min_cases": min_cases,
                                  "case_re": case_re})
        verify_cmd = "python3 draft-check.py"
    elif is_node_test(fx):
        # node --test / tsx --test fixture: the draft-check runs the SAME runner
        # verify.sh will (baked in here), reading verify.test.ts and requiring it
        # to FAIL on the buggy tree. A .ts routed to the chk() DRAFT_CHECK_TS
        # would look for a CASES_AUTHORED guard that a node-test file never has.
        runner, _why = node_test_runner(wt, fx)
        if runner is None:
            # No usable runner (tsx unresolvable, no node): fall back to plain
            # node --test so the draft-check at least runs the file.
            runner = [shutil.which("node") or "node",
                      "--experimental-strip-types", "--test",
                      "--test-reporter=tap", "--experimental-test-module-mocks"]
        (wt / "draft-check.py").write_text(
            DRAFT_CHECK_NODETEST % {"fx_name": fx.name,
                                    "runner_json": json.dumps(runner)})
        verify_cmd = "python3 draft-check.py"
    elif suffix in (".mts", ".ts"):
        (wt / "draft-check.py").write_text(DRAFT_CHECK_TS)
        verify_cmd = "python3 draft-check.py"
    elif suffix in (".mjs", ".js"):
        (wt / "draft-check.mjs").write_text(DRAFT_CHECK_JS)
        verify_cmd = "node draft-check.mjs"
    else:
        (wt / "draft-check.py").write_text(DRAFT_CHECK)
        verify_cmd = "python3 draft-check.py"
    pf = wt / "DRAFT-TASK.md"
    pf.write_text(prompt)
    # Studio work goes through the queue, never a direct API call.
    #
    # num_ctx: OMITTED by default (2026-09-17). This used to hand-pass a flat
    # 32768 for every draft regardless of how big the prompt it had just written
    # was -- and a draft prompt is the biggest in the pipeline, because it inlines
    # the whole TASK.md + the fixture + the shape guide. Passing it also DISABLED
    # ollama-queue.py's auto-ctx sizing entirely. wt-bfmr-relink-v3 is the case:
    # a 19KB DRAFT-TASK peaked at 31,946 tokens (97.5% of 32768) and came back
    # converged:false after 6 iterations. Omitting the flag hands the queue the
    # prompt file we just wrote, so it sizes the window from the ACTUAL job text
    # (plus the files that text names) and its ctx gate fails closed if the job
    # cannot fit the host at all. An explicit --num-ctx is still honored -- and is
    # still gated, so a too-small one is raised rather than quietly starved.
    cmd = [sys.executable, str(QUEUE), "enqueue", "--model", a.model,
           "--host", a.host, "--cwd", str(wt), "--task-file", str(pf),
           "--task-kind", "coding",
           "--verify", verify_cmd,
           "--max-iters", str(a.max_iters), "--label", f"draft-{wt.name}"]
    if a.num_ctx is not None:
        cmd += ["--num-ctx", str(a.num_ctx)]
    rc, out, err = sh(cmd)
    if rc != 0:
        return None, None, f"enqueue failed: {err.strip()[-300:]}"
    m = re.search(r"\b([0-9a-f]{12})\b", out) or re.search(r"\b([0-9a-f]{8,})\b", out)
    if not m:
        return None, None, f"could not read a job id from: {out.strip()[:200]}"
    job = m.group(1)
    print(f"    queued {job} (verify: the fixture must FAIL on the buggy tree)")
    deadline = time.time() + a.timeout
    last = None
    missing = 0
    while time.time() < deadline:
        time.sleep(15)
        row = job_row(job)
        if not row:
            # The row can VANISH from the state file -- a daemon restart (or its
            # recovery rewrite) drops finished jobs, and both swift/bash shakeout
            # jobs disappeared the moment they completed. The old loop then spun
            # here until the 1800s timeout and reported "did not finish" about a
            # job that had converged minutes earlier. The queue's per-job LOG is
            # the other, independent witness, so consult it once the row has been
            # gone for a couple of polls (never on the first, to avoid racing the
            # daemon's first state write).
            missing += 1
            if missing >= 2:
                st, why = job_outcome_from_log(job)
                if st == "done":
                    print(f"    {job}: done (state row gone; read from the job log)")
                    return "inplace", None, f"job {job} done ({why})"
                if st == "failed":
                    return None, None, f"job {job} failed ({why})"
            continue
        missing = 0
        st = row.get("status")
        if st != last:
            print(f"    {job}: {st}")
            last = st
        if st in ("done", "failed", "cancelled"):
            if st != "done":
                log = row.get("log_path") or ""
                tail = ""
                if log and Path(log).is_file():
                    tail = Path(log).read_text(errors="replace").strip()[-400:]
                return None, None, f"job {job} {st} (exit {row.get('exit_code')})\n{tail}"
            return "inplace", None, f"job {job} done"
    return None, None, f"job {job} did not finish within {a.timeout}s"


QUEUE_LOGS = Path.home() / "bin" / "ollama-queue-logs"


def job_outcome_from_log(job):
    """(status, why) read from the queue's per-job log, or (None, why).

    The SECOND witness to a job's outcome, used only when the state row has
    disappeared (see the polling loop). The worker writes an unambiguous
    terminal line: "VERIFY PASSED" when the verify went green, "VERIFY FAILED"
    / "DID NOT CONVERGE" when it did not. Keyed on those, not on an exit code
    the vanished row no longer carries. Absent log -> (None, ...) so the caller
    keeps waiting rather than inventing an outcome.
    """
    hits = sorted(QUEUE_LOGS.glob(f"{job}*.log"))
    if not hits:
        return None, f"no queue log matching {job}*.log"
    try:
        text = hits[-1].read_text(errors="replace")
    except OSError as e:
        return None, f"could not read {hits[-1].name}: {e}"
    tail = text[-4000:]
    if "VERIFY PASSED" in tail:
        return "done", f"VERIFY PASSED in {hits[-1].name}"
    if "DID NOT CONVERGE" in tail or "VERIFY FAILED" in tail:
        return "failed", f"the worker did not converge ({hits[-1].name})"
    return None, f"{hits[-1].name} has no terminal line yet"


def job_row(job):
    """The queue's own state file -- `status --json` is not a stable contract."""
    try:
        d = json.loads((Path.home() / "bin" / "ollama-queue-state.json")
                       .read_text())
        jobs = d.get("jobs") or []
        return next((j for j in jobs if str(j.get("id")).startswith(job)), None)
    except Exception:
        return None


def mark_drafted(wt: Path, fx: Path = None):
    """Stamp an in-place edit as an unconfirmed draft. `fx` names the fixture
    explicitly (ollama-dispatch-auto passes the one the scaffold's manifest
    records); omitted, it is resolved by fixture_of()."""
    fx = fx or fixture_of(wt)
    if not fx:
        return False, "no fixture file found"
    # Native (swift/bash/go/rust/java/kotlin) fixture. Two stamps, for two
    # different readers, and the second one is the load-bearing one:
    #   1. a comment marker in the FIXTURE, so the human reviewing the diff sees
    #      at a glance that a model wrote these cases; and
    #   2. the PYTHON marker in TASK.md, because the gate's draft-confirmed check
    #      only scans TASK.md + the .py and .mjs/.mts/.js/.ts fixtures the verify
    #      runs -- it cannot see a .swift/.sh/.go/.rs/.java/.kt file at all.
    #      Without (2) a model-drafted native fixture reaches GO with nobody
    #      having read it, which is the ONE invariant this tool exists to keep.
    #      `--confirm` strips both (TASK.md is already in its file list).
    if native_lang(fx):
        return _mark_native(wt, fx)
    # node-test fixture (test() blocks): no `CASES = [` array and no
    # CASES_AUTHORED guard -- the worker edited test() blocks in place. Stamp the
    # JS marker just AFTER the last import (so it sits above the tests, below the
    # imports) so the gate's draft-confirmed check can fire, then VERIFY it
    # landed. Without this an in-place node-test draft reaches GO unreviewed.
    if is_node_test(fx):
        body = fx.read_text(errors="replace")
        if DRAFT_MARK_JS in body:
            return True, f"{fx.name} already marked as an unconfirmed draft"
        stamp = ("// Model-drafted; NOT yet read by a human.\n"
                 f"{DRAFT_MARK_JS};\n")
        imports = list(re.finditer(r"^import\b.*$", body, re.M))
        if imports:
            idx = imports[-1].end()
            new_body = body[:idx] + "\n" + stamp + body[idx:]
        else:
            new_body = stamp + body
        if DRAFT_MARK_JS not in new_body:
            return False, (f"could not mark {fx.name}: no anchor for the marker. "
                           f"Add `{DRAFT_MARK_JS};` by hand before gating, or the "
                           "draft-confirmed check cannot fire.")
        fx.write_text(new_body)
        return True, f"marked {fx.name} as an unconfirmed draft"
    # .mts (chk()-style TS symbol fixture): no `CASES = [` array to anchor on --
    # the worker edited chk() cases in place. Stamp the JS marker just before the
    # CASES_AUTHORED guard (falling back to the DELETE-THIS-BLOCK banner, then the
    # top of file) so the gate's draft-confirmed check can fire, then VERIFY it
    # landed. Without this an in-place TS draft reaches GO unreviewed.
    if fx.suffix in (".mts", ".ts"):
        body = fx.read_text(errors="replace")
        if DRAFT_MARK_JS in body:
            return True, f"{fx.name} already marked as an unconfirmed draft"
        stamp = ("// Model-drafted; NOT yet read by a human.\n"
                 f"{DRAFT_MARK_JS};\n")
        idx = -1
        for anchor in ("const CASES_AUTHORED", "// >>> DELETE THIS BLOCK once"):
            idx = body.find(anchor)
            if idx != -1:
                break
        new_body = (body[:idx] + stamp + "\n" + body[idx:]) if idx != -1 \
            else (stamp + body)
        if DRAFT_MARK_JS not in new_body:
            return False, (f"could not mark {fx.name}: no anchor for the marker. "
                           f"Add `{DRAFT_MARK_JS};` by hand before gating, or the "
                           "draft-confirmed check cannot fire.")
        fx.write_text(new_body)
        return True, f"marked {fx.name} as an unconfirmed draft"
    # JS / .mjs fixtures get the `//` comment and the JS marker -- never the
    # Python `#` comment or the Python marker.
    is_js = fx.suffix in (".mjs", ".js")
    mark = DRAFT_MARK_JS if is_js else DRAFT_MARK
    comment = ("// Model-drafted; NOT yet read by a human." if is_js
               else "# Model-drafted; NOT yet read by a human.")
    body = fx.read_text(errors="replace")
    if mark in body:
        return True, f"{fx.name} already marked as an unconfirmed draft"
    new_body = re.sub(r"^CASES\s*=\s*\[",
                      f"{comment}\n{mark}\n\nCASES = [",
                      body, count=1, flags=re.M)
    # VERIFY the marker landed. re.sub is a no-op when the pattern misses (e.g.
    # CASES indented inside a function, so `^CASES` never matches), and the
    # first version then wrote the file back unchanged and returned
    # "marked ... as an unconfirmed draft". That is the worst possible lie
    # here: the gate's draft-confirmed check keys on this marker, so an
    # unreviewed model-drafted fixture would sail through to GO and the ONE
    # invariant this tool exists to enforce -- a human read the cases -- would
    # be silently off.
    if mark not in new_body:
        return False, (f"could not mark {fx.name}: no top-level `CASES = [` to "
                       f"anchor on. Add `{mark}` by hand before gating, "
                       "or the draft-confirmed check cannot fire.")
    fx.write_text(new_body)
    return True, f"marked {fx.name} as an unconfirmed draft"


def cmd_confirm(wt: Path):
    """Remove the marker. The one step that says a human read the cases."""
    touched = []
    files = (list(wt.glob("*.py")) + list(wt.glob("*.mjs"))
             + list(wt.glob("*.js")) + list(wt.glob("*.mts"))
             + list(wt.glob("*.ts"))  # node-test fixtures (verify.test.ts)
             + [wt / "TASK.md"])
    # Native fixtures (swift/bash/go/rust/java/kotlin) carry only the COMMENT
    # marker -- their machine-readable marker lives in TASK.md (see
    # mark_drafted). Include the fixture so --confirm cleans both, or the "a
    # model wrote these" comment outlives the review that retired it.
    nat = native_fixture(wt)
    if nat is not None:
        files.append(nat)
    for p in files:
        try:
            text = p.read_text(errors="replace") if p.is_file() else ""
            if (DRAFT_MARK in text or DRAFT_MARK_JS in text
                    or "Model-drafted; NOT yet read by a human." in text):
                b = p.read_text()
                b = "\n".join(l for l in b.splitlines()
                              if DRAFT_MARK not in l
                              and DRAFT_MARK_JS not in l
                              and l.strip() != "# Model-drafted; NOT yet read by a human."
                              and l.strip() != "// Model-drafted; NOT yet read by a human.")
                p.write_text(b + ("\n" if not b.endswith("\n") else ""))
                touched.append(p.name)
        except Exception:
            pass
    if not touched:
        print("nothing to confirm -- no unconfirmed drafts in this worktree")
        return 1
    print("confirmed (you are now the reason these cases are trusted): "
          + ", ".join(touched))
    return 0


def main():
    ap = argparse.ArgumentParser(
        description="Draft adversarial cases with a local model; the gate "
                    "bounces bad drafts, you judge relevance.")
    ap.add_argument("worktree")
    ap.add_argument("--confirm", action="store_true",
                    help="you have READ the drafted cases: remove the marker")
    ap.add_argument("--rounds", type=int, default=3,
                    help="how many times to re-draft on a gate bounce")
    ap.add_argument("--model", default=DEFAULT_MODEL)
    ap.add_argument("--host", default=DEFAULT_HOST)
    ap.add_argument("--num-ctx", type=int, default=None,
                    help="Window for the drafting job. DEFAULT: omitted, so "
                         "ollama-queue.py sizes it from the DRAFT-TASK.md this "
                         "tool just wrote (the old flat 32768 starved the "
                         "biggest prompts in the pipeline). An explicit value is "
                         "honored, and still raised by the queue's ctx gate if "
                         "it is provably too small.")
    ap.add_argument("--timeout", type=int, default=1800)
    ap.add_argument("--max-iters", type=int, default=8,
                    help="worker iterations per draft. 1 is NOT "
                         "enough -- the worker spends early ones "
                         "exploring with list_files/read_file.")
    ap.add_argument("--refimpl-cmd",
                    help="passed through to the gate for the both-ways proof")
    ap.add_argument("--drafter-cmd",
                    help="run this instead of dispatching a model; its stdout "
                         "is the draft. Exists so the retry loop is provable "
                         "without a GPU.")
    a = ap.parse_args()
    wt = Path(a.worktree).expanduser().resolve()
    if not wt.is_dir():
        ap.error(f"{wt} is not a directory")
    if a.confirm:
        return cmd_confirm(wt)
    if not (wt / "TASK.md").is_file():
        ap.error(f"no TASK.md in {wt} -- scaffold it first")

    # node-test fixtures import the real target, which for a Next.js/Prisma repo
    # pulls in the generated Prisma client at module load. Generate it ONCE up
    # front (verify.sh regenerates too, but the pre-gate discrimination check
    # runs the fixture standalone first) so a benign draft can't hide behind a
    # module-not-found "failure". No-op when there is no prisma generator.
    if is_node_test(fixture_of(wt)):
        env_ok, env_why = ensure_node_env(wt)
        if env_why:
            print(f"  {env_why}")

    feedback = None
    for rnd in range(1, a.rounds + 1):
        print(f"\n=== draft round {rnd}/{a.rounds} ===")
        mode, payload, how = run_drafter(wt, draft_prompt(wt, feedback), a)
        if mode is None:
            print(f"  drafter failed: {how}")
            return 2
        print(f"  {how}")
        if mode == "stdout":
            ok, why = apply_cases(wt, payload)
            print(f"  {why}")
            if not ok:
                feedback = f"Your output was unusable: {why}"
                continue
        else:
            ok, why = mark_drafted(wt)
            print(f"  {why}")
            if not ok:
                # Proceeding would hand back a draft the gate cannot flag as
                # unconfirmed -- i.e. an unreviewed draft that can reach GO.
                return 2
        # The narrow question the gate cannot ask -- BEFORE the gate, because a
        # benign draft is the common failure and this is the cheap test for it.
        disc, why_disc = fixture_discriminates(wt)
        if disc is False:
            print(f"  benign draft: {why_disc}")
            feedback = (
                "Every case you wrote PASSES on the current buggy code, so none "
                "of them can tell a correct fix from no fix at all. Each case "
                "must FAIL now and PASS after the fix. Target the exact "
                "boundary in the task.")
            continue
        print(f"  {why_disc}")
        # Seal the drafted fixture into the baseline BEFORE gating, or the gate's
        # baseline-clean check (which runs before its own --auto-seal and hard-
        # stops the run) bounces every round after the first and the loop never
        # converges with a live model. See seal_harness().
        sealed_ok, sealed_why = seal_harness(wt)
        print(f"  {sealed_why}")
        verdict, blockers, data = gate(wt, a.refimpl_cmd)
        real = [b for b in blockers if b not in IGNORED_BLOCKERS]
        if not real:
            print(f"  gate: {verdict} (ignoring draft-confirmed, which is "
                  "expected until you confirm)")
            fx = fixture_of(wt)
            print("\n" + "-" * 72)
            print("DRAFTED, MECHANICALLY CLEAN, AND NOT YET TRUSTED.")
            print("-" * 72)
            if fx:
                text = fx.read_text()
                if native_lang(fx):
                    # A native (swift/bash/go/rust/java/kotlin) fixture has no
                    # CASES array or injected region to slice -- echo the whole
                    # (small) fixture so the human sees exactly what to review.
                    print(text)
                elif is_node_test(fx):
                    # A node-test fixture edited in place has no CASES array/region
                    # to slice -- echo the whole (small) test file so the human
                    # sees exactly the test() cases to review.
                    print(text)
                elif fx.suffix in (".mts", ".ts") and MTS_BEGIN in text:
                    # .mts has no `CASES = [` array -- echo the injected chk()
                    # region so the human actually SEES what to review.
                    m = re.search(re.escape(MTS_BEGIN) + r".*?"
                                  + re.escape(MTS_END), text, re.S)
                    if m:
                        print(m.group(0))
                else:
                    m = re.search(r"^CASES\s*=\s*\[.*?^\]", text, re.S | re.M)
                    if m:
                        print(m.group(0))
            print("-" * 72)
            print("The gate proved these DISCRIMINATE. It cannot prove they are")
            print("RELEVANT -- a case that fails at baseline and asserts every")
            print("literal can still test the wrong property entirely.")
            print("\nRead each one and ask: could this pass on broken work?")
            print(f"  then:  ollama-dispatch-draft {shlex.quote(str(wt))} --confirm")
            print(f"  or:    re-run to draft again, or author them yourself")
            return 0
        detail = "; ".join(
            f"{b['check']}: {b['message']}"
            for b in data.get("blockers", [])
            if b["check"] not in IGNORED_BLOCKERS)
        print(f"  gate bounced: {', '.join(real)}")
        feedback = detail
    print(f"\n{a.rounds} rounds, still bouncing. The gate is doing its job -- "
          "this\ndrafter is not converging on this task. Author the cases "
          "yourself, or\nre-run with a stronger --model.")
    return 1


if __name__ == "__main__":
    sys.exit(main())
