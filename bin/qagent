#!/usr/bin/env python3
"""qagent -- lightweight "Agent tool" front door for the local-LLM queue.

Sends a FREEFORM prompt to ollama-worker.py (via ollama-queue.py -- never a direct
model call) WITHOUT the ollama-dispatch-auto harness/gate/TASK-scaffold/verify
authoring.  Output is UNVERIFIED local-model text; the caller must check it.

  qagent run [--repo PATH] [--readonly] [--model M] [--label L] [--max-iters N]
             [--max-tokens N] [--chat-timeout S] [--max-wall S]
             [--dry-run] "<prompt>"                     -> prints job id
  qagent status <id>
  qagent wait <id> [--timeout S]                        exit 0 done, 1 failed, 2 timeout
  qagent result <id>                                    summary + diff + banner + log path
  qagent followup <id> "<msg>" [--dry-run]              new job seeded from the prior one
  qagent land <job-id|group-id> [--push|--no-push] [--branch B]
                                                        land a VERIFIED fix (see LANDING below); prints `LANDED <sha> on <branch> (pushed|local)`
  qagent abort <id>                                     via ~/bin/queue-abort (fix jobs: also removes the worktree)
  qagent fix --repo R --verify "<cmd>" [--base REF] [--land] [--wait] "<problem>"
                                                        WRITE/FIX mode (see below); prints job id
                                                        --attempts N (needs --wait): retry in a FRESH worktree with the prior verify tail,
                                                        stop at first VERIFIED, else write <group>.escalation.md
  qagent watch <id> [--poll S]                          foreground watchdog: enforce --max-wall until the job
                                                        is terminal (`run` auto-spawns one, detached; --no-watch)

How the worker's mandatory-verify requirement is handled
  The queue REFUSES a coding job with no --verify unless --allow-no-verify (an
  explicit "scope-only/advisory" acknowledgement).  We pass exactly that; no fake
  always-pass verify.  Read-only runs use --task-kind research (no verify needed,
  no gate, no diff collection).
Isolation
  --repo PATH              queue creates a throwaway git worktree from PATH (--repo),
                           discarded by the pipeline reaper; PATH itself is never edited.
  no --repo                private scratch dir ~/.qagent/<stamp>/ (non-git).
  --readonly               the worker has NO edit-disable flag, so read-only is enforced
                           by (a) task-kind research, (b) a prompt preamble forbidding
                           edits, (c) throwaway worktree/scratch cwd, and (d) `result`
                           reports any diff it finds as a READONLY VIOLATION.
Bounds (always set; override with flags): --max-tokens 12000/turn, --max-iters 12 (40 with --readonly),
  --chat-timeout 900s, --max-wall 1800s active time (aborted by the detached watchdog `run` spawns,
  and also by status/wait).
  Sampling is never set -- the model-card profile applies.  NOTE the queue may serve a
  different model than requested (profile alias qwen3.8 -> qwen3.6 on the Darkbloom lane);
  `result` prints the served model parsed from the worker log.
Followup
  The worker's --resume only works on a paused/failed job's own transcript and the
  queue exposes no enqueue flag for it, so followup enqueues a NEW job whose prompt
  carries the original prompt, the prior final answer and the new message.
FIX mode (qagent fix) -- local-model code is NEVER trusted
  qagent cuts its OWN detached git worktree of R at --base (default HEAD) under
  ~/.ollama-dispatch/qagent-worktrees/<fixid>/ and enqueues ONE coding job with --cwd <worktree> (the worker
  already confines every file tool to its cwd: resolve_path "escapes working directory"; no new pin
  mechanism).  qagent -- not the model -- runs --verify in the worktree BEFORE (must FAIL, else
  "verify already passes -- nothing to fix" and nothing is enqueued) and, once the job is terminal
  (`result`/`fix --wait`), AFTER.  The patch is captured before the after-verify so verify litter never
  lands in it.  Verdicts: VERIFIED (fail->pass), UNVERIFIED (anything else), REJECTED (touches a
  test/verify file, a symlink/escaping path, or R's own checkout changed), NO-CHANGE.  R's branch is
  never committed to; output = <QAGENT_HOME>/fix/<jobid>.patch + the worktree path.
  --land (with --wait) runs `qagent land` automatically on a VERIFIED result.
  --harness-from DIR       copy the verify files (verify.sh, verify.test.ts, files named in --verify) that are absent
                           at --base from DIR into the new fix worktree as protected, never-committed files.
LANDING (qagent land)
  Needs a VERIFIED report.  Cuts a fresh worktree at the CURRENT tip of the target branch (fetch first), applies
  the patch with `git apply --3way` (conflict -> abort, list files, leave nothing), copies the protected harness in
  as UNTRACKED files, re-runs the fix's verify AND the repo suite (npm test, if package.json has one); both must
  pass.  Commits ONLY the patch's files (no add -A; title = problem's first line; no attribution), pushes
  fast-forward-only (one retry after a rejection), then fast-forwards the user's checkout only if that cannot
  clobber anything (never reset/stash/force/checkout over their changes).  Idempotent (`landed` in the fix JSON).
  Guards: INVALID BASELINE (baseline exit 126/127 or "No such file/command not found/ENOENT..." output aborts the fix
  before enqueue); --harness-from copies the COMPLETE harness (untracked files + files the verify script references)
  as protected; a model that modifies/creates a protected harness file -> UNVERIFIED; a declared scope ("Only edit X, Y")
  makes any out-of-scope or NEW file UNVERIFIED and `land` refuses it; with no scope `land` refuses new-files-only patches
  (override --allow-new-files) and patches that only touch protected harness files.
UNLAND (qagent unland <job> [--push|--no-push])
  Undo a recorded landing: fresh worktree at the branch's current tip, `git revert --no-edit <sha>` (already reverted ->
  notice; conflict -> abort listing files), message `Revert "<first line>"`, no attribution, fast-forward-only push (one
  retry), user's checkout fast-forwarded only if untouched.  Records `unlanded`; idempotent; no fix worktree needed.
Env: QAGENT_WT_ROOT (worktree root), QAGENT_VERIFY_TIMEOUT (s, default 600), QAGENT_QUEUE_PY (queue script), QAGENT_STATE (state json), QAGENT_HOME (scratch root),
     QAGENT_ABORT (queue-abort path), QAGENT_DRY_ID (dry-run fake id),
     QAGENT_WATCHER (script `run` spawns as `<script> watch <id>`; default this file).
"""
import argparse, json, os, re, shutil, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
QUEUE_PY = os.environ.get("QAGENT_QUEUE_PY", str(HOME / "bin" / "ollama-queue.py"))
STATE = Path(os.environ.get("QAGENT_STATE", str(HOME / "bin" / "ollama-queue-state.json")))
LOG_DIR = Path(os.environ.get("QAGENT_LOGDIR", str(HOME / "bin" / "ollama-queue-logs")))
QHOME = Path(os.environ.get("QAGENT_HOME", str(HOME / ".qagent")))
ABORT = os.environ.get("QAGENT_ABORT", str(HOME / "bin" / "queue-abort"))
DEFAULT_MODEL = "qwen3.8:27b-q4_K_M"
# Bounds for freeform tasks (the model-card profile otherwise allows 32768 tokens/turn, 30 iters,
# which let a first real run emit a >1500-line single generation).  Sampling is NOT touched.
DEF_MAX_TOKENS = 12000    # per-turn output cap (thinking + answer)
DEF_MAX_ITERS = 12        # tool-loop iterations
RO_DEF_MAX_ITERS = 40     # read-only investigation navigates a lot; 12 cut real-repo runs off (2ee1420aa901)
FIX_DEF_MAX_ITERS = 30    # fix mode edits + verifies; 12 cut c8f4 off mid-edit twice (verify never ran)
DEF_CHAT_TIMEOUT = 900    # seconds per chat call
DEF_MAX_WALL = 1800       # seconds of ACTIVE run time; enforced by status/wait (abort)
TERMINAL = {"done", "failed", "blocked", "cancelled", "canceled"}
BANNER = ("=" * 72 + "\n  UNVERIFIED local-model output -- produced by a local LLM with no gate,\n"
          "  no verify, no review. Check every claim/id/number against the source.\n" + "=" * 72)

READONLY_PREAMBLE = (
    "Worker-flags: READONLY_JOB=1\n"
    "READ-ONLY TASK. You may read files and run read-only shell commands (cat, ls, grep, "
    "python3 ... status/list/show style queries). You MUST NOT create, edit, delete or move "
    "any file, and must not run anything that mutates state. Put your whole answer in your "
    "final message as plain text. Keep the final answer concise (under ~60 lines); never repeat "
    "yourself or pad.\n"
    "Investigate as many steps as you need, but BUDGET them: by your last ~5 iterations stop exploring and "
    "WRITE THE FINAL ANSWER (findings, evidence with file:line, and what is still unknown). A progress note "
    "like 'Let me look at...' is NOT an answer; always end with the written answer itself.\n"
    "Tool output may be truncated: narrow queries with grep/cut/head/sort|uniq -c, state it if any "
    "result was cut, and never claim completeness you did not verify.\n\n")
GENERAL_PREAMBLE = (
    "You are a general-purpose local agent. Complete the task below, then end with a short "
    "plain-text summary of what you did/found. Do not ask clarifying questions. Tool output may be "
    "truncated: narrow queries with grep/cut/head, say so if a result was cut, and never claim "
    "completeness you did not verify.\n\n")


def die(msg, code=2):
    print(f"qagent: {msg}", file=sys.stderr); sys.exit(code)


def slug(s, n=28):
    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")[:n] or "task"


def load_jobs():
    for _ in range(5):
        try:
            return json.loads(STATE.read_text()).get("jobs", [])
        except Exception:
            time.sleep(0.3)
    return []


def find_job(jid):
    hits = [j for j in load_jobs() if str(j.get("id", "")).startswith(jid)]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        die(f"ambiguous id prefix {jid}")
    return None


def done_sidecar(jid):
    p = LOG_DIR / f"{jid}.done.json"
    try:
        return json.loads(p.read_text())
    except Exception:
        return None


def job_or_sidecar(jid):
    j = find_job(jid)
    if j:
        return j
    d = done_sidecar(jid)
    if d:
        d.setdefault("id", jid)
        return d
    die(f"no such job {jid}", 1)


def build_enqueue(args, prompt, qid_hint):
    """Return (argv, task_file, cwd_note). Pure except for creating scratch + task file."""
    stamp = time.strftime("%Y%m%d-%H%M%S")
    workdir = QHOME / f"{stamp}-{qid_hint}"
    n = 1
    while workdir.exists() and (workdir / "TASK.txt").exists():   # same-second enqueues (fix retries) must not clobber
        n += 1; workdir = QHOME / f"{stamp}-{qid_hint}{n}"
    workdir.mkdir(parents=True, exist_ok=True)
    pre = READONLY_PREAMBLE if args.readonly else GENERAL_PREAMBLE
    tf = workdir / "TASK.txt"
    tf.write_text(pre + prompt + "\n")
    label = f"qagent-{slug(args.label or prompt)}-{stamp[-6:]}"
    argv = [sys.executable, QUEUE_PY, "enqueue", "--model", args.model, "--host", "auto",
            "--task-file", str(tf), "--label", label, "--bundle", label, "--no-preflight"]
    if getattr(args, "cwd", None):
        argv += ["--cwd", str(args.cwd)]   # fix mode: qagent-owned linked worktree
    elif args.repo:
        argv += ["--repo", str(Path(args.repo).expanduser().resolve())]
    else:
        scratch = workdir / "scratch"; scratch.mkdir(exist_ok=True)
        argv += ["--cwd", str(scratch), "--allow-unisolated"]
    if args.readonly:
        argv += ["--task-kind", "research"]
    else:
        argv += ["--task-kind", "coding", "--allow-no-verify"]
    argv += ["--max-iters", str(args.max_iters or (RO_DEF_MAX_ITERS if args.readonly else DEF_MAX_ITERS)),
             "--max-tokens", str(args.max_tokens or DEF_MAX_TOKENS),
             "--chat-timeout", str(args.chat_timeout or DEF_CHAT_TIMEOUT)]
    (workdir / "META.json").write_text(json.dumps({"max_wall": args.max_wall or DEF_MAX_WALL}))
    return argv, tf, label


def enqueue(args, prompt, quiet=False):
    argv, tf, label = build_enqueue(args, prompt, "q")
    if args.dry_run:
        print(json.dumps({"argv": argv, "task_file": str(tf), "label": label}, indent=1))
        print(os.environ.get("QAGENT_DRY_ID", "dryrun000000"))
        return 0
    r = subprocess.run(argv, capture_output=True, text=True)
    out = (r.stdout or "") + (r.stderr or "")
    if r.returncode != 0:
        die(f"enqueue failed (exit {r.returncode}):\n{out.strip()}", 1)
    m = re.search(r"\b([0-9a-f]{12})\b", out)
    if not m:
        j = [x for x in load_jobs() if x.get("label") == label]
        jid = j[0]["id"] if j else None
    else:
        jid = m.group(1)
    if not jid:
        die(f"enqueued but could not parse job id:\n{out.strip()}", 1)
    (tf.parent / "JOB").write_text(jid)
    if getattr(args, "watch", True):
        spawn_watchdog(jid)
    m = json.loads((tf.parent / "META.json").read_text()); m["job"] = jid
    (tf.parent / "META.json").write_text(json.dumps(m))
    if not quiet:
        print(jid)
    args.job_id = jid
    return 0


def cmd_run(a):
    return enqueue(a, a.prompt)


def max_wall_for(j):
    try:
        return json.loads((Path(j["task_file"]).parent / "META.json").read_text())["max_wall"]
    except Exception:
        return DEF_MAX_WALL


def enforce_wall(j):
    """Abort a RUNNING job whose active time exceeds its wall cap. Only runs while someone polls."""
    cap = max_wall_for(j)
    if j.get("status") == "running" and (j.get("active_s") or 0) > cap:
        print(f"qagent: {j['id']} exceeded wall cap {cap}s (active {int(j['active_s'])}s) -- aborting", file=sys.stderr)
        subprocess.run([ABORT, j["id"], "--yes"])
        return True
    return False


WATCH_MAX_S = 6 * 3600   # a watcher never outlives this, even if the job is stuck pending


def spawn_watchdog(jid):
    """Detached (nohup-style: new session, no stdio) watcher so --max-wall holds with nobody polling.
    Best-effort: a spawn failure must never fail the enqueue."""
    script = os.environ.get("QAGENT_WATCHER", os.path.abspath(__file__))
    try:
        logf = open(QHOME / "watchdog.log", "a")
        subprocess.Popen([sys.executable, script, "watch", jid], stdin=subprocess.DEVNULL, stdout=logf,
                         stderr=logf, start_new_session=True, close_fds=True)
        return True
    except Exception as e:
        print(f"qagent: watchdog spawn failed ({e}); wall cap only enforced by status/wait", file=sys.stderr)
        return False


def cmd_watch(a):
    """Poll until the job is terminal, aborting it when its active time exceeds the wall cap."""
    t0 = time.time(); missing = 0
    while time.time() - t0 < (a.max_watch or WATCH_MAX_S):
        j = find_job(a.id) or done_sidecar(a.id)
        if j is None:
            missing += 1
            if missing > 20:   # never appeared / pruned: nothing left to guard
                return 1
        else:
            missing = 0
            if j.get("status") in TERMINAL:
                return 0
            if enforce_wall(j):
                return 0
        time.sleep(a.poll)
    return 2


def cmd_status(a):
    j = job_or_sidecar(a.id)
    enforce_wall(j)
    print(f"{j.get('id')} status={j.get('status')} host={j.get('host_pref')} lane={j.get('lane')} "
          f"exit={j.get('exit_code')} model={j.get('model')} label={j.get('label')}")
    for k in ("failure_reason", "reason", "pause_reason"):
        if j.get(k):
            print(f"  {k}: {j[k]}")
    if j.get("log_path"):
        print(f"  log: {j['log_path']}")
    return 0


def cmd_wait(a):
    t0 = time.time()
    while True:
        j = job_or_sidecar(a.id)
        enforce_wall(j)
        st = j.get("status")
        if st in TERMINAL:
            print(f"{a.id} {st} after {int(time.time()-t0)}s")
            return 0 if st == "done" else 1
        if a.timeout and time.time() - t0 > a.timeout:
            print(f"{a.id} still {st} after {a.timeout}s (timeout)")
            return 2
        time.sleep(a.poll)


def transcript_path(log_text):
    m = re.search(r"^\[worker\] full transcript written to (.+)$", log_text, re.M)
    return m.group(1).strip() if m else None


def final_answer(j):
    """Last assistant text from the saved transcript; falls back to the log tail."""
    if not j.get("log_path"):  # pruned row: recover from the durable sidecars
        g = sorted(LOG_DIR.glob(f"{j.get('id')}-*.log"))
        if g:
            j["log_path"] = str(g[-1])
    ap = LOG_DIR / f"{j.get('id')}.answer.md"
    lp = j.get("log_path")
    log_text = ""
    if lp and Path(lp).exists():
        log_text = Path(lp).read_text(errors="replace")
    tp = j.get("resume_transcript") or transcript_path(log_text)
    if ap.exists() and ap.read_text().strip():
        return ap.read_text().strip(), tp, log_text
    if tp and Path(tp).exists():
        try:
            d = json.loads(Path(tp).read_text())
            msgs = d.get("messages", d) if isinstance(d, dict) else d
            for m in reversed(msgs):
                if m.get("role") == "assistant" and (m.get("content") or "").strip():
                    return m["content"].strip(), tp, log_text
        except Exception:
            pass
    return ("(no transcript answer found; log tail follows)\n" + "\n".join(log_text.splitlines()[-40:]),
            tp, log_text)


def _log_text(j):
    lp = j.get("log_path")
    return Path(lp).read_text(errors="replace") if lp and Path(lp).exists() else ""


TRUNC_RE = re.compile(r"\[OUTPUT TRUNCATED[^\]]*\]|\[TRUNCATED at \d+ chars\]|page truncated at \d+ chars|"
                      r"\[truncated \d+ (?:lines|chars)\]")


def truncation_notes(tp, log_text):
    """Worker-reported tool-result truncations (marker text the worker injects into tool results).
    Fail-open: any problem reading the transcript just yields what the log shows (or nothing)."""
    hits = []
    try:
        if tp and Path(tp).exists():
            d = json.loads(Path(tp).read_text())
            msgs = d.get("messages", d) if isinstance(d, dict) else d
            for m in msgs:
                if isinstance(m, dict) and m.get("role") == "tool":
                    c = m.get("content")
                    c = c if isinstance(c, str) else json.dumps(c)
                    hits += [h[:120] for h in TRUNC_RE.findall(c or "")]
    except Exception:
        pass
    try:
        if not hits:
            hits = [h[:120] for h in TRUNC_RE.findall(log_text or "")]
    except Exception:
        pass
    return hits


def collect_diff(j):
    cwd = j.get("cwd")
    if not cwd or not (Path(cwd) / ".git").exists():
        return None
    r = subprocess.run(["git", "-C", cwd, "status", "--porcelain"], capture_output=True, text=True)
    if not r.stdout.strip():
        return ""
    d = subprocess.run(["git", "-C", cwd, "diff", "HEAD"], capture_output=True, text=True).stdout
    return r.stdout + "\n" + d


def cmd_result(a):
    j = job_or_sidecar(a.id)
    print(BANNER)
    print(f"job {j.get('id')}  status={j.get('status')}  exit={j.get('exit_code')}  model={j.get('model')}")
    if j.get("status") not in TERMINAL:
        print("(job not finished yet -- use `qagent wait`)"); return 2
    ans, tp, ltxt = final_answer(j)
    print("\n--- final answer ---\n" + ans + "\n")
    tn = truncation_notes(tp, ltxt)
    if tn:
        print(f"--- WARNING: {len(tn)} tool result(s) were TRUNCATED by the worker; the answer may rest on "
              f"incomplete data (verify counts/lists) ---")
        for h in tn[:5]:
            print("  " + h)
    fm = fix_meta(j.get("id"))
    if fm:
        fix_print_report(fix_finalize(j.get("id")))
        diff = None
    else:
        diff = collect_diff(j)
    if diff:
        ro = (j.get("task_kind") == "research")
        print("--- diff / changed files" + (" (READONLY VIOLATION: read-only job changed files!)" if ro else "") + " ---")
        print(diff)
    elif diff == "" and not fm:
        print("--- diff: none (working tree clean) ---")
    sm = re.search(r"\[worker\] model=(\S+) host=(\S+)", _log_text(j))
    if sm:
        print(f"served model: {sm.group(1)} (requested {j.get('model')}) host={sm.group(2)}")
    print(f"worker log: {j.get('log_path')}")
    if tp:
        print(f"transcript: {tp}")
    print(BANNER)
    return 0 if j.get("status") == "done" else 1


def cmd_followup(a):
    j = job_or_sidecar(a.id)
    tf = j.get("task_file")
    orig = Path(tf).read_text() if tf and Path(tf).exists() else "(original prompt unavailable)"
    orig = orig.replace(READONLY_PREAMBLE, "").replace(GENERAL_PREAMBLE, "")
    ans, _, _ = final_answer(j)
    ro = j.get("task_kind") == "research"
    prompt = (f"FOLLOW-UP to an earlier task.\n\n[Original task]\n{orig}\n[Your previous final answer "
              f"(unverified -- re-check against the source if the follow-up questions it)]\n{ans}\n\n"
              f"[Follow-up request]\n{a.msg}\n")
    class NS: pass
    n = NS(); n.readonly = ro; n.model = a.model or j.get("model") or DEFAULT_MODEL
    n.label = f"followup-{a.id[:6]}"; n.max_iters = a.max_iters; n.dry_run = a.dry_run
    n.max_tokens = n.chat_timeout = n.max_wall = None
    n.repo = None; n.watch = True
    cwd = j.get("cwd")
    if cwd and not ro and (Path(cwd) / ".git").exists():
        n.repo = cwd  # continue from the prior job's tree state
    return enqueue(n, prompt)


def cmd_abort(a):
    r = subprocess.run([ABORT, a.id, "--yes"])
    j = find_job(a.id) or done_sidecar(a.id) or {}
    fm = fix_meta(j.get("id") or a.id)
    if fm:
        ok, msg = remove_fix_worktree(fm)
        print(f"qagent: {msg}")
        return r.returncode if ok else 1
    return r.returncode


# ---------------------------------------------------------------- FIX mode
WT_ROOT = Path(os.environ.get("QAGENT_WT_ROOT", str(HOME / ".ollama-dispatch" / "qagent-worktrees")))
VERIFY_TIMEOUT = int(os.environ.get("QAGENT_VERIFY_TIMEOUT", "600"))
# files a fix must never touch: tests / verify inputs (test-file protection), checked against base.
TEST_RE = re.compile(r"(^|/)(tests?|__tests__|spec|specs)/|(^|/)test_[^/]*\.py$|_test\.[a-z]+$|"
                     r"\.(test|spec)\.[a-z]+$|(^|/)conftest\.py$", re.I)
JUNK_EXCLUDES = [":(exclude,glob)**/__pycache__/**", ":(exclude,glob)**/*.pyc", ":(exclude,glob)**/.pytest_cache/**",
                 ":(exclude,glob)**/node_modules/**", ":(exclude,glob)**/.DS_Store"]
FIX_PREAMBLE = (
    "FIX TASK. You are working in an isolated git worktree (your working directory); edit files ONLY there. "
    "Make the SMALLEST source change that fixes the problem. You MUST NOT modify, delete, rename or add "
    "any test file or anything the verify command reads as its check (tests/, test_*.py, *_test.*, "
    "*.test.*, conftest.py, fixtures) -- such a change is detected and REJECTED. Do not commit. "
    "Run the verify command yourself after editing and iterate until it exits 0. End with a short "
    "plain-text summary: root cause, what you changed, the verify result.\n"
    "Tool output may be truncated: narrow queries with grep/cut/head, and never claim completeness you did "
    "not verify.\n\n")


def git(repo, *a, check=False, timeout=120):
    return subprocess.run(["git", "-C", str(repo), *a], capture_output=True, text=True, timeout=timeout, check=check)


def under(path, root):
    try:
        rp, rr = Path(path).resolve(), Path(root).resolve()
    except Exception:
        return False
    return rr in rp.parents


def run_verify(cmd, cwd, timeout=None):
    """Run the verify command in cwd. Returns (exit_code, output_tail). Timeout -> 124."""
    try:
        r = subprocess.run(cmd, shell=True, cwd=str(cwd), capture_output=True, text=True,
                           timeout=timeout or VERIFY_TIMEOUT)
        out = (r.stdout or "") + (r.stderr or "")
        return r.returncode, out[-3000:]
    except subprocess.TimeoutExpired as e:
        return 124, f"(verify timed out after {timeout or VERIFY_TIMEOUT}s)"
    except Exception as e:
        return 127, f"(verify could not run: {e})"


def fix_dir():
    d = QHOME / "fix"; d.mkdir(parents=True, exist_ok=True); return d


def fix_meta(jid):
    if not jid:
        return None
    try:
        fp = fix_dir() / f"{jid}.json"
        if not fp.exists():   # accept a unique id prefix (abort/result are often called with 6 chars)
            g = list(fix_dir().glob(f"{jid}*.json"))
            fp = g[0] if len(g) == 1 else fp
        return json.loads(fp.read_text())
    except Exception:
        return None


def fix_save(jid, m):
    jid = m.get("job", jid)
    (fix_dir() / f"{jid}.json").write_text(json.dumps(m, indent=1))


def repo_snapshot(repo):
    return {"head": git(repo, "rev-parse", "HEAD").stdout.strip(),
            "status": git(repo, "status", "--porcelain", "--untracked-files=all").stdout}


def verify_protected(cmd, wt):
    """Paths (relative to the worktree) named by the verify command that exist at base: they are the check."""
    import shlex
    out = set()
    try:
        toks = shlex.split(cmd)
    except ValueError:
        toks = cmd.split()
    for t in toks:
        t = t.split("::")[0]
        if not t or t.startswith("-"):
            continue
        p = (Path(wt) / t)
        if p.exists() and under(p, wt):
            rel = str(p.resolve().relative_to(Path(wt).resolve()))
            if rel != ".":   # `pytest .` must not protect the whole tree (test-file regex still applies)
                out.add(rel)
    return out


def check_patch(files, protected, wt):
    """Reasons a diff must be REJECTED. `files` = [(status, path)] vs base."""
    bad = []
    for st, f in files:
        if f.startswith("/") or ".." in Path(f).parts:
            bad.append(f"path outside repo: {f}")
            continue
        fp = Path(wt) / f
        if fp.is_symlink() or (fp.exists() and not under(fp, wt)):
            bad.append(f"symlink / escaping path: {f}")
        if TEST_RE.search(f):
            bad.append(f"modifies test file: {f}")
        elif any(f == p or f.startswith(p.rstrip("/") + "/") for p in protected):
            bad.append(f"modifies verify target: {f}")
    return bad


# ---------------------------------------------------------------- baseline validity / harness / scope
INVALID_RE = re.compile(r"No such file or directory|command not found|cannot open|ENOENT|can't open file", re.I)
REF_EXT = r"(?:py|sh|bash|ts|tsx|mts|js|mjs|cjs|jsx|json|txt|rb|go|rs|ya?ml|sql|csv|toml|ini|cfg)"
REF_RE = re.compile(r"(?<![\w/.-])(?:\./)?([\w@+-][\w@+./-]*\.%s)(?![\w-])" % REF_EXT)
SCRIPT_EXT = (".sh", ".bash")


def file_sha(p):
    import hashlib
    try:
        return hashlib.sha256(Path(p).read_bytes()).hexdigest()
    except Exception:
        return None


def _ref_ok(n):
    return bool(n) and not n.startswith("/") and ".." not in Path(n).parts and "://" not in n


def referenced_names(cmd, roots, depth=4):
    """File names mentioned in the verify command and (transitively) inside any shell script it names that is
    found under `roots`.  Names only -- they need not exist."""
    seen, queue, out = set(), [cmd], []
    for _ in range(depth + 1):
        nxt = []
        for text in queue:
            for n in REF_RE.findall(text or ""):
                if n in seen or not _ref_ok(n):
                    continue
                seen.add(n); out.append(n)
                if n.endswith(SCRIPT_EXT):
                    for r in roots:
                        try:
                            if (Path(r) / n).is_file() and under(Path(r) / n, r):
                                nxt.append((Path(r) / n).read_text(errors="replace")); break
                        except Exception:
                            pass
        queue = nxt
        if not queue:
            break
    return out


def untracked_refs(cmd, roots, repo, base):
    """referenced_names() that are NOT tracked at `base`: harness-only names (copied in, or creatable by the model)."""
    return sorted(n for n in referenced_names(cmd, roots)
                  if git(repo, "cat-file", "-e", f"{base}:{n}").returncode != 0)


def invalid_baseline(code, out, verify, wt, srcs, repo):
    """Message when the baseline 'failure' is a missing file/command rather than a real failing check; else None."""
    if code == 0:
        return None
    if not (code in (126, 127) or INVALID_RE.search(out or "")):
        return None
    cand = []
    for ln in (out or "").splitlines():
        if INVALID_RE.search(ln):
            cand += [n.lstrip("./") if n.startswith("./") else n for n in re.findall(r"([\w@+./-]+\.\w+)", ln)]
    cand += referenced_names(verify, [wt])
    miss = sorted({n for n in cand if _ref_ok(n) and not (Path(wt) / n).exists()})
    where = [str(d) for d in [Path(repo), *map(Path, srcs)] if any((d / n).is_file() for n in miss)]
    return ("INVALID BASELINE: the baseline verify failed (exit %s) because a file or command is missing, not because a "
            "check detected the bug -- fixing against it would let the model write the missing check itself.\n"
            "Missing: %s\nRe-run with --harness-from <dir> containing the complete harness%s.\n"
            "verify output (tail):\n%s" % (
                code, ", ".join(miss) if miss else "(could not name a file; see output)",
                (" (found in: " + "; ".join(where) + ")") if where else "", (out or "").strip()[-600:]))


def parse_scope(problem):
    """Paths declared by 'Only edit X' / 'Only edit X, Y' in the problem text ([] = no scope declared)."""
    out = []
    for mt in re.finditer(r"(?i)\bonly\s+edit\s+([^\n]*)", problem or ""):
        seg = re.split(r"(?<=[\w`'\"/)])\.(?:\s|$)", mt.group(1))[0]
        items = re.findall(r"`([^`]+)`", seg) or re.split(r"\s*(?:,|\band\b)\s*", seg)
        for it in items:
            it = it.strip().strip("`'\".;: ")
            if it.startswith("./"):
                it = it[2:]
            if it and not re.search(r"\s", it):
                out.append(it)
    return out


def scope_violations(scope, files):
    """files = [(status, path)].  Out-of-scope paths, and ANY new file when a scope is declared."""
    out = []
    for st, f in files:
        ok = any(f == s or f.startswith(s.rstrip("/") + "/") for s in scope)
        if not ok:
            out.append(f"{f} is outside the declared scope ({', '.join(scope)})")
        elif st.startswith("A"):
            out.append(f"{f} is a NEW file (scope allows editing existing files only)")
    return out


def harness_names(m):
    names = set(m.get("protected", [])) | set(m.get("harness", [])) | set(m.get("harness_refs", []))
    wt = m.get("worktree")
    if wt and Path(wt).is_dir() and m.get("repo") and m.get("base"):
        names |= set(untracked_refs(m["verify"], [wt], m["repo"], m["base"]))
    return names


def land_guard(m, allow_new=False):
    """Reason `land` must refuse this report, else None.  Independent of the recorded verdict (old reports)."""
    files = [tuple(x.split("\t", 1)) for x in m["report"]["files"] if "\t" in x]
    scope = parse_scope(m.get("problem"))
    if scope:
        v = scope_violations(scope, files)
        if v:
            return "patch violates the declared scope:\n  " + "\n  ".join(v)
    names = harness_names(m)
    if files and all(f in names for _, f in files):
        return ("patch only adds/changes protected harness file(s) (" + ", ".join(f for _, f in files) +
                ") -- that is the verify harness, not a fix")
    if not scope and not allow_new and files and all(st.startswith("A") for st, _ in files):
        return ("patch only adds NEW files and modifies no pre-existing file (" + ", ".join(f for _, f in files) +
                "); pass --allow-new-files if that is intended")
    return None


def fix_verdict(before, after, files, bad, unv=()):
    if bad:
        return "REJECTED"
    if unv:
        return "UNVERIFIED"
    if not files:
        return "NO-CHANGE"
    if before != 0 and after == 0:
        return "VERIFIED"
    return "UNVERIFIED"


def fix_finalize(jid, force=False):
    m = fix_meta(jid)
    if not m:
        return None
    if m.get("report") and not force:
        return m
    wt = Path(m["worktree"])
    if not wt.is_dir() or not under(wt, WT_ROOT):
        m["report"] = {"verdict": "UNVERIFIED", "reasons": ["worktree missing or not under qagent-worktrees"],
                       "files": [], "before": m["baseline"]["exit"], "after": None}
        fix_save(jid, m); return m
    rs = repo_snapshot(m["repo"])
    reasons = []
    if rs != m["repo_snapshot"]:
        reasons.append("R's own checkout changed while the job ran (HEAD/status differ) -- worker wrote outside the worktree")
    # capture the patch BEFORE running verify (verify litter must not land in the patch)
    hset = set(m.get("harness", []))
    hx = [f":(exclude){h}" for h in sorted(hset | set(m.get("harness_refs", [])))]
    git(wt, "add", "-A", "--", ".", *JUNK_EXCLUDES, *hx)
    ns = git(wt, "diff", "--cached", "--name-status", "--no-renames", m["base"]).stdout
    files = [tuple(l.split("\t", 1)) for l in ns.splitlines() if "\t" in l]
    files = [(a, b.strip()) for a, b in files]
    patch = git(wt, "diff", "--cached", "--binary", "--no-renames", m["base"]).stdout
    pp = fix_dir() / f"{jid}.patch"
    pp.write_text(patch)
    stat = git(wt, "diff", "--cached", "--stat", "--no-renames", m["base"]).stdout
    protected = set(m.get("protected", []))
    bad = reasons + check_patch(files, protected, wt)
    unv = []
    # harness integrity: protected harness files must be byte-identical; protected names must not be created
    for h, sha in (m.get("harness_sha") or {}).items():
        if file_sha(Path(wt) / h) != sha:
            unv.append(f"model modified/deleted protected harness file {h} (dropped from the patch)")
    for n in m.get("harness_refs", []):
        if n not in hset and (Path(wt) / n).exists():
            unv.append(f"model created file {n}, a name the verify script depends on (protected; dropped from the patch)")
    scope = parse_scope(m.get("problem"))
    if scope:
        for x in scope_violations(scope, files):
            unv.append("scope: " + x)
    aft, aout = run_verify(m["verify"], wt)
    before = m["baseline"]["exit"]
    v = fix_verdict(before, aft, files, bad, unv)
    if v == "UNVERIFIED":
        if not (before != 0 and aft == 0):
            bad.append(f"verify after fix exit={aft} (needs fail->pass; before exit={before})")
        bad.extend(unv)
    m["report"] = {"verdict": v, "reasons": bad, "files": [f"{a}\t{b}" for a, b in files], "stat": stat,
                   "patch": str(pp), "before": before, "after": aft, "after_tail": aout[-1500:],
                   "when": time.strftime("%F %T")}
    fix_save(jid, m)
    return m


def fix_print_report(m):
    r = m["report"]
    print("\n--- FIX MODE report (verify run by qagent, not the model) ---")
    print(f"verdict: {r['verdict']}" + ("" if r["verdict"] == "VERIFIED" else "   <-- UNVERIFIED: do NOT apply unreviewed"))
    print(f"verify:  {m['verify']}")
    print(f"before:  exit {r['before']}   after: exit {r['after']}")
    for x in r["reasons"]:
        print(f"  ! {x}")
    print(f"files touched ({len(r['files'])}):")
    for x in r["files"]:
        print("  " + x.replace("\t", " "))
    if r.get("stat"):
        print(r["stat"].rstrip())
    print(f"full diff (patch file): {r['patch']}")
    print(f"worktree: {m['worktree']}   (base {m['base'][:12]} of {m['repo']}; R was not modified)")
    if r["verdict"] != "VERIFIED":
        print(f"after-verify tail:\n{r.get('after_tail', '')}")
    if r["verdict"] == "VERIFIED":
        print(f"land it: qagent land {m['job']}")
        if m.get("landed"):
            print(landed_line(m["landed"]))
    print(f"cleanup: qagent abort <jobid>   (removes the worktree)")
    if m.get("group"):
        print(group_summary(m["group"]))


def remove_fix_worktree(m):
    wt = Path(m["worktree"])
    if not under(wt, WT_ROOT):
        return False, f"refusing to remove {wt}: not under {WT_ROOT}"
    if wt.is_dir():
        r = git(m["repo"], "worktree", "remove", "--force", str(wt))
        if r.returncode != 0:
            return False, f"git worktree remove failed: {(r.stderr or r.stdout).strip()}"
    git(m["repo"], "worktree", "prune")
    return True, f"removed worktree {wt}"


def group_load(gid):
    try:
        return json.loads((fix_dir() / f"{gid}.group.json").read_text())
    except Exception:
        return None


def group_rows(g):
    rows = []
    for at in g["attempts"]:
        m = fix_meta(at["job"]) or {}
        r = m.get("report") or {}
        rows.append({"attempt": at["attempt"], "job": at["job"], "verdict": r.get("verdict", "PENDING"),
                     "tail": r.get("after_tail", ""), "patch": r.get("patch", "-"), "worktree": m.get("worktree", "-")})
    return rows


def group_summary(gid):
    g = group_load(gid)
    if not g:
        return ""
    out = [f"--- ATTEMPT GROUP {gid} ({len(g['attempts'])} of {g['max']} attempts) ---"]
    for r in group_rows(g):
        out.append(f"  attempt {r['attempt']}: job {r['job']}  {r['verdict']}  patch {r['patch']}")
    return "\n".join(out)


def write_escalation(g):
    gid = g["group"]
    L = [f"# qagent fix UNFIXED after {len(g['attempts'])} attempts -- escalate", "",
         f"group: {gid}", f"repo: {g['repo']}", f"base: {g['base']}", f"verify: {g['verify']}", "",
         "## Problem", "", g["problem"], "", "## Attempts", ""]
    for r in group_rows(g):
        L += [f"### Attempt {r['attempt']}", f"- job: {r['job']}", f"- outcome: {r['verdict']}",
              f"- patch: {r['patch']}", f"- worktree: {r['worktree']}", "- verify tail:", "", "```", r["tail"], "```", ""]
    p = fix_dir() / f"{gid}.escalation.md"
    p.write_text("\n".join(L))
    return p


def fix_group(a, repo, base):
    """--attempts N>1: sequential attempts, each a normal queue job in a FRESH worktree; stop at first VERIFIED."""
    n = a.attempts
    gid = "grp-" + time.strftime("%Y%m%d-%H%M%S") + "-" + os.urandom(3).hex()
    g = {"group": gid, "max": n, "repo": str(repo), "base": base, "verify": a.verify, "problem": a.problem, "attempts": []}
    note = ""
    for k in range(1, n + 1):
        rc, jid = fix_start(a, repo, base, note=note, group=gid if not a.dry_run else None, attempt=k)
        if jid is None:
            return rc
        g["attempts"].append({"job": jid, "attempt": k})
        (fix_dir() / f"{gid}.group.json").write_text(json.dumps(g, indent=1))
        w = type("W", (), {})(); w.id = jid; w.timeout = a.wait_timeout; w.poll = 15
        if cmd_wait(w) == 2:
            return 2
        m = fix_finalize(jid)
        r = m["report"]
        if r["verdict"] == "VERIFIED":
            x = type("X", (), {})(); x.id = jid
            rc = cmd_result(x)
            return land_after(a, jid, rc)
        if k < n:
            note = (f"\n\nThis is attempt {k + 1} of {n}. The previous attempt did not make the verify command pass. "
                    f"Raw verify output from that attempt (last 1500 chars):\n{(r.get('after_tail') or '')[-1500:]}")
    p = write_escalation(g)
    x = type("X", (), {})(); x.id = jid
    cmd_result(x)
    print(f"escalation: {p}")
    print(f"UNFIXED after {n} attempts -- escalate")
    return 1


def fix_start(a, repo, base, note="", group=None, attempt=1):
    """Cut a FRESH worktree at base, baseline-verify, enqueue one normal queue job. Returns (rc, jid); jid None = stop."""
    fixid = time.strftime("%Y%m%d-%H%M%S") + "-" + os.urandom(3).hex()
    wt = WT_ROOT / fixid
    if a.dry_run:
        print(f"(dry-run) would cut worktree {wt} at {base[:12]}, baseline-run {a.verify!r}, then enqueue")
    else:
        WT_ROOT.mkdir(parents=True, exist_ok=True)
        r = git(repo, "worktree", "add", "--detach", str(wt), base)
        if r.returncode != 0:
            die(f"worktree add failed: {(r.stderr or r.stdout).strip()}", 1)
    cleanup = lambda: git(repo, "worktree", "remove", "--force", str(wt)) if (not a.dry_run and under(wt, WT_ROOT)) else None
    harness = []
    if not a.dry_run:
        hf = getattr(a, "harness_from", None)
        if hf:
            harness = copy_harness(a.verify, hf, wt)
        else:
            miss = missing_harness(a.verify, wt, repo, a.problem)
            if miss:
                cleanup()
                die("verify names file(s) absent at base " + base[:12] + ": " + ", ".join(sorted(miss)) +
                    "  (present in " + "; ".join(sorted({v for v in miss.values()})) + ").\n"
                    "They are not in the base commit.  Re-run with  --harness-from <dir>  (e.g. --harness-from "
                    + str(next(iter(miss.values()))) + ")  to copy them in as protected, never-committed files.", 1)
        code, out = run_verify(a.verify, wt)
        git(wt, "clean", "-fdxq", *[x for h in harness for x in ("-e", h)])   # baseline litter must not enter the diff
        git(wt, "checkout", "-q", "--", ".")
        if code == 0:
            cleanup()
            print("qagent: verify already passes on the base -- nothing to fix (nothing enqueued, worktree removed).",
                  file=sys.stderr)
            return 3, None
        inv = invalid_baseline(code, out, a.verify, wt, [hf] if hf else [], repo)
        if inv:
            cleanup(); die(inv, 1)
        if code in (124, 127):
            cleanup(); die(f"baseline verify did not run cleanly (exit {code}): {out.strip()}", 1)
    else:
        code, out = 1, ""
    prompt = (FIX_PREAMBLE + f"PROBLEM:\n{a.problem}{note}\n\nVERIFY COMMAND (must exit 0 when fixed; currently exit {code}):\n"
              f"  {a.verify}\n" + (f"\nCurrent verify output (tail):\n{out[-1500:]}\n" if out else ""))
    n = type("N", (), {})()
    n.readonly = False; n.model = a.model; n.label = a.label or "fix-" + slug(a.problem, 20)
    n.max_iters = a.max_iters or FIX_DEF_MAX_ITERS; n.max_tokens = a.max_tokens; n.chat_timeout = a.chat_timeout
    n.max_wall = a.max_wall; n.dry_run = a.dry_run; n.watch = a.watch; n.repo = None; n.cwd = str(wt)
    rc = enqueue(n, prompt, quiet=True)
    if a.dry_run:
        return rc, None
    jid = getattr(n, "job_id", None)
    if rc != 0 or not jid:
        cleanup(); return (rc or 1), None
    protected = sorted(verify_protected(a.verify, wt))
    refs = untracked_refs(a.verify, [wt], repo, base)
    hsha = {h: file_sha(Path(wt) / h) for h in harness}
    fix_save(jid, {"harness_refs": refs, "harness_sha": hsha,"job": jid, "fixid": fixid, "repo": str(repo), "worktree": str(wt), "base": base,
                   "verify": a.verify, "baseline": {"exit": code, "tail": out[-1500:]}, "land": bool(a.land),
                   "protected": sorted(set(protected) | set(harness)), "harness": harness, "repo_snapshot": repo_snapshot(repo), "problem": a.problem,
                   **({"group": group, "attempt": attempt} if group else {})})
    print(jid)
    print(f"qagent: fix job {jid}; worktree {wt}; baseline verify exit {code} (fails, as required). "
          f"`qagent wait {jid}` then `qagent result {jid}`.", file=sys.stderr)
    if a.land and not a.wait:
        print(f"qagent: --land noted: without --wait, run `qagent land {jid}` once `qagent result {jid}` says VERIFIED.",
              file=sys.stderr)
    return 0, jid


def cmd_fix(a):
    repo = Path(a.repo).expanduser().resolve()
    top = git(repo, "rev-parse", "--show-toplevel")
    if top.returncode != 0:
        die(f"--repo is not a git repository: {repo}")
    repo = Path(top.stdout.strip()).resolve()
    br = git(repo, "rev-parse", "--verify", (a.base or "HEAD") + "^{commit}")
    if br.returncode != 0:
        die(f"bad --base {a.base}")
    base = br.stdout.strip()
    if a.attempts and a.attempts > 1:
        if not a.wait and not a.dry_run:
            die("--attempts > 1 needs --wait (retries are decided from each attempt's verify result)")
        return fix_group(a, repo, base)
    rc, jid = fix_start(a, repo, base)
    if jid is None:
        return rc
    if a.wait:
        w = type("W", (), {})(); w.id = jid; w.timeout = a.wait_timeout; w.poll = 15
        rw = cmd_wait(w)
        if rw == 2:
            return 2
        x = type("X", (), {})(); x.id = jid
        rc = cmd_result(x)
        return land_after(a, jid, rc)
    return 0


# ---------------------------------------------------------------- harness helpers
def _verify_paths(cmd):
    import shlex
    try:
        toks = shlex.split(cmd)
    except ValueError:
        toks = cmd.split()
    out = []
    for t in toks:
        t = t.split("::")[0]
        if t and not t.startswith("-") and not t.startswith("/") and ".." not in Path(t).parts:
            out.append(t)
    return out


def missing_harness(cmd, wt, repo, problem):
    """{path: where-found} for verify-named files absent in wt but present in the repo working tree or an earlier
    fix worktree for the same problem (the 'verify.sh is not in HEAD' case)."""
    found = {}
    prior = []
    try:
        for fp in fix_dir().glob("*.json"):
            if fp.name.endswith(".group.json"):
                continue
            pm = json.loads(fp.read_text())
            if pm.get("repo") == str(repo) and pm.get("problem") == problem and Path(pm.get("worktree", "")).is_dir():
                prior.append(Path(pm["worktree"]))
    except Exception:
        pass
    for t in _verify_paths(cmd):
        if (Path(wt) / t).exists():
            continue
        for d in [Path(repo)] + prior:
            if (d / t).is_file() and under(d / t, d):
                found[t] = str(d); break
    return found


def copy_harness(cmd, src, wt):
    """Copy the COMPLETE harness from src into wt (never overwriting): every untracked file of src (all files if src
    is not a git work tree), every file named in the verify command / referenced by name inside the verify
    script(s) that exists in src, plus verify.sh / verify.test.ts.  Returns the relative paths copied."""
    src = Path(src).expanduser().resolve()
    if not src.is_dir():
        die(f"--harness-from {src} is not a directory", 1)
    wt = Path(wt)
    cands = []
    top = git(src, "rev-parse", "--show-toplevel")
    if top.returncode == 0 and Path(top.stdout.strip()).resolve() == src:
        cands += [x for x in git(src, "ls-files", "-o", "--exclude-standard", "-z").stdout.split("\0") if x]
    elif top.returncode != 0:
        for dp, dn, fn in os.walk(src):
            dn[:] = [d for d in dn if d not in (".git", "node_modules", "__pycache__", ".venv")]
            cands += [str((Path(dp) / f).relative_to(src)) for f in fn]
    cands += _verify_paths(cmd) + ["verify.sh", "verify.test.ts"]
    done = []
    for _ in range(5):    # fixpoint: a copied script may reference more helpers
        before = len(done)
        for n in list(dict.fromkeys(cands + referenced_names(cmd, [src, wt]))):
            s, d = src / n, wt / n
            if (_ref_ok(n) and s.is_file() and not s.is_symlink() and under(s, src) and not d.exists()
                    and s.stat().st_size <= 5_000_000 and len(done) < 500 and ".git" not in Path(n).parts):
                d.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(s, d); done.append(n)
        if len(done) == before:
            break
    return sorted(done)


# ---------------------------------------------------------------- LAND
def landed_line(L):
    return f"LANDED {L['sha']} on {L['branch']} ({L['mode']})"


def _resolve_fix_job(ident):
    """-> (meta, error).  A group id picks its first VERIFIED attempt."""
    g = group_load(ident) if ident.startswith("grp-") else None
    if g:
        for at in g["attempts"]:
            m = fix_finalize(at["job"])
            if m and (m.get("report") or {}).get("verdict") == "VERIFIED":
                return m, None
        return None, f"group {ident}: no VERIFIED attempt -- refusing to land"
    m = fix_meta(ident)
    if not m:
        return None, f"{ident}: not a qagent fix job or group (no {fix_dir()}/{ident}*.json)"
    m = fix_finalize(m["job"])
    v = (m.get("report") or {}).get("verdict")
    if v != "VERIFIED":
        return None, f"job {m['job']}: verdict is {v}, not VERIFIED -- refusing to land"
    return m, None


def _pkg_has_test(wt):
    try:
        t = json.loads((Path(wt) / "package.json").read_text()).get("scripts", {}).get("test", "")
    except Exception:
        return False
    return bool(t) and "no test specified" not in t


def _land_once(m, branch, push, remote):
    """One landing attempt.  Returns ('ok', sha, mode) | ('rejected',) | ('fail', msg)."""
    repo, jid = m["repo"], m["job"]
    patch = m["report"]["patch"]
    files = [x.split("\t", 1)[1] for x in m["report"]["files"]]
    if remote:
        git(repo, "fetch", "-q", remote)
    tip = git(repo, "rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}")
    if tip.returncode != 0:
        return ("fail", f"branch {branch} does not exist in {repo}")
    tip = tip.stdout.strip()
    if remote and git(repo, "rev-parse", "--verify", "-q", f"refs/remotes/{remote}/{branch}").returncode == 0:
        rt = git(repo, "rev-parse", f"refs/remotes/{remote}/{branch}").stdout.strip()
        if rt != tip:
            if git(repo, "merge-base", "--is-ancestor", tip, rt).returncode == 0:
                tip = rt                        # remote is ahead: land on the newer tip
            elif push and git(repo, "merge-base", "--is-ancestor", rt, tip).returncode == 0:
                return ("fail", f"local {branch} has commits not on {remote}/{branch}; push them (or use --no-push) first")
            elif push:
                return ("fail", f"local {branch} and {remote}/{branch} have diverged; reconcile first")
    WT_ROOT.mkdir(parents=True, exist_ok=True)
    lw = WT_ROOT / ("land-" + jid[:12] + "-" + os.urandom(2).hex())
    r = git(repo, "worktree", "add", "--detach", str(lw), tip)
    if r.returncode != 0:
        return ("fail", f"worktree add failed: {(r.stderr or r.stdout).strip()}")
    try:
        return _land_in(m, lw, tip, branch, push, remote, patch, files)
    finally:
        git(repo, "worktree", "remove", "--force", str(lw))
        git(repo, "worktree", "prune")


def _land_in(m, lw, tip, branch, push, remote, patch, files):
    repo, jid = m["repo"], m["job"]
    r = git(lw, "apply", "--3way", patch)
    if r.returncode != 0:
        conf = git(lw, "diff", "--name-only", "--diff-filter=U").stdout.split()
        return ("fail", f"job {jid}: patch does not apply at {branch} tip {tip[:12]} (3-way)"
                        + (f"; conflicting files: {', '.join(conf)}" if conf else f"\n{(r.stderr or r.stdout).strip()[-800:]}"))
    # protected harness: untracked, uncommitted, only where the tip does not already have the file
    fwt = Path(m["worktree"])
    for h in m.get("protected", []):
        s, d = fwt / h, lw / h
        if s.exists() and not d.exists():
            d.parent.mkdir(parents=True, exist_ok=True)
            shutil.copytree(s, d) if s.is_dir() else shutil.copy2(s, d)
    if (Path(repo) / "node_modules").is_dir() and not (lw / "node_modules").exists():
        os.symlink(Path(repo) / "node_modules", lw / "node_modules")   # env parity for npm test (untracked)
    vc, vo = run_verify(m["verify"], lw)
    if vc != 0:
        return ("fail", f"job {jid}: fix verify FAILED at the current {branch} tip (exit {vc}): {m['verify']}\n{vo[-1500:]}")
    if _pkg_has_test(lw):
        sc, so = run_verify("npm test", lw)
        if sc != 0:
            return ("fail", f"job {jid}: repo suite (npm test) FAILED with the patch applied (exit {sc})\n{so[-1500:]}")
    else:
        print("qagent land: no package.json test script -- repo-suite step skipped", file=sys.stderr)
    # commit ONLY the patch's files
    for f in files:
        git(lw, "add", "-A", "--", f)
    staged = set(git(lw, "diff", "--cached", "--name-only").stdout.split())
    if not staged:
        return ("fail", f"job {jid}: patch is a no-op at the current {branch} tip (already applied?)")
    extra = staged - set(files)
    if extra:
        return ("fail", f"job {jid}: refusing to commit files outside the patch: {sorted(extra)}")
    first = (m.get("problem") or "").strip().splitlines()
    title = (first[0].strip()[:72] if first and first[0].strip() else f"qagent fix {jid}")
    c = git(lw, "commit", "-q", "-m", title)
    if c.returncode != 0:
        return ("fail", f"commit failed: {(c.stderr or c.stdout).strip()[-800:]}")
    sha = git(lw, "rev-parse", "HEAD").stdout.strip()
    if push:
        p = git(lw, "push", remote, f"{sha}:refs/heads/{branch}", timeout=300)
        if p.returncode != 0:
            txt = (p.stderr + p.stdout)
            if "rejected" in txt or "non-fast-forward" in txt or "fetch first" in txt:
                return ("rejected",)
            return ("fail", f"push failed: {txt.strip()[-800:]}")
        git(repo, "fetch", "-q", remote)
    # keep the commit reachable regardless (the worktree is about to be removed)
    git(repo, "update-ref", f"refs/qagent/landed/{jid}", sha)
    return ("ok", sha, "pushed" if push else "local", files, tip)


def _advance_checkout(m, sha, tip, branch, files, mode):
    """Fast-forward the user's checkout WITHOUT touching anything of theirs.  Prints at most one notice."""
    repo, jid = m["repo"], m["job"]
    cur = git(repo, "symbolic-ref", "-q", "--short", "HEAD").stdout.strip()
    if cur == branch:
        dirty = git(repo, "status", "--porcelain", "--", *files).stdout.strip()
        if dirty:
            if mode != "pushed":
                git(repo, "branch", f"qagent/{jid}", sha)
            return ("notice: your checkout has uncommitted changes to patched files; NOT touching it. " +
                    (f"Commit is on the remote -- pull with: git -C {repo} pull --ff-only" if mode == "pushed" else
                     f"Commit is on branch qagent/{jid}: git -C {repo} merge qagent/{jid}"))
        r = git(repo, "merge", "--ff-only", sha)
        if r.returncode != 0:
            if mode != "pushed":
                git(repo, "branch", f"qagent/{jid}", sha)
            return ("notice: could not fast-forward your checkout without risk (" + (r.stderr or r.stdout).strip().splitlines()[-1][:120] + "); " +
                    (f"commit is on the remote -- pull with: git -C {repo} pull --ff-only" if mode == "pushed"
                     else f"commit is on branch qagent/{jid}"))
        return None
    # branch not checked out here: compare-and-swap the ref
    r = git(repo, "update-ref", f"refs/heads/{branch}", sha, tip)
    return None if r.returncode == 0 else f"notice: could not advance local {branch}; commit {sha[:12]} is on refs/qagent/landed/{jid}"


def cmd_land(a):
    m, err = _resolve_fix_job(a.id)
    if not m:
        print(f"qagent land: {err}", file=sys.stderr); return 1
    if m.get("landed"):
        print(landed_line(m["landed"]) + "   (already landed)"); return 0
    why = land_guard(m, getattr(a, "allow_new_files", False))
    if why:
        print(f"qagent land: REFUSED, nothing landed. job {m['job']}: {why}", file=sys.stderr); return 1
    repo = m["repo"]
    branch = a.branch or git(repo, "symbolic-ref", "-q", "--short", "HEAD").stdout.strip() or "main"
    remotes = git(repo, "remote").stdout.split()
    remote = ("origin" if "origin" in remotes else (remotes[0] if remotes else None))
    tracks = bool(remote) and git(repo, "config", f"branch.{branch}.remote").returncode == 0
    push = a.push if a.push is not None else tracks
    if push and not remote:
        print("qagent land: --push but the repo has no remote", file=sys.stderr); return 1
    res = None
    for attempt in (1, 2):
        res = _land_once(m, branch, push, remote if (push or remote) else None)
        if res[0] != "rejected":
            break
        print(f"qagent land: push rejected (remote moved); re-landing from the new tip (attempt {attempt}/2)", file=sys.stderr)
    if res[0] == "rejected":
        print(f"qagent land: job {m['job']}: push rejected twice -- giving up cleanly (nothing pushed, nothing changed locally)", file=sys.stderr)
        return 1
    if res[0] == "fail":
        print(f"qagent land: ABORTED, nothing landed. {res[1]}", file=sys.stderr); return 1
    _, sha, mode, files, tip = res
    note = _advance_checkout(m, sha, tip, branch, files, mode)
    if note:
        print(f"qagent land: {note}")
    m = fix_meta(m["job"])
    m["landed"] = {"sha": sha, "branch": branch, "mode": mode, "when": time.strftime("%F %T")}
    fix_save(m["job"], m)
    print(landed_line(m["landed"]))
    return 0


# ---------------------------------------------------------------- UNLAND
def _unland_once(m, sha, branch, push, remote):
    """One revert attempt.  ('ok', newsha, tip, files) | ('already', by_sha) | ('rejected',) | ('fail', msg)."""
    repo, jid = m["repo"], m["job"]
    if remote:
        git(repo, "fetch", "-q", remote)
    tip = git(repo, "rev-parse", "--verify", f"refs/heads/{branch}^{{commit}}")
    if tip.returncode != 0:
        return ("fail", f"branch {branch} does not exist in {repo}")
    tip = tip.stdout.strip()
    if remote and git(repo, "rev-parse", "--verify", "-q", f"refs/remotes/{remote}/{branch}").returncode == 0:
        rt = git(repo, "rev-parse", f"refs/remotes/{remote}/{branch}").stdout.strip()
        if rt != tip:
            if git(repo, "merge-base", "--is-ancestor", tip, rt).returncode == 0:
                tip = rt
            elif push and git(repo, "merge-base", "--is-ancestor", rt, tip).returncode == 0:
                return ("fail", f"local {branch} has commits not on {remote}/{branch}; push them (or use --no-push) first")
            elif push:
                return ("fail", f"local {branch} and {remote}/{branch} have diverged; reconcile first")
    if git(repo, "cat-file", "-e", f"{sha}^{{commit}}").returncode != 0 or \
            git(repo, "merge-base", "--is-ancestor", sha, tip).returncode != 0:
        return ("fail", f"landed commit {sha[:12]} is not in the history of {branch} tip {tip[:12]} (rebased away?) -- nothing to revert")
    rv = git(repo, "log", "--format=%H", "-F", f"--grep=This reverts commit {sha}", f"{sha}..{tip}").stdout.split()
    if rv:
        return ("already", rv[0])
    files = git(repo, "diff-tree", "--no-commit-id", "--name-only", "-r", "--root", sha).stdout.split()
    WT_ROOT.mkdir(parents=True, exist_ok=True)
    lw = WT_ROOT / ("unland-" + jid[:12] + "-" + os.urandom(2).hex())
    r = git(repo, "worktree", "add", "--detach", str(lw), tip)
    if r.returncode != 0:
        return ("fail", f"worktree add failed: {(r.stderr or r.stdout).strip()}")
    try:
        r = git(lw, "revert", "--no-edit", sha)
        if r.returncode != 0:
            conf = git(lw, "diff", "--name-only", "--diff-filter=U").stdout.split()
            txt = (r.stderr + r.stdout)
            git(lw, "revert", "--abort")
            if not conf and "empty" in txt.lower():
                return ("already", tip)
            return ("fail", f"revert of {sha[:12]} conflicts at {branch} tip {tip[:12]}"
                    + (f"; conflicting files: {', '.join(conf)}" if conf else f"\n{txt.strip()[-600:]}"))
        new = git(lw, "rev-parse", "HEAD").stdout.strip()
        if push:
            p = git(lw, "push", remote, f"{new}:refs/heads/{branch}", timeout=300)
            if p.returncode != 0:
                txt = p.stderr + p.stdout
                if "rejected" in txt or "non-fast-forward" in txt or "fetch first" in txt:
                    return ("rejected",)
                return ("fail", f"push failed: {txt.strip()[-800:]}")
            git(repo, "fetch", "-q", remote)
        git(repo, "update-ref", f"refs/qagent/unlanded/{jid}", new)
        return ("ok", new, tip, files)
    finally:
        git(repo, "worktree", "remove", "--force", str(lw))
        git(repo, "worktree", "prune")


def cmd_unland(a):
    m = fix_meta(a.id)
    if not m and a.id.startswith("grp-") and group_load(a.id):
        for at in group_load(a.id)["attempts"]:
            mm = fix_meta(at["job"])
            if mm and mm.get("landed"):
                m = mm; break
    if not m:
        print(f"qagent unland: {a.id}: not a qagent fix job (no {fix_dir()}/{a.id}*.json)", file=sys.stderr); return 1
    L = m.get("landed")
    if not L:
        print(f"qagent unland: job {m['job']} has no `landed` record -- nothing to undo", file=sys.stderr); return 1
    if m.get("unlanded"):
        print(f"UNLANDED job {m['job']}: {L['sha']} was reverted by {m['unlanded']['sha']} on {m['unlanded']['branch']}"
              "   (already unlanded)"); return 0
    repo, branch, sha = m["repo"], L["branch"], L["sha"]
    remotes = git(repo, "remote").stdout.split()
    remote = ("origin" if "origin" in remotes else (remotes[0] if remotes else None))
    tracks = bool(remote) and git(repo, "config", f"branch.{branch}.remote").returncode == 0
    push = a.push if a.push is not None else (tracks and L.get("mode") == "pushed")
    if push and not remote:
        print("qagent unland: --push but the repo has no remote", file=sys.stderr); return 1
    res = None
    for attempt in (1, 2):
        res = _unland_once(m, sha, branch, push, remote)
        if res[0] != "rejected":
            break
        print(f"qagent unland: push rejected (remote moved); re-reverting from the new tip (attempt {attempt}/2)", file=sys.stderr)
    if res[0] == "rejected":
        print(f"qagent unland: job {m['job']}: push rejected twice -- giving up cleanly (nothing pushed, nothing changed locally)",
              file=sys.stderr); return 1
    if res[0] == "fail":
        print(f"qagent unland: ABORTED, nothing reverted. {res[1]}", file=sys.stderr); return 1
    m = fix_meta(m["job"])
    if res[0] == "already":
        m["unlanded"] = {"sha": res[1], "branch": branch, "mode": "already-reverted", "when": time.strftime("%F %T")}
        fix_save(m["job"], m)
        print(f"qagent unland: notice: {sha[:12]} is already reverted by {res[1][:12]} -- nothing to do")
        print(f"UNLANDED job {m['job']}: {sha} reverted by {res[1]} on {branch} (already reverted)"); return 0
    _, new, tip, files = res
    mode = "pushed" if push else "local"
    note = _advance_checkout(dict(m, job=m["job"] + "-unland"), new, tip, branch, files, mode)
    if note:
        print(f"qagent unland: {note}")
    m["unlanded"] = {"sha": new, "branch": branch, "mode": mode, "when": time.strftime("%F %T")}
    fix_save(m["job"], m)
    print(f"UNLANDED job {m['job']}: {sha} reverted by {new} on {branch} ({mode})")
    return 0


def land_after(a, jid, rc):
    """qagent fix --land: land automatically once the --wait result is VERIFIED."""
    if not getattr(a, "land", False):
        return rc
    m = fix_meta(jid)
    if not m or (m.get("report") or {}).get("verdict") != "VERIFIED":
        return rc
    x = type("X", (), {})(); x.id = jid; x.push = None; x.branch = None
    x.allow_new_files = getattr(a, "allow_new_files", False)
    return cmd_land(x) or rc



def main(argv=None):
    p = argparse.ArgumentParser(prog="qagent", description=__doc__.split("\n")[1])
    sp = p.add_subparsers(dest="cmd", required=True)
    r = sp.add_parser("run"); r.add_argument("--repo"); r.add_argument("--readonly", action="store_true")
    r.add_argument("--model", default=DEFAULT_MODEL); r.add_argument("--label")
    r.add_argument("--max-iters", type=int); r.add_argument("--max-tokens", type=int)
    r.add_argument("--chat-timeout", type=int); r.add_argument("--max-wall", type=int)
    r.add_argument("--dry-run", action="store_true")
    r.add_argument("--no-watch", dest="watch", action="store_false", help="skip the detached wall-cap watchdog")
    r.add_argument("prompt"); r.set_defaults(f=cmd_run)
    s = sp.add_parser("status"); s.add_argument("id"); s.set_defaults(f=cmd_status)
    w = sp.add_parser("wait"); w.add_argument("id"); w.add_argument("--timeout", type=int, default=0)
    w.add_argument("--poll", type=float, default=15); w.set_defaults(f=cmd_wait)
    x = sp.add_parser("result"); x.add_argument("id"); x.set_defaults(f=cmd_result)
    f = sp.add_parser("followup"); f.add_argument("id"); f.add_argument("msg")
    f.add_argument("--model"); f.add_argument("--max-iters", type=int)
    f.add_argument("--dry-run", action="store_true"); f.set_defaults(f=cmd_followup)
    wd = sp.add_parser("watch"); wd.add_argument("id"); wd.add_argument("--poll", type=float, default=20)
    wd.add_argument("--max-watch", type=float, default=0); wd.set_defaults(f=cmd_watch)
    fx = sp.add_parser("fix"); fx.add_argument("--repo", required=True); fx.add_argument("--verify", required=True)
    fx.add_argument("--base"); fx.add_argument("--land", action="store_true"); fx.add_argument("--model", default=DEFAULT_MODEL)
    fx.add_argument("--label"); fx.add_argument("--max-iters", type=int); fx.add_argument("--max-tokens", type=int)
    fx.add_argument("--chat-timeout", type=int); fx.add_argument("--max-wall", type=int)
    fx.add_argument("--dry-run", action="store_true"); fx.add_argument("--no-watch", dest="watch", action="store_false")
    fx.add_argument("--wait", action="store_true", help="block until done, then print the result report")
    fx.add_argument("--attempts", type=int, default=1, help="verify-gated retries in fresh worktrees (needs --wait)")
    fx.add_argument("--wait-timeout", type=int, default=2400)
    fx.add_argument("--allow-new-files", action="store_true", help="let --land accept a patch that only adds new files")
    fx.add_argument("--harness-from", help="dir holding verify files absent at --base (copied in as protected, uncommitted)")
    fx.add_argument("problem"); fx.set_defaults(f=cmd_fix)
    ld = sp.add_parser("land"); ld.add_argument("id")
    ld.add_argument("--push", dest="push", action="store_true", default=None)
    ld.add_argument("--no-push", dest="push", action="store_false")
    ld.add_argument("--branch"); ld.add_argument("--allow-new-files", action="store_true"); ld.set_defaults(f=cmd_land)
    ul = sp.add_parser("unland", help="revert a landed fix commit (see UNLAND in the module doc)"); ul.add_argument("id")
    ul.add_argument("--push", dest="push", action="store_true", default=None)
    ul.add_argument("--no-push", dest="push", action="store_false")
    ul.set_defaults(f=cmd_unland)
    ab = sp.add_parser("abort"); ab.add_argument("id"); ab.set_defaults(f=cmd_abort)
    a = p.parse_args(argv)
    return a.f(a)


if __name__ == "__main__":
    sys.exit(main())
